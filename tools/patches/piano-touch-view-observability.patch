+static void print_diagnostics(double elapsed, int final)
+{
+	double interval = elapsed - diag.previous_time;
+	int type, first = 1;
+
+	if (!opt.diagnostics)
+		return;
+	fprintf(stderr,
+		"{\"kind\":\"piano_touch_diagnostics\",\"final\":%s,\"replay\":%s,"
+		"\"elapsed_s\":%.6f,\"interval_s\":%.6f,\"records\":%lu,"
+		"\"records_hz\":%.3f,\"source_completion_hz\":%.3f,"
+		"\"sequence\":%llu,\"sequence_gaps\":%llu,"
+		"\"source_timestamp_ns\":%llu,\"source_interval_min_ms\":%.3f,"
+		"\"source_interval_max_ms\":%.3f,"
+		"\"sequence_reorders\":%llu,\"timestamp_reorders\":%llu,\"epochs\":%llu,"
+		"\"checksum_ok\":%lu,\"checksum_bad\":%lu,\"short_payload\":%lu,"
+		"\"reference_frames\":%lu,\"type_skips\":%lu,\"shape_skips\":%lu,"
+		"\"algorithm_frames\":%llu,\"algorithm_hz\":%.3f,"
+		"\"algorithm_sequence\":%llu,\"algorithm_complete_ns\":%llu,\"algorithm_mean_us\":%.3f,"
+		"\"input_report_attempts\":%llu,\"input_syn_success\":%llu,"
+		"\"input_syn_hz\":%.3f,\"input_sequence\":%llu,\"input_complete_ns\":%llu,\"input_write_errors\":%lu,"
+		"\"read_age_samples\":%llu,\"read_age_mean_ms\":%.3f,\"read_age_max_ms\":%.3f,"
+		"\"input_age_samples\":%llu,\"input_age_mean_ms\":%.3f,\"input_age_max_ms\":%.3f,"
+		"\"frame_no\":%u,\"firmware_drop_frame_no\":%u,\"scan_mode\":%u,"
+		"\"firmware_scan_rate\":%u,\"scan_freq_index\":%u,\"types\":{",
+		final ? "true" : "false", diag.replay ? "true" : "false", elapsed, interval,
+		st.records, interval > 0 ? (st.records - diag.previous_records) / interval : 0,
+		diag.source_ns ? diag.source_intervals * 1e9 / diag.source_ns : 0,
+		(unsigned long long)diag.sequence, (unsigned long long)diag.sequence_gaps,
+		(unsigned long long)diag.timestamp_ns, diag.source_interval_min_ns / 1e6,
+		diag.source_interval_max_ns / 1e6,
+		(unsigned long long)diag.sequence_reorders,
+		(unsigned long long)diag.timestamp_reorders, (unsigned long long)diag.epochs,
+		st.csum_ok, st.csum_bad, st.short_payload, diag.reference_frames,
+		diag.type_skips, diag.shape_skips, (unsigned long long)diag.algorithm_frames,
+		interval > 0 ? (diag.algorithm_frames - diag.previous_algorithm_frames) / interval : 0,
+		(unsigned long long)diag.algorithm_sequence,
+		(unsigned long long)diag.algorithm_complete_ns,
+		diag.algorithm_frames ? diag.algorithm_ns / 1e3 / diag.algorithm_frames : 0,
+		(unsigned long long)diag.input_attempts, (unsigned long long)diag.input_frames,
+		interval > 0 ? (diag.input_frames - diag.previous_input_frames) / interval : 0,
+		(unsigned long long)diag.input_sequence, (unsigned long long)diag.input_complete_ns,
+		st.ui_write_errors,
+		(unsigned long long)diag.age_count,
+		diag.age_count ? diag.age_ns / 1e6 / diag.age_count : 0, diag.age_max_ns / 1e6,
+		(unsigned long long)diag.input_age_count,
+		diag.input_age_count ? diag.input_age_ns / 1e6 / diag.input_age_count : 0,
+		diag.input_age_max_ns / 1e6, diag.frame_no, diag.firmware_drop_frame_no,
+		diag.scan_mode, diag.firmware_scan_rate, diag.scan_freq_index);
+	for (type = 0; type < MAX_TYPES; type++)
+		if (st.types[type]) {
+			fprintf(stderr, "%s\"%d\":%lu", first ? "" : ",", type, st.types[type]);
+			first = 0;
+		}
+	fputs("}}\n", stderr);
+	fflush(stderr);
+	diag.previous_time = elapsed;
+	diag.previous_records = st.records;
+	diag.previous_algorithm_frames = diag.algorithm_frames;
+	diag.previous_input_frames = diag.input_frames;
+}
