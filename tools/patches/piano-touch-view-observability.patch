+static uint64_t le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+static uint64_t boot_ns(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_BOOTTIME, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static void observe_record(const uint8_t *h)
+{
+	uint64_t sequence = le64(h + 8), timestamp = le64(h + 16);
+	uint64_t now;
+	int epoch = !!(le16(h + 26) & 2);
+
+	if (!opt.diagnostics)
+		return;
+	if (diag.have_sequence) {
+		if (sequence <= diag.sequence_high)
+			diag.sequence_reorders++;
+		else
+			diag.sequence_gaps += sequence - diag.sequence_high - 1;
+	}
+	if (epoch) {
+		diag.epochs++;
+		diag.have_timestamp = 0;
+	}
+	if (diag.have_timestamp) {
+		if (timestamp <= diag.timestamp_ns)
+			diag.timestamp_reorders++;
+		else {
+			uint64_t interval = timestamp - diag.timestamp_ns;
+
+			diag.source_intervals++;
+			diag.source_ns += interval;
+			if (!diag.source_interval_min_ns || interval < diag.source_interval_min_ns)
+				diag.source_interval_min_ns = interval;
+			if (interval > diag.source_interval_max_ns)
+				diag.source_interval_max_ns = interval;
+		}
+	}
+	diag.sequence = sequence;
+	if (!diag.have_sequence || sequence > diag.sequence_high)
+		diag.sequence_high = sequence;
+	diag.timestamp_ns = timestamp;
+	diag.have_sequence = diag.have_timestamp = 1;
+	if (!diag.replay && timestamp) {
+		now = boot_ns();
+		if (now >= timestamp) {
+			uint64_t age = now - timestamp;
+
+			diag.age_count++;
+			diag.age_ns += age;
+			if (age > diag.age_max_ns)
+				diag.age_max_ns = age;
+		}
+	}
