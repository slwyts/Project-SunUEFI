+
+/* Optional bounded snapshot inside the one existing FIFO owner. Keep every
+ * complete NTP1 header and frame byte, including ordinary/SC/reference frames
+ * before and between pen29 packets. No packet or checksum field is rewritten.
+ * Memory is allocated only when enabled; the reader keeps running afterwards.
+ */
+#define CAPTURE_MAX_BYTES (16 * 1024 * 1024)
+static struct {
+	uint8_t *data;
+	size_t bytes;
+	unsigned long records, types[MAX_TYPES];
+	double start;
+	int fd, active;
+} raw_capture = { .fd = -1 };
+
+static int capture_open(void)
+{
+	if (!opt.capture_file)
+		return 0;
+	raw_capture.data = malloc(CAPTURE_MAX_BYTES);
+	if (!raw_capture.data)
+		return -ENOMEM;
+	/* New regular output only: do not overwrite a previous real capture. */
+	raw_capture.fd = open(opt.capture_file,
+			      O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	if (raw_capture.fd < 0) {
+		int error = -errno;
+
+		free(raw_capture.data);
+		raw_capture.data = NULL;
+		return error;
+	}
+	return 0;
+}
+
+static void capture_finish(const char *reason)
+{
+	size_t written = 0;
+	int error = 0, type, first = 1;
+
+	if (raw_capture.fd < 0)
+		return;
+	raw_capture.active = 0;
+	/* One bounded output at the end of the short window. Use a local tmpfs
+ * destination for debug capture; no per-frame disk writes or new daemon.
+ */
+	while (written < raw_capture.bytes) {
+		ssize_t n = write(raw_capture.fd, raw_capture.data + written,
+				  raw_capture.bytes - written);
+
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n <= 0) {
+			error = n < 0 ? errno : EIO;
+			break;
+		}
+		written += n;
+	}
+	if (close(raw_capture.fd) && !error)
+		error = errno;
+	raw_capture.fd = -1;
+	free(raw_capture.data);
+	raw_capture.data = NULL;
+	fprintf(stderr,
+		"{\"kind\":\"piano_touch_raw_capture\",\"reason\":\"%s\","
+		"\"format\":\"NTP1_UNCHANGED_RECORDS\",\"records\":%lu,"
+		"\"bytes\":%zu,\"written_bytes\":%zu,\"write_errno\":%d,\"types\":{",
+		reason, raw_capture.records, raw_capture.bytes, written, error);
+	for (type = 0; type < MAX_TYPES; type++)
+		if (raw_capture.types[type]) {
+			fprintf(stderr, "%s\"%d\":%lu", first ? "" : ",", type,
+				raw_capture.types[type]);
+			first = 0;
+		}
+	fputs("}}\n", stderr);
+}
+
+static void capture_record(const uint8_t *record, uint16_t hlen, uint16_t flen)
+{
+	size_t bytes = (size_t)hlen + flen;
+
+	if (!raw_capture.active)
+		return;
+	if (now_s() - raw_capture.start >= opt.capture_seconds) {
+		capture_finish("time_limit");
+		return;
+	}
+	if (bytes > CAPTURE_MAX_BYTES - raw_capture.bytes) {
+		capture_finish("byte_limit");
+		return;
+	}
+	memcpy(raw_capture.data + raw_capture.bytes, record, bytes);
+	raw_capture.bytes += bytes;
+	raw_capture.records++;
+	if (flen >= TRANSPORT_LEN + PAYLOAD_MIN)
+		raw_capture.types[record[hlen + TRANSPORT_LEN + 56]]++;
 }
 
