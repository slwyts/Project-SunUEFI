From: Project SunUEFI
Subject: [PATCH] input: connect real pen pressure and frames in the touch owner

Apply after the current observability and raw-capture patches.
Prerequisite derived source SHA256: 3074eedafe2230430e681560b1e1a95af57672d270d394e80a28569ee66cfe63

One existing THP FIFO reader polls read-only Bluetooth HID matching22/5081.
CLOCK_BOOTTIME aligns actual Report5 receipts and NTP1 frame timestamps.
The optional explicit --pen-input path uses the real calibrated core and
standard tablet-tool uinput. Missing pressure releases contact under the
caller-supplied timeout, without inventing a zero pressure value. Epoch,
transport loss and owner exit release state. Type29 is not a type3 hand
matrix; simultaneous hand-quarter input remains unimplemented.
No Bluetooth setup or scan/display writes are added. No pen options means
no pen/HID/uinput setup. The input path requires actual ini and explicitTTL.

--- a/initramfs/touch-view/piano-touch-view.c
+++ b/initramfs/touch-view/piano-touch-view.c
@@ -65,0 +66 @@
+#include "piano-pen-owner.h"
@@ -98 +99,7 @@
-} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5 };
+	const char *pen_ini, *pen_hidraw;
+	uint64_t pen_age_ns;
+	int pen_age_set, pen_input, pen_json;
+} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5, NULL, NULL, 0, 0, 0, 0 };
+
+static struct piano_pen_owner *pen_owner;
+static int kernel_hand_input;
@@ -330,0 +338,22 @@
+}
+
+static void pen_number(const char *name, int value, int known)
+{
+	fprintf(stderr, ",\"%s\":", name);
+	if (known)
+		fprintf(stderr, "%d", value);
+	else
+		fputs("null", stderr);
+}
+
+static void pen_diagnostic(const struct piano_pen_output *out)
+{
+	fprintf(stderr, "{\"kind\":\"piano_pen_decoded\",\"orientation\":\"portrait\","
+		"\"timestamp_ns\":%llu,\"valid\":%u,\"frame_no\":%u",
+		(unsigned long long)out->timestamp_ns, out->valid, out->frame_no);
+	pen_number("x", out->x, out->valid & PIANO_PEN_COORDINATES_VALID);
+	pen_number("y", out->y, out->valid & PIANO_PEN_COORDINATES_VALID);
+	pen_number("pressure", out->pressure, out->valid & PIANO_PEN_PRESSURE_VALID);
+	pen_number("tilt_x", out->tilt_x, out->valid & PIANO_PEN_TILT_VALID);
+	pen_number("tilt_y", out->tilt_y, out->valid & PIANO_PEN_TILT_VALID);
+	fputs("}\n", stderr);
@@ -763,0 +793,3 @@
+	if (kernel_hand_input)
+		return;
+
@@ -800,0 +833,2 @@
+	if (kernel_hand_input)
+		return;
@@ -1026,0 +1061,2 @@
+	      "       [--pen-ini FILE --pen-pressure-max-age-ms N] [--pen-hidraw FILE]\n"
+	      "       [--pen-input] (live input mode) [--pen-json] (native portrait diagnostics)\n"
@@ -1028,0 +1065,19 @@
+}
+
+/* Native touch input has no THP reader or uinput dependency. */
+static int kernel_hand_input_available(void)
+{
+	FILE *status = fopen("/proc/nvt_thp_status", "r");
+	char line[128], value[32];
+	int enabled = 0;
+
+	if (!status)
+		return 0;
+	while (fgets(line, sizeof(line), status)) {
+		if (sscanf(line, "kernel_input: %31s", value) == 1) {
+			enabled = !strcmp(value, "enabled");
+			break;
+		}
+	}
+	fclose(status);
+	return enabled;
@@ -1063,0 +1119,19 @@
+		else if (!strcmp(argv[i], "--pen-ini") && i + 1 < argc)
+			opt.pen_ini = argv[++i];
+		else if (!strcmp(argv[i], "--pen-hidraw") && i + 1 < argc)
+			opt.pen_hidraw = argv[++i];
+		else if (!strcmp(argv[i], "--pen-pressure-max-age-ms") && i + 1 < argc) {
+			char *end;
+			const char *value = argv[++i];
+			errno = 0;
+			unsigned long long age = strtoull(value, &end, 10);
+			if (errno || !value[0] || value[0] == '-' || *end ||
+			    age > UINT64_MAX / 1000000ULL)
+				usage();
+			opt.pen_age_ns = age * 1000000ULL;
+			opt.pen_age_set = 1;
+		}
+		else if (!strcmp(argv[i], "--pen-input"))
+			opt.pen_input = 1;
+		else if (!strcmp(argv[i], "--pen-json"))
+			opt.pen_json = 1;
@@ -1080,0 +1155,26 @@
+	if ((opt.pen_ini && !opt.pen_age_set) ||
+	    (!opt.pen_ini && (opt.pen_age_set || opt.pen_input || opt.pen_json || opt.pen_hidraw)) ||
+	    (opt.pen_input && (opt.mode != MODE_INPUT || !opt.pen_age_ns)))
+		usage();
+	kernel_hand_input = opt.mode == MODE_INPUT &&
+		!getenv("PIANO_THP_STREAM") && kernel_hand_input_available();
+	if (kernel_hand_input && !opt.pen_ini && !opt.capture_file &&
+	    !opt.diagnostics)
+		return 0;
+	if (opt.pen_ini && getenv("PIANO_THP_STREAM")) {
+		fputs("Use piano-pen-offline for captured pressure/frame replay; live HID timestamps cannot be mixed with old NTP1 records\n", stderr);
+		return 1;
+	}
+	if (opt.pen_ini) {
+		pen_owner = piano_pen_owner_create(opt.pen_ini, opt.pen_hidraw, opt.pen_age_ns);
+		if (!pen_owner)
+			return 1;
+		if (opt.pen_input) {
+			ret = piano_pen_owner_enable_input(pen_owner);
+			if (ret) {
+				fprintf(stderr, "pen input setup: %s\n", strerror(-ret));
+				piano_pen_owner_destroy(pen_owner);
+				return 1;
+			}
+		}
+	}
@@ -1096 +1196 @@
-	if (opt.mode == MODE_INPUT) {
+	if (opt.mode == MODE_INPUT && !kernel_hand_input) {
@@ -1100,0 +1201 @@
+			piano_pen_owner_destroy(pen_owner);
@@ -1111,0 +1213 @@
+		piano_pen_owner_destroy(pen_owner);
@@ -1116,0 +1219,2 @@
+		close(fd);
+		piano_pen_owner_destroy(pen_owner);
@@ -1131 +1235 @@
-		struct pollfd pfd[2] = {
+		struct pollfd pfd[3] = {
@@ -1133,0 +1238 @@
+			{ .fd = piano_pen_owner_poll_fd(pen_owner), .events = POLLIN },
@@ -1138 +1243 @@
-		ret = poll(pfd, 2, 200);
+		ret = poll(pfd, 3, opt.pen_input ? 10 : 200);
@@ -1140,0 +1246,2 @@
+		if (ret > 0)
+			piano_pen_owner_read_hid(pen_owner, pfd[2].revents);
@@ -1178 +1285,19 @@
-			handle_frame(h + hlen, flen);
+			struct piano_pen_output pen_output;
+			int pen_ret = piano_pen_owner_record(pen_owner, h + hlen, flen,
+				le64(h + 16), le16(h + 26), &pen_output);
+			if (pen_ret > 0 && opt.pen_json)
+				pen_diagnostic(&pen_output);
+			/* Type29 has four pen matrices and one hand quarter, not the
+			 * contiguous type3 hand matrix. Never feed it to that decoder.
+			 * Full concurrent hand-quarter integration remains separate work.
+			 */
+			if (pen_owner && flen >= TRANSPORT_LEN + 57 &&
+			    h[hlen + TRANSPORT_LEN + 56] == 29) {
+				st.types[29]++;
+				if (pen_ret > 0 && opt.mode == MODE_INPUT) {
+					int active = track(NULL, 0);
+					ui_report(active);
+				}
+			} else {
+				handle_frame(h + hlen, flen);
+			}
@@ -1189,0 +1315 @@
+		piano_pen_owner_tick(pen_owner);
@@ -1193,0 +1320,13 @@
+	struct piano_pen_owner_stats pen_stats = { 0 };
+	piano_pen_owner_stats(pen_owner, &pen_stats);
+	if (pen_owner)
+		fprintf(stderr, "pen: report5=%llu decoded29=%llu rejected=%llu input=%llu input_errors=%llu policy_contact_releases=%llu policy_stream_releases=%llu\n",
+			(unsigned long long)pen_stats.reports5,
+			(unsigned long long)pen_stats.frames29,
+			(unsigned long long)pen_stats.rejected_frames,
+			(unsigned long long)pen_stats.input_frames,
+			(unsigned long long)pen_stats.input_errors,
+			(unsigned long long)pen_stats.policy_contact_releases,
+			(unsigned long long)pen_stats.policy_stream_releases);
+	piano_pen_owner_destroy(pen_owner);
+	pen_owner = NULL;
@@ -1208,2 +1347,2 @@
-	return st.csum_ok ? 0 : 3;
-}
+	return st.csum_ok || pen_stats.frames29 || kernel_hand_input ? 0 : 3;
+}
