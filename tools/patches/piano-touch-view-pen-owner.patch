From: Project SunUEFI
Subject: [PATCH] input: connect real pen pressure and frames in the touch owner

Apply after the current observability and raw-capture patches.
Prerequisite derived source SHA256: 3074eedafe2230430e681560b1e1a95af57672d270d394e80a28569ee66cfe63

One existing THP FIFO reader polls read-only Bluetooth HID matching22/5081.
CLOCK_BOOTTIME aligns actual Report5 receipts and NTP1 frame timestamps.
The optional explicit --pen-input path uses the real calibrated core and
standard tablet-tool uinput. Missing pressure releases contact under the
caller-supplied timeout, without inventing a zero pressure value. Epoch,
transport loss and owner exit release state. Type29 is not a type3 hand
matrix; simultaneous hand-quarter input remains unimplemented.
No Bluetooth setup or scan/display writes are added. No pen options means
no pen/HID/uinput setup. The input path requires actual ini and explicitTTL.

--- a/initramfs/touch-view/piano-touch-view.c
+++ b/initramfs/touch-view/piano-touch-view.c
@@ -63,6 +63,7 @@
 #include <unistd.h>
 #include <linux/fb.h>
 #include <linux/uinput.h>
+#include "piano-pen-owner.h"
 
 #define STREAM_PATH "/proc/nvt_thp_stream"
 #define CONTROL_PATH "/proc/nvt_thp_raw"
@@ -95,7 +96,12 @@
 	int diagnostics;
 	const char *capture_file;
 	int capture_seconds;
-} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5 };
+	const char *pen_ini, *pen_hidraw;
+	uint64_t pen_age_ns;
+	int pen_age_set, pen_input, pen_json;
+} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5, NULL, NULL, 0, 0, 0, 0 };
+
+static struct piano_pen_owner *pen_owner;
 
 static struct {
 	unsigned long records, bad_magic, flag_valid, csum_ok, csum_bad;
@@ -328,6 +334,28 @@
 	raw_capture.records++;
 	if (flen >= TRANSPORT_LEN + PAYLOAD_MIN)
 		raw_capture.types[record[hlen + TRANSPORT_LEN + 56]]++;
+}
+
+static void pen_number(const char *name, int value, int known)
+{
+	fprintf(stderr, ",\"%s\":", name);
+	if (known)
+		fprintf(stderr, "%d", value);
+	else
+		fputs("null", stderr);
+}
+
+static void pen_diagnostic(const struct piano_pen_output *out)
+{
+	fprintf(stderr, "{\"kind\":\"piano_pen_decoded\",\"orientation\":\"portrait\","
+		"\"timestamp_ns\":%llu,\"valid\":%u,\"frame_no\":%u",
+		(unsigned long long)out->timestamp_ns, out->valid, out->frame_no);
+	pen_number("x", out->x, out->valid & PIANO_PEN_COORDINATES_VALID);
+	pen_number("y", out->y, out->valid & PIANO_PEN_COORDINATES_VALID);
+	pen_number("pressure", out->pressure, out->valid & PIANO_PEN_PRESSURE_VALID);
+	pen_number("tilt_x", out->tilt_x, out->valid & PIANO_PEN_TILT_VALID);
+	pen_number("tilt_y", out->tilt_y, out->valid & PIANO_PEN_TILT_VALID);
+	fputs("}\n", stderr);
 }
 
 static int write_control(int value)
@@ -1024,6 +1052,8 @@
 	      "       [--type N] [--threshold T] [--reference N] [--invert]\n"
 	      "       [--diagnostics N] (JSON every N seconds; default off)\n"
 	      "       [--capture FILE] [--capture-seconds N] (1..10s, default5s, max16MiB)\n"
+	      "       [--pen-ini FILE --pen-pressure-max-age-ms N] [--pen-hidraw FILE]\n"
+	      "       [--pen-input] (live input mode) [--pen-json] (native portrait diagnostics)\n"
 	      "       [--swap-xy] [--flip-x] [--flip-y]\n", stderr);
 	exit(2);
 }
@@ -1061,6 +1091,25 @@
