From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] Leave finger reporting to the touch driver

Apply after the palm-rejection patch.

The NT36532E driver now decodes THP frames and reports an MT-B input device,
so a second finger device from this reader would duplicate every touch. Add
--pen-only: no uinput device, no finger decode, no line-noise pass. The
reader keeps the stylus path, which still needs this process: type29 frames
carry the pen position and tilt from the touch chip while Bluetooth HID
report5 carries its pressure, and libinput needs both on one tablet device.

---
--- a/initramfs/touch-view/piano-touch-view.c
+++ b/initramfs/touch-view/piano-touch-view.c
@@ -110,8 +110,8 @@
 	int capture_seconds;
 	const char *pen_ini, *pen_hidraw;
 	uint64_t pen_age_ns;
-	int pen_age_set, pen_input, pen_json;
-} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5, NULL, NULL, 0, 0, 0, 0 };
+	int pen_age_set, pen_input, pen_json, pen_only;
+} opt = { MODE_STATS, 30, 200, 32, 0, 0, 0, 1, -1, 0, NULL, 5, NULL, NULL, 0, 0, 0, 0, 0 };
 
 static struct piano_pen_owner *pen_owner;
 
@@ -1119,6 +1119,12 @@
 			diag.shape_skips++;
 		return;
 	}
+	/* --pen-only: the touch driver decodes fingers; nothing here needs the
+	 * reference, the line-noise pass or the peak search.
+	 */
+	if (opt.pen_only)
+		return;
+
 	if (opt.diagnostics)
 		algorithm_start = boot_ns();
 
@@ -1160,6 +1166,11 @@
 			paint(active);
 			return;
 		}
+		if (opt.mode == MODE_INPUT && opt.pen_only) {
+			if (opt.diagnostics)
+				diag.algorithm_frames++;
+			return;
+		}
 		if (opt.mode == MODE_INPUT) {
 			int active = track(pts, count);
 
@@ -1327,6 +1338,8 @@
 			opt.pen_input = 1;
 		else if (!strcmp(argv[i], "--pen-json"))
 			opt.pen_json = 1;
+		else if (!strcmp(argv[i], "--pen-only"))
+			opt.pen_only = 1;
 		else if (!strcmp(argv[i], "--type") && i + 1 < argc)
 			opt.type = strtol(argv[++i], NULL, 0);
 		else if (!strcmp(argv[i], "--invert"))
@@ -1345,8 +1358,10 @@
 	    opt.capture_seconds < 1 || opt.capture_seconds > 10)
 		usage();
 	if ((opt.pen_ini && !opt.pen_age_set) ||
-	    (!opt.pen_ini && (opt.pen_age_set || opt.pen_input || opt.pen_json || opt.pen_hidraw)) ||
-	    (opt.pen_input && (opt.mode != MODE_INPUT || !opt.pen_age_ns)))
+	    (!opt.pen_ini && (opt.pen_age_set || opt.pen_input || opt.pen_json ||
+			      opt.pen_hidraw || opt.pen_only)) ||
+	    (opt.pen_input && (opt.mode != MODE_INPUT || !opt.pen_age_ns)) ||
+	    (opt.pen_only && !opt.pen_input))
 		usage();
 	if (opt.pen_ini && getenv("PIANO_THP_STREAM")) {
 		fputs("Use piano-pen-offline for captured pressure/frame replay; live HID timestamps cannot be mixed with old NTP1 records\n", stderr);
@@ -1380,7 +1395,10 @@
 		if (ret)
 			fprintf(stderr, "no framebuffer painting: %s\n", strerror(-ret));
 	}
-	if (opt.mode == MODE_INPUT) {
+	/* --pen-only: the touch driver owns the MT device; this process reads
+	 * the stylus frames and merges their Bluetooth pressure.
+	 */
+	if (opt.mode == MODE_INPUT && !opt.pen_only) {
 		ret = ui_open();
 		if (ret) {
 			fprintf(stderr, "/dev/uinput: %s (modprobe uinput)\n",
@@ -1469,7 +1487,7 @@
 				st.flag_valid++;
 			observe_record(h);
 			if (le16(h + 26) & 2) {
-				if (opt.mode == MODE_INPUT)
+				if (opt.mode == MODE_INPUT && !opt.pen_only)
 					ui_report(track(NULL, 0));
 				have_reference = 0;
 				ref_count = 0;
@@ -1491,7 +1509,7 @@
 			if (pen_owner && flen >= TRANSPORT_LEN + 57 &&
 			    h[hlen + TRANSPORT_LEN + 56] == 29) {
 				st.types[29]++;
-				if (pen_ret > 0 && opt.mode == MODE_INPUT) {
+				if (pen_ret > 0 && opt.mode == MODE_INPUT && !opt.pen_only) {
 					int active = release_as_palms();
 					ui_report(active);
 				}
