+/* 4-connected cells at or above the touch threshold around a peak. The
+ * cell count decides a palm; MAJOR/MINOR are 4 standard deviations of a
+ * filled ellipse. Every peak in a palm area is the palm
+ */
+static struct contact_area {
+	double x, y, weight;	/* delta-weighted centre, sensor pitch units */
+	double major_mm, minor_mm;
+	int palm, reported;
+} areas[MAX_POINTS];
+static unsigned char area_of[MAX_NODES];
+
+static void measure_area(int start, int label)
 {
-	int r, c, dr, dc, n = 0;
+	static const int step_r[] = { -1, 1, 0, 0 }, step_c[] = { 0, 0, -1, 1 };
+	static int queue[MAX_NODES];
+	struct contact_area *a = &areas[label - 1];
+	double cell_w = (double)PANEL_W_MM / st.cols, cell_h = (double)PANEL_H_MM / st.rows;
+	double n = 0, sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0;
+	double vx, vy, cxy, mid, half;
+	int head = 0, tail = 0, k;
+
+	memset(a, 0, sizeof(*a));
+	area_of[start] = label;
+	queue[tail++] = start;
+	while (head < tail) {
+		int node = queue[head++], r = node / st.cols, c = node % st.cols;
+		double x = (c + 0.5) * cell_w, y = (r + 0.5) * cell_h;
 
+		n++;
+		sx += x;
+		sy += y;
+		sxx += x * x;
+		syy += y * y;
+		sxy += x * y;
+		a->weight += delta[node];
+		a->x += delta[node] * (c + 0.5);
+		a->y += delta[node] * (r + 0.5);
+		for (k = 0; k < 4; k++) {
+			int rr = r + step_r[k], cc = c + step_c[k], next;
+
+			if (rr < 0 || cc < 0 || rr >= st.rows || cc >= st.cols)
+				continue;
+			next = rr * st.cols + cc;
+			if (area_of[next] || delta[next] < opt.threshold)
+				continue;
+			area_of[next] = label;
+			queue[tail++] = next;
+		}
+	}
+	a->x /= a->weight;
+	a->y /= a->weight;
+	vx = sxx / n - (sx / n) * (sx / n) + cell_w * cell_w / 12;
+	vy = syy / n - (sy / n) * (sy / n) + cell_h * cell_h / 12;
+	cxy = sxy / n - (sx / n) * (sy / n);
+	mid = (vx + vy) / 2;
+	half = sqrt((vx - vy) * (vx - vy) / 4 + cxy * cxy);
+	a->major_mm = 4 * sqrt(mid + half);
+	a->minor_mm = mid > half ? 4 * sqrt(mid - half) : 0;
+	a->palm = n >= PALM_AREA_CELLS;
+}
+
