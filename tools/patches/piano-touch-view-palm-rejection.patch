+/* contact sizes in touch units, at most the screen diagonal */
+#define TOUCH_SIZE_MAX 3848
+static int touch_units(double mm)
+{
+	double units = mm * SCREEN_RES + 0.5;
+
+	return units > TOUCH_SIZE_MAX ? TOUCH_SIZE_MAX : (int)units;
