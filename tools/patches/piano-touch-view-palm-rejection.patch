 }
 
+/* contacts down when the pen arrives are the hand holding it: lift them
+ * as palms so libinput cancels them instead of delivering a tap
+ */
+static int release_as_palms(void)
+{
+	int s;
+
+	for (s = 0; s < MAX_POINTS; s++)
+		if (trk.slot[s].active)
+			trk.slot[s].palm = 1;
+	return track(NULL, 0);
+}
