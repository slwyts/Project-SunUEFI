 						  .events = POLLPRI };
 			owner[n] = c;
-			is_vid[n++] = false;
+			kind[n++] = 0;
 			if (c->streaming) {
 				pfd[n] = (struct pollfd){ .fd = c->vid_fd,
 							  .events = POLLIN };
 				owner[n] = c;
-				is_vid[n++] = true;
