 				if (owner[i]->streaming)
 					cam_frame(owner[i]);
 			} else if (pfd[i].revents & POLLPRI) {
@@ -1409,6 +1793,7 @@
 
 	for (unsigned int i = 0; i < NUM_CAMS; i++)
 		cam_stop(&cams[i]);
+	control_close();
 	logmsg(NULL, "exit");
 
 	return 0;
