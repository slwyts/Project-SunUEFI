+		for (unsigned int i = 0; i < CONTROL_CLIENTS; i++) {
+			if (control_clients[i] < 0)
+				continue;
+			pfd[n] = (struct pollfd){ .fd = control_clients[i], .events = POLLIN };
+			owner[n] = NULL;
+			kind[n++] = 3 + i;
 		}
 
 		if (poll(pfd, n, 1000) < 0) {
@@ -1398,7 +1777,12 @@
 		for (unsigned int i = 0; i < n; i++) {
 			if (!pfd[i].revents)
