[Unit]
Description=Explicit Piano ttyGS0 debug shell
After=piano-linux-debug.service
Requires=piano-linux-debug.service
ConditionPathExists=/dev/ttyGS0
ConditionKernelCommandLine=piano.debug_shell=1

[Service]
Type=simple
ExecStart=/usr/local/sbin/piano-debug-bootstrap serial
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
