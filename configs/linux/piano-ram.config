# First autonomous UEFI RAM smoke profile; merge after the branch defconfig.
# Only RAM/virtual filesystems are available. Successful builds are not device
# validation. Keep the final DTB and initramfs provenance in the build manifest.
CONFIG_MODULES=y
CONFIG_ARCH_QCOM=y
CONFIG_OF=y
CONFIG_EFI=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y

# Let PianoUEFI pass this build's RAM init and recovery arguments. The
# reference /beaconinit, /pianoinit and userdata command lines must not survive.
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set

CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# Ramoops must describe this tablet's reserved RAM, not a copied board layout.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# CONFIG_PSTORE_BLK is not set
# CONFIG_EFI_VARS_PSTORE is not set
# CONFIG_EFI_CAPSULE_LOADER is not set
# CONFIG_EFI_BOOTLOADER_CONTROL is not set
# CONFIG_EFIVAR_FS is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y

# The first smoke boot has no block device or persistent storage driver.
# initramfs does not need CONFIG_BLOCK. A later debug fragment can restore it.
# BLOCK's disable choice is only visible under EXPERT in the kernel Kconfig.
CONFIG_EXPERT=y
# CONFIG_BLOCK is not set
# CONFIG_SCSI is not set
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_SCSI_UFSHCD_PLATFORM is not set
# CONFIG_SCSI_UFS_QCOM is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_MASS_STORAGE is not set

# Delay native display/IOMMU/DSP takeover until its own verified stage. These
# modules are not to be bundled or autoloaded by the first RAM initramfs.
CONFIG_DRM_MSM=m
CONFIG_ARM_SMMU=m
CONFIG_ARM_SMMU_V3=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PMIC_GLINK=m
# CONFIG_FW_LOADER_USER_HELPER is not set
