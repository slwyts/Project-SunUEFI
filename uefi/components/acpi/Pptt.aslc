#include "PianoAcpi.h"

typedef EFI_ACPI_6_3_PPTT_STRUCTURE_PROCESSOR PROCESSOR;
typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER Header;
  PROCESSOR                   Package;
  PROCESSOR                   Cluster[2];
  PROCESSOR                   Core[8];
} PIANO_PPTT;

#define PROCESSOR_HEADER .Type = EFI_ACPI_6_3_PPTT_TYPE_PROCESSOR, .Length = sizeof (PROCESSOR)
#define CLUSTER { PROCESSOR_HEADER, .Parent = OFFSET_OF (PIANO_PPTT, Package) }
#define CORE(Uid, Group) { PROCESSOR_HEADER, .Flags.AcpiProcessorIdValid = 1, \
  .Flags.NodeIsALeaf = 1, .Parent = OFFSET_OF (PIANO_PPTT, Cluster[Group]), .AcpiProcessorId = Uid }

STATIC PIANO_PPTT mPptt = {
  .Header = PIANO_HEADER (EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
                          PIANO_PPTT, EFI_ACPI_6_3_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION),
  .Package = { PROCESSOR_HEADER, .Flags.PhysicalPackage = 1 },
  .Cluster = { CLUSTER, CLUSTER },
  .Core = {
    CORE (0, 0), CORE (1, 0), CORE (2, 0), CORE (3, 0),
    CORE (4, 0), CORE (5, 0), CORE (6, 1), CORE (7, 1)
  }
};

VOID * EFIAPI ReferenceAcpiTable (VOID) { return &mPptt; }
