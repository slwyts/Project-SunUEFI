[Defines]
  INF_VERSION    = 0x00010005
  BASE_NAME      = PianoAcpiTables
  # The standard AcpiPlatformDxe locates this file with PcdAcpiTableStorageFile.
  FILE_GUID      = 7E374E25-8E01-4FEE-87F2-390C23C606CD
  MODULE_TYPE    = USER_DEFINED
  VERSION_STRING = 1.0

[Sources]
  Dsdt.asl
  Iort.aslc
  SmmuResources.h
  PianoAcpi.h

[Binaries.AARCH64]
  BIN|Tables/APIC.bin
  BIN|Tables/CSRT.bin
  BIN|Tables/DBG2.bin
  BIN|Tables/FACP.bin
  BIN|Tables/FACS.bin
  BIN|Tables/GTDT.bin
  BIN|Tables/PPTT.bin
  BIN|Tables/SPCR.bin

[Packages]
  MdePkg/MdePkg.dec
