#include "PianoAcpi.h"
#include <IndustryStandard/IoRemappingTable.h>
#include "SmmuResources.h"

#pragma pack(1)
typedef struct {
  EFI_ACPI_6_0_IO_REMAPPING_ITS_NODE Node;
  UINT32                             ItsId;
} PIANO_ITS;

typedef struct {
  EFI_ACPI_6_0_IO_REMAPPING_SMMU_NODE Node;
  EFI_ACPI_6_0_IO_REMAPPING_SMMU_INT  Context[PIANO_SMMU_CONTEXT_COUNT];
  EFI_ACPI_6_0_IO_REMAPPING_ID_TABLE  Msi;
} PIANO_SMMU;

typedef struct {
  EFI_ACPI_6_0_IO_REMAPPING_SMMU_NODE Node;
  EFI_ACPI_6_0_IO_REMAPPING_SMMU_INT  Context[PIANO_GPU_SMMU_CONTEXT_COUNT];
} PIANO_GPU_SMMU;

typedef struct {
  EFI_ACPI_6_0_IO_REMAPPING_NAMED_COMP_NODE Node;
  CHAR8                                     Path[sizeof ("\\_SB_.XXXX")];
  // A named component with a single mapping occupies 64 bytes.
  UINT8                                     Padding[4];
} PIANO_NAMED_COMPONENT;

typedef struct {
  PIANO_NAMED_COMPONENT                     Component;
  EFI_ACPI_6_0_IO_REMAPPING_ID_TABLE        Dma;
} PIANO_NAMED_DEVICE;

typedef struct {
  PIANO_NAMED_COMPONENT                     Component;
  EFI_ACPI_6_0_IO_REMAPPING_ID_TABLE        Dma[PIANO_GPU_MAPPING_COUNT];
} PIANO_GPU_DEVICE;

typedef struct {
  EFI_ACPI_6_0_IO_REMAPPING_TABLE Header;
  PIANO_ITS                       Its;
  PIANO_SMMU                      Smmu;
  PIANO_NAMED_DEVICE              Ufs;
  PIANO_NAMED_DEVICE              Usb;
  PIANO_GPU_SMMU                  GpuSmmu;
  PIANO_GPU_DEVICE                Gpu;
} PIANO_IORT;
#pragma pack()

#define NAMED_COMPONENT(Table, Name, Count, Width, Coherent) {         \
  .Node = { .Node = { .Type = EFI_ACPI_IORT_TYPE_NAMED_COMP,           \
    .Length = sizeof (Table), .Revision = 2,                           \
    .NumIdMappings = Count, .IdReference = OFFSET_OF (Table, Dma) },   \
    .CacheCoherent = Coherent, .AddressSizeLimit = Width,              \
    .MemoryAccessFlags = Coherent ? EFI_ACPI_IORT_MEM_ACCESS_FLAGS_CPM | \
                                    EFI_ACPI_IORT_MEM_ACCESS_FLAGS_DACS : 0 }, \
  .Path = Name }

#define DMA_DEVICE(Name, Sid, Width, Coherent) {                       \
  .Component = NAMED_COMPONENT (PIANO_NAMED_DEVICE, Name, 1, Width, Coherent), \
  .Dma = { .OutputBase = Sid,                                          \
    .OutputReference = OFFSET_OF (PIANO_IORT, Smmu),                   \
    .Flags = EFI_ACPI_IORT_ID_MAPPING_FLAGS_SINGLE } }

#define GPU_MAPPING(Input, Range, Sid, MappingFlags) {                 \
  .InputBase = Input, .NumIds = Range, .OutputBase = Sid,              \
  .OutputReference = OFFSET_OF (PIANO_IORT, GpuSmmu), .Flags = MappingFlags }

#define SMMU_REGISTERS(Prefix, Table)                                  \
  .Base = Prefix ## _BASE, .Span = Prefix ## _SPAN,                    \
  .Model = EFI_ACPI_IORT_SMMUv1v2_MODEL_MMU500, .Flags = Prefix ## _FLAGS, \
  .GlobalInterruptArrayRef = OFFSET_OF (EFI_ACPI_6_0_IO_REMAPPING_SMMU_NODE, SMMU_NSgIrpt), \
  .SMMU_NSgIrpt = Prefix ## _GLOBAL_IRQ, .SMMU_NSgIrptFlags = Prefix ## _GLOBAL_IRQ_FLAGS, \
  .NumContextInterrupts = Prefix ## _CONTEXT_COUNT,                    \
  .ContextInterruptArrayRef = OFFSET_OF (Table, Context)

STATIC PIANO_IORT mIort = {
  .Header = {
    .Header = PIANO_HEADER (EFI_ACPI_6_3_IO_REMAPPING_TABLE_SIGNATURE, PIANO_IORT,
                            EFI_ACPI_IO_REMAPPING_TABLE_REVISION_00),
    .NumNodes = 6, .NodeOffset = OFFSET_OF (PIANO_IORT, Its)
  },
  .Its = {
    .Node = { .Node = { .Type = EFI_ACPI_IORT_TYPE_ITS_GROUP, .Length = sizeof (PIANO_ITS) },
              .NumItsIdentifiers = 1 },
    .ItsId = 0  // Matches the ITS identifier in the MADT.
  },
  .Smmu = {
    .Node = {
      .Node = { .Type = EFI_ACPI_IORT_TYPE_SMMUv1v2, .Length = sizeof (PIANO_SMMU),
                .Revision = 1, .NumIdMappings = 1, .IdReference = OFFSET_OF (PIANO_SMMU, Msi) },
      SMMU_REGISTERS (PIANO_SMMU, PIANO_SMMU)
    },
    .Context = PIANO_SMMU_CONTEXT_IRQS,
    // Only UFS has an MSI parent; USB uses its wired GIC interrupt.
    .Msi = { .InputBase = PIANO_UFS_SID, .OutputBase = PIANO_UFS_MSI_ID,
             .OutputReference = OFFSET_OF (PIANO_IORT, Its) }
  },
  .Ufs = DMA_DEVICE ("\\_SB_.UFS0", PIANO_UFS_SID, PIANO_UFS_DMA_BITS, PIANO_UFS_COHERENT),
  .Usb = DMA_DEVICE ("\\_SB_.URS0", PIANO_USB_SID, PIANO_USB_DMA_BITS, PIANO_USB_COHERENT),
  .GpuSmmu = {
    .Node = {
      .Node = { .Type = EFI_ACPI_IORT_TYPE_SMMUv1v2, .Length = sizeof (PIANO_GPU_SMMU),
                .Revision = 1 },
      SMMU_REGISTERS (PIANO_GPU_SMMU, PIANO_GPU_SMMU)
    },
    .Context = PIANO_GPU_SMMU_CONTEXT_IRQS
  },
  .Gpu = {
    .Component = NAMED_COMPONENT (PIANO_GPU_DEVICE, "\\_SB_.GPU0", PIANO_GPU_MAPPING_COUNT,
                                  PIANO_GPU_DMA_BITS, PIANO_GPU_COHERENT),
    .Dma = { PIANO_GPU_MAPPINGS (GPU_MAPPING) }
  }
};

VOID * EFIAPI ReferenceAcpiTable (VOID) { return &mIort; }
