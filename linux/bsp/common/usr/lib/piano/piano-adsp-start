#!/bin/sh
# Start signed DSP firmware after native display rail ownership.
# Module discovery and supplier ordering belong to the kernel and udev.
set -eu
remaining=150
while :; do
    for device in /sys/class/remoteproc/remoteproc*; do
        [ -r "$device/name" ] || continue
        [ "$(cat "$device/name")" = adsp ] || continue
        [ "$(cat "$device/state")" != running ] || exit 0
        if grep -qx enabled /sys/class/drm/card*-DSI-1/enabled 2>/dev/null; then
            echo start > "$device/state"
            [ "$(cat "$device/state")" = running ]
            exit
        fi
    done
    [ "$remaining" -gt 0 ] || {
        echo 'ADSP 未启动：没有找到远程处理器，或内置显示尚未接管供电。' >&2
        exit 1
    }
    sleep 1
    remaining=$((remaining - 1))
done
