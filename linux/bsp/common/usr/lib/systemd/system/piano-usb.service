# SPDX-License-Identifier: MIT
[Unit]
Description=Piano USB NCM management network
# Udev marks the Type-C port ready after orientation and device role are set.
# Losing that readiness stops the gadget without blocking a cable-free boot.
BindsTo=sys-subsystem-typec-devices-port0.device
After=sys-subsystem-typec-devices-port0.device

[Service]
Type=oneshot
ExecStart=/usr/lib/piano/usb-network
ExecStop=/usr/lib/piano/usb-network stop
RemainAfterExit=yes
TimeoutStartSec=130
