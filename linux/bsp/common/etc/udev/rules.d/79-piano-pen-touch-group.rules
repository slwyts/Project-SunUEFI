# SPDX-License-Identifier: MIT
# The physical touchscreen and pen share one display. Keep legacy input names
# in the same group when using an older kernel.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", DRIVERS=="NVT-ts-spi", ENV{LIBINPUT_DEVICE_GROUP}="piano-touchscreen"
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="piano NT36532 THP touchscreen|Piano Focus Pen Pro", ENV{LIBINPUT_DEVICE_GROUP}="piano-touchscreen"
