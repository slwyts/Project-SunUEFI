# SPDX-License-Identifier: MIT
# The native touchscreen and virtual pen share one display. An explicit group
# pairs pen proximity with this touchscreen for libinput's touch arbitration.
# The names also cover finger input provided by the older userspace reader.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="piano NT36532 THP touchscreen|Piano Focus Pen Pro", ENV{LIBINPUT_DEVICE_GROUP}="piano-touchscreen"
