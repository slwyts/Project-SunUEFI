--- a/rootfs/overlay/usr/share/alsa/ucm2/Qualcomm/sm8750/Xiaomi-Pad-8-Pro/HiFi.conf
+++ b/rootfs/overlay/usr/share/alsa/ucm2/Qualcomm/sm8750/Xiaomi-Pad-8-Pro/HiFi.conf
@@ -5,13 +5,42 @@
 # landscape with the front camera at the top) and a four-channel stream
 # (FL, FR, LS, RS) to all four.
 
+Define {
+	SpeakerPcm 0
+	SpeakerChannels 4
+	SpeakerRoute MultiMedia1
+	SpeakerRawPlay 1
+}
+
+If.SpeakerDap {
+	Condition {
+		Type ControlExists
+		Control "name='SECONDARY_TDM_RX_0 Audio Mixer MultiMedia4'"
+	}
+
+	True.Define {
+		SpeakerPcm 3
+		SpeakerChannels 2
+		SpeakerRoute MultiMedia4
+		SpeakerRawPlay 0
+	}
+}
+
 SectionVerb {
 	# The front end to back end routes belong to the verb: the PCMs do not
 	# open without them, and PipeWire opens every PCM while it probes the
 	# verb, before any device is enabled.
 	EnableSequence [
-		cset "name='SECONDARY_TDM_RX_0 Audio Mixer MultiMedia1' 1"
+		cset "name='SECONDARY_TDM_RX_0 Audio Mixer MultiMedia1' ${var:SpeakerRawPlay}"
+		cset "name='SECONDARY_TDM_RX_0 Audio Mixer ${var:SpeakerRoute}' 1"
+		cset "name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2' 1"
 		cset "name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 1"
+		# Set all physical amp caches before PipeWire probes/starts the PCM.
+		# OEM FSM_Volume is 235 (-7.5 dB) on all four speaker paths.
+		cset "name='Top Left Amp Volume' 235"
+		cset "name='Top Right Amp Volume' 235"
+		cset "name='Bottom Left Amp Volume' 235"
+		cset "name='Bottom Right Amp Volume' 235"
 	]
 
 	Value {
@@ -23,20 +52,42 @@
 	Comment "Speaker playback"
 
 	Value {
-		PlaybackChannels 2
+		# DAP accepts stereo and renders four channels before the TDM port.
+		PlaybackChannels "${var:SpeakerChannels}"
 		PlaybackPriority 100
-		PlaybackPCM "hw:${CardId},0"
+		PlaybackPCM "hw:${CardId},${var:SpeakerPcm}"
 	}
 }
 
 SectionDevice."Mic" {
 	Comment "Internal microphone"
 
-	Include.vadm0e.File "/codecs/qcom-lpass/va-macro/DMIC0EnableSeq.conf"
-	Include.vadm0d.File "/codecs/qcom-lpass/va-macro/DMIC0DisableSeq.conf"
+	EnableSequence [
+		cset "name='VA DEC0 MUX' VA_DMIC"
+		cset "name='VA DMIC MUX0' DMIC2"
+		cset "name='VA_AIF1_CAP Mixer DEC0' 1"
+		# VA digital gain: -84 + 124 = +40 dB.
+		cset "name='VA_DEC0 Volume' 124"
+	]
+	DisableSequence [
+		cset "name='VA DMIC MUX0' ZERO"
+		cset "name='VA_DEC0 Volume' 0"
+		cset "name='VA_AIF1_CAP Mixer DEC0' 0"
+	]
 
 	Value {
+		CaptureChannels 1
 		CapturePriority 100
 		CapturePCM "hw:${CardId},2"
 	}
 }
+
+SectionDevice."HDMI" {
+	Comment "DisplayPort audio"
+	Value {
+		PlaybackChannels 2
+		PlaybackPriority 200
+		PlaybackPCM "hw:${CardId},1"
+		JackControl "DP0 Jack"
+	}
+}
