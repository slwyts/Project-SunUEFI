--- a/rootfs/overlay/usr/share/alsa/ucm2/Qualcomm/sm8750/Xiaomi-Pad-8-Pro/HiFi.conf
+++ b/rootfs/overlay/usr/share/alsa/ucm2/Qualcomm/sm8750/Xiaomi-Pad-8-Pro/HiFi.conf
@@ -12,6 +12,12 @@
 	EnableSequence [
 		cset "name='SECONDARY_TDM_RX_0 Audio Mixer MultiMedia1' 1"
 		cset "name='MultiMedia3 Mixer VA_CODEC_DMA_TX_0' 1"
+		# Set all physical amp caches before PipeWire probes/starts the PCM.
+		# OEM FSM_Volume is 235 (-7.5 dB) on all four speaker paths.
+		cset "name='Top Left Amp Volume' 235"
+		cset "name='Top Right Amp Volume' 235"
+		cset "name='Bottom Left Amp Volume' 235"
+		cset "name='Bottom Right Amp Volume' 235"
 	]
 
 	Value {
@@ -23,7 +29,8 @@
 	Comment "Speaker playback"
 
 	Value {
-		PlaybackChannels 2
+		# Open all four hardware slots; PipeWire duplicates ordinary stereo.
+		PlaybackChannels 4
 		PlaybackPriority 100
 		PlaybackPCM "hw:${CardId},0"
 	}
@@ -32,10 +39,21 @@
 SectionDevice."Mic" {
 	Comment "Internal microphone"
 
-	Include.vadm0e.File "/codecs/qcom-lpass/va-macro/DMIC0EnableSeq.conf"
-	Include.vadm0d.File "/codecs/qcom-lpass/va-macro/DMIC0DisableSeq.conf"
+	EnableSequence [
+		cset "name='VA DEC0 MUX' VA_DMIC"
+		cset "name='VA DMIC MUX0' DMIC2"
+		cset "name='VA_AIF1_CAP Mixer DEC0' 1"
+		# Measured speech headroom; the standard VA control uses 1 dB steps.
+		cset "name='VA_DEC0 Volume' 98"
+	]
+	DisableSequence [
+		cset "name='VA DMIC MUX0' ZERO"
+		cset "name='VA_DEC0 Volume' 0"
+		cset "name='VA_AIF1_CAP Mixer DEC0' 0"
+	]
 
 	Value {
+		CaptureChannels 1
 		CapturePriority 100
 		CapturePCM "hw:${CardId},2"
 	}
