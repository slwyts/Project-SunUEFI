Subject: [PATCH] avcodec/v4l2m2m: keep decoder phases out of encoder drain polling

The encoder does not negotiate a decoder capture phase and its zeroed
phase is WAIT_INITIAL. Applying that phase to its drain kept POLLOUT in
the poll mask, returned EAGAIN after input EOF and hit the ffmpeg encoder
frame assertion. Preserve the encoder's original capture-only drain poll.
Only a raw-video capture decoder uses source-change/initial phases.

Do not change payload, LAST/ERROR flags or other I/O errors.

--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -470,9 +470,11 @@
         pfd.events =  POLLOUT | POLLWRNORM;
     else {
         /* no need to listen to requests for more input while draining */
-        if ((s->draining && s->capture_phase != V4L2_CAPTURE_WAIT_INITIAL) ||
-            s->capture_phase == V4L2_CAPTURE_DRC_DRAIN ||
-            (s->capture_phase == V4L2_CAPTURE_RUNNING && (s->eof_pending || s->eos_event_seen)))
+        if ((s->draining && (ctx->av_codec_id != AV_CODEC_ID_RAWVIDEO ||
+                             s->capture_phase != V4L2_CAPTURE_WAIT_INITIAL)) ||
+            (ctx->av_codec_id == AV_CODEC_ID_RAWVIDEO &&
+             (s->capture_phase == V4L2_CAPTURE_DRC_DRAIN ||
+              (s->capture_phase == V4L2_CAPTURE_RUNNING && (s->eof_pending || s->eos_event_seen)))))
             pfd.events =  POLLIN | POLLRDNORM | POLLPRI;
     }
 
