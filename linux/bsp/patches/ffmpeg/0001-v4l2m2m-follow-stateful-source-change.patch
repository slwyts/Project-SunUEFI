+static int v4l2_buffer_has_payload(V4L2Buffer *buf)
+{
+    int i;
+
+    if (!V4L2_TYPE_IS_MULTIPLANAR(buf->buf.type))
+        return buf->buf.bytesused != 0;
+    for (i = 0; i < buf->num_planes; i++)
+        if (buf->planes[i].bytesused > buf->planes[i].data_offset)
+            return 1;
+    return 0;
+}
+
+static int v4l2_reclaim_initial_output(V4L2m2mContext *s)
+{
+    V4L2Context *ctx = &s->output;
+    struct v4l2_plane planes[VIDEO_MAX_PLANES];
+    struct v4l2_buffer buf;
+    V4L2Buffer *avbuf;
+    int i, queued = 0;
+
+    for (;;) {
+        memset(&buf, 0, sizeof(buf));
+        buf.type = ctx->type;
+        buf.memory = V4L2_MEMORY_MMAP;
+        if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+            memset(planes, 0, sizeof(planes));
+            buf.length = VIDEO_MAX_PLANES;
+            buf.m.planes = planes;
+        }
+        if (ioctl(s->fd, VIDIOC_DQBUF, &buf) < 0) {
+            if (errno != EAGAIN)
+                return AVERROR(errno);
+            break;
+        }
+        avbuf = &ctx->buffers[buf.index];
+        avbuf->status = V4L2BUF_AVAILABLE;
+        avbuf->buf = buf;
+        if (V4L2_TYPE_IS_MULTIPLANAR(ctx->type)) {
+            memcpy(avbuf->planes, planes, sizeof(planes));
+            avbuf->buf.m.planes = avbuf->planes;
+        }
+        if (buf.flags & V4L2_BUF_FLAG_ERROR)
+            return AVERROR_INVALIDDATA;
+    }
+    for (i = 0; i < ctx->num_buffers; i++)
+        queued += ctx->buffers[i].status == V4L2BUF_IN_DRIVER;
+    return queued;
+}
