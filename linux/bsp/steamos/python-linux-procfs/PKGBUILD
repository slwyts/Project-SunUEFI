# Arch Linux recipe rebuilt for Valve's Python ABI.
# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: Joakim Hernberg <jhernberg@alchemy.lu>
# Contributor: Ninez <triplesquarednine@gmail.com>

pkgname=python-linux-procfs
pkgver=0.7.4
pkgrel=2
pkgdesc='Linux /proc abstraction classes for Python'
arch=('any')
url='https://git.kernel.org/pub/scm/libs/python/python-linux-procfs/python-linux-procfs.git'
license=('GPL-2.0-only')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
# Use kernel.org's mirror for the release archive.
_mirror_repo=libs_python_python-linux-procfs_python-linux-procfs
source=("$pkgname-$pkgver-mirror.tar.gz::https://codeload.github.com/kernelorg-mirror/$_mirror_repo/tar.gz/refs/tags/v$pkgver")
sha512sums=('1b411d8545ffc8c58ff00d684c5263d5e97e56c87fb6e753f2f77b086669075f3a2b84666498f5777d5386a0beda92f8b0be55ac1d37b54d2f462022048ceae3')
b2sums=('9f524965df877782fa904cd0881d8b0ea12026864eab32ca605b5736ac44b5ef5b045eb0d411fcb2c7ffae8598c306b4ba5212eb533be4213c906a992acdef52')

build() {
  cd "$_mirror_repo-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_mirror_repo-$pkgver"
  python bitmasklist_test.py
}

package() {
  cd "$_mirror_repo-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
