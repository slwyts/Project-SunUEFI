# Based on the Arch Linux libfprint recipe recorded in config/fingerprint.json.
# Maintainer (upstream): Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Thomas Baechler <thomas@archlinux.org>

pkgname=libfprint
pkgver=@VERSION@
pkgrel=@RELEASE@
pkgdesc='Library for fingerprint readers'
url='https://fprint.freedesktop.org/'
arch=(aarch64)
license=(LGPL-2.1-or-later)
@OPTIONS@depends=(@DEPENDENCIES@)
makedepends=(git glib2-devel gobject-introspection gtk-doc meson python-cairo python-gobject systemd)
checkdepends=(cairo umockdev)
provides=(libfprint-2.so)
groups=(fprint)
source=(@SOURCES@)
sha256sums=(@CHECKSUMS@)
noextract=(piano-goodix-sources.tar)

prepare() {
  cd "$srcdir/$pkgname"
  local file backend=libfprint/drivers/piano-goodix
  for file in @PATCHES@; do
    patch --batch --fuzz=0 -Np1 -i "$srcdir/$file"
  done
  mkdir -p "$backend"
  bsdtar -xf "$srcdir/piano-goodix-sources.tar" -C "$backend"
}

build() {
  arch-meson "$pkgname" build -D drivers=all -D installed-tests=false
  meson compile -C build -j4
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
  local backend="$srcdir/$pkgname/libfprint/drivers/piano-goodix"
  local licenses="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$backend/BSD-3-Clause.txt" "$licenses/piano-goodix-BSD-3-Clause.txt"
  install -Dm644 "$backend/BSD-3-Clause-Clear.txt" "$licenses/piano-goodix-BSD-3-Clause-Clear.txt"
  install -Dm644 "$backend/qcbor/LICENSE" "$licenses/piano-goodix-QCBOR.txt"
  install -Dm644 "$backend/uapi/linux/tee.h" "$licenses/piano-goodix-linux-tee.h"
}
