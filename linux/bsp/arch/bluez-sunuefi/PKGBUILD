# Adapted from Arch Linux bluez 5.88-1 (Andreas Radke and Robin Candau).
# Build only the daemon package; keep its paths and boot integration unchanged.
pkgname=bluez-sunuefi
pkgver=5.88
pkgrel=1.1
pkgdesc='Bluetooth protocol stack daemon with the HID-over-GATT identity fix'
arch=(aarch64)
url='https://www.bluez.org/'
license=('GPL-2.0-only')
depends=(systemd-libs dbus glib2 alsa-lib glibc)
makedepends=(git systemd python-docutils)
provides=("bluez=$pkgver")
conflicts=(bluez)
backup=(etc/bluetooth/{main,input,network}.conf)
options=(!debug !lto)
source=("git+https://github.com/bluez/bluez.git#tag=$pkgver"
        bluetooth.modprobe
        0001-hog-read-uncached-pnp-id.patch)
b2sums=('debb4734eb5b59028a6194588c635652b8d170d74d2730d28cc60e0d4c01e682d594f9f65612c82a7ba2b60cc6b0fc362f4619846689fb8c24ebbece435b9637'
        '0ce33d13b796d4ae2fd688b17742b3a3055663b68a352b02720dac82bcfdaa47bf2ee2a034dfb8ef4ddf3f827bc58fe80548730939c2915f64864cea39c10170'
        'd478a69d54029087ec3c37052585bf0e2abf9a8c458b25fd53f56c5c3fe4bc13b06d339afd61d73db329b35bced21a2662e73d4e6369d94cfccf7e3d73bdfbdb')

prepare() {
  cd bluez
  patch --forward --fuzz=0 -Np1 -i "$srcdir/0001-hog-read-uncached-pnp-id.patch"
  autoreconf -vfi
}

build() {
  cd bluez
  ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --libexecdir=/usr/lib \
    --with-dbusconfdir=/usr/share \
    --enable-midi \
    --enable-sixaxis \
    --enable-datafiles \
    --disable-client \
    --disable-tools \
    --disable-monitor \
    --disable-cups \
    --disable-obex
  make src/builtin.h
  make src/bluetoothd doc/bluetoothd.8
}

check() {
  cd bluez
  make unit/test-hog
  ./unit/test-hog
}

package() {
  cd bluez
  install -Dm755 src/bluetoothd "$pkgdir/usr/lib/bluetooth/bluetoothd"
  install -Dm644 -t "$pkgdir/etc/bluetooth" src/main.conf \
    profiles/input/input.conf profiles/network/network.conf
  chmod 555 "$pkgdir/etc/bluetooth"
  install -Dm644 src/bluetooth.service "$pkgdir/usr/lib/systemd/system/bluetooth.service"
  install -Dm644 src/org.bluez.service "$pkgdir/usr/share/dbus-1/system-services/org.bluez.service"
  install -Dm644 src/bluetooth.conf "$pkgdir/usr/share/dbus-1/system.d/bluetooth.conf"
  install -Dm644 doc/bluetoothd.8 "$pkgdir/usr/share/man/man8/bluetoothd.8"
  install -Dm644 -t "$pkgdir/usr/share/doc/bluez/dbus-apis" doc/*.txt
  install -Dm644 "$srcdir/bluetooth.modprobe" "$pkgdir/usr/lib/modprobe.d/bluetooth-usb.conf"
  install -dm755 "$pkgdir/usr/lib/modules-load.d"
  printf '%s\n' crypto_user > "$pkgdir/usr/lib/modules-load.d/bluez.conf"
}
