{
  "schema_version": 1,
  "configuration": {
    "architecture": "all",
    "arch_package_architecture": "any"
  },
  "required_layers": {
    "firmware": {
      "target_specific": true,
      "source": {
        "commit": "05fc37c09ca8146eecfc4920f8485479db140ae5",
        "url": "https://github.com/blu-sharky/piano-firmware.git"
      },
      "license": "per blob; no license inherited from config"
    },
    "mesa": {
      "target_specific": true,
      "source": {
        "configuration": "config/mesa.json"
      },
      "license": "MIT AND BSD-3-Clause AND SGI-B-2.0; retain upstream notices"
    },
    "runtime": {
      "target_specific": true,
      "source": [
        "tools/stage_piano_ram_hardware.py",
        "tools/build_release_helpers.py"
      ],
      "kernel_context_abi": "piano-dma-context-v1",
      "include_adapted_public_scripts": true,
      "prebuilt_host_paths": false
    },
    "modules": {
      "target_specific": true,
      "kernel_release_must_match": true,
      "license": "retain kernel GPL and per-file BSD declarations"
    }
  }
}
