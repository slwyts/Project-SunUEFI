Subject: Recognize a render-only Adreno platform device

The split MSM render node has an Adreno platform device as its parent,
so the sysfs driver name is adreno rather than msm or msm_dpu.

--- a/runtime/droidloom-supervisor/src/host_gpu.rs
+++ b/runtime/droidloom-supervisor/src/host_gpu.rs
@@ -65,7 +65,7 @@
             "amdgpu" => Some(Vendor::Amd),
             "i915" | "xe" => Some(Vendor::Intel),
             "nvidia" => Some(Vendor::Nvidia),
-            "msm" | "msm_dpu" | "msm_mdp5" => Some(Vendor::Qualcomm),
+            "adreno" | "msm" | "msm_dpu" | "msm_mdp5" => Some(Vendor::Qualcomm),
             "panthor" | "panfrost" => Some(Vendor::Mali),
             _ => None,
         }
@@ -92,7 +92,7 @@
     Intel,
     /// `nvidia`, rendering through the GPU server.
     Nvidia,
-    /// `msm`, an Adreno on a Qualcomm SoC, rendering natively.
+    /// An Adreno on a Qualcomm SoC, rendering natively.
     Qualcomm,
     /// `panthor` or `panfrost`, an Arm Mali on the SoC, rendering natively.
     Mali,
@@ -269,23 +269,28 @@
         node("renderD131", "ae01000.display-controller", "msm_dpu");
         node("renderD132", "1c00000.gpu", "vc4");
         node("renderD133", "13000000.gpu", "panthor");
+        node("renderD134", "2c00000.gpu", "adreno");
+        node("card1", "ae02000.display-controller", "msm_dpu");
         assert_eq!(
             HostGpu::list(&root.join("drm")).unwrap(),
             [
                 gpu(128, "0000:04:00.0", "nvidia"),
                 gpu(129, "0000:0a:00.0", "amdgpu"),
                 gpu(131, "ae01000.display-controller", "msm_dpu"),
-                gpu(133, "13000000.gpu", "panthor")
+                gpu(133, "13000000.gpu", "panthor"),
+                gpu(134, "2c00000.gpu", "adreno"),
             ]
         );
     }
 
     #[test]
     fn an_adreno_renders_natively() {
-        let phone = [gpu(128, "ae01000.display-controller", "msm_dpu")];
-        let auto = Graphics::resolve(&GpuChoice::Auto, &phone).unwrap();
-        assert_eq!((auto.render_node.as_str(), auto.backend, auto.forwarded()), ("/dev/dri/renderD128", GraphicsBackend::Drm, None));
-        assert_eq!(Graphics::resolve(&"qualcomm".parse().unwrap(), &phone).unwrap(), auto);
+        for (device, driver) in [("ae01000.display-controller", "msm_dpu"), ("2c00000.gpu", "adreno")] {
+            let phone = [gpu(128, device, driver)];
+            let auto = Graphics::resolve(&GpuChoice::Auto, &phone).unwrap();
+            assert_eq!((auto.render_node.as_str(), auto.backend, auto.forwarded()), ("/dev/dri/renderD128", GraphicsBackend::Drm, None));
+            assert_eq!(Graphics::resolve(&"qualcomm".parse().unwrap(), &phone).unwrap(), auto);
+        }
     }
 
     #[test]
