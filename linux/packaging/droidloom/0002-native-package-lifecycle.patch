+fn runuser() -> Command {
+    // The executable is under /usr/sbin on Debian and /usr/bin on Arch.
+    let path = if Path::new("/usr/sbin/runuser").is_file() {
+        "/usr/sbin/runuser"
+    } else {
+        "/usr/bin/runuser"
+    };
+    Command::new(path)
+}
+
 fn user_command(uid: u32, executable: &str) -> Result<Command> {
     let account = user(uid)?;
-    let mut command = Command::new("/usr/bin/runuser");
+    let mut command = runuser();
     command
         .args(["-u", &account.name, "--", "/usr/bin/env"])
         .arg(format!("XDG_RUNTIME_DIR=/run/user/{uid}"))
@@ -476,7 +486,7 @@
