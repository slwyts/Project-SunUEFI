# Derived from the official Arch GNOME 51.0 package recipe.
# The upstream release includes the gvc source; no moving submodule is fetched.
pkgname=gnome-settings-daemon
pkgver=51.0
pkgrel=1.1
pkgdesc="GNOME Settings Daemon with optional device ambient-light profiles"
url="https://gitlab.gnome.org/GNOME/gnome-settings-daemon"
arch=(x86_64 aarch64)
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(alsa-lib bash dconf fontconfig gcr-4 geoclue geocode-glib-2 glib2 glibc
         gnome-desktop-4 gsettings-desktop-schemas gtk4 libcanberra-pulse libcolord
         libcups libgcc libgudev libgweather-4 libmm-glib libnm libnotify libp11-kit
         libpulse libx11 libxfixes polkit pulse-native-provider systemd-libs upower)
makedepends=(docbook-xsl glib2-devel libxslt meson python usbguard)
optdepends=('usbguard: USB protection support')
groups=(gnome)
backup=(etc/xdg/Xwayland-session.d/00-xrdb)
source=("https://download.gnome.org/sources/gnome-settings-daemon/51/gnome-settings-daemon-$pkgver.tar.xz"
        ambient-device-profile.patch)
sha256sums=('7c6249118ddfffc4bb34d6b3edaa86b3ea02a1ad2b7711d79480749906767665'
            '@PATCH_SHA256@')

prepare() {
  cd "gnome-settings-daemon-$pkgver"
  patch --fuzz=0 -Np1 -i "$srcdir/ambient-device-profile.patch"
}

build() {
  arch-meson "gnome-settings-daemon-$pkgver" build
  meson compile -C build
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
