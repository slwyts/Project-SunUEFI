#!/bin/sh
# Shared disk root: explicit PIANOROOT label or project PARTUUID, plus sunuefi_root and ext4.
export PATH=/usr/sbin:/usr/bin:/bin:/sbin
log() {
    printf 'piano: %s\n' "$*"
    # Persist early userspace failures even when the framebuffer stays blank.
    # After mount --move, the same devtmpfs is reachable below /sysroot.
    kmsg=/dev/kmsg
    [ -c "$kmsg" ] || kmsg=/sysroot/dev/kmsg
    if [ -c "$kmsg" ]; then printf '<5>piano: %s\n' "$*" >"$kmsg"; fi
}
fail() {
    log "DISK_ROOT_REFUSED: $*; remaining in initramfs rescue"
    # The shared gadget helper needs all virtual mounts at their original paths.
    # Rescue never returns, so no gadget handoff to the disk root is needed.
    # A late failure can occur after some or all mounts moved below /sysroot.
    # Move those same mounts back; do not create a second gadget or hide logs.
    for virtual in dev proc sys run; do
        if ! mountpoint -q "/$virtual" && mountpoint -q "/sysroot/$virtual"; then
            if ! mount --move "/sysroot/$virtual" "/$virtual"; then
                log "Cannot return $virtual to initramfs rescue"
            fi
        fi
    done
    if mountpoint -q /dev && mountpoint -q /proc &&
       mountpoint -q /sys && mountpoint -q /run; then
        if [ -r /etc/piano/modules-rescue-order ]; then
            while read -r name module; do
                [ -d "/sys/module/$name" ] || insmod "$module" ||
                    log "Rescue module $name could not load"
            done </etc/piano/modules-rescue-order
        fi
        if /usr/local/sbin/piano-debug-bootstrap start; then
            (
                while :; do
                    /usr/local/sbin/piano-debug-bootstrap serial
                    sleep 5
                done
            ) &
        else
            log 'USB rescue setup failed; console rescue remains available'
        fi
    fi
    console=/dev/console
    [ -c /dev/tty1 ] && console=/dev/tty1
    [ -c "$console" ] || console=/sysroot/dev/console
    while :; do
        setsid /bin/sh -c 'exec /bin/sh <"$1" >"$1" 2>&1' -- "$console"
        sleep 5
    done
}
mkdir -p /dev /proc /sys /run /sysroot || fail 'Cannot create mountpoints'
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev || fail 'devtmpfs failed'
mountpoint -q /proc || mount -t proc proc /proc || fail 'proc failed'
mountpoint -q /sys || mount -t sysfs sysfs /sys || fail 'sysfs failed'
mountpoint -q /run || mount -t tmpfs -o mode=0755 tmpfs /run || fail 'run failed'
if [ -r /etc/piano/root-label ]; then
    expected=$(cat /etc/piano/root-label) || fail 'Missing root label'
    [ "$expected" = PIANOROOT ] || fail 'Unexpected root label'
    [ "$(cat /etc/piano/root-partname)" = sunuefi_root ] || fail 'Unexpected root partition name'
    selector=LABEL
    probe=LABEL
elif [ -r /etc/piano/root-partuuid ]; then
    expected=$(cat /etc/piano/root-partuuid) || fail 'Missing root identity'
    [ -n "$expected" ] || fail 'Empty root identity'
    selector=PARTUUID
    probe=PART_ENTRY_UUID
else
    fail 'Missing Linux root configuration'
fi
root_identity="$selector=$expected"
release=$(cat /etc/piano/kernel-release) || fail 'Missing kernel identity'
[ "$(uname -r)" = "$release" ] || fail 'Kernel/module release mismatch'
log "DISK_INIT_BEGIN: kernel=$release root=$root_identity"
selected=0
dma_log=0
for arg in $(cat /proc/cmdline); do
    case "$arg" in
        piano.boot-dma-log=1) dma_log=1 ;;
        piano.root=*)
            [ "$arg" = "piano.root=$root_identity" ] || fail 'Unexpected piano.root'
            selected=$((selected + 1)) ;;
        root=*) [ "$arg" = "root=$root_identity" ] || fail 'Other block roots are forbidden' ;;
    esac
done
[ "$selected" -eq 1 ] || fail 'Exactly one matching piano.root is required'
dma_routes() {
    # Full routing dumps are diagnostic, not a condition for loading modules.
    [ "$dma_log" -eq 1 ] || return 0
    # Reuse the kernel's serialized per-master readback; never write SMMU MMIO.
    for device in 1d84000.ufshc a600000.ssusb; do
        for attribute in piano_dma_route piano_dma_context; do
            path=/sys/bus/platform/devices/$device/$attribute
            [ -r "$path" ] || continue
            snapshot=$(cat "$path" 2>&1)
            result=$?
            log "DMA_READBACK phase=$1 device=$device attribute=$attribute status=$result"
            printf '%s\n' "$snapshot" | while IFS= read -r line; do log "$line"; done
        done
    done
}
while read -r name module; do
    log "Loading module $name"
    [ -d "/sys/module/$name" ] || insmod "$module" || fail "Cannot load $name"
    case "$name" in arm_smmu|ufs_qcom) dma_routes "after-$name" ;; esac
done </etc/piano/modules-load-order

# sysfs identifies partition nodes; blkid low-level probing bypasses all caches.
# Both the filesystem label and GPT partition name must match. Journal recovery is left to ext4.
rootdev=
attempt=0
while [ "$attempt" -lt 30 ]; do
    for part in /sys/class/block/*; do
        [ -f "$part/partition" ] || continue
        grep -qx 'PARTNAME=sunuefi_root' "$part/uevent" || continue
        candidate=/dev/${part##*/}
        [ -b "$candidate" ] || continue
        label=$(blkid -p -s "$probe" -o value "$candidate" 2>/dev/null) || continue
        [ "$label" = "$expected" ] || continue
        [ -z "$rootdev" ] || fail 'Duplicate Linux root identity'
        rootdev=$candidate
    done
    [ -z "$rootdev" ] || break
    attempt=$((attempt + 1))
    sleep 1
done
[ -n "$rootdev" ] || fail 'Selected Linux partition did not appear'
verify_device() {
    [ "$(blkid -p -s "$probe" -o value "$rootdev")" = "$expected" ] &&
    [ "$(blkid -p -s PART_ENTRY_NAME -o value "$rootdev")" = sunuefi_root ] &&
    [ "$(blkid -p -s TYPE -o value "$rootdev")" = ext4 ]
}
verify_device || fail 'Root identity/PARTNAME/TYPE mismatch'
# Let ext4 recover its journal before inspecting files after an unclean stop.
# noload would expose stale metadata and orphan lists to that inspection.
mount -t ext4 -o ro "$rootdev" /sysroot || fail 'Read-only Linux mount failed'
[ -x /sysroot/usr/lib/systemd/systemd ] || fail 'Real systemd is missing'
[ -d "/sysroot/usr/lib/modules/$release" ] || fail 'Matching distro modules are missing'
[ ! -f /sysroot/etc/initrd-release ] || fail 'Root is initrd-only'
verify_device || fail 'Root identity changed before writable mount'
mount -o remount,rw /sysroot || fail 'Writable Linux mount failed'
mkdir -p /sysroot/dev /sysroot/proc /sysroot/sys /sysroot/run /sysroot/tmp || fail 'Root mountpoints failed'
chmod 1777 /sysroot/tmp || fail 'Root tmp permissions failed'
printf '%s\n' "$root_identity" >/run/piano-root-mode || fail 'Cannot record root mode'
printf '%s\n' "$rootdev" >/run/piano-root-device || fail 'Cannot record root device'
for virtual in dev proc sys run; do
    mount --move "/$virtual" "/sysroot/$virtual" || fail "Cannot move $virtual"
done
log "DISK_ROOT_READY: starting systemd on $root_identity"
if [ -f /etc/piano/boot-task-snapshot ]; then
    # Run from the real root, so this process survives the initramfs removal.
    rm -f /sysroot/run/piano-boot-task-snapshot.ready
    chroot /sysroot /bin/sh /usr/lib/piano/piano-boot-task-snapshot \
        </sysroot/dev/null >/sysroot/dev/null 2>&1 &
    diagnostic_wait=0
    while [ ! -f /sysroot/run/piano-boot-task-snapshot.ready ] && [ "$diagnostic_wait" -lt 3 ]; do
        sleep 1
        diagnostic_wait=$((diagnostic_wait + 1))
    done
    [ -f /sysroot/run/piano-boot-task-snapshot.ready ] || log 'Diagnostic task snapshot could not be armed'
fi
exec switch_root -c /dev/console /sysroot /usr/lib/systemd/systemd \
    --log-target=kmsg --log-level=info >/sysroot/dev/kmsg 2>&1
fail 'switch_root failed'
