[Unit]
Description=Piano RAM Linux debug diagnostics and explicit ACM/NCM
After=systemd-udevd.service local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/piano-debug-stage
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
