# Complete public piano_defconfig + piano_rootfs.config; only root policy differs.
# Root's separate /pianoinit must validate a RAM or explicitly selected external
# root. This kernel does not authorize mounting or changing Android userdata.
CONFIG_CMDLINE="console=tty0 loglevel=4 consoleblank=0 fbcon=font:TER16x32 rdinit=/pianoinit piano.root=ram rootfstype=ext4 rootwait ro pd_ignore_unused clk_ignore_unused panic=0 iommu.passthrough=1"
