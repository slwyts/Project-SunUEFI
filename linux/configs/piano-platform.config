# Qualcomm SCMI uses the standard performance/clock protocols.
# NXP vendor protocols must not attach to Qualcomm protocol 0x80.
CONFIG_IMX_SCMI_LMM_DRV=n
CONFIG_IMX_SCMI_CPU_DRV=n
CONFIG_IMX_SCMI_MISC_DRV=n
CONFIG_IMX_SCMI_LMM_EXT=n
CONFIG_IMX_SCMI_CPU_EXT=n
CONFIG_IMX_SCMI_MISC_EXT=n
CONFIG_IMX_SCMI_BBM_EXT=n

# Gunyah owns EL2 on the stock boot chain. Build the VM manager in, retaining
# direct-map invalidation for lent pages (unavailable to loadable modules).
CONFIG_GUNYAH=y
CONFIG_GUNYAH_QCOM_PLATFORM=y
CONFIG_GUNYAH_IRQFD=y
CONFIG_GUNYAH_IOEVENTFD=y

# All distributions use the same hardware kernel.
CONFIG_LOCALVERSION="-piano-sunuefi-cachy"
CONFIG_LOCALVERSION_AUTO=n

# Keep full preemption and idle tick suppression from the hardware baseline.
# BORE uses its upstream defaults; MGLRU complements the existing Zstd ZRAM.
CONFIG_SCHED_BORE=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_HZ_250=n
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_PREEMPT_DYNAMIC=y

# Standard distro services: firewalld's nftables backend and BlueZ's AF_ALG
# privacy-key operations. These are shared by every desktop/rootfs.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_UIO=m
CONFIG_UIO_PIANO_FINGERPRINT=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_COMPAT=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# SteamOS Manager creates a tracefs instance for its performance telemetry.
# Keep event tracing available without enabling function instrumentation.
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y

# The board-specific MCA transport owns the GLINK power endpoint.
CONFIG_BATTERY_QCOM_BATTMGR=n

# Android Binder IPC is part of the SteamOS developer userspace interface.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
