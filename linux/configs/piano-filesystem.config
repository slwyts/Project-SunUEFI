# The public defconfig enables VFAT_FS only, so a FAT32 stick mounts while
# every consumer exFAT or NTFS stick fails at mount time with "Filesystem
# type exfat not configured in kernel". Keep them built in for the same
# reason CONFIG_USB_HID is built in: the medium must work on insert instead
# of waiting for someone to load a module by hand.
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
# Reads files compressed with the Windows "compact" tools (xpress4k/8k/16k
# and lzx). Upstream recommends it; without it such files open as corrupt.
CONFIG_NTFS3_LZX_XPRESS=y
# exFAT and NTFS3 both request the "utf8" NLS table while mounting. Missing
# it does not fail the filesystem check but the mount, with "Unable to load
# IO charset utf8", which looks like an unrelated bug.
CONFIG_NLS_UTF8=y
