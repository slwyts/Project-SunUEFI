# Optional later stage, merged after piano-ram.config. This enables facilities
# for a real userspace; it does not prove USB, UFS or networking works on piano.
# Keep the first RAM-smoke initramfs separate. Load DMA/storage modules only
# after the branch's DTB, firmware, ownership and handover have been validated.
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_SCSI_UFSHCD=m
CONFIG_SCSI_UFSHCD_PLATFORM=m
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_QMP_UFS=m
# CONFIG_SCSI_UFS_CRYPTO is not set
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BINFMT_MISC=m

CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_INET_DIAG=m
CONFIG_NETLINK_DIAG=m

# USB network/serial debug channels. Role, PHY, clock, interconnect and Type-C
# providers still need the correct board DT and staged hardware validation.
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_ACM=m
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_USB_MASS_STORAGE is not set

# Keep boot arguments under the loader's control, including the explicit root
# chosen for this test. No userdata root or charging policy is selected here.
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
