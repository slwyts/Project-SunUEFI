# Built-in SCMI/cpufreq uses the SM8750 CPUCP mailbox provider in sm8750.dtsi.
# Register the provider at core_initcall, before initramfs starts, so CPU DVFS
# does not wait for root userspace to load the transport. The initramfs module
# closure and existing modules-load configuration also accept built-in drivers.
CONFIG_QCOM_CPUCP_MBOX=y
