# Standard SID 1 flash IP (type 0x18/subtype 0x07), outputs 1/2.
# The default complete release merges these four options with the public config.
# Existing LED/SPMI/media dependencies stay in the base; the V4L2 wrapper
# selects MEDIA_CONTROLLER, V4L2_ASYNC and VIDEO_V4L2_SUBDEV_API via Kconfig.
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m
CONFIG_VIDEO_V4L2_SUBDEV_API=y
