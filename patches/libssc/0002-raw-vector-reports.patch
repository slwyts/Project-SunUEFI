From: Project SunUEFI
Subject: [PATCH] libssc: expose immutable raw reports and uninterpreted vectors

Apply after the sensor property type correction to libssc 0.4.4.
Keep the existing SUID discovery, QMI subscription and typed measurements.
Forward original event bytes only for the sensor UID and only if used;
provide a public proto-c vector decoder without guessed component units.
Unknown event IDs and malformed payloads return normal GIO errors.

Package as a new +sunuefi2 build, not a replacement of +sunuefi1.
Live delivery and ARM64/GIR packaging still require normal validation.

--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -40,6 +40,12 @@
 };
 static GParamSpec *properties[N_PROPERTIES];
 
+enum {
+	SIGNAL_RAW_REPORT,
+	N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
 typedef struct {
 	GTask *task;
 	SSCSensor *sensor;
@@ -80,6 +86,28 @@
 
 static void
 report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data);
+
+static void
+raw_report_received (SSCClient *client, guint32 msg_id, guint64 uid_high,
+		     guint64 uid_low, GArray *buf, gpointer user_data)
+{
+	SSCSensor *self = SSC_SENSOR (user_data);
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (self);
+	g_autoptr (GBytes) payload = NULL;
+
+	if (uid_high != priv->uid_high || uid_low != priv->uid_low ||
+	    !g_signal_has_handler_pending (self, signals[SIGNAL_RAW_REPORT], 0, FALSE))
+		return;
+	if (buf == NULL || g_array_get_element_size (buf) != 1 || buf->len > 65536) {
+		g_warning ("Invalid raw SSC report buffer");
+		return;
+	}
+	/* The client frees its GArray after report emission. Copy only when used. */
+	payload = g_bytes_new (buf->data, buf->len);
+	g_object_ref (self);
+	g_signal_emit (self, signals[SIGNAL_RAW_REPORT], 0, msg_id, payload);
+	g_object_unref (self);
+}
 
 GQuark ssc_sensor_error_quark (void)
 {
