+++ b/src/libssc-vector.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef _LIBSSC_VECTOR_H_
+#define _LIBSSC_VECTOR_H_
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+/**
+ * ssc_sensor_decode_vector_report:
+ * @message_id: original SSC event message ID, not a payload field value
+ * @payload: unmodified protobuf event payload from SSCSensor::raw-report
+ * @error: return location for a #GError
+ *
+ * Decode observed wire layouts without assigning physical component meanings.
+ * Message 1025 returns `values` (ad, lossless float32 to double) and `accuracy`
+ * (i). Message 769 returns `field1`, `field2`, `field3` (i) and `values` (ad).
+ * All known scalar fields must be present. Empty/oversized/malformed payloads
+ * are invalid; other event IDs return G_IO_ERROR_NOT_SUPPORTED. Unknown protobuf
+ * fields remain available in the caller's original @payload.
+ * No lux, Kelvin, Hz, axis transform, filtering or calibration is inferred.
+ *
+ * Returns: (transfer full) (nullable): a #GVariant of type a{sv}, or %NULL
+ */
+GVariant *ssc_sensor_decode_vector_report (guint32 message_id,
+                                          GBytes *payload,
+                                          GError **error);
+
+G_END_DECLS
+
+#endif
--- /dev/null
+++ b/src/libssc-vector.c
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "libssc-vector.h"
+#include "ssc-sensor-vector.pb-c.h"
+
+#define SSC_VECTOR_MAX_PAYLOAD (64 * 1024)
+
+static void
+add_values (GVariantBuilder *fields, const gfloat *values, gsize count)
+{
+    GVariantBuilder vector;
+
+    g_variant_builder_init (&vector, G_VARIANT_TYPE ("ad"));
+    for (gsize i = 0; i < count; i++)
+        g_variant_builder_add (&vector, "d", (gdouble) values[i]);
+    g_variant_builder_add (fields, "{sv}", "values", g_variant_builder_end (&vector));
+}
+
+GVariant *
+ssc_sensor_decode_vector_report (guint32 message_id, GBytes *payload, GError **error)
+{
+    GVariantBuilder fields;
+    gsize length;
+    const guint8 *data;
+
+    g_return_val_if_fail (payload != NULL, NULL);
+    g_return_val_if_fail (error == NULL || *error == NULL, NULL);
+    if (message_id != 1025 && message_id != 769) {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+                     "No vector wire schema for SSC event %u", message_id);
+        return NULL;
+    }
+    data = g_bytes_get_data (payload, &length);
+    if (length == 0 || length > SSC_VECTOR_MAX_PAYLOAD) {
+        g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                     "SSC vector payload size %" G_GSIZE_FORMAT " is outside 1..65536", length);
+        return NULL;
+    }
+    g_variant_builder_init (&fields, G_VARIANT_TYPE_VARDICT);
+    if (message_id == 1025) {
+        SscVectorResponse *message = ssc_vector_response__unpack (NULL, length, data);
+
+        if (message == NULL)
+            goto invalid;
+        add_values (&fields, message->values, message->n_values);
+        g_variant_builder_add (&fields, "{sv}", "accuracy", g_variant_new_int32 (message->accuracy));
+        ssc_vector_response__free_unpacked (message, NULL);
+    } else {
+        SscVendorVectorResponse *message = ssc_vendor_vector_response__unpack (NULL, length, data);
+
+        if (message == NULL)
+            goto invalid;
+        g_variant_builder_add (&fields, "{sv}", "field1", g_variant_new_int32 (message->field1));
+        g_variant_builder_add (&fields, "{sv}", "field2", g_variant_new_int32 (message->field2));
+        g_variant_builder_add (&fields, "{sv}", "field3", g_variant_new_int32 (message->field3));
+        add_values (&fields, message->values, message->n_values);
+        ssc_vendor_vector_response__free_unpacked (message, NULL);
+    }
+    return g_variant_ref_sink (g_variant_builder_end (&fields));
+
+invalid:
+    g_variant_builder_clear (&fields);
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_INVALID_DATA,
+                 "Invalid SSC event %u protobuf or missing required scalar fields", message_id);
+    return NULL;
+}
--- /dev/null
+++ b/data/ssc-sensor-vector.proto
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+syntax = "proto2";
+
+// Observed SSC 1025 layout; values have no implied component units here.
+message SscVectorResponse {
+    repeated float values = 1 [packed = true];
+    required int32 accuracy = 2;
+}
+
+// Observed vendor 769 layout. Require the complete observed shape in this API;
+// names intentionally preserve wire field numbers, not guessed semantics.
+message SscVendorVectorResponse {
+    required int32 field1 = 1;
+    required int32 field2 = 2;
+    required int32 field3 = 3;
+    repeated float values = 4 [packed = true];
+}
