+	/**
+	 * SSCSensor::raw-report:
+	 * @self: the sensor matching the report's original SUID
+	 * @message_id: original SSC message ID
+	 * @payload: (transfer none): immutable original event protobuf bytes
+	 *
+	 * Emitted synchronously in the SSC client's report dispatch context.
+	 * Retain @payload with g_bytes_ref() to keep it after the callback.
+	 * No physical units, firmware timestamp or successful hardware calibration
+	 * are implied. Discovery/open/close and sampling remain the existing APIs.
+	 */
+	signals[SIGNAL_RAW_REPORT] = g_signal_new ("raw-report",
+		G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
+		0, NULL, NULL, NULL, G_TYPE_NONE, 2, G_TYPE_UINT, G_TYPE_BYTES);
 
 	properties[PROP_UID_LOW] =
 		g_param_spec_uint64 (SSC_SENSOR_UID_LOW,
