From: Project SunUEFI
Subject: [PATCH] drm/msm/dpu: describe SM8750 GC v2 capability

Apply after the complete GC v2 REGDMA v3 backend. Use the actual SM8750
GC register offset/version and describe the capability on all four
DSPPs. Capability is not an unconditional GAMMA_LUT publication: only
the initialized REGDMA backend binds GC2 ops, and the CRTC checks those
ops. Keep the old GC1 AHB path excluded for version 2.0.

The composed Piano DT requires its separate regdma resource overlay.
Compilation/catalog capability is not a hardware validation result.

--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
@@ -428,6 +428,8 @@
 static const struct dpu_dspp_sub_blks sm8750_dspp_sblk = {
 	.pcc = {.name = "pcc", .base = 0x1700,
 		.len = 0x90, .version = 0x60000},
+	.gc = {.name = "gc", .base = 0x17c0,
+		.len = 0x40, .version = 0x20000},
 };
 
 /*************************************************************
--- a/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_0_sm8750.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/catalog/dpu_12_0_sm8750.h
@@ -207,18 +207,22 @@
 	{
 		.name = "dspp_0", .id = DSPP_0,
 		.base = 0x54000, .len = 0x1800,
+		.features = BIT(DPU_DSPP_PCC) | BIT(DPU_DSPP_GC),
 		.sblk = &sm8750_dspp_sblk,
 	}, {
 		.name = "dspp_1", .id = DSPP_1,
 		.base = 0x56000, .len = 0x1800,
+		.features = BIT(DPU_DSPP_PCC) | BIT(DPU_DSPP_GC),
 		.sblk = &sm8750_dspp_sblk,
 	}, {
 		.name = "dspp_2", .id = DSPP_2,
 		.base = 0x58000, .len = 0x1800,
+		.features = BIT(DPU_DSPP_PCC) | BIT(DPU_DSPP_GC),
 		.sblk = &sm8750_dspp_sblk,
 	}, {
 		.name = "dspp_3", .id = DSPP_3,
 		.base = 0x5a000, .len = 0x1800,
+		.features = BIT(DPU_DSPP_PCC) | BIT(DPU_DSPP_GC),
 		.sblk = &sm8750_dspp_sblk,
 	},
 };
