+
+/*
+ * Preserve the first raw error tuple for each IRQ-enable cycle. All six
+ * values are returned by the existing read/clear helpers: no extra MMIO
+ * accesses or error handling changes are needed to classify the event.
+ */
+static void dsi_error(struct msm_dsi_host *msm_host, u32 isr)
+{
+	u32 clk, fifo, ack, timeout, ctrl_status, phy;
+
 	/* disable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 0);
 
-	dsi_clk_status(msm_host);
-	dsi_fifo_status(msm_host);
-	dsi_ack_err_status(msm_host);
-	dsi_timeout_status(msm_host);
-	dsi_status(msm_host);
-	dsi_dln0_phy_err(msm_host);
+	clk = dsi_clk_status(msm_host);
+	fifo = dsi_fifo_status(msm_host);
+	ack = dsi_ack_err_status(msm_host);
+	timeout = dsi_timeout_status(msm_host);
+	ctrl_status = dsi_status(msm_host);
+	phy = dsi_dln0_phy_err(msm_host);
+
+	/* Do not allow repeated IRQs to flood or replace the first event. */
+	if (!atomic_xchg(&msm_host->first_error_logged, 1))
+		pr_err("dsi_first_error: host=%d isr=%08x clk=%08x fifo=%08x ack=%08x timeout=%08x ctrl_status=%08x phy=%08x work=%08x power=%u enabled=%u video=%u\n",
+		       msm_host->id, isr, clk, fifo, ack, timeout, ctrl_status,
+		       phy, msm_host->err_work_state,
+		       READ_ONCE(msm_host->power_on), READ_ONCE(msm_host->enabled),
+		       READ_ONCE(msm_host->video_enabled));
 
 	queue_work(msm_host->workqueue, &msm_host->err_work);
 }
@@ -1718,7 +1747,7 @@
 	DBG("isr=0x%x, id=%d", isr, msm_host->id);
 
 	if (isr & DSI_IRQ_ERROR)
-		dsi_error(msm_host);
+		dsi_error(msm_host, isr);
 
 	if (isr & DSI_IRQ_VIDEO_DONE)
 		complete(&msm_host->video_comp);
@@ -2444,6 +2473,8 @@
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 
+	/* Re-arm only while the IRQ is disabled, before the next enable. */
+	atomic_set(&msm_host->first_error_logged, 0);
 	enable_irq(msm_host->irq);
 }
 
