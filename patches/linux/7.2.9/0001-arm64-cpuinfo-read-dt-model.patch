+static void cpuinfo_show_model(struct seq_file *m, int cpu, u32 midr, bool compat)
+{
+	struct device_node *node = of_get_cpu_node(cpu, NULL);
+	const char *model;
+
+	if (node && !of_property_read_string(node, "model", &model))
+		seq_printf(m, "model name\t: %s\n", model);
+	else if (compat)
+		seq_printf(m, "model name\t: ARMv8 Processor rev %d (%s)\n",
+			   MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
+	of_node_put(node);
+}
