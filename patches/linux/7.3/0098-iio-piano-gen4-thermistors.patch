diff --git a/drivers/iio/adc/qcom-vadc-common-test.c b/drivers/iio/adc/qcom-vadc-common-test.c
new file mode 100644
index 000000000..36312dd2c
--- /dev/null
+++ b/drivers/iio/adc/qcom-vadc-common-test.c
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <kunit/test.h>
+
+static void qcom_vadc_gen4_midpoint_test(struct kunit *test)
+{
+	int temp;
+
+	/* A 100 kOhm thermistor equals the pull-up at 25 degrees Celsius. */
+	KUNIT_ASSERT_EQ(test, qcom_adc5_hw_scale(
+		SCALE_HW_CALIB_THERM_100K_PU_GEN4, 0, NULL, 32768, &temp), 0);
+	KUNIT_EXPECT_GE(test, temp, 24950);
+	KUNIT_EXPECT_LE(test, temp, 25050);
+	KUNIT_ASSERT_EQ(test, qcom_adc5_hw_scale(
+		SCALE_HW_CALIB_THERM_100K_PU_PM7, 0, NULL, 8192, &temp), 0);
+	KUNIT_EXPECT_EQ(test, temp, 25000);
+}
+
+static void qcom_vadc_mixed_generation_test(struct kunit *test)
+{
+	static const u16 gen3_codes[] = { 2048, 4096, 8192, 12288, 14336 };
+	int i, gen3, gen4;
+
+	/* The same divider ratio has four times the code on a Gen4 channel. */
+	for (i = 0; i < ARRAY_SIZE(gen3_codes); i++) {
+		KUNIT_ASSERT_EQ(test, qcom_adc5_hw_scale(
+			SCALE_HW_CALIB_THERM_100K_PU_PM7, 0, NULL,
+			gen3_codes[i], &gen3), 0);
+		KUNIT_ASSERT_EQ(test, qcom_adc5_hw_scale(
+			SCALE_HW_CALIB_THERM_100K_PU_GEN4, 0, NULL,
+			gen3_codes[i] * 4, &gen4), 0);
+		KUNIT_EXPECT_LE(test, abs(gen3 - gen4), 50);
+	}
+}
+
+static void qcom_vadc_gen4_trip_roundtrip_test(struct kunit *test)
+{
+	static const int temps[] = { -20000, 0, 25000, 35000, 40000,
+				     45000, 55000, 80000 };
+	int i, actual;
+	u16 code;
+
+	for (i = 0; i < ARRAY_SIZE(temps); i++) {
+		code = qcom_adc_tm5_gen4_temp_res_scale(temps[i]);
+		KUNIT_ASSERT_EQ(test, qcom_adc5_hw_scale(
+			SCALE_HW_CALIB_THERM_100K_PU_GEN4, 0, NULL,
+			code, &actual), 0);
+		KUNIT_EXPECT_LE(test, abs(actual - temps[i]), 100);
+	}
+}
+
+static void qcom_vadc_gen4_invalid_code_test(struct kunit *test)
+{
+	int temp;
+
+	KUNIT_EXPECT_EQ(test, qcom_adc5_hw_scale(
+		SCALE_HW_CALIB_THERM_100K_PU_GEN4, 0, NULL, 65535, &temp), -EINVAL);
+}
+
+static struct kunit_case qcom_vadc_gen4_cases[] = {
+	KUNIT_CASE(qcom_vadc_gen4_midpoint_test),
+	KUNIT_CASE(qcom_vadc_mixed_generation_test),
