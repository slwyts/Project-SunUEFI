From b10af20777de0700c19bfdd87e702e14d55c3118 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Wed, 11 Nov 2026 00:18:30 +0800
Subject: [PATCH] iio: adc: support mixed Gen3 and Gen4 Piano thermistors

Backport the Qualcomm mixed-generation ADC and thermal monitor support,
including the channel bindings, per-channel scaling and extended routing.
Honor disabled channel nodes so the board can omit unsupported charger
current channels without losing the supported temperature channels.

Convert the PM7 resistance table from Q10 degrees at the public millidegree
boundaries, including the inverse thermal-trip conversion. Exercise nominal
thermistor values, mixed generations, trip roundtrips and invalid codes.

Based on patches by Jishnu Prakash and Anjelique Melendez.
Link: https://lore.kernel.org/all/20260731-pmic5_gen4_adc-v1-1-9c49b2eea6f9@oss.qualcomm.com/
Link: https://lore.kernel.org/all/20260731-pmic5_gen4_adc-v1-2-9c49b2eea6f9@oss.qualcomm.com/
Link: https://lore.kernel.org/all/20260731-pmic5_gen4_adc-v1-3-9c49b2eea6f9@oss.qualcomm.com/

Signed-off-by: Cryolitia PukNgae <cryolitia@gmail.com>
---
 .../bindings/iio/adc/qcom,spmi-adc5-gen3.yaml |  47 ++++-
 drivers/iio/adc/Kconfig                       |   7 +
 drivers/iio/adc/qcom-spmi-adc5-gen3.c         | 168 +++++++++++++-----
 drivers/iio/adc/qcom-vadc-common-test.c       |  71 ++++++++
 drivers/iio/adc/qcom-vadc-common.c            |  55 +++++-
 drivers/thermal/qcom/qcom-spmi-adc-tm5-gen3.c |  19 +-
 include/linux/iio/adc/qcom-adc5-gen3-common.h |  44 ++++-
 include/linux/iio/adc/qcom-vadc-common.h      |   6 +
 8 files changed, 358 insertions(+), 59 deletions(-)
 create mode 100644 drivers/iio/adc/qcom-vadc-common-test.c

diff --git a/Documentation/devicetree/bindings/iio/adc/qcom,spmi-adc5-gen3.yaml b/Documentation/devicetree/bindings/iio/adc/qcom,spmi-adc5-gen3.yaml
index 149f4af8f..e79ddc2ac 100644
--- a/Documentation/devicetree/bindings/iio/adc/qcom,spmi-adc5-gen3.yaml
+++ b/Documentation/devicetree/bindings/iio/adc/qcom,spmi-adc5-gen3.yaml
@@ -21,9 +21,14 @@ description: |
   All boards using a particular (SOC + master PMIC) combination will have the
   same number of ADC SDAMs supported on that PMIC.
 
+  PMIC5 Gen4 ADC is similar to Gen3 ADC, with some differences such as
+  improved ratiometric conversion resolution.
+
 properties:
   compatible:
-    const: qcom,spmi-adc5-gen3
+    enum:
+      - qcom,spmi-adc5-gen3
+      - qcom,spmi-adc5-gen4
 
   reg:
     items:
@@ -83,6 +88,46 @@ patternProperties:
           This property indicates ADC_TM monitoring is done on this channel.
         type: boolean
 
+      qcom,adc5-gen4:
+        description:
+          Indicates channel is of type ADC5 Gen4. This may be needed in cases where the
+          master PMIC has an ADC peripheral of type Gen3, but some of the other PMICs it
+          communicates with have ADC peripherals of type Gen4, so channels of those PMICs
+          need to be marked as Gen4 to ensure their conversions are handled correctly.
+        type: boolean
+
+      qcom,adc5-gen3:
+        description:
+          Indicates channel is of type ADC5 Gen3. This may be needed in cases where the
+          master PMIC has an ADC peripheral of type Gen4, but some of the other PMICs
+          under it have ADC peripherals of type Gen3.
+        type: boolean
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,spmi-adc5-gen4
+
+    then:
+      patternProperties:
+        "^channel@[0-9a-f]+$":
+          properties:
+            qcom,adc5-gen4: false
+
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: qcom,spmi-adc5-gen3
+
+    then:
+      patternProperties:
+        "^channel@[0-9a-f]+$":
+          properties:
+            qcom,adc5-gen3: false
+
 required:
   - compatible
   - reg
