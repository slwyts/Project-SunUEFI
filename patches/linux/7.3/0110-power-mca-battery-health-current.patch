+	int health, health_error;
 	unsigned int mode_writes, mode_failures;
 };
 
@@ -564,6 +565,7 @@ static int piano_mca_test_init(struct kunit *test)
 	fixture->gauge[0].design_uah = 4500000;
 	fixture->gauge[0].charge_type = POWER_SUPPLY_CHARGE_TYPE_STANDARD;
 	fixture->gauge[0].authentic = true;
+	fixture->gauge[0].health = POWER_SUPPLY_HEALTH_GOOD;
 	fixture->gauge[1] = fixture->gauge[0];
 	mca->battery_authentic = true;
 	mca->ffc_mode_known = true;
@@ -612,6 +614,11 @@ static int piano_mca_test_gauge_get(struct power_supply *psy,
 	     property == POWER_SUPPLY_PROP_CHARGE_FULL) && gauge->charge_error)
 		return gauge->charge_error;
 	switch (property) {
