@@ -674,6 +681,7 @@ static int piano_mca_test_register_gauges(struct kunit *test)
 		POWER_SUPPLY_PROP_CYCLE_COUNT,
 		POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 		POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_PROP_HEALTH,
 	};
 	static const struct power_supply_desc descriptions[] = {
 		{
@@ -3666,6 +3674,37 @@ static void piano_mca_ffc_tail_does_not_reenter_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
 }
 
+static void piano_mca_battery_alert_current_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct piano_mca_cp_limits limits;
+	int vbat, ibat, tcool, twarm;
+
+	piano_mca_ffc_prepare(test);
+	f->gauge[1].health = POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_gauges(&f->mca, &vbat, &ibat,
+		&tcool, &twarm), 0);
+	KUNIT_EXPECT_TRUE(test, f->mca.battery_alert);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, tcool, twarm), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_normal_limits(&f->mca, vbat, ibat,
+		tcool, twarm, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.ma, 9720U);
+	f->mca.ffc = false;
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_normal_limits(&f->mca, vbat, ibat,
+		tcool, twarm, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.ma, 6200U);
+	f->gauge[0].health_error = -EREMOTEIO;
+	f->gauge[1].health = POWER_SUPPLY_HEALTH_GOOD;
+	KUNIT_EXPECT_EQ(test, piano_mca_battery_alert(&f->mca), -EREMOTEIO);
+	KUNIT_EXPECT_TRUE(test, f->mca.battery_alert);
+	f->gauge[0].health_error = 0;
+	KUNIT_ASSERT_EQ(test, piano_mca_battery_alert(&f->mca), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.battery_alert);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_normal_limits(&f->mca, vbat, ibat,
+		tcool, twarm, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.ma, 8000U);
+}
+
 static void piano_mca_pps_vstep_test(struct kunit *test)
 {
 	struct piano_mca_test *f = test->priv;
@@ -4008,6 +4047,7 @@ static void piano_mca_cp_entry_gate_test(struct kunit *test)
 }
 
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_battery_alert_current_test),
 	KUNIT_CASE(piano_mca_pps_vstep_test),
 	KUNIT_CASE(piano_mca_third_pps_limits_test),
 	KUNIT_CASE(piano_mca_qc_limits_test),
