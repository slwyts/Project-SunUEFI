From a20312b35e10bf3b903da5add40b9bbe1bcdca2d Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Mon, 9 Nov 2026 23:39:17 +0800
Subject: [PATCH] arm64: dts: qcom: sm8750: describe CPU capacity differences

Use the capacity-dmips-mhz values from the Piano final factory device tree: 1792 for CPU0-5 and 1894 for CPU6-7. The standard topology code combines these values with the SCMI policy maximum frequencies.

The existing product board DTB already retains these values. This aligns the native DTS and does not change the current product boot topology.
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index 90cb849046b..60dc29db003 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -44,6 +44,7 @@ cpu0: cpu@0 {
 			reg = <0x0 0x0>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd0>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -61,6 +62,7 @@ cpu1: cpu@100 {
 			reg = <0x0 0x100>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd1>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -72,6 +74,7 @@ cpu2: cpu@200 {
 			reg = <0x0 0x200>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd2>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -83,6 +86,7 @@ cpu3: cpu@300 {
 			reg = <0x0 0x300>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd3>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -94,6 +98,7 @@ cpu4: cpu@400 {
 			reg = <0x0 0x400>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd4>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -105,6 +110,7 @@ cpu5: cpu@500 {
 			reg = <0x0 0x500>;
 			enable-method = "psci";
 			next-level-cache = <&l2_0>;
+			capacity-dmips-mhz = <1792>;
 			power-domains = <&cpu_pd5>, <&scmi_dvfs 0>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -116,6 +122,7 @@ cpu6: cpu@10000 {
 			reg = <0x0 0x10000>;
 			enable-method = "psci";
 			next-level-cache = <&l2_1>;
+			capacity-dmips-mhz = <1894>;
 			power-domains = <&cpu_pd6>, <&scmi_dvfs 1>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
@@ -133,6 +140,7 @@ cpu7: cpu@10100 {
 			reg = <0x0 0x10100>;
 			enable-method = "psci";
 			next-level-cache = <&l2_1>;
+			capacity-dmips-mhz = <1894>;
 			power-domains = <&cpu_pd7>, <&scmi_dvfs 1>;
 			power-domain-names = "psci", "perf";
 			#cooling-cells = <2>;
-- 
