 		return -ENOMEM;
 
 	camss->res = of_device_get_match_data(dev);
+	camss->check_dma_stop = camss->res->version == CAMSS_8750 &&
+				of_machine_is_compatible("xiaomi,piano");
 
 	atomic_set(&camss->ref_count, 0);
+	mutex_init(&camss->dma_lock);
 	camss->dev = dev;
 	platform_set_drvdata(pdev, camss);
 
@@ -6253,6 +6258,84 @@ void camss_delete(struct camss *camss)
 	pm_runtime_disable(camss->dev);
 }
 
+void camss_wait_for_dma_isolation(struct camss *camss)
+{
+	unsigned int i, j;
+	int ret;
+
+	lockdep_assert_held(&camss->dma_lock);
+	if (camss->dma_isolated)
+		return;
+
+	WRITE_ONCE(camss->dma_faulted, true);
+	for (i = 0; i < camss->res->vfe_num; i++) {
+		struct vfe_device *vfe = &camss->vfe[i];
+		unsigned long flags;
+
+		/* Wait out any address publication already running on this VFE. */
+		spin_lock_irqsave(&vfe->output_lock, flags);
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+
+		for (j = 0; j < vfe->res->line_num; j++) {
+			struct camss_video *video = &vfe->line[j].video_out;
+
+			if (video_is_registered(&video->vdev))
+				vb2_queue_error(&video->vb2_q);
+		}
+	}
+
+	/*
+	 * VB2 reclaims every buffer when stop_streaming returns. Keep the
+	 * existing DMA mappings and pipeline power until the SMMU confirms
+	 * isolation, even if closing a queue must wait for a hardware fault.
+	 */
+	for (;;) {
+		ret = qcom_smmu_camss_dma_quiesce(camss->dev);
+		if (!ret)
+			break;
+
+		dev_err_ratelimited(camss->dev,
+				    "Camera DMA isolation failed (%d); retaining buffers and power\n",
+				    ret);
+		msleep(1000);
+	}
+
+	camss->dma_isolated = true;
+	dev_err(camss->dev, "Camera DMA isolated after stop failure; power cycle to restore cameras\n");
+}
+
+static void camss_stop_queues(struct camss *camss)
+{
+	unsigned int i, j;
+
+	if (!camss->check_dma_stop)
+		return;
+
+	mutex_lock(&camss->dma_lock);
+	camss->removing = true;
+	mutex_unlock(&camss->dma_lock);
+
+	for (i = 0; i < camss->res->vfe_num; i++) {
+		struct vfe_device *vfe = &camss->vfe[i];
+
+		for (j = 0; j < vfe->res->line_num; j++) {
+			struct camss_video *video = &vfe->line[j].video_out;
+
+			if (!video_is_registered(&video->vdev))
+				continue;
+			mutex_lock(&video->q_lock);
+			vb2_queue_release(&video->vb2_q);
+			video->vb2_q.owner = NULL;
+			mutex_unlock(&video->q_lock);
+		}
+	}
+}
+
+static void camss_shutdown(struct platform_device *pdev)
+{
+	camss_stop_queues(platform_get_drvdata(pdev));
+}
+
