 drivers/media/platform/qcom/camss/camss-vfe.c | 99 ++++++++++++++++++-
 drivers/media/platform/qcom/camss/camss-vfe.h |  5 +
 .../media/platform/qcom/camss/camss-video.c   | 29 +++++-
 drivers/media/platform/qcom/camss/camss.c     | 97 +++++++++++++++++-
 drivers/media/platform/qcom/camss/camss.h     |  7 ++
 6 files changed, 261 insertions(+), 6 deletions(-)

