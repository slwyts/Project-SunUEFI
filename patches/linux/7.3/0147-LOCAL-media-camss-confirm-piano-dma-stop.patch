diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index f928d91aab04c16d5ceda4fd12c857abec76a278..924806407674ed7990c7001c1716d4a3a39f0b03 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -7,6 +7,8 @@
  * Copyright (c) 2013-2015, The Linux Foundation. All rights reserved.
  * Copyright (C) 2015-2018 Linaro Ltd.
  */
+#include <linux/iommu/qcom-sm8750-camss.h>
+#include <linux/kexec.h>
 #include <linux/overflow.h>
 #include <linux/slab.h>
 #include <media/media-entity.h>
@@ -339,6 +341,19 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	unsigned int started = 0;
 	int ret;
 
+	guard(mutex)(&video->camss->dma_lock);
+	if (video->camss->check_dma_stop) {
+		if (video->camss->removing || video->camss->dma_faulted) {
+			ret = -EIO;
+			goto flush_buffers;
+		}
+		ret = qcom_smmu_camss_dma_prepare(video->camss->dev);
+		if (ret) {
+			dev_err(video->camss->dev, "Camera DMA isolation unavailable: %d\n", ret);
+			goto flush_buffers;
+		}
+	}
+
 	ret = video_device_pipeline_alloc_start(vdev);
 	if (ret < 0) {
 		dev_err(video->camss->dev, "Failed to start media pipeline: %d\n", ret);
@@ -369,9 +384,16 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	}
 
 	if (video->ops->start_output) {
+		if (video->camss->check_dma_stop && !kexec_block_for_dma()) {
+			ret = -EBUSY;
+			goto error;
+		}
 		ret = video->ops->start_output(video);
-		if (ret)
+		if (ret) {
+			if (video->camss->check_dma_stop)
+				kexec_unblock_for_dma();
 			goto error;
+		}
 	}
 
 	return 0;
@@ -391,9 +413,12 @@ static void video_stop_streaming(struct vb2_queue *q)
 	struct camss_video *video = vb2_get_drv_priv(q);
 	struct video_device *vdev = &video->vdev;
 
+	guard(mutex)(&video->camss->dma_lock);
 	video_stop_subdevs(video, UINT_MAX);
 	video_device_pipeline_stop(vdev);
 	video->ops->flush_buffers(video, VB2_BUF_STATE_ERROR);
+	if (video->camss->check_dma_stop && !video->camss->dma_faulted)
+		kexec_unblock_for_dma();
 }
 
 static void video_unprepare_streaming(struct vb2_queue *q)
@@ -802,6 +827,8 @@ int msm_video_register(struct camss_video *video, struct v4l2_device *v4l2_dev,
 	q->buf_struct_size = sizeof(struct camss_buffer);
 	q->dev = video->camss->dev;
 	q->lock = &video->q_lock;
+	if (video->camss->check_dma_stop)
+		q->min_queued_buffers = 1;
 	ret = vb2_queue_init(q);
 	if (ret < 0) {
 		dev_err(v4l2_dev->dev, "Failed to init vb2 queue: %d\n", ret);
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 842bcf16339ddd70d4aecd87ad92a97f34a2fc56..9d380e260e48563fca75aaa21f2ff27fbb4e6d9f 100644
