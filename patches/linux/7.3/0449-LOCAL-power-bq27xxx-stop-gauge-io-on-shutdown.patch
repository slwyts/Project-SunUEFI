--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -581,8 +581,11 @@ struct mca_resp {
 	u8 data[MCA_DATA_LEN];
 } __packed;
 
+static char *piano_mca_supplied_to[] = { "bq27z561-0", "bq27z561-1" };
+
 struct piano_mca {
 	struct device *dev;
+	struct device *gauge_devices[ARRAY_SIZE(piano_mca_supplied_to)];
 	u32 pd_protocol_version;
 	__le32 otg_config[4];
 	bool otg_config_valid;
@@ -2337,8 +2340,6 @@ static void piano_mca_apply_policy(struct piano_mca *mca, unsigned int generatio
 	piano_mca_apply_input_policy(mca, generation, connection);
 }
 
-static char *piano_mca_supplied_to[] = { "bq27z561-0", "bq27z561-1" };
-
 static int piano_mca_battery_alert(struct piano_mca *mca)
 {
 	union power_supply_propval health;
@@ -2532,13 +2533,54 @@ static int piano_mca_battery_state(struct piano_mca *mca)
 	return 0;
 }
 
-/* No raised PMIC voltage is retained across a partial gauge-mode update. */
-static int piano_mca_set_gauge_modes(struct piano_mca *mca, bool fast)
+static void piano_mca_unlink_gauge(struct piano_mca *mca, unsigned int index)
+{
+	struct device *gauge = mca->gauge_devices[index];
+
+	if (!gauge)
+		return;
+	device_link_remove(mca->dev, gauge);
+	put_device(gauge);
+	mca->gauge_devices[index] = NULL;
+}
+
+static int piano_mca_link_gauge(struct piano_mca *mca, struct device *gauge,
+				 unsigned int index)
+{
+	if (mca->gauge_devices[index] == gauge)
+		return 0;
+
+	/* Restore standard mode before the gauge and its I2C bus shut down. */
+	if (!device_link_add(mca->dev, gauge, DL_FLAG_STATELESS))
+		return -ENODEV;
+	piano_mca_unlink_gauge(mca, index);
+	mca->gauge_devices[index] = get_device(gauge);
+	return 0;
+}
+
+static int piano_mca_set_gauge_mode(struct piano_mca *mca, struct power_supply *psy,
+				    unsigned int index, bool fast)
 {
 	union power_supply_propval value = {
 		.intval = fast ? POWER_SUPPLY_CHARGE_TYPE_FAST :
 				POWER_SUPPLY_CHARGE_TYPE_STANDARD,
 	};
+	int ret = -ESHUTDOWN;
+
+	guard(rwsem_read)(&psy->epc_sem);
+	if (psy->removing)
+		return -ENODEV;
+	if (READ_ONCE(system_state) <= SYSTEM_RUNNING)
+		ret = piano_mca_link_gauge(mca, psy->dev.parent, index);
+	if (fast && ret)
+		return ret;
+
+	return power_supply_set_property(psy, POWER_SUPPLY_PROP_CHARGE_TYPE, &value);
+}
+
+/* No raised PMIC voltage is retained across a partial gauge-mode update. */
+static int piano_mca_set_gauge_modes(struct piano_mca *mca, bool fast)
+{
 	struct power_supply *psy;
 	int i, ret = 0, error;
 
@@ -2548,7 +2590,7 @@ static int piano_mca_set_gauge_modes(struct piano_mca *mca, bool fast)
 			ret = ret ?: -ENODEV;
 			continue;
 		}
-		error = power_supply_set_property(psy, POWER_SUPPLY_PROP_CHARGE_TYPE, &value);
+		error = piano_mca_set_gauge_mode(mca, psy, i, fast);
 		power_supply_put(psy);
 		ret = ret ?: error;
 	}
@@ -5527,6 +5569,7 @@ static void piano_mca_stop_work(struct piano_mca *mca)
 static void piano_mca_stop(void *data)
 {
 	struct piano_mca *mca = data;
+	unsigned int i;
 
 	mutex_lock(&mca->policy_lock);
 	if (mca->policy_stopped) {
@@ -5540,6 +5583,8 @@ static void piano_mca_stop(void *data)
 		disable_delayed_work_sync(&mca->connector_work);
 	guard(mutex)(&mca->policy_lock);
 	piano_mca_stop_work(mca);
+	for (i = 0; i < ARRAY_SIZE(mca->gauge_devices); i++)
+		piano_mca_unlink_gauge(mca, i);
 }
 
