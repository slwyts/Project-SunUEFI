From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Fri, 20 Nov 2026 00:49:21 +0800
Subject: power: supply: bq27xxx: stop gauge I/O on shutdown

A queued power supply notification can read STATUS after the I2C
adapter has stopped accepting transfers. The gauge has no I2C shutdown
callback, and STATUS reads the bus outside the update lock. On Piano
this leads to a "Transfer while suspended" warning during reboot.

Stop polling and use the existing gauge lock to finish in-flight I/O
before marking the gauge unavailable. Keep the power supply registered
for existing consumers, but return -ENODEV rather than issuing new
transfers. Preserve the I2C core's IRQ disable and use the same stop path
for removal, keeping the existing removal-time charge-mode restore.
The shutdown callback itself does not write to the gauge.

Fixes: 9f78c607600c ("i2c: qcom-geni: Add shutdown callback for i2c")

Establish shutdown dependencies on the two gauges before enabling FFC.

Signed-off-by: slwyts <slwyts@foxmail.com>
---
 drivers/power/supply/bq27xxx_battery.c      | 55 +++++++++++++--------
 drivers/power/supply/bq27xxx_battery_i2c.c  |  9 ++++
 drivers/power/supply/bq27xxx_battery_test.c | 48 +++++++++++++++---
 drivers/power/supply/piano_mca.c            | 55 +++++++++++++++++++--
 include/linux/power/bq27xxx_battery.h       |  1 +
 5 files changed, 137 insertions(+), 31 deletions(-)

diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index 0726da5fb0abcad4c6278c1e675f2299631e0d1e..163e6a22a4faff7f58bfe4b668bbd5d06d9cee75 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -1849,10 +1849,8 @@ static int bq27xxx_battery_read_health(struct bq27xxx_device_info *di,
 
 	/* Vendor firmware exposes read-only SOA and ISC alerts as byte registers. */
 	if (di->health_alerts) {
-		mutex_lock(&di->lock);
-		isc = di->removed ? -ENODEV : di->bus.read(di, BQ27Z561_ISC_ALERT, true);
+		isc = di->bus.read(di, BQ27Z561_ISC_ALERT, true);
 		soa = isc < 0 ? isc : di->bus.read(di, BQ27Z561_SOA_ALERT, true);
-		mutex_unlock(&di->lock);
 		if (soa < 0)
 			return soa;
 		if (isc > 3)
@@ -1955,6 +1953,9 @@ static void bq27xxx_battery_update_unlocked(struct bq27xxx_device_info *di)
 	struct bq27xxx_reg_cache cache = {0, };
 	bool has_singe_flag = di->opts & BQ27XXX_O_ZERO;
 
+	if (di->removed)
+		return;
+
 	cache.flags = bq27xxx_read(di, BQ27XXX_REG_FLAGS, has_singe_flag);
 	if (di->chip == BQ27000 && (cache.flags & 0xff) == 0xff)
 		cache.flags = -ENODEV; /* bq27000 hdq read error */
@@ -1985,7 +1986,7 @@ static void bq27xxx_battery_update_unlocked(struct bq27xxx_device_info *di)
 
 	di->last_update = jiffies;
 
-	if (!di->removed && poll_interval > 0)
+	if (poll_interval > 0)
 		mod_delayed_work(system_percpu_wq, &di->work, poll_interval * HZ);
 }
 
@@ -2291,14 +2292,13 @@ static int bq27z561_get_charge_property(struct bq27xxx_device_info *di,
 				      enum power_supply_property property,
 				      union power_supply_propval *value)
 {
-	int ret = 0;
+	int ret;
 
-	mutex_lock(&di->lock);
-	ret = di->removed ? -ENODEV : bq27xxx_read(di, BQ27XXX_REG_FLAGS, false);
+	ret = bq27xxx_read(di, BQ27XXX_REG_FLAGS, false);
 	if (ret < 0) {
 		di->authentic = false;
 		di->charge_mode_known = false;
-		goto out;
+		return ret;
 	}
 	ret = 0;
 	if (property == POWER_SUPPLY_PROP_AUTHENTIC && !di->authentic &&
@@ -2315,8 +2315,6 @@ static int bq27z561_get_charge_property(struct bq27xxx_device_info *di,
 	else if (!ret)
 		value->intval = di->fast_charge ? POWER_SUPPLY_CHARGE_TYPE_FAST :
 			POWER_SUPPLY_CHARGE_TYPE_STANDARD;
-out:
-	mutex_unlock(&di->lock);
 	return ret;
 }
 
@@ -2355,14 +2353,16 @@ static int bq27xxx_battery_get_property(struct power_supply *psy,
 	struct bq27xxx_device_info *di = power_supply_get_drvdata(psy);
 	enum bq27xxx_reg_index current_reg = BQ27XXX_REG_AI;
 
+	guard(mutex)(&di->lock);
+	if (di->removed)
+		return -ENODEV;
+
 	if (di->auth_key && (psp == POWER_SUPPLY_PROP_AUTHENTIC ||
 			    psp == POWER_SUPPLY_PROP_CHARGE_TYPE))
 		return bq27z561_get_charge_property(di, psp, val);
 
-	mutex_lock(&di->lock);
 	if (time_is_before_jiffies(di->last_update + 5 * HZ))
 		bq27xxx_battery_update_unlocked(di);
-	mutex_unlock(&di->lock);
 
 	if (psp != POWER_SUPPLY_PROP_PRESENT && di->cache.flags < 0)
 		return di->cache.flags;
@@ -2606,20 +2606,35 @@ int bq27xxx_battery_setup(struct bq27xxx_device_info *di)
 }
 EXPORT_SYMBOL_GPL(bq27xxx_battery_setup);
 
+static void bq27xxx_battery_stop(struct bq27xxx_device_info *di,
+				 bool restore_charge_mode)
+{
+	scoped_guard(mutex, &di->lock) {
+		if (di->removed)
+			return;
+		if (restore_charge_mode && di->auth_key &&
+		    bq27z561_set_charge_mode(di, false))
+			dev_warn(di->dev, "could not disable gauge fast-charge mode\n");
+		di->removed = true;
+	}
+
+	/* Supply notifications can still try to schedule a poll. */
+	disable_delayed_work_sync(&di->work);
+}
+
+void bq27xxx_battery_shutdown(struct bq27xxx_device_info *di)
+{
+	bq27xxx_battery_stop(di, false);
+}
+EXPORT_SYMBOL_GPL(bq27xxx_battery_shutdown);
+
 void bq27xxx_battery_teardown(struct bq27xxx_device_info *di)
 {
 	mutex_lock(&bq27xxx_list_lock);
 	list_del(&di->list);
 	mutex_unlock(&bq27xxx_list_lock);
 
-	/* Set removed to avoid bq27xxx_battery_update() re-queuing the work */
-	mutex_lock(&di->lock);
-	if (di->auth_key && bq27z561_set_charge_mode(di, false))
-		dev_warn(di->dev, "could not disable gauge fast-charge mode\n");
-	di->removed = true;
-	mutex_unlock(&di->lock);
-
-	cancel_delayed_work_sync(&di->work);
+	bq27xxx_battery_stop(di, true);
 }
 EXPORT_SYMBOL_GPL(bq27xxx_battery_teardown);
 
