+static void bq27xxx_shutdown_stops_io_test(struct kunit *test)
+{
+	struct bq27xxx_suspend_test *f = test->priv;
+	struct power_supply psy = { .drv_data = &f->di };
+	union power_supply_propval val = { .intval = 42 };
+
+	f->di.chip = BQ27Z561;
+	f->di.regs = bq27z561_regs;
+	f->di.opts = BQ27Z561_O_BITS;
+	f->di.bus.read = bq27xxx_current_test_read;
+	f->di.last_update = jiffies;
+
+	bq27xxx_battery_shutdown(&f->di);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&f->di.work));
+	bq27xxx_external_power_changed(&psy);
+	KUNIT_EXPECT_FALSE(test, delayed_work_pending(&f->di.work));
+	KUNIT_EXPECT_EQ(test, bq27xxx_battery_get_property(&psy,
+				POWER_SUPPLY_PROP_STATUS, &val), -ENODEV);
+	KUNIT_EXPECT_EQ(test, val.intval, 42);
+	KUNIT_EXPECT_EQ(test, f->current_avg_reads, 0U);
+	val.intval = POWER_SUPPLY_CHARGE_TYPE_STANDARD;
+	KUNIT_EXPECT_EQ(test, bq27xxx_battery_set_property(&psy,
+				POWER_SUPPLY_PROP_CHARGE_TYPE, &val), -ENODEV);
+	KUNIT_EXPECT_TRUE(test, f->di.fast_charge);
