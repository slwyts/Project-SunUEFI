diff --git a/drivers/media/i2c/dw9768-gt9764ba.c b/drivers/media/i2c/dw9768-gt9764ba.c
new file mode 100644
index 0000000000000000000000000000000000000000..d4fcf488f6ec578ccd4ab9ef1c95def1092052c9
--- /dev/null
+++ b/drivers/media/i2c/dw9768-gt9764ba.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Giantec GT9764BA bidirectional voice-coil lens actuator.
+ *
+ * Register values follow the Piano factory actuator description. The neutral
+ * position is also documented by MiCode's GPL GT9764 V4L2 driver.
+ */
+
+#include <linux/i2c.h>
+#include <linux/pm_runtime.h>
+
+#include "dw9768.h"
+
+#define GT9764_AAC_MODE			0x06
+#define GT9764_AAC_TIMING			0x07
+#define GT9764_MAX_POSITION		1023
+#define GT9764_PARK_STEP			50
+#define GT9764_PARK_DELAY_US		10000
+
+static int gt9764_set_position(struct dw9768 *lens, u16 position)
+{
+	int ret;
+
+	ret = dw9768_set_dac(lens, position);
+	lens->position_valid = !ret;
+	if (ret)
+		return ret;
+
+	lens->position = position;
+	return 0;
+}
+
+static int gt9764_move_gradually(struct dw9768 *lens, unsigned int target)
+{
+	int ret, position;
+
+	/* A failed transfer may have reached either byte of the DAC register. */
+	if (!lens->position_valid) {
+		struct i2c_client *client = v4l2_get_subdevdata(&lens->sd);
+
+		usleep_range(GT9764_PARK_DELAY_US, GT9764_PARK_DELAY_US + 1000);
+		ret = i2c_smbus_read_word_swapped(client, DW9768_MSB_ADDR);
+		if (ret < 0)
+			return ret;
+		if (ret > GT9764_MAX_POSITION)
+			return -EIO;
+		lens->position = ret;
+		lens->position_valid = true;
+	}
+
+	while (lens->position != target) {
+		position = lens->position;
+		position += clamp_t(int, (int)target - position,
+				    -GT9764_PARK_STEP, GT9764_PARK_STEP);
+		ret = gt9764_set_position(lens, position);
+		if (ret)
+			return ret;
+
+		usleep_range(GT9764_PARK_DELAY_US, GT9764_PARK_DELAY_US + 1000);
+	}
+
+	return 0;
+}
+
+static int gt9764_init(struct dw9768 *lens)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&lens->sd);
+	int ret;
+
+	if (lens->configured)
+		return 0;
+
+	ret = dw9768_reset_aac(lens);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 200);
+	ret = i2c_smbus_write_byte_data(client, GT9764_AAC_MODE, 0x40);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 200);
+	ret = i2c_smbus_write_byte_data(client, GT9764_AAC_TIMING, 0x73);
+	if (ret)
+		return ret;
+
+	usleep_range(100, 200);
+	lens->configured = true;
+	return 0;
+}
+
+static int gt9764_restore_focus(struct dw9768 *lens, bool cold)
+{
+	int ret = gt9764_init(lens);
+
+	if (ret)
+		return ret;
+
+	/* The factory power-on sequence starts at neutral once per power-up. */
+	if (cold) {
+		ret = gt9764_set_position(lens, GT9764_NEUTRAL_POSITION);
+		if (ret)
+			return ret;
+		usleep_range(GT9764_PARK_DELAY_US, GT9764_PARK_DELAY_US + 1000);
+	}
+
+	return gt9764_move_gradually(lens, lens->focus->cur.val);
+}
+
+static int gt9764_power_down(struct dw9768 *lens)
+{
+	int ret;
+
+	usleep_range(GT9764_PARK_DELAY_US, GT9764_PARK_DELAY_US + 1000);
+	ret = regulator_bulk_disable(ARRAY_SIZE(lens->supplies), lens->supplies);
+	/* A failed bulk disable can still have cycled one of the rails. */
+	lens->configured = false;
+	lens->position_valid = false;
+	if (!ret)
+		lens->powered = false;
+	return ret;
+}
+
+int gt9764_suspend(struct device *dev)
+{
+	struct dw9768 *lens = sd_to_dw9768(dev_get_drvdata(dev));
+	int ret;
+
+	mutex_lock(&lens->lock);
+	if (!lens->powered) {
+		ret = 0;
+		goto unlock;
+	}
+
+	if (lens->configured) {
+		ret = gt9764_move_gradually(lens, GT9764_NEUTRAL_POSITION);
+		if (ret) {
+			dev_err(dev, "Failed to park lens; power remains enabled: %d\n", ret);
+			ret = -EBUSY;
+			goto unlock;
+		}
+	}
+
+	ret = gt9764_power_down(lens);
+	if (ret) {
+		dev_err(dev, "Failed to disable regulators: %d\n", ret);
+		ret = -EBUSY;
+	}
+unlock:
+	mutex_unlock(&lens->lock);
+	return ret;
+}
+
+int gt9764_resume(struct device *dev)
+{
+	struct dw9768 *lens = sd_to_dw9768(dev_get_drvdata(dev));
+	bool cold;
+	int ret;
+
+	mutex_lock(&lens->lock);
+	cold = !lens->powered;
+	if (cold) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(lens->supplies), lens->supplies);
+		if (ret)
+			goto unlock;
+		lens->powered = true;
+		usleep_range(5000, 6000);
+	}
+
+	ret = gt9764_restore_focus(lens, cold);
+	if (ret) {
+		int disable;
+
+		if (lens->configured) {
+			int park = gt9764_move_gradually(lens, GT9764_NEUTRAL_POSITION);
+
+			if (park) {
+				dev_err(dev, "Failed to park lens; power remains enabled: %d\n", park);
+				goto unlock;
+			}
+		}
+
+		disable = gt9764_power_down(lens);
+		if (disable)
+			dev_err(dev, "Failed to disable regulators: %d\n", disable);
+	}
+unlock:
+	mutex_unlock(&lens->lock);
+	return ret;
+}
+
+int gt9764_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct dw9768 *lens = container_of(ctrl->handler, struct dw9768, ctrls);
+	struct device *dev = lens->sd.dev;
+	int ret;
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	ret = pm_runtime_get_if_active(dev);
+	if (ret <= 0)
+		return ret;
+
+	ret = gt9764_init(lens);
+	if (!ret)
+		ret = gt9764_set_position(lens, ctrl->val);
+	pm_runtime_put_autosuspend(dev);
+	return ret;
+}
+
+int gt9764_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh)
+{
+	struct dw9768 *lens = sd_to_dw9768(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sd->dev);
+	if (ret < 0)
+		return ret;
+
+	/* A busy suspend leaves runtime PM active without a resume callback. */
+	mutex_lock(&lens->lock);
+	if (!lens->configured || !lens->position_valid)
+		ret = gt9764_restore_focus(lens, false);
+	mutex_unlock(&lens->lock);
+	if (ret)
+		pm_runtime_put_autosuspend(sd->dev);
+	return ret;
+}
+
+void gt9764_stop_on_remove(struct device *dev, struct dw9768 *lens)
+{
+	if (lens->powered) {
+		int ret;
+
+		ret = gt9764_suspend(dev);
+		if (ret) {
+			/*
+			 * Runtime suspend can be retried; unbind cannot keep the
+			 * regulators enabled after it releases their handles.
+			 */
+			ret = regulator_bulk_disable(ARRAY_SIZE(lens->supplies), lens->supplies);
+			if (ret)
+				dev_err(dev, "Failed to disable regulators on remove: %d\n", ret);
+		}
+		if (!ret)
+			pm_runtime_set_suspended(dev);
+	}
+}
diff --git a/drivers/media/i2c/dw9768.h b/drivers/media/i2c/dw9768.h
new file mode 100644
index 0000000000000000000000000000000000000000..55d2b7123b8613002a4d467c06573d31a8c7941f
--- /dev/null
+++ b/drivers/media/i2c/dw9768.h
@@ -0,0 +1,84 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DW9768_H
+#define _DW9768_H
+
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/mutex.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-subdev.h>
+
+/*
+ * Ring control and Power control register
+ * Bit[1] RING_EN
+ * 0: Direct mode
+ * 1: AAC mode (ringing control mode)
+ * Bit[0] PD
+ * 0: Normal operation mode
+ * 1: Power down mode
+ * DW9768 requires waiting time of Topr after PD reset takes place.
+ */
+#define DW9768_RING_PD_CONTROL_REG		0x02
+#define DW9768_PD_MODE_OFF			0x00
+#define DW9768_AAC_MODE_EN			BIT(1)
+#define DW9768_MSB_ADDR				0x03
+#define DW9768_T_OPR_US				1000
+#define GT9764_NEUTRAL_POSITION		512
+
+/* dw9768 device structure */
+struct dw9768 {
+	struct regulator_bulk_data supplies[2];
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *focus;
+	struct v4l2_subdev sd;
+
+	u32 aac_mode;
+	u32 aac_timing;
+	u32 clock_presc;
+	u32 move_delay_us;
+
+	bool gt9764ba;
+	/* Serialize bidirectional focus updates with power transitions. */
+	struct mutex lock;
+	u16 position;
+	bool position_valid;
+	bool configured;
+	bool powered;
+};
+
+static inline struct dw9768 *sd_to_dw9768(struct v4l2_subdev *subdev)
+{
+	return container_of(subdev, struct dw9768, sd);
+}
+
+static inline int dw9768_set_dac(struct dw9768 *dw9768, u16 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&dw9768->sd);
+
+	/* Write VCM position to registers */
+	return i2c_smbus_write_word_swapped(client, DW9768_MSB_ADDR, val);
+}
+
+static inline int dw9768_reset_aac(struct dw9768 *dw9768)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&dw9768->sd);
+	int ret;
+
+	ret = i2c_smbus_write_byte_data(client, DW9768_RING_PD_CONTROL_REG,
+					DW9768_PD_MODE_OFF);
+	if (ret < 0)
+		return ret;
+
+	usleep_range(DW9768_T_OPR_US, DW9768_T_OPR_US + 100);
+	return i2c_smbus_write_byte_data(client, DW9768_RING_PD_CONTROL_REG,
+					 DW9768_AAC_MODE_EN);
+}
+
+int gt9764_suspend(struct device *dev);
+int gt9764_resume(struct device *dev);
+int gt9764_set_ctrl(struct v4l2_ctrl *ctrl);
+int gt9764_open(struct v4l2_subdev *sd, struct v4l2_subdev_fh *fh);
+void gt9764_stop_on_remove(struct device *dev, struct dw9768 *lens);
+
+#endif
