From 4858338c44393d6c08bbbb7c29ed3dfdef72425e Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 04:26:52 +0800
Subject: [PATCH] fix(power): match firmware charger types and selected PPS
 voltage range

Use the stock PPS=11 and PD_VERIFY=12 type values. Bind APDO reads to the active charging session, retain its minimum voltage, and clamp regulation requests to the complete selected APDO window.

Describe the enabled charging defaults in the driver header.

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index af193c0ad..7cf5c17a3 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -14,13 +14,10 @@
  * Property ids are 32 bits wide; bits 31:16 select a class (0: charger and
  * battery, 1: wireless, 2: USB and PD).
  *
- * This driver replaces qcom_battmgr on this board.  By default only reads
- * are issued and charging limits stay with the ADSP firmware defaults. With
- * charge_policy=1 it raises the input current limit by charger type, with
- * charge_current=1 as well the charge current, and with hv_charge=1 it asks
- * PD and PPS sources for 9 V, and with cp_charge=1 as well it charges
- * through the SC8541 switched-capacitor stage from PPS sources; with
- * mipps_auth=1 it authenticates Xiaomi MiPPS adapters in the kernel.
+ * This driver replaces qcom_battmgr on this board. Charging policy is enabled
+ * by default, including PD/PPS and QC input negotiation, SC8541 direct charging
+ * and Xiaomi MiPPS authentication. Read-only module parameters can disable
+ * individual paths for debugging.
  * piano_mca_write_allowed()
  * lists every property it can write. FFC requires the authenticated adapter,
  * both authenticated cell gauges and the factory temperature/SOC window.
@@ -132,8 +129,8 @@ enum mca_real_type {
 	MCA_TYPE_HVDCP_3P5,
 	MCA_TYPE_C,
 	MCA_TYPE_PD,
-	MCA_TYPE_PD_VERIFY,
 	MCA_TYPE_PD_PPS,
+	MCA_TYPE_PD_VERIFY,
 	MCA_TYPE_ACA = 14,
 	MCA_TYPE_DCP_B,
 	MCA_TYPE_MAX = 20,
@@ -151,7 +148,7 @@ static const char * const mca_real_type_names[MCA_TYPE_MAX] = {
 	[MCA_TYPE_HVDCP_3P5]	= "HVDCP_3P5",
 	[MCA_TYPE_C]		= "C",
 	[MCA_TYPE_PD]		= "PD",
-	[MCA_TYPE_PD_VERIFY]	= "PD_PPS",
+	[MCA_TYPE_PD_VERIFY]	= "PD_VERIFY",
 	[MCA_TYPE_PD_PPS]	= "PD_PPS",
 	[MCA_TYPE_ACA]		= "ACA",
 	[MCA_TYPE_DCP_B]	= "DCP",
@@ -631,6 +628,7 @@ struct piano_mca {
 	bool cp_verified;	/* Xiaomi proof used for this attempt's source limits */
 	u32 cp_mv;		/* voltage asked of the direct-charge source */
 	u32 cp_ma;		/* its current limit */
+	u32 cp_min_mv;
 	u32 cp_max_mv;		/* the most the source offers */
 	u32 cp_ibus_ma;		/* bus current target */
 	u32 cp_ibus_hot;	/* the target as lowered for the stage temperature */
@@ -3070,11 +3068,12 @@ static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
 {
 	u32 quantum = mca->cp_real_type == MCA_TYPE_HVDCP_3_B ?
 		MCA_QC3_STEP_MV : MCA_QC3P5_STEP_MV;
+	u32 minimum = max_t(u32, mca->cp_min_mv, MCA_CP_PPS_MIN_MV);
 	int ret;
 
 	if (!piano_mca_cp_session_valid(mca))
 		return -ECONNRESET;
-	mv = clamp(rounddown(mv, quantum), (u32)MCA_CP_PPS_MIN_MV,
+	mv = clamp(rounddown(mv, quantum), roundup(minimum, quantum),
 		   rounddown(min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV), quantum));
 	if (piano_mca_is_qc_cp(mca->cp_real_type)) {
 		/* A lost acknowledgement can still leave the adapter at this voltage. */
@@ -3223,23 +3222,26 @@ static int piano_mca_pause_charging(struct piano_mca *mca,
 }
 
 /* The PPS APDO direct charging can use, 0 if none */
-static u32 piano_mca_cp_apdo(struct piano_mca *mca, u32 start_mv, u32 *max_mv)
+static u32 piano_mca_cp_apdo(struct piano_mca *mca, u32 start_mv,
+			     u32 *min_mv, u32 *max_mv)
 {
 	struct piano_mca_pdo pdos[MCA_PD_MAX_PDOS];
 	u32 ma = 0;
 	int i;
 
-	if (piano_mca_read(mca, MCA_PROP_PDOS, pdos, sizeof(pdos)))
+	if (piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_PDOS, pdos, sizeof(pdos),
+			    mca->cp_generation, mca->cp_connection_generation))
 		return 0;
 
 	for (i = 0; i < MCA_PD_MAX_PDOS; i++) {
-		u32 min_mv = le32_to_cpu(pdos[i].min_mv);
+		u32 lo_mv = le32_to_cpu(pdos[i].min_mv);
 		u32 hi_mv = le32_to_cpu(pdos[i].max_mv);
 
-		if (min_mv < hi_mv && min_mv <= start_mv &&
+		if (lo_mv < hi_mv && lo_mv <= start_mv &&
 		    hi_mv >= 2 * MCA_CP_VBAT_MAX_MV + MCA_CP_DELTA_MV &&
 		    le32_to_cpu(pdos[i].max_ma) > ma) {
 			ma = le32_to_cpu(pdos[i].max_ma);
+			*min_mv = lo_mv;
 			*max_mv = hi_mv;
 		}
 	}
@@ -3288,7 +3290,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	bool is_qc = piano_mca_is_qc_cp(mca->real_type);
 	bool verified;
 	int vbat, ibat, tcool, twarm, ret;
-	u32 start_mv, ma, src_ma, max_mv = 0;
+	u32 start_mv, ma, src_ma, min_mv = MCA_CP_PPS_MIN_MV, max_mv = 0;
 
 	if (READ_ONCE(mca->inhibit_charge) || mca->cp_errors >= MCA_CP_MAX_ERRORS)
 		return;
@@ -3353,7 +3355,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		ma = qc.max_ibus_ma;
 		start_mv = roundup(start_mv, qc.step_mv);
 	} else {
-		ma = piano_mca_cp_apdo(mca, start_mv, &max_mv);
+		ma = piano_mca_cp_apdo(mca, start_mv, &min_mv, &max_mv);
 		if (!verified) {
 			ma = min_t(u32, ma, MCA_CP_THIRD_IBUS_MA);
 			max_mv = min_t(u32, max_mv, MCA_CP_THIRD_VBUS_MV);
@@ -3363,6 +3365,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		return;
 
 	mca->cp_ma = min_t(u32, ma, MCA_CP_PPS_MAX_MA);
+	mca->cp_min_mv = max_t(u32, min_mv, MCA_CP_PPS_MIN_MV);
 	mca->cp_max_mv = max_mv;
 	mca->cp_real_type = mca->real_type;
 	mca->cp_verified = verified;
diff --git a/drivers/power/supply/piano_mca_test.c b/drivers/power/supply/piano_mca_test.c
index 482c63d78..486443234 100644
--- a/drivers/power/supply/piano_mca_test.c
+++ b/drivers/power/supply/piano_mca_test.c
@@ -138,6 +138,7 @@ struct piano_mca_test {
 	bool restart_on_enable_read;
 	bool offer_cp_apdo;
 	u32 apdo_max_mv;
+	u32 apdo_min_mv;
 	bool only_5v;
 	unsigned int fv_writes;
 	unsigned int fcc_writes;
@@ -397,7 +398,7 @@ static int piano_mca_test_send(struct pmic_glink_client *client, void *data,
 			pdo[1].max_mv = cpu_to_le32(9000);
 			pdo[1].max_ma = cpu_to_le32(fixture->fixed_9v_ma);
 			if (fixture->offer_cp_apdo) {
-				pdo[2].min_mv = cpu_to_le32(6000);
+				pdo[2].min_mv = cpu_to_le32(fixture->apdo_min_mv);
 				pdo[2].max_mv = cpu_to_le32(fixture->apdo_max_mv);
 				pdo[2].max_ma = cpu_to_le32(6000);
 			}
@@ -546,6 +547,7 @@ static int piano_mca_test_init(struct kunit *test)
 	fixture->fixed_9v_ma = 2000;
 	fixture->fixed_5v_ma = 3000;
 	fixture->apdo_max_mv = 10000;
+	fixture->apdo_min_mv = 6000;
 	fixture->vbus_uv = 5000000;
 	fixture->real_type = MCA_TYPE_PD;
 	fixture->charge_status = 4;
@@ -3674,6 +3676,28 @@ static void piano_mca_ffc_tail_does_not_reenter_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
 }
 
+static void piano_mca_pps_apdo_window_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int writes;
+
+	KUNIT_EXPECT_EQ(test, (u32)MCA_TYPE_PD_PPS, 11U);
+	KUNIT_EXPECT_EQ(test, (u32)MCA_TYPE_PD_VERIFY, 12U);
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_pause(&f->mca, "APDO window"), 0);
+	f->apdo_min_mv = 7000;
+	f->mca.hv = MCA_HV_ON;
+	piano_mca_cp_try_start(&f->mca, f->remote_generation);
+	KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_OPENING);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_min_mv, 7000U);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_request(&f->mca, 6000), 0);
+	KUNIT_EXPECT_EQ(test, f->last_pps_word, piano_mca_pps_word(7000, 4100));
+	writes = f->pps_writes;
+	atomic_inc(&f->mca.connection_generation);
+	KUNIT_EXPECT_EQ(test, piano_mca_cp_request(&f->mca, 8000), -ECONNRESET);
+	KUNIT_EXPECT_EQ(test, f->pps_writes, writes);
+}
+
 static void piano_mca_battery_alert_current_test(struct kunit *test)
 {
 	struct piano_mca_test *f = test->priv;
@@ -4047,6 +4071,7 @@ static void piano_mca_cp_entry_gate_test(struct kunit *test)
 }
 
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_pps_apdo_window_test),
 	KUNIT_CASE(piano_mca_battery_alert_current_test),
 	KUNIT_CASE(piano_mca_pps_vstep_test),
 	KUNIT_CASE(piano_mca_third_pps_limits_test),
