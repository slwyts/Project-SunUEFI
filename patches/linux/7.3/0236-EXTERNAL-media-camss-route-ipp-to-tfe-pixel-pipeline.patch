+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		line->isp.digital_gain = ctrl->val;
+		break;
+	case V4L2_CID_SATURATION:
+		line->isp.saturation = ctrl->val;
+		break;
+	case V4L2_CID_CONTRAST:
+		line->isp.contrast = ctrl->val;
+		break;
