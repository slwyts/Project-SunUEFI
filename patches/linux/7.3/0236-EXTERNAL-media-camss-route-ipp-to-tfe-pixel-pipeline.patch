+			  0, VFE_ISP_GAIN_MAX, 1, VFE_ISP_GAIN_UNITY);
+	v4l2_ctrl_new_std(hdl, &vfe_ctrl_ops, V4L2_CID_BLUE_BALANCE,
+			  0, VFE_ISP_GAIN_MAX, 1, VFE_ISP_GAIN_UNITY);
