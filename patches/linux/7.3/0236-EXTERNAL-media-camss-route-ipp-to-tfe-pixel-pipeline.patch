@@ -192,7 +235,7 @@ static void __csid_reg_update_clear(struct csid_device *csid, int port_id)
 	if (csid_is_lite(csid))
 		csid->reg_update &= ~CSID_LITE_RUP_RDI(port_id);
 	else
-		csid->reg_update &= ~CSID_RUP_AUP_RDI(port_id);
