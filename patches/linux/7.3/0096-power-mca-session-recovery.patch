+	enables = f->cp_enable_writes;
+	f->cp_temp = 350;
+
+	/* Allow stop confirmation and the ordinary 9 V/PPS policy to run. */
+	for (n = 0; n < 4; n++)
+		piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->remote_generation, generation);
+	KUNIT_EXPECT_EQ(test, piano_mca_connection_generation(&f->mca), connection);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_FALSE(test, f->mca.cp_retry);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_EQ(test, f->cp_enable_writes, enables);
