+static void piano_mca_source_drop_retry_limit_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval value = { .intval = 4000000 };
+	unsigned int enables;
+	int error, n;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	for (error = 1; error <= MCA_CP_MAX_ERRORS; error++) {
+		f->vbus_uv = 0;
+		if (error == 1)
+			f->cp_stop_failures = 1;
+		piano_mca_poll(&f->mca.poll.work);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_errors, (u32)error);
+		/* Repeated offline polls and stop-confirmation retries count once. */
+		piano_mca_poll(&f->mca.poll.work);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_errors, (u32)error);
+		enables = f->cp_enable_writes;
+		f->vbus_uv = 9000000;
+		for (n = 0; n < (error == 1 ? 3 : 6); n++)
+			piano_mca_poll(&f->mca.poll.work);
+		if (error < MCA_CP_MAX_ERRORS)
+			KUNIT_ASSERT_TRUE(test, piano_mca_cp_active(&f->mca));
+	}
+	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 11U);
+	KUNIT_EXPECT_FALSE(test, piano_mca_cp_active(&f->mca));
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_EQ(test, f->cp_enable_writes, enables);
+	KUNIT_EXPECT_EQ(test, f->icl_ma, 1600U);
+
+	KUNIT_ASSERT_EQ(test, power_supply_set_property(f->mca.usb,
+		POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT, &value), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 11U);
+	KUNIT_EXPECT_FALSE(test, piano_mca_cp_active(&f->mca));
+
+	/* A real connector event gives the replacement source a fresh budget. */
+	atomic_inc(&f->mca.connection_generation);
+	for (n = 0; n < 6; n++)
+		piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 0U);
+	KUNIT_EXPECT_EQ(test, f->mca.polled_connection_generation, 1U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_ON);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 1750U);
+}
