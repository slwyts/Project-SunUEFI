+	f->mca.cp_start_ibat_ma = MCA_CP_IBAT_MAX_MA;
+	f->mca.hv = MCA_HV_ON;
+	f->mca.vbus_uv = f->vbus_uv = 9000000;
+	generation = f->remote_generation;
+	connection = piano_mca_connection_generation(&f->mca);
+
+	/* A real stage-temperature fault reaches cp_stop through the worker. */
+	f->cp_temp = MCA_CP_TDIE_MAX + 1;
