+static void piano_mca_new_session_reapplies_cached_input_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	hv_charge = false;
+	f->remote_generation += 2;
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_DOWN);
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_UP);
+	/* Model an old worker publishing its result after the PDR notification. */
+	f->mca.icl_set_ma = 1500;
+	f->mca.hv = MCA_HV_BLOCKED;
+	f->mca.cp_errors = 7;
+	f->icl_ma = f->mca.icl_ma = 500;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.polled_generation, f->remote_generation);
+	KUNIT_EXPECT_EQ(test, f->icl_ma, 1500U);
+	KUNIT_EXPECT_EQ(test, f->mca.hv, MCA_HV_OFF);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 7U);
+}
