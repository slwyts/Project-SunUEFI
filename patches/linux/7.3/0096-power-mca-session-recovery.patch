 	if (!device_link_add(mca->dev, mca->cp_psy->dev.parent,
@@ -2520,7 +2561,6 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	mca->cp_ibus_hot = mca->cp_ibus_ma;
 	mca->cp_start_ibat_ma = limits.ma;
 	mca->cp_ibat_trip = 0;
-	mca->cp_thermal_stop = false;
