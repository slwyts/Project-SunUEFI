+static void piano_mca_source_read_fault(struct kunit *test, u32 property)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int enables;
+	int n;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	f->source_read_error = property;
+	enables = f->cp_enable_writes;
+	for (n = 0; n < 3; n++)
+		piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 0U);
+	KUNIT_EXPECT_TRUE(test, f->mca.online);
+	f->source_read_error = 0;
+	for (n = 0; n < 6; n++)
+		piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_EQ(test, f->cp_enable_writes, enables);
+}
