 static u32 piano_mca_cp_apdo(struct piano_mca *mca, u32 start_mv, u32 *max_mv)
 {
@@ -2443,9 +2482,9 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	int vbat, ibat, tcool, twarm, ret;
 	u32 start_mv, ma, src_ma, max_mv = 0;
 
-	if (READ_ONCE(mca->inhibit_charge))
+	if (READ_ONCE(mca->inhibit_charge) || mca->cp_errors >= MCA_CP_MAX_ERRORS)
 		return;
-	if (mca->cp == MCA_CP_DONE && mca->cp_thermal_stop)
+	if (mca->cp == MCA_CP_DONE && mca->cp_retry)
