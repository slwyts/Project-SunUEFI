@@ -2462,7 +2501,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	    limits.ma < MCA_CP_BUCK_MA + 4 * MCA_CP_OPEN_IBUS_MA ||
 	    piano_mca_normal_voltage_stop(mca, vbat, limits.fv_mv) ||
 	    vbat < MCA_CP_VBAT_MIN_MV || vbat >= limits.cv_mv ||
-	    piano_mca_read_u32(mca, MCA_PROP_VERIFY_PROCESS))
+	    piano_mca_verifying(mca, generation, mca->cp_connection_generation))
 		return;
 	/* Complete the PMIC voltage transition before arming the pump. */
 	if (piano_mca_normal_set_fv(mca, limits.fv_mv,
@@ -2482,7 +2521,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 
 	mca->cp_ma = min_t(u32, ma, MCA_CP_PPS_MAX_MA);
 	mca->cp_max_mv = max_mv;
-	src_ma = piano_mca_cp_src_ma(mca);
+	src_ma = mca->cp_ma;
 	src_ma -= min_t(u32, src_ma, MCA_CP_BUCK_MA + 200);
 	mca->cp_ibus_ma = min(clamp(cp_ibus_max, 500U, (u32)MCA_CP_IBUS_MAX_MA),
 			      src_ma);
@@ -2498,6 +2537,8 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	mca->cp_psy = power_supply_get_by_name("sc8541");
 	if (!mca->cp_psy)
 		return;
+	/* This is a new attempt; an earlier policy pause cannot own its faults. */
+	mca->cp_retry = false;
 	mca->cp = MCA_CP_STOPPING;
