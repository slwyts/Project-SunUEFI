From d4c0684caecc11422b7ae3977fcd4f7a38b44129 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Tue, 10 Nov 2026 23:43:19 +0800
Subject: [PATCH] fix(power): reconcile MCA source recovery and charging stops

Recalculate source current from the APDO and normal charging budget after VBUS loss instead of preserving a guessed dropout-current ceiling. Bound same-connection recovery and retain hardware-fault and completed-charge stops.

Keep input and JEITA maintenance during zero-current or user inhibition, preserve stop ownership through errors and cancellation, reapply the complete PMIC enable command, and hand off to buck in the same poll. Reject unknown source/verification state, limit current before both voltage transitions, and invalidate late host caches across sessions.

Signed-off-by: Cryolitia PukNgae <cryolitia@gmail.com>
---
 drivers/power/supply/piano_mca.c      | 338 +++++++-----
 drivers/power/supply/piano_mca_test.c | 749 +++++++++++++++++++++++++-
 2 files changed, 944 insertions(+), 143 deletions(-)

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index f9ad399b0..685a7ae05 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -394,9 +394,10 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 #define MCA_CP_TRIP_GRACE_MS	30000
 #define MCA_CP_LOW_POLLS	6
 #define MCA_CP_LOG_POLLS	20
-/* see piano_mca_cp_learn_drop() */
-#define MCA_CP_DROP_BACKOFF_MA	500
-#define MCA_CP_DROP_FORGET_MS	10000
+/* Stock blocks further starts after eleven errors in one connection. */
+#define MCA_CP_MAX_ERRORS	11
+/* A prolonged VBUS loss invalidates the cached authentication. */
+#define MCA_AUTH_REATTACH_MS	10000
 /* with mipps_auth, waits this long after attach for the authentication */
 #define MCA_CP_AUTH_WAIT_MS	60000
 /* an authenticated adapter resets itself within this, see piano_mca_auth_pending() */
@@ -502,6 +503,7 @@ struct piano_mca {
 	bool inhibit_stopped_cp;	/* This policy requested the CP stop. */
 	struct notifier_block connection_notifier;
 	atomic_t connection_generation;
+	unsigned int polled_generation;
 	unsigned int polled_connection_generation;
 	bool online;
 	int vbus_uv;
@@ -537,7 +539,7 @@ struct piano_mca {
 	bool normal_voltage_stop;	/* low-FV JEITA charging vote */
 	int battery_direction;	/* sign of the last combined gauge current */
 	u8 normal_cool_zone, normal_hot_zone;	/* previous JEITA indices + 1 */
-	bool cp_thermal_stop;	/* may retry after temperature or current recovery */
+	bool cp_retry;	/* only a policy pause may restart this connection */
 	unsigned long cp_taper_at;
 	u32 fv_set_mv;
 	unsigned int fv_generation;
@@ -545,8 +547,7 @@ struct piano_mca {
 	bool cp_buck_par;	/* buck charger at MCA_CP_PAR_* */
 	int cp_polls;		/* while opening: tries; then: polls */
 	int cp_low;		/* consecutive polls below MCA_CP_LOW_IBUS_MA */
-	u32 cp_ibus_last;	/* stage and buck input current at the last step */
-	u32 cp_ibus_cap;	/* learned from a source dropping out, 0 if none */
+	u32 cp_errors;		/* non-authentication VBUS losses in this connection */
 	unsigned long cp_off_at;	/* jiffies when the source went away */
 	unsigned long cp_on_at;		/* jiffies when it came */
 	bool auth_ok;		/* adapter response matched our fresh challenge */
@@ -1714,6 +1715,33 @@ static int piano_mca_request_volt_session(struct piano_mca *mca, u32 mv,
 					 unsigned int generation,
 					 unsigned int connection)
 {
+	u32 icl = piano_mca_pd_5v_ma(mca, generation, connection);
+	int ret;
+
+	if (mv == MCA_HV_MV) {
+		if (icl < MCA_ICL_MIN_MA)
+			return -EINVAL;
+		icl = min(icl, mca->hv_pps_ma);
+	}
+	icl = min(icl, piano_mca_policy_icl(mca->real_type));
+	if (mca->polled_generation != generation) {
+		/* Teardown may see a new, unsampled session: only return to safe 5 V. */
+		if (mv != 5000)
+			return -ECONNRESET;
+		icl = MCA_ICL_MIN_MA;
+	}
+	/* Lower before either transition; raise only after the contract is known. */
+	if (mca->icl_set_ma > 0)
+		icl = min_t(u32, icl, mca->icl_set_ma);
+	icl = clamp(icl, MCA_ICL_MIN_MA, MCA_ICL_HV_MAX_MA);
+	if (mca->polled_generation != generation ||
+	    mca->icl_set_ma != icl || mca->icl_ma > icl) {
+		ret = piano_mca_write_u32_session(mca, MCA_PROP_ICL, icl,
+						  generation, connection);
+		if (ret)
+			return ret;
+		mca->icl_set_ma = icl;
+	}
 	if (mv == MCA_HV_MV && mca->hv_pps)
 		return piano_mca_write_u32_session(mca, MCA_PROP_PPS_SELECT,
 						   piano_mca_pps_word(mv, mca->hv_pps_ma),
@@ -1736,6 +1764,18 @@ static bool piano_mca_auth_pending(struct piano_mca *mca)
 				    msecs_to_jiffies(MCA_AUTH_RESET_WAIT_MS));
 }
 
+/* A failed verification-state read must not authorize a PD request. */
+static int piano_mca_verifying(struct piano_mca *mca, unsigned int generation,
+			       unsigned int connection)
+{
+	__le32 verifying;
+	int ret;
+
+	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_VERIFY_PROCESS,
+			     &verifying, sizeof(verifying), generation, connection);
+	return ret ? ret : !!le32_to_cpu(verifying);
+}
+
 /*
  * hv_charge state machine, one step per poll.  Returns the input current
  * the source allows at 9 V once the bus is there, 0 while at 5 V.
@@ -1749,9 +1789,13 @@ static u32 piano_mca_hv_step(struct piano_mca *mca, unsigned int generation,
 	u32 ma = 0;
 	int ret;
 
-	if (!hv_charge || mca->hv == MCA_HV_BLOCKED ||
-	    !piano_mca_session_valid(mca, generation, connection))
+	if (!hv_charge || !piano_mca_session_valid(mca, generation, connection))
+		return 0;
+	if (mca->hv == MCA_HV_BLOCKED) {
+		if (mca->vbus_uv > MCA_HV_VBUS_5V_MAX_UV)
+			piano_mca_request_volt_session(mca, 5000, generation, connection);
 		return 0;
+	}
 
 	if (piano_mca_is_pd(mca->real_type))
 		ma = piano_mca_pd_9v_ma(mca, &pps, generation, connection);
@@ -1767,14 +1811,14 @@ static u32 piano_mca_hv_step(struct piano_mca *mca, unsigned int generation,
 		/* not in the middle of an adapter authentication */
 		if (!ma || time_before(jiffies, mca->hv_retry) ||
 		    piano_mca_auth_pending(mca) ||
-		    piano_mca_read_u32(mca, MCA_PROP_VERIFY_PROCESS))
+		    piano_mca_verifying(mca, generation, connection))
 			return 0;
 		mca->hv_pps = pps;
 		mca->hv_pps_ma = ma;
 		ret = piano_mca_request_volt_session(mca, MCA_HV_MV,
 						    generation, connection);
 		if (ret) {
-			dev_warn(mca->dev, "9 V request refused: %d (adsp %d)\n",
+			dev_warn(mca->dev, "failed to request 9 V: %d (adsp %d)\n",
 				 ret, mca->retcode);
 			break;
 		}
@@ -1853,8 +1897,13 @@ static void piano_mca_apply_input_policy(struct piano_mca *mca,
 	else if (piano_mca_is_pd(mca->real_type))
 		target = clamp(piano_mca_pd_5v_ma(mca, generation, connection),
 			       MCA_ICL_MIN_MA, target);
+	/* Either contract may still be in effect while the voltage settles. */
+	if (mca->hv == MCA_HV_REQUESTED)
+		target = min(target, mca->hv_pps_ma);
+	if (mca->hv == MCA_HV_BLOCKED && mca->vbus_uv > MCA_HV_VBUS_5V_MAX_UV)
+		target = min_t(u32, target, max(mca->icl_set_ma, MCA_ICL_MIN_MA));
 
-	if (target == mca->icl_set_ma)
+	if (target == mca->icl_set_ma && mca->polled_generation == generation)
 		return;
 
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_ICL, target,
@@ -2076,11 +2125,10 @@ static int piano_mca_normal_enable(struct piano_mca *mca, bool enable,
 
 	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_ENABLE,
 			     &actual, sizeof(actual), generation, connection);
-	if (!ret && actual == requested)
-		return 0;
 	/* An unreadable charger may still be stopped, but must not be enabled. */
 	if (ret && enable)
 		return ret;
+	/* The getter covers CHG_EN only; the setter also configures DCDC modes. */
 	ret = piano_mca_write_session(mca, MCA_PROP_CHARGE_ENABLE,
 				      &requested, sizeof(requested),
 				      generation, connection);
@@ -2273,8 +2321,7 @@ static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
 		return -ECONNRESET;
 	mv = clamp(rounddown(mv, 20), (u32)MCA_CP_PPS_MIN_MV,
 		   min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV));
-	if (mv == mca->cp_mv)
-		return 0;
+	/* Stock sends every regulation request, including an unchanged target. */
 
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_PPS_SELECT,
 					  piano_mca_pps_word(mv, mca->cp_ma),
@@ -2285,10 +2332,6 @@ static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
 	return ret;
 }
 
-/*
- * Turn the stage off and go back to the buck charger: the next poll asks
- * the source for 9 V again and puts the buck limits back.
- */
 /* Buck charger share while direct charging */
 static int piano_mca_cp_set_buck(struct piano_mca *mca, u32 icl_ma,
 				 u32 fcc_ma)
@@ -2321,7 +2364,8 @@ static int piano_mca_cp_stop(struct piano_mca *mca, const char *why)
 	if (!piano_mca_cp_active(mca))
 		return 0;
 
-	mca->cp_thermal_stop = false;
+	if (mca->cp != MCA_CP_STOPPING)
+		mca->cp_retry = false;
 	mca->cp = MCA_CP_STOPPING;
 	ret = piano_mca_cp_set_online(mca, false);
 	ret = ret ?: piano_mca_cp_get(mca, POWER_SUPPLY_PROP_ONLINE, &on);
@@ -2341,17 +2385,37 @@ static int piano_mca_cp_stop(struct piano_mca *mca, const char *why)
 	return 0;
 }
 
-/* Called with the poll drained, or by the sole charging worker. */
-static int piano_mca_inhibit_charging(struct piano_mca *mca,
-				     unsigned int generation,
-				     unsigned int connection)
+/* A policy pause may retry after its condition clears, including stop errors. */
+static int piano_mca_cp_pause(struct piano_mca *mca, const char *why)
+{
+	bool retry = mca->cp_retry || mca->cp == MCA_CP_OPENING ||
+		     mca->cp == MCA_CP_ON;
+	int ret = piano_mca_cp_stop(mca, why);
+
+	mca->cp_retry = retry;
+	return ret;
+}
+
+/* Retry a changed session, but retain same-session hardware/transport faults. */
+static int piano_mca_cp_stop_io(struct piano_mca *mca, const char *why)
+{
+	return piano_mca_cp_session_valid(mca) ? piano_mca_cp_stop(mca, why) :
+		piano_mca_cp_pause(mca, why);
+}
+
+/* Called under policy_lock; source negotiation remains independent. */
+static int piano_mca_pause_charging(struct piano_mca *mca,
+				   unsigned int generation,
+				   unsigned int connection)
 {
+	bool inhibit = READ_ONCE(mca->inhibit_charge);
 	int ret;
 
 	/* Remember the stop reason if confirmation must be retried. */
-	if (mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON)
+	if (inhibit && (mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON))
 		mca->inhibit_stopped_cp = true;
-	ret = piano_mca_cp_stop(mca, "charging inhibited");
+	ret = inhibit ? piano_mca_cp_stop(mca, "charging inhibited") :
+		piano_mca_cp_pause(mca, "charge current limit");
 	if (ret)
 		return ret;
 	if (!READ_ONCE(mca->service_up))
@@ -2360,31 +2424,6 @@ static int piano_mca_inhibit_charging(struct piano_mca *mca,
 	return piano_mca_normal_pause(mca, generation, connection);
 }
 
-/*
- * A source that drops out under direct charging (a hard reset; the request
- * in flight may be refused first) did not take that much current, whatever
- * it advertised: aim lower from then on, unless it is away for longer than
- * MCA_CP_DROP_FORGET_MS (a replug).  The current is what the stage and the
- * buck charger took together.
- */
-static void piano_mca_cp_learn_drop(struct piano_mca *mca)
-{
-	/* not the reset an authenticated adapter may do by itself */
-	if (mca->cp != MCA_CP_ON || piano_mca_auth_pending(mca) ||
-	    mca->cp_ibus_last <= 2 * MCA_CP_DROP_BACKOFF_MA)
-		return;
-
-	mca->cp_ibus_cap = mca->cp_ibus_last - MCA_CP_DROP_BACKOFF_MA;
-	dev_warn(mca->dev, "source dropped out at %u mA, %u mA from now on\n",
-		 mca->cp_ibus_last, mca->cp_ibus_cap);
-}
-
-/* What the source gives: its APDO current, less once it dropped out */
-static u32 piano_mca_cp_src_ma(struct piano_mca *mca)
-{
-	return mca->cp_ibus_cap ? min(mca->cp_ma, mca->cp_ibus_cap) : mca->cp_ma;
-}
-
