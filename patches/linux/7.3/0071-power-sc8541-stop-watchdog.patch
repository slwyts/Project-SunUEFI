From 8cf58735f8a52c9ce794d2ddbead6974df41962b Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Sun, 8 Nov 2026 07:40:31 +0800
Subject: [PATCH] fix(power-supply): confirm SC8541 stop and arm its hardware
 watchdog

Return stop and readback failures to the caller, retain runtime guard retries, and reject suspend when switching cannot be confirmed off. Program and verify the five-second hardware watchdog before CHG_EN, preserving unrelated CTRL3 bits.

The SC8541 datasheet V1.0.2 section 9.2.6 and CTRL3 register table specify that any register access feeds the watchdog and expiry clears CHG_EN without resetting protection thresholds.

Signed-off-by: Cryolitia PukNgae <cryolitia@gmail.com>
---
 drivers/power/supply/sc8541_charger.c | 59 +++++++++++++++++++--------
 1 file changed, 43 insertions(+), 16 deletions(-)

diff --git a/drivers/power/supply/sc8541_charger.c b/drivers/power/supply/sc8541_charger.c
index 9c9862406..52c1d4961 100644
--- a/drivers/power/supply/sc8541_charger.c
+++ b/drivers/power/supply/sc8541_charger.c
@@ -46,6 +46,9 @@
 #define SC8541_CTRL2		0x0f
 #define SC8541_CHG_EN		BIT(4)
 #define SC8541_EN_BYPASS	BIT(3)
+#define SC8541_CTRL3		0x10
+#define SC8541_WATCHDOG_MASK	GENMASK(4, 2)
+#define SC8541_WATCHDOG_5S	BIT(4)
 #define SC8541_DEVICE_INFO	0x22
 #define SC8541_DEVICE_ID	0x41
 #define SC8541_ADC_CTRL1	0x23
@@ -77,7 +80,7 @@
 #define SC8541_BUSOCP_MIN_MA	1000
 #define SC8541_BUSOCP_MAX_MA	7000	/* stock bus-ocp-threshold */
 
-/* Switching is turned off unless "online" is written again within this */
+/* Software timeout unless "online" is written again within this. */
 #define SC8541_KICK_MS		3000
 /*
  * CHG_EN reads back as set only some time after it is written, and is
@@ -189,14 +192,17 @@ static int sc8541_stop_switching(struct sc8541 *sc)
 	return ret;
 }
 
-static void sc8541_disable_locked(struct sc8541 *sc)
+static int sc8541_disable_locked(struct sc8541 *sc)
 {
-	sc8541_stop_switching(sc);
+	int ret;
+
+	ret = sc8541_stop_switching(sc);
 	if (sc->enabled)
 		dev_info(sc->dev, "switching off\n");
 	sc->enabled = false;
 	mod_delayed_work(system_dfl_wq, &sc->watch,
 			 msecs_to_jiffies(SC8541_GUARD_MS));
+	return ret;
 }
 
 /* Protections and the ADC, written before every start */
@@ -221,6 +227,13 @@ static int sc8541_arm(struct sc8541 *sc)
 				SC8541_BUSOCP_STEP_MA);
 	/* 2:1, not bypass */
 	ret = ret ?: sc8541_write_check(sc, SC8541_CTRL2, SC8541_EN_BYPASS, 0);
+	/*
+	 * Hardware watchdog: 5 s, enabled. Any register read or write kicks it,
+	 * including the caller's 500 ms ADC polls. Keep the separate software
+	 * timeout: other register readers must not keep an abandoned stage on.
+	 */
+	ret = ret ?: sc8541_write_check(sc, SC8541_CTRL3,
+				      SC8541_WATCHDOG_MASK, SC8541_WATCHDOG_5S);
 	/* all channels, continuous conversion */
 	ret = ret ?: sc8541_write_check(sc, SC8541_ADC_CTRL2, 0xff, 0);
 	ret = ret ?: sc8541_write_check(sc, SC8541_ADC_CTRL1, 0xc3,
@@ -252,30 +265,39 @@ static int sc8541_enable(struct sc8541 *sc)
 	return ret;
 }
 
-static void sc8541_disable(struct sc8541 *sc)
+static int sc8541_disable(struct sc8541 *sc)
 {
+	int ret;
+
 	mutex_lock(&sc->lock);
-	sc8541_disable_locked(sc);
+	ret = sc8541_disable_locked(sc);
 	mutex_unlock(&sc->lock);
+
+	return ret;
 }
 
 /*
- * Final stop (unbind, shutdown, suspend): no watch afterwards, so stop,
- * wait out the CHG_EN latency and stop again.
+ * Wait out the CHG_EN latency before confirming a stop. The caller must not
+ * restore the buck charger or suspend until switching is known to be off.
  */
-static void sc8541_disable_sync(struct sc8541 *sc)
+static int sc8541_disable_sync(struct sc8541 *sc)
 {
 	unsigned int ctrl;
+	int ret;
 
 	sc8541_disable(sc);
 	cancel_delayed_work_sync(&sc->watch);
 	msleep(SC8541_GUARD_MS);
 	mutex_lock(&sc->lock);
-	sc8541_stop_switching(sc);
-	if (!regmap_read(sc->regmap, SC8541_CTRL2, &ctrl) &&
-	    (ctrl & SC8541_CHG_EN))
-		dev_err(sc->dev, "still switching after stop\n");
+	ret = sc8541_stop_switching(sc);
+	ret = ret ?: regmap_read(sc->regmap, SC8541_CTRL2, &ctrl);
+	if (!ret && (ctrl & SC8541_CHG_EN))
+		ret = -EIO;
+	if (ret)
+		dev_err(sc->dev, "failed to confirm switching stopped: %d\n", ret);
 	mutex_unlock(&sc->lock);
+
+	return ret;
 }
 
 static void sc8541_watch(struct work_struct *work)
@@ -352,8 +374,14 @@ static int sc8541_set_property(struct power_supply *psy,
 	if (val->intval)
 		return sc8541_enable(sc);
 
-	sc8541_disable(sc);
-	return 0;
+	ret = sc8541_disable_sync(sc);
+	if (ret) {
+		mutex_lock(&sc->lock);
+		mod_delayed_work(system_dfl_wq, &sc->watch,
+				 msecs_to_jiffies(SC8541_GUARD_MS));
+		mutex_unlock(&sc->lock);
+	}
+	return ret;
 }
 
 static int sc8541_property_is_writeable(struct power_supply *psy,
@@ -541,8 +569,7 @@ static void sc8541_shutdown(struct i2c_client *client)
 
 static int sc8541_suspend(struct device *dev)
 {
-	sc8541_disable_sync(dev_get_drvdata(dev));
-	return 0;
+	return sc8541_disable_sync(dev_get_drvdata(dev));
 }
 
 static DEFINE_SIMPLE_DEV_PM_OPS(sc8541_pm_ops, sc8541_suspend, NULL);
-- 
2.55.0

