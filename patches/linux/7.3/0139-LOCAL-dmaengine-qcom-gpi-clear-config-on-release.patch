+static void gpi_shutdown(struct platform_device *pdev)
+{
+	struct gpi_dev *gpi_dev = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	/* A DMA client may already have unbound while retaining its buffers. */
+	for (i = 0; i < gpi_dev->max_gpii; i++) {
+		struct gpii *gpii = &gpi_dev->gpiis[i];
+		u32 channels;
+
+		while ((channels = READ_ONCE(gpii->unconfirmed_channels))) {
+			struct dma_chan *chan = &gpii->gchan[__ffs(channels)].vc.chan;
+			int ret = gpi_terminate(chan, false);
+
+			if (!ret)
+				continue;
+			dev_err_ratelimited(gpi_dev->dev,
+					    "GPII %u DMA stop unconfirmed (%d); keeping the system on\n",
+					    i, ret);
+			msleep(1000);
+		}
+	}
+}
