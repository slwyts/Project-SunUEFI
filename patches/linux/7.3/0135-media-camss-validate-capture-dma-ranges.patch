From 6466c064f6eed9d62727701d2e08bc47bfc98ae6 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@tuta.io>
Date: Wed, 18 Nov 2026 19:39:38 +0800
Subject: [PATCH] media: camss: Validate contiguous DMA ranges for capture

CAMSS uses the videobuf2 scatter-gather allocator but programs a DMA
base address for each plane. Reading the first mapped entry alone does
not ensure that the bytes the hardware will capture are addressable
from that base.

Require a contiguous prefix of the mapped entries covering sizeimage
before saving an address. Accept adjacent DMA segments and ignore the
unused tail of a larger buffer. Fail in buf_init() so videobuf2 can
release the mapping without giving it to the hardware.

OpenAI Codex assisted with the source review and implementation.

Fixes: 0ac2586c410f ("media: camss: Add files which handle the video device nodes")
Assisted-by: LLM
---
 .../media/platform/qcom/camss/camss-video.c   | 34 ++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 1b369fa584a7cebabe80e8b03a3c654f32c1f6bd..34d15edbe19a55638486083659d0b606c612df60 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -7,6 +7,7 @@
  * Copyright (c) 2013-2015, The Linux Foundation. All rights reserved.
  * Copyright (C) 2015-2018 Linaro Ltd.
  */
+#include <linux/overflow.h>
 #include <linux/slab.h>
 #include <media/media-entity.h>
 #include <media/v4l2-dev.h>
@@ -152,6 +153,36 @@ static int video_queue_setup(struct vb2_queue *q,
 	return 0;
 }
 
+/* The hardware receives one DMA base address per plane. */
+static bool video_dma_range_is_contiguous(const struct sg_table *sgt, u32 size)
+{
+	struct scatterlist *sg;
+	dma_addr_t expected;
+	dma_addr_t last;
+	unsigned int i;
+
+	if (!sgt || !sgt->sgl || !sgt->nents || !size)
+		return false;
+
+	expected = sg_dma_address(sgt->sgl);
+	if (check_add_overflow(expected, size - 1, &last))
+		return false;
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		unsigned int len = sg_dma_len(sg);
+
+		if (!len || sg_dma_address(sg) != expected)
+			return false;
+		if (len >= size)
+			return true;
+
+		expected += len;
+		size -= len;
+	}
+
+	return false;
+}
+
 static int video_buf_init(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
@@ -165,7 +196,8 @@ static int video_buf_init(struct vb2_buffer *vb)
 
 	for (i = 0; i < format->num_planes; i++) {
 		sgt = vb2_dma_sg_plane_desc(vb, i);
-		if (!sgt)
+		if (!video_dma_range_is_contiguous(sgt,
+						   format->plane_fmt[i].sizeimage))
 			return -EFAULT;
 
 		buffer->addr[i] = sg_dma_address(sgt->sgl);
-- 
