From a291fa1c51082b3cef6f1525ca9e8ee47fdaaafd Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@tuta.io>
Date: Wed, 18 Nov 2026 02:42:00 +0800
Subject: [PATCH] fix(power): preserve charge state and report applied pump
 limits

Do not create termination votes while charging is inhibited. Preserve existing full votes and their normal SOC recharge threshold. Reject notifications shorter than the header and property before inspecting fields or queueing work. Cache the SC8541 protection limit only after verified writes and report the actual quantized value. Exercise these paths in the existing MCA and SC8541 KUnit suites.
---
 drivers/power/supply/piano_mca.c           | 12 ++++
 drivers/power/supply/piano_mca_test.c      | 70 ++++++++++++++++++++++
 drivers/power/supply/sc8541_charger.c      | 16 +++--
 drivers/power/supply/sc8541_charger_test.c | 45 ++++++++++++++
 4 files changed, 138 insertions(+), 5 deletions(-)

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index d2ff628bd8fb0f67eded26daaf5f8507539411f6..2f6205a83f00a91735760761fee30451cebb162f 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -774,6 +774,10 @@ static void piano_mca_callback(const void *data, size_t len, void *priv)
 	struct piano_mca *mca = priv;
 	const struct mca_resp *resp = data;
 
+	/* Notifications contain a header and property ID, but no full response. */
+	if (len < offsetof(struct mca_resp, retcode))
+		return;
+
 	if (le32_to_cpu(resp->type) == PMIC_GLINK_NOTIFY) {
 		/* notification: id at +0xc, payload from +0x10 */
 		dev_dbg(mca->dev, "notify %#x len %zu\n",
@@ -2848,6 +2852,14 @@ static int piano_mca_normal_termination(struct piano_mca *mca, int vbat, int iba
 	}
 	if (mca->normal_term_count && mca->normal_term_generation != generation)
 		mca->normal_term_count = 0;
+	/* User inhibition creates low/negative current, not a termination sample.
+	 * A genuine full vote still follows the ordinary recharge SOC below.
+	 */
+	if (mca->inhibit_charge) {
+		mca->normal_term_count = 0;
+		if (!mca->normal_full)
+			return 0;
+	}
 	if (!mca->normal_full) {
 		/* FFC has a different tail current and compensated PMIC voltage. */
 		if (mca->ffc) {
diff --git a/drivers/power/supply/piano_mca_test.c b/drivers/power/supply/piano_mca_test.c
index d137202479bcb7c6b00937057e5125157301845b..bafc4de27f869b3b4d7c9b064e486f3d126ee6d3 100644
--- a/drivers/power/supply/piano_mca_test.c
+++ b/drivers/power/supply/piano_mca_test.c
@@ -2994,6 +2994,73 @@ static int piano_mca_full_prepare(struct kunit *test)
 	return 0;
 }
 
+static void piano_mca_short_notification_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	u8 *packet;
+	size_t len;
+
+	/* Allocate the exact wire length so KASAN can detect a property overread. */
+	for (len = 12; len < 16; len++) {
+		packet = kunit_kzalloc(test, len, GFP_KERNEL);
+		KUNIT_ASSERT_NOT_NULL(test, packet);
+		put_unaligned_le32(PMIC_GLINK_NOTIFY, packet + 4);
+		piano_mca_callback(packet, len, &f->mca);
+		flush_delayed_work(&f->mca.poll);
+		KUNIT_EXPECT_FALSE(test, delayed_work_pending(&f->mca.poll));
+		KUNIT_EXPECT_EQ(test, atomic_read(&f->work_runs), 0);
+	}
+	packet = kunit_kzalloc(test, 16, GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, packet);
+	put_unaligned_le32(PMIC_GLINK_NOTIFY, packet + 4);
+	piano_mca_callback(packet, 16, &f->mca);
+	flush_delayed_work(&f->mca.poll);
+	KUNIT_EXPECT_EQ(test, atomic_read(&f->work_runs), 1);
+}
+
+static void piano_mca_inhibit_does_not_create_full_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int n;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE), 0);
+	f->gauge[0].voltage_uv = f->gauge[1].voltage_uv = 4475000;
+	f->gauge[0].current_ua = f->gauge[1].current_ua = -50000;
+	f->mca.normal_term_count = 4;
+	for (n = 0; n < 6; n++) {
+		f->mca.normal_term_at = jiffies - msecs_to_jiffies(1000);
+		piano_mca_poll(&f->mca.poll.work);
+		KUNIT_EXPECT_FALSE(test, f->mca.normal_full);
+		KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)0);
+	}
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->mca.normal_full);
+	KUNIT_EXPECT_TRUE(test, f->pmic_enabled);
+}
+
+static void piano_mca_auto_preserves_real_full_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_TRUE(test, f->mca.normal_full);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+}
+
 static void piano_mca_full_hardware_hold_test(struct kunit *test)
 {
 	struct piano_mca_test *f = test->priv;
@@ -4271,6 +4338,9 @@ static void piano_mca_cp_entry_gate_test(struct kunit *test)
 }
 
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_short_notification_test),
+	KUNIT_CASE(piano_mca_inhibit_does_not_create_full_test),
+	KUNIT_CASE(piano_mca_auto_preserves_real_full_test),
 	KUNIT_CASE(piano_mca_pps_conversion_selection_test),
 	KUNIT_CASE(piano_mca_pps_bypass_regulation_test),
 	KUNIT_CASE(piano_mca_pps_bypass_stop_failure_test),
diff --git a/drivers/power/supply/sc8541_charger.c b/drivers/power/supply/sc8541_charger.c
index 4ef9e0d07a182eba5488560f5b5c478e9ead5b15..da90a5336231900be21735f77b4b2a1bb4f30346 100644
--- a/drivers/power/supply/sc8541_charger.c
+++ b/drivers/power/supply/sc8541_charger.c
@@ -346,7 +346,9 @@ static int sc8541_get_property(struct power_supply *psy,
 		val->intval = !!(reg & SC8541_CHG_EN);
 		return 0;
 	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		mutex_lock(&sc->lock);
 		val->intval = sc->busocp_ma * 1000;
+		mutex_unlock(&sc->lock);
 		return 0;
 	case POWER_SUPPLY_PROP_CHARGE_TYPE:
 		ret = regmap_read(sc->regmap, SC8541_CTRL2, &reg);
@@ -411,12 +413,16 @@ static int sc8541_set_property(struct power_supply *psy,
 	if (psp == POWER_SUPPLY_PROP_CHARGE_TYPE)
 		return sc8541_set_charge_type(sc, val->intval);
 	if (psp == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT) {
+		int ma = clamp(val->intval / 1000, SC8541_BUSOCP_MIN_MA,
+			       SC8541_BUSOCP_MAX_MA);
+		unsigned int code = (ma - SC8541_BUSOCP_OFFSET_MA) /
+				    SC8541_BUSOCP_STEP_MA;
+
 		mutex_lock(&sc->lock);
-		sc->busocp_ma = clamp(val->intval / 1000, SC8541_BUSOCP_MIN_MA,
-				      SC8541_BUSOCP_MAX_MA);
-		ret = sc8541_write_check(sc, SC8541_BUSOCP, 0x9f,
-				(sc->busocp_ma - SC8541_BUSOCP_OFFSET_MA) /
-				SC8541_BUSOCP_STEP_MA);
+		ret = sc8541_write_check(sc, SC8541_BUSOCP, 0x9f, code);
+		if (!ret)
+			sc->busocp_ma = SC8541_BUSOCP_OFFSET_MA +
+					code * SC8541_BUSOCP_STEP_MA;
 		mutex_unlock(&sc->lock);
 		return ret;
 	}
diff --git a/drivers/power/supply/sc8541_charger_test.c b/drivers/power/supply/sc8541_charger_test.c
index eb49459fb986a7549c3c33d598cf5550b75cf41c..065f412c432c6ff082fb9ea143087d12c180a1ee 100644
--- a/drivers/power/supply/sc8541_charger_test.c
+++ b/drivers/power/supply/sc8541_charger_test.c
@@ -8,6 +8,7 @@ struct sc8541_test {
 	u8 regs[SC8541_MAX_REG + 1];
 	unsigned int writes;
 	int read_error;
+	int write_error;
 	bool ignore_write;
 };
 
@@ -25,6 +26,8 @@ static int sc8541_test_write(void *context, unsigned int reg, unsigned int val)
 {
 	struct sc8541_test *f = context;
 
+	if (f->write_error)
+		return f->write_error;
 	f->writes++;
 	if (!f->ignore_write)
 		f->regs[reg] = val;
@@ -156,7 +159,49 @@ static void sc8541_mode_waits_for_stop_confirmation_test(struct kunit *test)
 		POWER_SUPPLY_CHARGE_TYPE_BYPASS), 0);
 }
 
+static void sc8541_current_limit_rounding_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+	union power_supply_propval value;
+	const int requested[] = { 2950000, 500000, 8000000 };
+	const int expected[] = { 2750000, 1000000, 7000000 };
+	int n;
+
+	for (n = 0; n < ARRAY_SIZE(requested); n++) {
+		KUNIT_ASSERT_EQ(test, sc8541_test_set(f,
+			POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, requested[n]), 0);
+		KUNIT_ASSERT_EQ(test, power_supply_get_property(f->sc.psy,
+			POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &value), 0);
+		KUNIT_EXPECT_EQ(test, value.intval, expected[n]);
+		KUNIT_EXPECT_EQ(test,
+			(f->regs[SC8541_BUSOCP] & 0x1f) * SC8541_BUSOCP_STEP_MA +
+			SC8541_BUSOCP_OFFSET_MA, expected[n] / 1000);
+	}
+}
+
+static void sc8541_current_limit_write_error_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+	union power_supply_propval value;
+
+	KUNIT_ASSERT_EQ(test, sc8541_test_set(f,
+		POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, 3000000), 0);
+	f->write_error = -EREMOTEIO;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f,
+		POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, 2950000), -EREMOTEIO);
+	KUNIT_ASSERT_EQ(test, power_supply_get_property(f->sc.psy,
+		POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &value), 0);
+	KUNIT_EXPECT_EQ(test, value.intval, 3000000);
+	f->write_error = 0;
+	f->ignore_write = true;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f,
+		POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, 2950000), -EIO);
+	KUNIT_EXPECT_EQ(test, f->sc.busocp_ma, 3000);
+}
+
 static struct kunit_case sc8541_test_cases[] = {
+	KUNIT_CASE(sc8541_current_limit_rounding_test),
+	KUNIT_CASE(sc8541_current_limit_write_error_test),
 	KUNIT_CASE(sc8541_conversion_modes_test),
 	KUNIT_CASE(sc8541_mode_requires_stopped_stage_test),
 	KUNIT_CASE(sc8541_mode_readback_error_test),
