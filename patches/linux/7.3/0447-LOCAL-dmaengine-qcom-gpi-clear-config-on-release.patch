+	write_lock_irq(&gpii->pm_lock);
+	gpii->pm_state = PREPARE_TERMINATE;
+	for (i = 0; i < MAX_CHANNELS_PER_GPII; i++)
+		gpii->gchan[i].pm_state = PREPARE_TERMINATE;
+	/* Publish the retained channel state to gpi_find_avail_gpii(). */
+	smp_store_release(&gpii->unusable, true);
+	write_unlock_irq(&gpii->pm_lock);
+	dev_err(gpii->gpi_dev->dev, "GPII %u disabled; retaining DMA rings\n",
+		gpii->gpii_id);
+}
