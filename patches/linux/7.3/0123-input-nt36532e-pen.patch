From a2644bfc0106c20a3e4b9b62043b70adbf802b34 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sun, 15 Nov 2026 01:11:01 +0800
Subject: [PATCH] Input: nt36532e: decode pen frames and fuse Bluetooth samples

Validate both checksums before decoding the four pen scan planes. Remove
each scan group's median baseline and calculate the centroid from the
strongest local signal within one group. Load the LCD-ID-specific mapping
and tilt calibration through the firmware loader.

Pair the touchscreen samples with timestamped pressure and button
reports from hid-xiaomi. Report a physical tablet tool with the pressure
range for the connected pen and reject ambiguous simultaneous radios.
Release the tool across disconnect, suspend and firmware recovery.

Keep the last valid tilt only while the tool stays in proximity. Retry
unacknowledged scan stops before selecting a different pen model; a
failure to set up the pen dock must not prevent finger input.
---
 drivers/hid/hid-xiaomi.c                      |  41 +-
 drivers/input/touchscreen/nt36532e/Makefile   |   2 +-
 .../touchscreen/nt36532e/nt36xxx-pen-input.c  | 600 ++++++++++++++++++
 .../input/touchscreen/nt36532e/nt36xxx-pen.c  | 500 +++++++++++++++
 .../input/touchscreen/nt36532e/nt36xxx-pen.h  |  29 +
 drivers/input/touchscreen/nt36532e/nt36xxx.c  |  83 ++-
 drivers/input/touchscreen/nt36532e/nt36xxx.h  |   5 +
 include/linux/input/xiaomi-pen.h              |  38 ++
 8 files changed, 1285 insertions(+), 13 deletions(-)
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx-pen-input.c
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx-pen.c
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx-pen.h
 create mode 100644 include/linux/input/xiaomi-pen.h

diff --git a/drivers/hid/hid-xiaomi.c b/drivers/hid/hid-xiaomi.c
index 48c0c927b..6b0fb1a1b 100644
--- a/drivers/hid/hid-xiaomi.c
+++ b/drivers/hid/hid-xiaomi.c
@@ -9,6 +9,8 @@
 #include <linux/module.h>
 #include <linux/hid.h>
 #include <linux/input.h>
+#include <linux/input/xiaomi-pen.h>
+#include <linux/ktime.h>
 #include <linux/slab.h>
 #include <linux/unaligned.h>
 
@@ -97,6 +99,20 @@ struct xiaomi_pen {
 	unsigned int pressure_max;
 };
 
+static ATOMIC_NOTIFIER_HEAD(xiaomi_pen_notifiers);
+
+int xiaomi_pen_register_notifier(struct notifier_block *notifier)
+{
+	return atomic_notifier_chain_register(&xiaomi_pen_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(xiaomi_pen_register_notifier);
+
+void xiaomi_pen_unregister_notifier(struct notifier_block *notifier)
+{
+	atomic_notifier_chain_unregister(&xiaomi_pen_notifiers, notifier);
+}
+EXPORT_SYMBOL_GPL(xiaomi_pen_unregister_notifier);
+
 static bool xiaomi_is_pen(struct hid_device *hdev)
 {
 	return hdev->bus == BUS_BLUETOOTH &&
@@ -230,6 +246,8 @@ static int xiaomi_pen_init(struct hid_device *hdev)
 	input_set_drvdata(input, pen);
 	/* BLE has no coordinates or proximity; do not advertise a tablet tool. */
 	input_set_abs_params(input, ABS_PRESSURE, 0, pen->pressure_max, 0, 0);
+	input_set_capability(input, EV_KEY, BTN_STYLUS);
+	input_set_capability(input, EV_KEY, BTN_STYLUS2);
 	hid_set_drvdata(hdev, pen);
 	return 0;
 }
@@ -238,9 +256,28 @@ static int xiaomi_raw_event(struct hid_device *hdev, struct hid_report *report,
 			    u8 *data, int size)
 {
 	struct xiaomi_pen *pen = hid_get_drvdata(hdev);
+	struct xiaomi_pen_report sample;
 	unsigned int pressure;
 
-	if (!pen || !xiaomi_pen_pressure_report(report))
+	if (!pen)
+		return 0;
+	sample.input = pen->pressure;
+	sample.timestamp_ns = ktime_get_boottime_ns();
+	if (report->type == HID_INPUT_REPORT && size == 2 &&
+	    data[0] == 2 && report->maxfield == 1 &&
+	    xiaomi_p81c_body_keys(report, report->field[0])) {
+		bool pro = hdev->product == BT_DEVICE_ID_XIAOMI_P81C;
+
+		sample.value = data[1];
+		atomic_notifier_call_chain(&xiaomi_pen_notifiers, XIAOMI_PEN_BUTTONS, &sample);
+		input_report_key(pen->pressure, BTN_STYLUS,
+				 data[1] == (pro ? 0x6e : 0x4e));
+		input_report_key(pen->pressure, BTN_STYLUS2,
+				 data[1] == (pro ? 0x58 : 0x4b));
+		input_sync(pen->pressure);
+		return 0;
+	}
+	if (!xiaomi_pen_pressure_report(report))
 		return 0;
 	/* HID core pads short reports. Never interpret that padding as release. */
 	if (size != 15 || data[0] != 5)
@@ -249,6 +286,8 @@ static int xiaomi_raw_event(struct hid_device *hdev, struct hid_report *report,
 	if (pressure > pen->pressure_max)
 		return 0;
 
+	sample.value = pressure;
+	atomic_notifier_call_chain(&xiaomi_pen_notifiers, XIAOMI_PEN_PRESSURE, &sample);
 	input_report_abs(pen->pressure, ABS_PRESSURE, pressure);
 	input_sync(pen->pressure);
 	/* Keep the unchanged report available to existing hidraw consumers. */
