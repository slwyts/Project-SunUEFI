 		qphy_checkbits(pcs, cfg->regs[QPHY_PCS_POWER_DOWN_CONTROL], cfg->pwrdn_ctrl);
@@ -5712,6 +5710,8 @@ static int qmp_pcie_init(struct phy *phy)
 		goto err_disable_clks;
 	}
 
+	PIANO_MARK(qmp->dev, "PHY supplies and clocks on (skip_init=%d)", qmp->skip_init);
+
 	return 0;
 
