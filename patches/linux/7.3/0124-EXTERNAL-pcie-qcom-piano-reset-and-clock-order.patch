@@ -1081,7 +1077,8 @@ static int qcom_pcie_get_resources_2_7_0(struct qcom_pcie *pcie)
 	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(res->supplies),
 				      res->supplies);
 	if (ret)
-		return ret;
+		return dev_err_probe(dev, ret,
+				     "missing or unresolved vdda/vddpe-3v3 supplies\n");
 
 	res->num_clks = devm_clk_bulk_get_all(dev, &res->clks);
 	if (res->num_clks < 0) {
@@ -1092,6 +1089,80 @@ static int qcom_pcie_get_resources_2_7_0(struct qcom_pcie *pcie)
