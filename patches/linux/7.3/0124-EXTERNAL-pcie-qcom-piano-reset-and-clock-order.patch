-			failed_port = port;
 			goto err_exit_phy;
 		}
 	}
@@ -495,11 +494,8 @@ static int qcom_pcie_phy_init(struct qcom_pcie *pcie)
 	return 0;
 
 err_exit_phy:
-	list_for_each_entry(port, &pcie->ports, list) {
-		if (port == failed_port)
-			break;
+	list_for_each_entry_continue_reverse(port, &pcie->ports, list)
 		phy_exit(port->phy);
