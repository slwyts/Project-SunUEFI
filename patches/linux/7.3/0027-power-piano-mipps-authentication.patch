+/*
+ * MiPPS challenge/response from xiaomi-mipps-auth, with Piano's stock
+ * command order. The transport and charging policy remain in this driver.
+ */
+static int piano_mca_vdm(struct piano_mca *mca, unsigned int generation,
+			 unsigned int cmd, const u8 *bytes, u32 flag)
+{
+	__le32 payload[MCA_VDM_LEN / 4] = {};
+	unsigned long deadline;
+	size_t len = sizeof(payload[0]);
+	__le32 state, vbus;
+	int attempt, i, ret;
+
+	if (bytes) {
+		for (i = 0; i < ARRAY_SIZE(payload); i++)
+			payload[i] = cpu_to_le32(get_unaligned_be32(bytes + 4 * i));
+		len = sizeof(payload);
+	} else {
+		payload[0] = cpu_to_le32(flag);
+	}
+
+	/* Stock batterysecret retries an unanswered command once. */
+	for (attempt = 0; attempt < 2; attempt++) {
+		if (generation != READ_ONCE(mca->pdr_generation))
+			return -ENODEV;
+		ret = piano_mca_write(mca, MCA_PROP_VDM_BASE + cmd - 1,
+				      payload, len);
+		if (ret)
+			return ret;
+		msleep(cmd == 4 || cmd == 5 ? 500 : 5);
+		deadline = jiffies + msecs_to_jiffies(1000);
+		do {
+			if (generation != READ_ONCE(mca->pdr_generation))
+				return -ENODEV;
+			ret = piano_mca_read(mca, MCA_PROP_BUS_VOLT, &vbus, sizeof(vbus));
+			if (ret || le32_to_cpu(vbus) < MCA_VBUS_ONLINE_UV)
+				return ret ?: -ENODEV;
+			ret = piano_mca_read(mca, MCA_PROP_UVDM_STATE, &state, sizeof(state));
+			if (ret)
+				return ret;
+			if (le32_to_cpu(state) == cmd)
+				return 0;
+			msleep(20);
+		} while (time_before(jiffies, deadline));
+	}
+	return -ETIMEDOUT;
+}
+
+static bool piano_mca_mipps_digest(struct piano_mca *mca,
+				  const struct piano_mipps_key *key,
+				  u8 message[20], const u8 response[MCA_VDM_LEN],
+				  u8 digest[SHA256_DIGEST_SIZE], u32 *adapter_id,
+				  unsigned int generation)
+{
+	struct hmac_sha256_key prepared;
+	u32 id;
+	bool matched = false;
+
+	hmac_sha256_preparekey(&prepared, key->key, sizeof(key->key));
+	put_unaligned_be32(*adapter_id, message + MCA_VDM_LEN);
+	hmac_sha256(&prepared, message, 20, digest);
+	if (*adapter_id && !memcmp(response, digest, MCA_VDM_LEN)) {
+		matched = true;
+		goto out;
+	}
+
+	/*
+	 * Firmware can omit or retain an old ID. Recover it only from a valid
+	 * answer to our fresh random challenge, never from a cached identity.
+	 * Limit work to 65536 guesses; reported 32-bit IDs are checked above.
+	 * No match simply leaves this source on ordinary PD/PPS.
+	 */
+	for (id = 0; id < 65536; id++) {
+		if (!(id & 255)) {
+			if (generation != READ_ONCE(mca->pdr_generation))
+				break;
+			cond_resched();
+		}
+		put_unaligned_be32(id, message + MCA_VDM_LEN);
+		hmac_sha256(&prepared, message, 20, digest);
+		if (!memcmp(response, digest, MCA_VDM_LEN)) {
+			*adapter_id = id;
+			matched = true;
+			break;
+		}
+	}
+ out:
+	memzero_explicit(&prepared, sizeof(prepared));
+	return matched;
+}
+
+static void piano_mca_mipps_authenticate(struct piano_mca *mca)
+{
+	struct piano_mca_pdo pdos[MCA_PD_MAX_PDOS];
+	const struct piano_mipps_key *key;
+	u8 message[20], digest[SHA256_DIGEST_SIZE], response[MCA_VDM_LEN];
+	__le32 words[MCA_VDM_LEN / 4], version, vbus;
+	unsigned int generation = READ_ONCE(mca->pdr_generation);
+	u32 adapter_id;
+	bool discovered = false, capable = false;
+	int i, ret;
+
+	if (!mipps_auth || mca->mipps_attempted || piano_mca_authenticated(mca) ||
+	    mca->hv != MCA_HV_OFF || mca->cp != MCA_CP_OFF ||
+	    (mca->real_type != MCA_TYPE_PD &&
+	     mca->real_type != MCA_TYPE_PD_VERIFY &&
+	     mca->real_type != MCA_TYPE_PD_PPS))
+		return;
+	if (piano_mca_read(mca, MCA_PROP_PDOS, pdos, sizeof(pdos)))
+		return;
+	for (i = 0; i < MCA_PD_MAX_PDOS; i++)
+		capable |= le32_to_cpu(pdos[i].max_mv) > 5000;
+	if (!capable)
+		return;
+
+	mca->mipps_attempted = true;
+	ret = piano_mca_write_u32(mca, MCA_PROP_VERIFY_PROCESS, 1);
+	if (ret)
+		goto out;
+
+	/* A Xiaomi VDM query works as UFP too. Never swap PC/hub data roles. */
+	ret = piano_mca_vdm(mca, generation, 1, NULL, 0);
+	if (ret)
+		goto finish;
+	ret = piano_mca_read(mca, MCA_PROP_VDM_VERSION, &version, sizeof(version));
+	if (ret || !le32_to_cpu(version) || le32_to_cpu(version) == U32_MAX) {
+		ret = ret ?: -ENODEV;
+		goto finish;
+	}
+	discovered = true;
+	ret = piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 0);
+	if (ret)
+		goto finish;
+	for (i = 2; i <= 3; i++) {
+		ret = piano_mca_vdm(mca, generation, i, NULL, 0);
+		if (ret)
+			goto finish;
+	}
+
+	key = &piano_mipps_keys[get_random_u32_below(ARRAY_SIZE(piano_mipps_keys))];
+	get_random_bytes(message, MCA_VDM_LEN);
+	ret = piano_mca_vdm(mca, generation, 4, key->seed, 0);
+	if (ret)
+		goto finish;
+	ret = piano_mca_vdm(mca, generation, 5, message, 0);
+	if (ret)
+		goto finish;
+	ret = piano_mca_read(mca, MCA_PROP_VDM_AUTH, words, sizeof(words));
+	if (ret)
+		goto finish;
+	for (i = 0; i < ARRAY_SIZE(words); i++)
+		put_unaligned_be32(le32_to_cpu(words[i]), response + 4 * i);
+	adapter_id = piano_mca_read_u32(mca, MCA_PROP_ADAPTER_ID);
+	if (!piano_mca_mipps_digest(mca, key, message, response, digest,
+				    &adapter_id, generation)) {
+		ret = -EKEYREJECTED;
+		goto finish;
+	}
+
+	/* Piano batterysecret sends 7 then 6. Command 8 stalls this firmware. */
+	ret = piano_mca_vdm(mca, generation, 7, NULL, 1);
+	ret = ret ?: piano_mca_vdm(mca, generation, 6, NULL, 1);
+	if (ret)
+		goto finish;
+	ret = piano_mca_read(mca, MCA_PROP_BUS_VOLT, &vbus, sizeof(vbus));
+	if (ret || le32_to_cpu(vbus) < MCA_VBUS_ONLINE_UV ||
+	    generation != READ_ONCE(mca->pdr_generation)) {
+		ret = ret ?: -ENODEV;
+		goto finish;
+	}
+	ret = piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 1);
+	if (!ret) {
+		mca->auth_generation = generation;
+		mca->auth_ok = true;
+		mca->auth_at = jiffies;
+		mca->auth_tried = false;
+	}
+ finish:
+	if (generation == READ_ONCE(mca->pdr_generation)) {
+		if (ret && discovered) {
+			piano_mca_write_u32(mca, MCA_PROP_PD_VERIFIED, 0);
+			piano_mca_vdm(mca, generation, 7, NULL, 0);
+		}
+		piano_mca_write_u32(mca, MCA_PROP_VERIFY_PROCESS, 0);
+	}
+	memzero_explicit(message, sizeof(message));
+	memzero_explicit(digest, sizeof(digest));
+	memzero_explicit(response, sizeof(response));
+ out:
+	if (!ret)
+		dev_info(mca->dev, "MiPPS adapter %08x authenticated\n", adapter_id);
+	else if (discovered)
+		dev_info(mca->dev,
+			 "MiPPS authentication failed (%d); using standard PD/PPS\n", ret);
+	power_supply_changed(mca->usb);
+}
