 		return 0;
 
 	ret = piano_mca_read(mca, MCA_PROP_PD_STATE, &val, sizeof(val));
@@ -1213,7 +1431,7 @@ static int piano_mca_request_volt(struct piano_mca *mca, u32 mv)
  */
