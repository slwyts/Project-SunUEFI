-	return mipps_auth &&
+	return mipps_auth && piano_mca_authenticated(mca) &&
 	       piano_mca_read_u32(mca, MCA_PROP_PD_VERIFIED) == 1;
 }
 
@@ -1527,7 +1745,7 @@ static bool piano_mca_cp_after_auth(struct piano_mca *mca)
 	if (!mipps_auth || mca->hv == MCA_HV_REQUESTED ||
 	    mca->vbus_uv >= MCA_HV_VBUS_5V_MAX_UV)
 		return false;
-	if (mca->auth_ok && time_after(mca->cp_on_at, mca->auth_at))
+	if (piano_mca_authenticated(mca) && time_after(mca->cp_on_at, mca->auth_at))
 		return true;
 	if (piano_mca_auth_pending(mca) && mca->auth_tried)
 		return false;
@@ -1585,7 +1803,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca)
 	    piano_mca_read_u32(mca, MCA_PROP_VERIFY_PROCESS))
 		return;
 	/* PD requests in the middle of the authentication break it */
-	if (mipps_auth && !mca->auth_ok &&
+	if (mipps_auth && !piano_mca_authenticated(mca) &&
 	    time_before(jiffies, mca->cp_on_at +
 				 msecs_to_jiffies(MCA_CP_AUTH_WAIT_MS)))
 		return;
@@ -1855,8 +2073,10 @@ static void piano_mca_poll(struct work_struct *work)
 	if (online && !mca->online) {
 		/* away longer than a reset takes: another attach */
 		if (time_after(jiffies, mca->cp_off_at +
-				msecs_to_jiffies(MCA_CP_DROP_FORGET_MS)))
+				msecs_to_jiffies(MCA_CP_DROP_FORGET_MS))) {
 			mca->auth_ok = false;
+			mca->mipps_attempted = false;
+		}
 		mca->cp_on_at = jiffies;
 		/* a voltage change under way breaks the identity exchange */
 		if (mipps_auth)
@@ -1887,6 +2107,15 @@ static void piano_mca_poll(struct work_struct *work)
 	mutex_unlock(&mca->pen_boost_lock);
 
 	if (!online) {
+		/* UCSI ONLINE follows the connector, not VBUS. Preserve an
+		 * authentication reset only while its cable remains connected.
