+pwrseq_qcom_wcn_set_ol_cpr(struct device *consumer,
+			   const struct pwrseq_qcom_wcn_pmu_param *params,
+			   size_t num_params)
+{
+	return -EOPNOTSUPP;
+}
+#endif
