+static void piano_mca_skin_high_load_hysteresis_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct { int temp; u32 ma; } rows[] = {
+		{ 34999, 8000 }, { 35000, 8000 }, { 37000, 8000 },
+		{ 39000, 4400 }, { 40000, 3600 }, { 44000, 2000 },
+		{ 45000, 700 }, { 44001, 700 }, { 44000, 2000 },
+		{ 42001, 2000 }, { 42000, 3600 }, { 39001, 3600 },
+		{ 39000, 4400 }, { 37001, 4400 }, { 37000, 8000 },
+		{ 35000, 8000 }, { 32000, 8000 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rows); i++)
+		KUNIT_EXPECT_EQ(test, piano_mca_skin_current(&f->mca, rows[i].temp),
+				rows[i].ma);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_flags, 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_current(&f->mca, 50000), 700U);
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_current(&f->mca, 25000), 8000U);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_flags, 0);
+}
