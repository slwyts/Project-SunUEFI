+	f->mca.skin_limit_ma = piano_mca_skin_current(&f->mca, 45000);
+	f->mca.vbus_uv = 5000000;
+	KUNIT_ASSERT_EQ(test, piano_mca_normal_buck(&f->mca, &tbat, 1, 0), 0);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 700U);
+	KUNIT_EXPECT_EQ(test, f->mca.charge_limit_ua, 8000000U);
