+static int piano_mca_test_iio_type(struct iio_channel *channel, enum iio_chan_type *type)
+{
+	struct piano_mca_test_iio *input = channel->data;
+
+	*type = input->type;
+	return 0;
+}
+
+static int piano_mca_test_iio_read(struct iio_channel *channel, int *value)
+{
+	struct piano_mca_test_iio *input = channel->data;
+
+	if (input->error)
+		return input->error;
+	*value = input->temp_mc;
+	return 0;
+}
