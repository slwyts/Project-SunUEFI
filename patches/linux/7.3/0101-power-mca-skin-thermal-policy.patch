+static void piano_mca_skin_normal_buck_fcc_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	static const struct { u32 type; int vbus; u32 fcc; } rows[] = {
+		{ MCA_TYPE_DCP, 5000000, 1200 },
+		{ MCA_TYPE_PD, 5000000, 1200 },
+		{ MCA_TYPE_PD, 9000000, 2000 },
+		{ MCA_TYPE_PD_PPS, 9000000, 2000 },
