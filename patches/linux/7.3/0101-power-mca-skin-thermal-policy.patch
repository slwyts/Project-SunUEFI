+	int i, tbat;
+
+	piano_mca_skin_limits_prepare(test);
+	f->mca.skin_limit_ma = piano_mca_skin_current(&f->mca, 44000);
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		f->mca.real_type = rows[i].type;
+		f->mca.vbus_uv = rows[i].vbus;
+		KUNIT_ASSERT_EQ(test, piano_mca_normal_buck(&f->mca, &tbat, 1, 0), 0);
+		KUNIT_EXPECT_EQ(test, f->fcc_ma, rows[i].fcc);
+		KUNIT_EXPECT_TRUE(test, f->pmic_enabled);
