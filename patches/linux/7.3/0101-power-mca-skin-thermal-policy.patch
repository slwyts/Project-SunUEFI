+#undef iio_read_channel_processed
+#undef iio_get_channel_type
 
 struct piano_mca_test_gauge {
 	int voltage_uv;
@@ -37,8 +51,16 @@ struct piano_mca_test_gauge {
 	int charge_error;
 };
 
+struct piano_mca_test_iio {
+	int temp_mc, error, releases;
+	enum iio_chan_type type;
+};
+
 struct piano_mca_test {
 	struct piano_mca mca;
+	struct iio_channel skin_channels[6];
+	struct piano_mca_test_iio skin_input[6];
+	int skin_get_error;
 	atomic_t work_runs;
 	struct completion blocker_started, blocker_release;
 	bool block_once;
@@ -3088,7 +3110,314 @@ static void piano_mca_full_skips_active_cp_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_ON);
 }
 
+static struct iio_channel *piano_mca_test_iio_get(struct device *dev, const char *name)
+{
+	struct piano_mca *mca = dev_get_drvdata(dev);
+	struct piano_mca_test *f = container_of(mca, struct piano_mca_test, mca);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_skin_channels); i++) {
+		if (!strcmp(name, piano_mca_skin_channels[i])) {
+			if (f->skin_get_error == i + 1)
+				return ERR_PTR(-EPROBE_DEFER);
+			return &f->skin_channels[i];
+		}
+	}
+	return ERR_PTR(-ENODEV);
+}
