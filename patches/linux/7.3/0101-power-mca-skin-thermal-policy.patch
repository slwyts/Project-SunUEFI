+static void piano_mca_skin_weighted_model_test(struct kunit *test)
+{
+	int temp[] = { 25000, 25000, 25000, 25000, 25000, 25000 };
+	int normal;
+
+	/* The calibrated denominator is 1000, despite weights adding to 943. */
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 25440);
+	normal = piano_mca_skin_temperature(temp);
+	temp[3] = 45000;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), normal - 184);
+	memset(temp, 0, sizeof(temp));
+	temp[3] = 1;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 1600);
+}
+
+static void piano_mca_skin_original_battery_test(struct kunit *test)
+{
+	int temp[] = { 25000, 30000, 25000, 25000, 25000, 25000 };
+
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 27940);
+	temp[0] = 18000;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 21940);
+	temp[0] = 18001;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 27940);
+	temp[0] = 100001;
+	temp[1] = 110000;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_temperature(temp), 62941);
+}
