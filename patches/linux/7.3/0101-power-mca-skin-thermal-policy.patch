index 71bad9b08..089afbf07 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -37,6 +37,7 @@
 #include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/hex.h>
+#include <linux/iio/consumer.h>
 #include <linux/module.h>
 #include <linux/math64.h>
 #include <linux/mutex.h>
@@ -162,6 +163,7 @@ static const char * const mca_real_type_names[MCA_TYPE_MAX] = {
 /* VBUS above this means a source is attached (USB default is 5 V) */
 #define MCA_VBUS_ONLINE_UV	4000000
 #define MCA_POLL_MS		3000
+#define MCA_SKIN_POLL_MS	2000
 
 /* Input current limits (mA) set by charge_policy, from the stock tables */
 #define MCA_ICL_MIN_MA		100	/* also the ADSP power-on value */
@@ -497,6 +499,12 @@ struct piano_mca {
 	u32 *cooling_limits_ua;
 	unsigned int cooling_count;
 	unsigned long cooling_state;
+	struct iio_channel *skin_channels[6];
+	u32 skin_limit_ma;
+	int skin_temp_mc, skin_error;
+	unsigned long skin_sample_at;
+	u8 skin_flags;
+	bool skin_control;
 	bool policy_ready;
 	bool policy_stopped;
 	bool policy_suspended;
@@ -586,13 +594,18 @@ struct piano_mca {
 	int dbg_ret;
 };
 
-/* The cooling device and power-supply limit constrain the same total budget. */
+static int piano_mca_update_skin(struct piano_mca *mca);
+static u32 piano_mca_skin_buck_current(struct piano_mca *mca);
+
+/* Skin, the cooling device and power-supply limit share one total budget. */
 static u32 piano_mca_charge_limit(struct piano_mca *mca)
 {
 	u32 ua = READ_ONCE(mca->charge_limit_ua);
 
 	if (mca->cooling_count)
 		ua = min(ua, mca->cooling_limits_ua[READ_ONCE(mca->cooling_state)]);
+	if (mca->skin_control)
+		ua = min(ua, READ_ONCE(mca->skin_limit_ma) * 1000);
 	return ua / 1000;
 }
 
@@ -2343,6 +2356,7 @@ static int piano_mca_normal_buck(struct piano_mca *mca, int *tbat,
 	fv = min(piano_mca_jeita[cool].fv, piano_mca_jeita[warm].fv);
 	ma = min3(ma, piano_mca_jeita[cool].ma, piano_mca_jeita[warm].ma);
 	ma = min_t(u32, ma, piano_mca_charge_limit(mca));
+	ma = min_t(u32, ma, piano_mca_skin_buck_current(mca));
 	ret = piano_mca_normal_termination(mca, vbat, ibat, fv, generation, connection);
 	pause = piano_mca_normal_voltage_stop(mca, vbat, fv) ||
 		ret || mca->normal_full ||
@@ -2449,7 +2463,8 @@ static int piano_mca_cp_set_buck(struct piano_mca *mca, u32 icl_ma,
 {
 	int ret;
 
-	fcc_ma = min(fcc_ma, piano_mca_charge_limit(mca));
+	fcc_ma = min3(fcc_ma, piano_mca_charge_limit(mca),
+		      piano_mca_skin_buck_current(mca));
 	if (fcc_ma < MCA_FCC_MIN_MA)
 		return -ERANGE;
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_ICL, icl_ma,
@@ -3080,6 +3095,8 @@ static void piano_mca_poll(struct work_struct *work)
 	}
 	mca->online = online;
 	mca->real_type = real_type;
+	if (piano_mca_update_skin(mca))
+		goto requeue;
 
 	/* Restore an in-use pen rail after ADSP restarts. Its consumer will
 	 * stop the transmitter on a communication error in the meantime.
@@ -3164,12 +3181,16 @@ static void piano_mca_poll(struct work_struct *work)
 				       mca->polled_connection_generation);
 
 requeue:
-	if (mca->service_up || mca->cp == MCA_CP_STOPPING)
+	if (mca->service_up || mca->cp == MCA_CP_STOPPING) {
+		int interval = mca->skin_control ? MCA_SKIN_POLL_MS : MCA_POLL_MS;
+
+		if (piano_mca_cp_active(mca))
+			interval = min(interval, MCA_CP_POLL_MS);
+		if (mca->normal_term_count)
+			interval = min(interval, MCA_NORMAL_TERM_POLL_MS);
 		queue_delayed_work(system_freezable_wq, &mca->poll,
-				   msecs_to_jiffies(piano_mca_cp_active(mca) ?
-						    MCA_CP_POLL_MS :
-						    mca->normal_term_count ?
-						    MCA_NORMAL_TERM_POLL_MS : MCA_POLL_MS));
+				   msecs_to_jiffies(interval));
+	}
 unlock:
 	mutex_unlock(&mca->policy_lock);
 }
@@ -3234,6 +3255,188 @@ static int piano_mca_update_charge_limit(struct piano_mca *mca, u32 old_ma)
 	return ret;
 }
 
+/* The factory high-load profile has its own hysteresis at every threshold. */
+static const struct {
+	int trigger_mc, clear_mc;
+	u32 ma, buck_5v_ma, buck_9v_ma;
+} piano_mca_skin_limits[] = {
+	{ 35000, 32000, 10500, 1800, 3500 },
+	{ 37000, 35000,  9000, 1800, 3500 },
+	{ 39000, 37000,  4400, 1800, 3500 },
+	{ 40000, 39000,  3600, 1700, 3500 },
+	{ 44000, 42000,  2000, 1200, 2000 },
+	{ 45000, 44000,   700, 1000,  700 },
+};
+
+static const char * const piano_mca_skin_channels[] = {
+	"battery0", "battery1", "quiet-therm", "charger-therm",
+	"wifi-therm", "cpu-therm",
+};
+
+static int piano_mca_skin_temperature(const int *temp)
+{
+	int cold = min(temp[0], temp[1]), hot = max(temp[0], temp[1]);
+	int battery = cold > 18000 && cold <= 100000 ? hot : cold;
+	s64 weighted;
+
+	/* Board channels used Q10 temperatures in the factory calibration. */
+	weighted = 500LL * battery +
+		   131LL * div_s64((s64)temp[2] * 1024, 1000) -
+		     9LL * div_s64((s64)temp[3] * 1024, 1000) +
+		    89LL * div_s64((s64)temp[4] * 1024, 1000) +
+		   232LL * div_s64((s64)temp[5] * 1024, 1000);
+	return div_s64(weighted, 1000) + 1600;
+}
+
+static u32 piano_mca_skin_current(struct piano_mca *mca, int temp)
+{
+	u32 ma = MCA_CP_IBAT_MAX_MA;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_skin_limits); i++) {
+		if (temp >= piano_mca_skin_limits[i].trigger_mc)
+			mca->skin_flags |= BIT(i);
+		else if (temp <= piano_mca_skin_limits[i].clear_mc)
+			mca->skin_flags &= ~BIT(i);
+	}
+	for (i = 0; i < ARRAY_SIZE(piano_mca_skin_limits); i++) {
+		if (!(mca->skin_flags & BIT(i)))
+			break;
+		ma = min(ma, piano_mca_skin_limits[i].ma);
+	}
+	return ma;
+}
+
+/* The PMIC has separate thermal FCC columns at 5 V and high input voltage. */
+static u32 piano_mca_skin_buck_current(struct piano_mca *mca)
+{
+	u32 ma = U32_MAX;
+	int i;
+
+	if (!mca->skin_control)
+		return ma;
+	for (i = 0; i < ARRAY_SIZE(piano_mca_skin_limits); i++) {
+		if (!(mca->skin_flags & BIT(i)))
+			break;
+		ma = min(ma, mca->vbus_uv > 6000000 ?
+			 piano_mca_skin_limits[i].buck_9v_ma :
+			 piano_mca_skin_limits[i].buck_5v_ma);
+	}
+	return ma;
+}
+
+static void piano_mca_skin_release(void *data)
+{
+	struct piano_mca *mca = data;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(mca->skin_channels); i++) {
+		if (mca->skin_channels[i]) {
+			iio_channel_release(mca->skin_channels[i]);
+			mca->skin_channels[i] = NULL;
+		}
+	}
+}
+
+static int piano_mca_skin_read(struct piano_mca *mca, int *skin)
+{
+	struct iio_channel *channel;
+	enum iio_chan_type type;
+	int temp[ARRAY_SIZE(piano_mca_skin_channels)], i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_skin_channels); i++) {
+		if (!mca->skin_channels[i]) {
+			channel = iio_channel_get(mca->dev, piano_mca_skin_channels[i]);
+			if (IS_ERR(channel)) {
+				ret = PTR_ERR(channel);
+				goto failed;
+			}
+			mca->skin_channels[i] = channel;
+			ret = iio_get_channel_type(channel, &type);
+			if (ret)
+				goto failed;
+			if (type != IIO_TEMP) {
+				ret = -EINVAL;
+				goto failed;
+			}
+		}
+		ret = iio_read_channel_processed(mca->skin_channels[i], &temp[i]);
+		if (ret < 0)
+			goto failed;
+	}
+	*skin = piano_mca_skin_temperature(temp);
+	return 0;
+
+failed:
+	/* Reacquire after a provider is rebound, instead of keeping a dead device. */
+	piano_mca_skin_release(mca);
+	return ret;
+}
+
+/* Called under policy_lock, before either normal or direct charge is applied. */
+static int piano_mca_update_skin(struct piano_mca *mca)
+{
+	u32 old_ma;
+	int temp, ret;
+
+	if (!mca->skin_control)
+		return 0;
+	old_ma = piano_mca_charge_limit(mca);
+	ret = piano_mca_skin_read(mca, &temp);
+	mca->skin_error = ret;
+	if (ret) {
+		mca->skin_limit_ma = 0;
+		dev_warn_ratelimited(mca->dev,
+				     "skin temperature unavailable, charging paused: %d\n", ret);
+	} else {
+		mca->skin_temp_mc = temp;
+		mca->skin_sample_at = jiffies;
+		mca->skin_limit_ma = piano_mca_skin_current(mca, temp);
+	}
+	if (piano_mca_charge_limit(mca) < old_ma)
+		return piano_mca_update_charge_limit(mca, old_ma);
+	return 0;
+}
+
+static int piano_mca_skin_get_temp(struct thermal_zone_device *zone, int *temp)
+{
+	struct piano_mca *mca = thermal_zone_device_priv(zone);
+
+	guard(mutex)(&mca->policy_lock);
+	if (mca->skin_error)
+		return mca->skin_error;
+	/* Transport failures can prevent the policy worker from taking a sample. */
+	if (time_after(jiffies, mca->skin_sample_at +
+			      msecs_to_jiffies(2 * MCA_SKIN_POLL_MS)))
+		return -EAGAIN;
+	*temp = mca->skin_temp_mc;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops piano_mca_skin_ops = {
+	.get_temp = piano_mca_skin_get_temp,
+};
+
+static int piano_mca_register_skin(struct piano_mca *mca)
+{
+	struct thermal_zone_device *zone;
+	int ret;
+
+	if (!charge_policy || !charge_current || !cp_charge ||
+	    device_property_match_string(mca->dev, "io-channel-names", "battery0") < 0)
+		return 0;
+	mca->skin_control = true;
+	mca->skin_error = -EAGAIN;
+	/* Register before poll-stop; channels can be acquired later by the worker. */
+	ret = devm_add_action_or_reset(mca->dev, piano_mca_skin_release, mca);
+	if (ret)
+		return ret;
+	if (!device_property_present(mca->dev, "#thermal-sensor-cells"))
+		return 0;
+	zone = devm_thermal_of_zone_register(mca->dev, 0, mca, &piano_mca_skin_ops);
+	return PTR_ERR_OR_ZERO(zone);
+}
+
 static int piano_mca_usb_get_property(struct power_supply *psy,
 				      enum power_supply_property psp,
 				      union power_supply_propval *val)
@@ -3942,7 +4145,10 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 	ret = piano_mca_register_cooling(mca);
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to register charger cooling\n");
-	/* Stop before devres releases the cooling limits and power supply. */
+	ret = piano_mca_register_skin(mca);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to register skin temperature\n");
+	/* Stop before devres releases temperatures, cooling and power supply. */
 	ret = devm_add_action_or_reset(dev, piano_mca_stop, mca);
 	if (ret)
 		return ret;
@@ -3995,3 +4201,4 @@ module_auxiliary_driver(piano_mca_driver);
 
 MODULE_DESCRIPTION("Xiaomi MCA ADSP property transport (piano)");
 MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("IIO_CONSUMER");
diff --git a/drivers/power/supply/piano_mca_test.c b/drivers/power/supply/piano_mca_test.c
