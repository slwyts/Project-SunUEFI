+++ b/drivers/power/supply/piano_mca_test.c
@@ -5,6 +5,7 @@
 #include <linux/auxiliary_bus.h>
 #include <linux/atomic.h>
 #include <linux/kthread.h>
+#include <linux/iio/consumer.h>
 #include <linux/power_supply.h>
 #include <linux/soc/qcom/pmic_glink.h>
 
@@ -16,6 +17,15 @@ static unsigned int piano_mca_test_get_generation(struct pmic_glink_client *);
 #define pmic_glink_send_generation piano_mca_test_send_generation
 #define pmic_glink_get_generation piano_mca_test_get_generation
 
