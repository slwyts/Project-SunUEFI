+		f->mca.vbus_uv = 9000000;
+		KUNIT_EXPECT_EQ(test, piano_mca_skin_buck_current(&f->mca), high[i]);
+	}
+	f->mca.skin_control = false;
+	KUNIT_EXPECT_EQ(test, piano_mca_skin_buck_current(&f->mca), U32_MAX);
