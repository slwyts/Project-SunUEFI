+static void piano_mca_skin_preserves_user_policy_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	u32 cooling[] = { 8000000, 500000 };
+	int i;
+
+	piano_mca_skin_limits_prepare(test);
+	for (i = 0; i < ARRAY_SIZE(f->skin_input); i++)
+		f->skin_input[i].temp_mc = 55000;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_limit_ma, 700U);
+	f->mca.charge_limit_ua = 1000000;
+	f->mca.cooling_count = ARRAY_SIZE(cooling);
+	f->mca.cooling_limits_ua = cooling;
+	f->mca.cooling_state = 1;
+	f->mca.inhibit_charge = true;
+	f->mca.normal_voltage_stop = true;
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 500U);
+	for (i = 0; i < ARRAY_SIZE(f->skin_input); i++)
+		f->skin_input[i].temp_mc = 25000;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_limit_ma, 8000U);
+	KUNIT_EXPECT_EQ(test, f->mca.charge_limit_ua, 1000000U);
+	KUNIT_EXPECT_EQ(test, f->mca.cooling_state, 1UL);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 500U);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_charge);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_voltage_stop);
+	f->mca.charge_limit_ua = 0;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+}
