+static void piano_mca_skin_read_error_recovers_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int i, tbat;
+
+	piano_mca_skin_limits_prepare(test);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 8000U);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_temp_mc, 25440);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	f->skin_input[3].error = -EIO;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_error, -EIO);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	for (i = 0; i < 4; i++) {
+		KUNIT_EXPECT_PTR_EQ(test, f->mca.skin_channels[i], NULL);
+		KUNIT_EXPECT_EQ(test, f->skin_input[i].releases, 1);
+	}
+	KUNIT_ASSERT_EQ(test, piano_mca_normal_buck(&f->mca, &tbat, 1, 0), 0);
+	KUNIT_EXPECT_EQ(test, f->fv_mv, 4480U);
+	f->skin_input[3].error = 0;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 8000U);
+	KUNIT_EXPECT_EQ(test, f->mca.skin_error, 0);
+}
