+	seq_printf(m, "sensor_y: %u\n", ts->y_num);
+	seq_printf(m, "irq_enabled: %u\n", ts->irq_enabled);
+	seq_printf(m, "irqs: %llu\n", (unsigned long long)ts->thp_irq_count);
