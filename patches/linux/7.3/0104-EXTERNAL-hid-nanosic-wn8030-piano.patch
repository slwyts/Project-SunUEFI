From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: HID: add the Piano Nanosic WN8030 keyboard cover

Carry the Nanosic keyboard, touchpad and hinge interfaces used by the board.

The port retains changes from these linux-piano commits:
piano: Nanosic WN8030 keyboard cover driver with the piano variant (#17) (bluseliu50 <265648257+bluseliu50@users.noreply.github.com>)

Co-authored-by: bluseliu50 <265648257+bluseliu50@users.noreply.github.com>

Link: https://github.com/blu-sharky/linux-piano/commit/f8afe7ff7127f46f5339fdaf5c24ecbffbfbb92b
Link: https://github.com/slwyts/Project-SunUEFI/commit/e8fcf33971263f28085dbc0dbe5039438bf76c13
---
 drivers/hid/Kconfig              |   10 +-
 drivers/hid/Makefile             |    1 +
 drivers/hid/hid-nanosic-wn8030.c | 2115 ++++++++++++++++++++++++++++++
 3 files changed, 2125 insertions(+), 1 deletion(-)
 create mode 100644 drivers/hid/hid-nanosic-wn8030.c

diff --git a/drivers/hid/Kconfig b/drivers/hid/Kconfig
index c43e824428f02ec0b05ed365e7b83b45e8955e5d..f8a4298ffbb84ffdc3ed15bb7aaac8540cc5cacb 100644
--- a/drivers/hid/Kconfig
+++ b/drivers/hid/Kconfig
@@ -566,7 +566,8 @@ config HID_XIAOMI
 	tristate "Xiaomi"
 	help
 	  Adds support for side buttons of Xiaomi Mi Dual Mode Wireless
-	  Mouse Silent Edition.
+	  Mouse Silent Edition and prevents private Focus Pen Pro pressure
+	  reports from being interpreted as keyboard plus keys.
 
 config HID_GYRATION
 	tristate "Gyration remote control"
@@ -863,6 +864,13 @@ config HID_MULTITOUCH
 	  To compile this driver as a module, choose M here: the
 	  module will be called hid-multitouch.
 
+config HID_NANOSIC_WN8030
+	tristate "Nanosic WN8030 keyboard MCU"
+	depends on OF && PM && HIDRAW && I2C && GPIOLIB && LEDS_CLASS
+	help
+	  Say Y here if you want to enable support for the Nanosic WN8030 MCU
+	  used as keyboard controller in devices such as Xiaomi Pad 6S Pro 12.4
+
 config HID_NINTENDO
 	tristate "Nintendo Joy-Con, NSO, and Pro Controller support"
 	depends on NEW_LEDS
diff --git a/drivers/hid/Makefile b/drivers/hid/Makefile
index 48a863b245eed3db2da475dd41dead6333e8c481..44fb35abfaa90f070c2bd020c397c4e0ea0def0e 100644
--- a/drivers/hid/Makefile
+++ b/drivers/hid/Makefile
@@ -95,6 +95,7 @@ obj-$(CONFIG_HID_MICROSOFT)	+= hid-microsoft.o
 obj-$(CONFIG_HID_MONTEREY)	+= hid-monterey.o
 obj-$(CONFIG_HID_MSI)		+= hid-msi.o
 obj-$(CONFIG_HID_MULTITOUCH)	+= hid-multitouch.o
+obj-$(CONFIG_HID_NANOSIC_WN8030)	+= hid-nanosic-wn8030.o
 obj-$(CONFIG_HID_NINTENDO)	+= hid-nintendo.o
 obj-$(CONFIG_HID_NTI)			+= hid-nti.o
 obj-$(CONFIG_HID_NTRIG)		+= hid-ntrig.o
