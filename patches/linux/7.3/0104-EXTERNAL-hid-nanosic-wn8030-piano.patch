+	hid->driver_data = nanosic;
+	hid->ll_driver = &nanosic_wn8030_hid_ll_driver;
+	hid->bus = BUS_I2C;
+	hid->dev.parent = nanosic->dev;
+	hid->vendor = 0x15D9;
+	hid->product = 0x00A3;
+	sprintf(hid->name, "%s", "Xiaomi Keyboard");
