+static DEVICE_ATTR_RO(keyboard_attached);
+
+static struct attribute *nanosic_hinge_attrs[] = {
+	&dev_attr_keyboard_attached.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(nanosic_hinge);
