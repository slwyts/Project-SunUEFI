+	if (hid_add_device(hid)) {
+		dev_err(nanosic->dev, "failed add keyboard hid device");
+		hid_destroy_device(hid);
+		nanosic->hid_keyboard = NULL;
+		return;
+	}
+
+	nanosic->hid_keyboard = hid;
