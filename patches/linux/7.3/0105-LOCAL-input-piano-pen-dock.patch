Subject: Input: support the Piano magnetic pen dock

Expose the dock state through the input interface used by the board.

Link: https://github.com/slwyts/Project-SunUEFI/commit/e8fcf33971263f28085dbc0dbe5039438bf76c13
---
 drivers/input/misc/Kconfig          |  12 ++
 drivers/input/misc/Makefile         |   1 +
 drivers/input/misc/piano-pen-dock.c | 166 ++++++++++++++++++++++++++++
 3 files changed, 179 insertions(+)
 create mode 100644 drivers/input/misc/piano-pen-dock.c

diff --git a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
index 169768e3d5bb54213a175257e9500db16a10017b..3da0c29ce4f48f01b4de00a7ee60c17ebe3fb1b4 100644
--- a/drivers/input/misc/Kconfig
+++ b/drivers/input/misc/Kconfig
@@ -1023,4 +1023,16 @@ config INPUT_STPMIC1_ONKEY
 	  To compile this driver as a module, choose M here: the
 	  module will be called stpmic1_onkey.
 
+config INPUT_XIAOMI_PIANO_PEN_DOCK
+	tristate "Xiaomi Piano magnetic pen dock"
+	depends on OF && GPIOLIB
+	help
+	  Report the logical OR of two Hall inputs as SW_PEN_INSERTED.
+	  Hall GPIO polarity comes from firmware. This is only the magnetic
+	  dock switch and does not provide wireless charging or battery data.
+	  The board must configure its AP-owned Hall inputs and power first.
+
+	  To compile this driver as a module, choose M here: the module will
+	  be called piano-pen-dock.
+
 endif
