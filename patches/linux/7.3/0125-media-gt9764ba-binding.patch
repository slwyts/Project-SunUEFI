From 33d308a8364fc7f919636640a967e1a275a1a182 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Mon, 16 Nov 2026 11:16:46 +0800
Subject: [PATCH] dt-bindings: media: add Giantec GT9764BA lens actuator

Describe the GT9764BA bidirectional lens actuator and its I2C address,
digital I/O supply and actuator supply. The neutral DAC value is 512.

Signed-off-by: slwyts <slwyts@foxmail.com>
---
 .../bindings/media/i2c/giantec,gt9764ba.yaml  | 51 +++++++++++++++++++
 MAINTAINERS                                   |  6 +++
 2 files changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/giantec,gt9764ba.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/giantec,gt9764ba.yaml b/Documentation/devicetree/bindings/media/i2c/giantec,gt9764ba.yaml
new file mode 100644
index 000000000..daf9f3597
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/giantec,gt9764ba.yaml
@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/giantec,gt9764ba.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Giantec GT9764BA camera lens actuator
+
+maintainers:
+  - slwyts <slwyts@foxmail.com>
+
+description:
+  The GT9764BA is an I2C-controlled bidirectional voice-coil motor driver
+  with a 10-bit position DAC. Code 512 is the neutral position, unlike
+  unidirectional actuators that park at code zero.
+
+properties:
+  compatible:
+    const: giantec,gt9764ba
+
+  reg:
+    maxItems: 1
+
+  vin-supply:
+    description: Digital I/O supply
+
+  vdd-supply:
+    description: Actuator supply
+
+required:
+  - compatible
+  - reg
+  - vin-supply
+  - vdd-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera-lens@c {
+            compatible = "giantec,gt9764ba";
+            reg = <0x0c>;
+            vin-supply = <&vreg_l6b_1p8>;
+            vdd-supply = <&vreg_l7b_2p8>;
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 266c61a18..820537bb4 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -11105,6 +11105,12 @@ F:	Documentation/filesystems/gfs2/
 F:	fs/gfs2/
 F:	include/uapi/linux/gfs2_ondisk.h
 
+GIANTEC GT9764BA LENS ACTUATOR DRIVER
+M:	slwyts <slwyts@foxmail.com>
+L:	linux-media@vger.kernel.org
+S:	Maintained
+F:	Documentation/devicetree/bindings/media/i2c/giantec,gt9764ba.yaml
+
 GIGABYTE WATERFORCE SENSOR DRIVER
 M:	Aleksa Savic <savicaleksa83@gmail.com>
 L:	linux-hwmon@vger.kernel.org
-- 
