From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: power: supply: expose Piano battery current readings

Use separate measured and filtered readings from the BQ27Z561 gauges.

Link: https://github.com/slwyts/Project-SunUEFI/commit/e8fcf33971263f28085dbc0dbe5039438bf76c13
Signed-off-by: slwyts <slwyts@foxmail.com>
---
 drivers/power/supply/bq27xxx_battery.c | 21 ++++++++++++++-------
 1 file changed, 14 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index 4d4809a70b622c15980b9da619b4843d4fe27d42..fcd2bdbbc26ee2c9f41f0f2738e2dbaf81a1dacc 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -104,6 +104,7 @@ enum bq27xxx_reg_index {
 	BQ27XXX_REG_TEMP,	/* Temperature */
 	BQ27XXX_REG_INT_TEMP,	/* Internal Temperature */
 	BQ27XXX_REG_VOLT,	/* Voltage */
+	BQ27XXX_REG_CI,		/* Current */
 	BQ27XXX_REG_AI,		/* Average Current */
 	BQ27XXX_REG_FLAGS,	/* Flags */
 	BQ27XXX_REG_TTE,	/* Time-to-Empty */
@@ -485,6 +486,7 @@ static u8
 		[BQ27XXX_REG_TEMP] = 0x06,
 		[BQ27XXX_REG_INT_TEMP] = INVALID_REG_ADDR,
 		[BQ27XXX_REG_VOLT] = 0x08,
+		[BQ27XXX_REG_CI] = 0x0c,
 		[BQ27XXX_REG_AI] = 0x14,
 		[BQ27XXX_REG_FLAGS] = 0x0a,
 		[BQ27XXX_REG_TTE] = 0x16,
@@ -821,6 +823,7 @@ static enum power_supply_property bq27z561_props[] = {
 	POWER_SUPPLY_PROP_PRESENT,
 	POWER_SUPPLY_PROP_VOLTAGE_NOW,
 	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CURRENT_AVG,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_CAPACITY_LEVEL,
 	POWER_SUPPLY_PROP_TEMP,
@@ -1853,12 +1856,11 @@ static bool bq27xxx_battery_is_full(struct bq27xxx_device_info *di, int flags)
 }
 
 /*
- * Return the battery average current in µA and the status
- * Note that current can be negative signed as well
- * Or 0 if something fails.
+ * Return the selected battery current in µA and/or the battery status.
  */
 static int bq27xxx_battery_current_and_status(
 	struct bq27xxx_device_info *di,
+	enum bq27xxx_reg_index current_reg,
 	union power_supply_propval *val_curr,
 	union power_supply_propval *val_status,
 	struct bq27xxx_reg_cache *cache)
@@ -1867,7 +1869,7 @@ static int bq27xxx_battery_current_and_status(
 	int curr;
 	int flags;
 
-	curr = bq27xxx_read(di, BQ27XXX_REG_AI, false);
+	curr = bq27xxx_read(di, current_reg, false);
 	if (curr < 0) {
 		dev_err(di->dev, "error reading current\n");
 		return curr;
@@ -1929,7 +1931,8 @@ static void bq27xxx_battery_update_unlocked(struct bq27xxx_device_info *di)
 		 * checked to detect charging <-> discharging status changes.
 		 */
 		if (!(di->opts & BQ27XXX_O_ZERO))
-			bq27xxx_battery_current_and_status(di, NULL, &status, &cache);
+			bq27xxx_battery_current_and_status(di, BQ27XXX_REG_AI, NULL,
+							   &status, &cache);
 	}
 
 	if ((di->cache.capacity != cache.capacity) ||
@@ -2124,6 +2127,7 @@ static int bq27xxx_battery_get_property(struct power_supply *psy,
 {
 	int ret = 0;
 	struct bq27xxx_device_info *di = power_supply_get_drvdata(psy);
+	enum bq27xxx_reg_index current_reg = BQ27XXX_REG_AI;
 
 	mutex_lock(&di->lock);
 	if (time_is_before_jiffies(di->last_update + 5 * HZ))
@@ -2135,7 +2139,7 @@ static int bq27xxx_battery_get_property(struct power_supply *psy,
 
 	switch (psp) {
 	case POWER_SUPPLY_PROP_STATUS:
-		ret = bq27xxx_battery_current_and_status(di, NULL, val, NULL);
+		ret = bq27xxx_battery_current_and_status(di, BQ27XXX_REG_AI, NULL, val, NULL);
 		break;
 	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
 		ret = bq27xxx_battery_voltage(di, val);
@@ -2144,7 +2148,10 @@ static int bq27xxx_battery_get_property(struct power_supply *psy,
 		val->intval = di->cache.flags < 0 ? 0 : 1;
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
-		ret = bq27xxx_battery_current_and_status(di, val, NULL, NULL);
+	case POWER_SUPPLY_PROP_CURRENT_AVG:
+		if (psp == POWER_SUPPLY_PROP_CURRENT_NOW && di->chip == BQ27Z561)
+			current_reg = BQ27XXX_REG_CI;
+		ret = bq27xxx_battery_current_and_status(di, current_reg, val, NULL, NULL);
 		break;
 	case POWER_SUPPLY_PROP_CAPACITY:
 		ret = bq27xxx_simple_value(di->cache.capacity, val);
