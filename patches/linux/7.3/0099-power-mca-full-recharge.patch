+#define MCA_NORMAL_FULL_MIN_MV	4400
+#define MCA_NORMAL_TERM_DELTA_MV 8
+#define MCA_NORMAL_TERM_SAMPLES	5
+#define MCA_NORMAL_TERM_POLL_MS	1000
+#define MCA_NORMAL_RECHARGE_SOC	9700	/* 0.01 percent, from remaining/full charge */
 #define MCA_NORMAL_LOW_FV_MAX_MV	4200
