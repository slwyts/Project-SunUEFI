+static void piano_mca_full_recharge_precision_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int stops;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	f->gauge[0].charge_full_uah = 5000000;
+	f->gauge[1].charge_full_uah = 4000000;
+	f->gauge[0].charge_now_uah = 4851000;
+	f->gauge[1].charge_now_uah = 3880000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_TRUE(test, f->mca.normal_full); /* weighted raw9701 */
+	stops = f->pmic_disable_writes;
+	f->gauge[0].charge_now_uah = 4850000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->mca.normal_full); /* raw9700 */
+	KUNIT_EXPECT_TRUE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->pmic_disable_writes, stops);
+	/* A still-latched hardware5 must not cause stop/start pulses at this SOC. */
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->mca.normal_full);
+	KUNIT_EXPECT_EQ(test, f->pmic_disable_writes, stops);
+}
