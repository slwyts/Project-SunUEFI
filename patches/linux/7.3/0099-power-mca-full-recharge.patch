 	return ret ?: fcc_ret;
 }
 
+/* Match the parallel FG's integer FCC weights and 0.01-percent SOC. */
+static int piano_mca_normal_raw_soc(int *soc)
+{
+	union power_supply_propval now, full;
+	struct power_supply *psy;
+	u32 rm[2], fcc[2], raw[2], weight;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_supplied_to); i++) {
+		psy = power_supply_get_by_name(piano_mca_supplied_to[i]);
+		if (!psy)
+			return -ENODEV;
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_CHARGE_NOW, &now);
+		ret = ret ?: power_supply_get_property(psy, POWER_SUPPLY_PROP_CHARGE_FULL,
+							&full);
+		power_supply_put(psy);
+		if (ret)
+			return ret;
+		if (now.intval < 0 || full.intval < 1000)
+			return -ERANGE;
+		/* Both BQ register reads have an integer mAh resolution. */
+		rm[i] = now.intval / 1000;
+		fcc[i] = full.intval / 1000;
+		raw[i] = div_u64((u64)rm[i] * 10000, fcc[i]);
+	}
+	weight = div_u64((u64)fcc[0] * 100, fcc[0] + fcc[1]);
+	*soc = div_u64((u64)raw[0] * weight + (u64)raw[1] * (100 - weight) + 50,
+		       100);
+	return 0;
+}
+
+/* Whole-pack ordinary termination; the FG's separate cell-CO writes are unused. */
+static int piano_mca_normal_termination(struct piano_mca *mca, int vbat, int ibat,
+					 u32 fv, unsigned int generation,
+					 unsigned int connection)
+{
+	__le32 status;
+	bool was_full = mca->normal_full;
+	int soc, ret;
+
+	if (!piano_mca_session_valid(mca, generation, connection)) {
+		mca->normal_term_count = 0;
+		return -ENODEV;
+	}
+	if (mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON ||
+	    mca->cp == MCA_CP_STOPPING) {
+		mca->normal_term_count = 0;
+		return 0;
+	}
+	if (mca->normal_term_count && mca->normal_term_generation != generation)
+		mca->normal_term_count = 0;
+	if (!mca->normal_full) {
+		if (!mca->online || fv <= MCA_NORMAL_FULL_MIN_MV) {
+			mca->normal_term_count = 0;
+			return 0;
+		}
+		ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CHARGE_STATUS,
+				     &status, sizeof(status), generation, connection);
+		if (ret) {
+			mca->normal_term_count = 0;
+			return ret;
+		}
+		if (le32_to_cpu(status) == 5) {
+			mca->normal_full = true;
+		} else if (ibat < MCA_NORMAL_FG_ITERM_MA * 115 / 100 &&
+			   vbat >= fv - MCA_NORMAL_TERM_DELTA_MV) {
+			/* Immediate policy work must not count the same sample twice. */
+			if (!mca->normal_term_count ||
+			    time_after_eq(jiffies, mca->normal_term_at +
+					  msecs_to_jiffies(MCA_NORMAL_TERM_POLL_MS))) {
+				mca->normal_term_at = jiffies;
+				mca->normal_term_generation = generation;
+				if (++mca->normal_term_count >= MCA_NORMAL_TERM_SAMPLES)
+					mca->normal_full = true;
+			}
+		} else {
+			mca->normal_term_count = 0;
+		}
+	}
+	if (!mca->normal_full)
+		return 0;
+	mca->normal_term_count = 0;
+	ret = piano_mca_normal_raw_soc(&soc);
+	if (ret)
+		return ret;
+	if (!piano_mca_session_valid(mca, generation, connection))
+		return -ENODEV;
+	/* Stock checks recharge after termination in the same monitor cycle. */
+	if (soc <= MCA_NORMAL_RECHARGE_SOC)
+		mca->normal_full = false;
+	if (mca->normal_full != was_full)
+		dev_info(mca->dev, "ordinary charging %s, raw SOC %d/10000\n",
+			 mca->normal_full ? "complete" : "recharging", soc);
+	return 0;
+}
