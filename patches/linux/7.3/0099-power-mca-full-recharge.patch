+static void piano_mca_full_pdr_and_restrictions_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval value = { .intval = 0 };
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_TRUE(test, f->mca.normal_full);
+	f->remote_generation += 2;
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_DOWN);
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_UP);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_TRUE(test, f->mca.normal_full);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE), 0);
+	KUNIT_ASSERT_EQ(test, power_supply_set_property(f->mca.usb,
+		POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT, &value), 0);
+	f->gauge[0].charge_now_uah = f->gauge[1].charge_now_uah = 4365000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->mca.normal_full);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_charge);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+}
