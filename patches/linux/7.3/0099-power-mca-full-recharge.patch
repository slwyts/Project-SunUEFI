+static void piano_mca_full_recharge_uses_stock_weights_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	f->gauge[0].charge_full_uah = 4900000;
+	f->gauge[1].charge_full_uah = 4100000;
+	f->gauge[0].charge_now_uah = 4714000;
+	f->gauge[1].charge_now_uah = 4016000;
+	/* Per-cell raw9620/9795, FCC weights54/46 ->9701; sum RM/FCC ->9700. */
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+}
