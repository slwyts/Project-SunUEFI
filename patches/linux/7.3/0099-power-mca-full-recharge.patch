@@ -2508,6 +2619,11 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 				    mca->cp_generation,
 				    mca->cp_connection_generation))
 		return;
+	if (piano_mca_normal_termination(mca, vbat, ibat, limits.fv_mv, generation,
+					  mca->cp_connection_generation) || mca->normal_full) {
+		piano_mca_normal_pause(mca, generation, mca->cp_connection_generation);
+		return;
+	}
 	/* PD requests in the middle of the authentication break it */
 	if (mipps_auth && !piano_mca_authenticated(mca) &&
 	    time_before(jiffies, mca->cp_on_at +
@@ -2537,6 +2653,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	mca->cp_psy = power_supply_get_by_name("sc8541");
 	if (!mca->cp_psy)
 		return;
+	mca->normal_term_count = 0;
 	/* This is a new attempt; an earlier policy pause cannot own its faults. */
 	mca->cp_retry = false;
 	mca->cp = MCA_CP_STOPPING;
@@ -2843,6 +2960,8 @@ static int piano_mca_sync_connection(struct piano_mca *mca)
 	mca->cp_profile = 0;
 	mca->cp_retry = false;
 	mca->cp_errors = 0;
+	mca->normal_full = false;
+	mca->normal_term_count = 0;
 	mca->hv = MCA_HV_OFF;
 	mca->hv_renegs = 0;
 	mca->icl_set_ma = 0;
@@ -2976,6 +3095,8 @@ static void piano_mca_poll(struct work_struct *work)
 	if (!online) {
 		bool auth_reset = piano_mca_auth_pending(mca);
 
+		mca->normal_term_count = 0;
+
 		/* UCSI ONLINE follows the connector, not VBUS. Preserve an
 		 * authentication reset only while its cable remains connected.
 		 * A physical replug needs a fresh challenge even within 10 s.
@@ -3012,6 +3133,7 @@ static void piano_mca_poll(struct work_struct *work)
 			piano_mca_apply_policy(mca, generation,
 					       mca->polled_connection_generation);
 	} else if (charge_policy && piano_mca_cp_active(mca)) {
+		mca->normal_term_count = 0;
 		piano_mca_cp_step(mca);
 		if (!piano_mca_cp_active(mca) &&
 		    piano_mca_session_valid(mca, generation,
@@ -3035,6 +3157,7 @@ static void piano_mca_poll(struct work_struct *work)
 	goto requeue;
 
 source_error:
+	mca->normal_term_count = 0;
 	/* A transport failure is not a measured disconnect or a new source. */
 	if (!piano_mca_cp_stop_io(mca, "source read failed"))
 		piano_mca_normal_pause(mca, generation,
@@ -3044,7 +3167,9 @@ static void piano_mca_poll(struct work_struct *work)
 	if (mca->service_up || mca->cp == MCA_CP_STOPPING)
 		queue_delayed_work(system_freezable_wq, &mca->poll,
 				   msecs_to_jiffies(piano_mca_cp_active(mca) ?
-						    MCA_CP_POLL_MS : MCA_POLL_MS));
+						    MCA_CP_POLL_MS :
+						    mca->normal_term_count ?
+						    MCA_NORMAL_TERM_POLL_MS : MCA_POLL_MS));
 unlock:
 	mutex_unlock(&mca->policy_lock);
 }
@@ -3721,6 +3846,7 @@ static int piano_mca_suspend(struct device *dev)
 	if (mca->policy_stopped || mca->policy_suspended)
 		goto unlock;
 	mca->policy_suspended = true;
+	mca->normal_term_count = 0;
 	mutex_unlock(&mca->policy_lock);
 	/* A queued poll sees the suspended flag and exits without requeueing. */
 	disable_delayed_work_sync(&mca->poll);
