+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)0);
+	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_voltage_stop);
