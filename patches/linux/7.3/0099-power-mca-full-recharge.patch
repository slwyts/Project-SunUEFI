+static int piano_mca_full_prepare(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int ret = piano_mca_api_prepare(test);
+
+	if (ret)
+		return ret;
+	f->only_5v = true;
+	f->gauge[0].voltage_uv = f->gauge[1].voltage_uv = 4472000;
+	f->gauge[0].current_ua = f->gauge[1].current_ua = 100000;
+	f->gauge[0].charge_now_uah = f->gauge[1].charge_now_uah = 4455000;
+	return 0;
+}
+
+static void piano_mca_full_hardware_hold_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int enables;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_TRUE(test, f->mca.normal_full);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, f->fv_mv, 4480U);
+	KUNIT_EXPECT_EQ(test, f->icl_ma, 1500U);
+	enables = f->pmic_enable_writes;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
+	KUNIT_EXPECT_EQ(test, f->pmic_enable_writes, enables);
+}
+
+static void piano_mca_full_soft_five_samples_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int n;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_ASSERT_EQ(test, f->mca.normal_term_count, (u8)1);
+	/* A queued setter poll cannot count another independent one-second sample. */
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)1);
+	for (n = 1; n < 5; n++) {
+		f->mca.normal_term_at = jiffies - msecs_to_jiffies(1000);
+		piano_mca_poll(&f->mca.poll.work);
+		KUNIT_EXPECT_EQ(test, f->mca.normal_full, n == 4);
+	}
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)0);
+	KUNIT_EXPECT_EQ(test, f->icl_ma, 1500U);
+}
+
+static void piano_mca_full_soft_boundaries_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->gauge[0].current_ua = 129000;
+	f->gauge[1].current_ua = 130000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)0);
+	f->gauge[0].current_ua = 128000;
+	f->gauge[0].voltage_uv = f->gauge[1].voltage_uv = 4471000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)0);
+	f->gauge[1].voltage_uv = 4472000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)1);
+	/* The stock condition includes negative net current, without abs(). */
+	f->gauge[0].current_ua = f->gauge[1].current_ua = -500000;
+	f->mca.normal_term_at = jiffies - msecs_to_jiffies(1000);
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_EQ(test, f->mca.normal_term_count, (u8)2);
+}
+
+static void piano_mca_full_low_fv_excluded_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int n;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_full_prepare(test), 0);
+	f->charge_status = 5;
+	f->pack_temp = 48;
