+static inline void trace_android_rvh_gh_note_fw_parcel(struct gunyah_vm *ghvm,
+							u16 ghvm_vmid,
+							u32 fw_mem_handle)
+{
+}
+#endif /* CONFIG_ANDROID_VENDOR_HOOKS */
