From 912b80ad574e53ebcad7bfe3d18f86edc59fc5a2 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Sun, 8 Nov 2026 01:57:31 +0800
Subject: [PATCH] PCI: qcom: power endpoint devices before enabling PHYs

Source: Cryolitia/xiaomi-piano-nixos, packages/kernel/patches/pcie-qcom-power-before-phy.patch
---
 drivers/pci/controller/dwc/pcie-qcom.c | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index a412da12b96..e5143337c0d 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -1528,16 +1528,10 @@ static int qcom_pcie_host_init(struct dw_pcie_rp *pp)
 	if (ret)
 		return ret;
 
-	PIANO_MARK(pci->dev, "H1 phy power-on");
-	ret = qcom_pcie_phy_power_on(pcie);
-	if (ret)
-		goto err_deinit;
-	PIANO_MARK(pci->dev, "H2 phy up");
-
 	if (!pci->suspended) {
 		ret = pci_pwrctrl_create_devices(pci->dev);
 		if (ret)
-			goto err_disable_phy;
+			goto err_deinit;
 	}
 
 	if (!pp->skip_pwrctrl_off) {
@@ -1545,12 +1539,18 @@ static int qcom_pcie_host_init(struct dw_pcie_rp *pp)
 		if (ret)
 			goto err_pwrctrl_destroy;
 	}
+
+	PIANO_MARK(pci->dev, "H1 phy power-on");
+	ret = qcom_pcie_phy_power_on(pcie);
+	if (ret)
+		goto err_pwrctrl_power_off;
+	PIANO_MARK(pci->dev, "H2 phy up");
 	PIANO_MARK(pci->dev, "H3 pwrctrl on");
 
 	if (pcie->cfg->ops->post_init) {
 		ret = pcie->cfg->ops->post_init(pcie);
 		if (ret)
-			goto err_pwrctrl_power_off;
+			goto err_disable_phy;
 	}
 	PIANO_MARK(pci->dev, "H4 post_init done (first DBI access passed)");
 
@@ -1575,14 +1575,14 @@ static int qcom_pcie_host_init(struct dw_pcie_rp *pp)
 
 err_assert_reset:
 	qcom_pcie_perst_assert(pcie);
+err_disable_phy:
+	qcom_pcie_phy_power_off(pcie);
 err_pwrctrl_power_off:
 	if (!pp->skip_pwrctrl_off)
 		pci_pwrctrl_power_off_devices(pci->dev);
 err_pwrctrl_destroy:
 	if (ret != -EPROBE_DEFER && !pci->suspended)
 		pci_pwrctrl_destroy_devices(pci->dev);
-err_disable_phy:
-	qcom_pcie_phy_power_off(pcie);
 err_deinit:
 	pcie->cfg->ops->deinit(pcie);
 
