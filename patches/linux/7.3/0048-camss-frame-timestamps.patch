+void vfe_frame_sync(struct vfe_device *vfe, int port_id, bool start,
+		    u64 ticks, u64 previous_ticks, u64 arch_ticks,
+		    u64 arch_after, u64 irq_ns, u64 mono_ns)
+{
+	struct v4l2_event event = { .type = V4L2_EVENT_FRAME_SYNC };
