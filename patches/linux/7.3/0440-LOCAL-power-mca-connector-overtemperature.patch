+	int temp[] = { 30000, 31000 };
+
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 100 * HZ);
+	temp[0] = 34000;
+	temp[1] = 35000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 101 * HZ);
+	KUNIT_EXPECT_EQ(test, f->mca.connector_rate, 4);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_latched);
+
+	f->mca.connector_latched = false;
+	f->mca.connector_sample_valid = false;
+	temp[0] = 25000;
+	temp[1] = 40000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 200 * HZ);
+	temp[0] = 35000;
+	temp[1] = 41000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 201 * HZ);
+	/* The factory uses the hotter sensor's rate, not the largest rate. */
+	KUNIT_EXPECT_EQ(test, f->mca.connector_rate, 1);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+
+	f->mca.connector_sample_valid = false;
+	temp[0] = 30000;
+	temp[1] = 30000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 300 * HZ);
+	temp[0] = 34000;
+	temp[1] = 34000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 301 * HZ);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+	temp[0] = 35000;
+	temp[1] = 35000;
+	piano_mca_connector_sample(&f->mca, temp, false, 0, 303 * HZ);
+	KUNIT_EXPECT_EQ(test, f->mca.connector_rate, 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+}
+
+static int piano_mca_test_mos_set(struct gpio_chip *chip, unsigned int offset,
+				 int value)
+{
+	struct piano_mca_test *f = gpiochip_get_data(chip);
+
+	if (f->mos_write_error || (value && f->fail_mos_isolate))
+		return -EIO;
+	f->connector_pin = value;
+	f->last_mos_event = ++f->events;
+	f->mos_writes++;
+	if (value)
+		f->vbus_uv = 0;
+	else if (f->attach_on_mos_restore) {
+		f->attach_on_mos_restore = false;
+		f->connector_present = true;
+		piano_mca_connector_changed(&f->mca);
+	}
+	return 0;
+}
+
+static int piano_mca_test_mos_get(struct gpio_chip *chip, unsigned int offset)
+{
+	struct piano_mca_test *f = gpiochip_get_data(chip);
+
+	return f->connector_pin;
+}
+
+static int piano_mca_test_ucsi_get(struct power_supply *psy,
+				   enum power_supply_property prop,
+				   union power_supply_propval *val)
+{
+	struct piano_mca_test *f = power_supply_get_drvdata(psy);
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = f->connector_present;
+		return 0;
+	case POWER_SUPPLY_PROP_ONLINE:
+		val->intval = f->connector_present && !f->connector_otg;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int piano_mca_test_connector_prepare(struct kunit *test, bool ucsi)
+{
+	struct piano_mca_test *f = test->priv;
+	struct gpio_desc *desc;
+	int i, ret;
+
+	f->connector_gpio = (struct gpio_chip) {
+		.label = "piano-connector-test",
+		.parent = f->mca.dev,
+		.base = -1,
+		.ngpio = 1,
+		.can_sleep = true,
+		.get = piano_mca_test_mos_get,
+		.set = piano_mca_test_mos_set,
+		.direction_output = piano_mca_test_mos_set,
+	};
+	ret = devm_gpiochip_add_data(f->mca.dev, &f->connector_gpio, f);
+	if (ret)
+		return ret;
+	desc = gpiochip_request_own_desc(&f->connector_gpio, 0, "mos",
+					 GPIO_ACTIVE_HIGH, GPIOD_OUT_LOW);
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+	f->mca.connector_mos = desc;
+	f->mos_writes = 0;
+	f->mca.connector_wake = wakeup_source_register(f->mca.dev,
+						      "connector-suspend-test");
+	if (!f->mca.connector_wake)
+		return -ENOMEM;
+	for (i = 0; i < ARRAY_SIZE(f->connector_input); i++) {
+		f->connector_input[i].temp_mc = 25000;
+		f->connector_input[i].type = IIO_TEMP;
+		f->connector_channels[i].data = &f->connector_input[i];
+	}
+	f->mca.connector_control = true;
+	f->mca.pd_protocol_version = 1;
+	f->mca.connector_blocked = true;
+	f->mca.connector_mos_state = MCA_CONNECTOR_MOS_CONDUCTING;
+	if (ucsi) {
+		static const enum power_supply_property properties[] = {
+			POWER_SUPPLY_PROP_PRESENT, POWER_SUPPLY_PROP_ONLINE,
+		};
+		static const struct power_supply_desc description = {
+			.name = "ucsi-source-psy-piano-test",
+			.type = POWER_SUPPLY_TYPE_USB,
+			.properties = properties,
+			.num_properties = ARRAY_SIZE(properties),
+			.get_property = piano_mca_test_ucsi_get,
+		};
+		struct power_supply_config cfg = { .drv_data = f };
+		struct power_supply *supply;
+
+		struct device *parent = kunit_device_register(test, "piano-ucsi");
+
+		if (IS_ERR(parent))
+			return PTR_ERR(parent);
+		supply = devm_power_supply_register(parent, &description, &cfg);
+		if (IS_ERR(supply))
+			return PTR_ERR(supply);
+	}
+	return 0;
+}
+
+static void piano_mca_test_connector_poll(struct piano_mca_test *f)
+{
+	/* A connection event may request another run during this sample. */
+	disable_delayed_work_sync(&f->mca.connector_work);
+	piano_mca_connector_work(&f->mca.connector_work.work);
+	enable_delayed_work(&f->mca.connector_work);
+}
+
+static void piano_mca_connector_recovery_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval value;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_connector_prepare(test, true), 0);
+	f->vbus_uv = 9000000;
+	f->connector_present = true;
+	f->connector_otg = true;
+	f->connector_input[1].temp_mc = 65000;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_latched);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, f->usb_boost_stops, 1U);
+	KUNIT_EXPECT_NE(test, f->last_vsafe_event, 0U);
+	KUNIT_EXPECT_LT(test, f->last_vsafe_event, f->last_stop_event);
+	KUNIT_EXPECT_LT(test, f->last_mos_event, f->last_pmic_disable_event);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	piano_mca_usb_get_property(f->mca.usb, POWER_SUPPLY_PROP_HEALTH, &value);
+	KUNIT_EXPECT_EQ(test, value.intval, POWER_SUPPLY_HEALTH_OVERHEAT);
+	piano_mca_usb_get_property(f->mca.usb, POWER_SUPPLY_PROP_ONLINE, &value);
+	KUNIT_EXPECT_EQ(test, value.intval, 0);
+	KUNIT_EXPECT_TRUE(test, f->connector_present);
+
+	f->connector_input[1].temp_mc = 54000;
+	f->mca.connector_sample_at = jiffies - HZ;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_EQ(test, f->mos_writes, 1U);
+	f->connector_present = false;
+	f->connector_cid = 1;
+	f->mca.connector_sample_at = jiffies - HZ;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	f->connector_cid = 0;
+	f->vbus_uv = 5000000;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	f->vbus_uv = 0;
+	f->connector_input[1].temp_mc = 55000;
+	f->mca.connector_sample_at = jiffies - HZ;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	f->connector_input[1].temp_mc = 54000;
+	f->mca.connector_sample_at = jiffies - HZ;
+	f->mos_write_error = true;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_latched);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	f->mca.connector_sample_at = jiffies - HZ;
+	f->mos_write_error = false;
+	/* First reassert isolation because the failed bus write is ambiguous. */
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	f->mca.connector_sample_at = jiffies - HZ;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+	KUNIT_EXPECT_FALSE(test, f->connector_pin);
+	KUNIT_EXPECT_GT(test, piano_mca_charge_limit(&f->mca), 0U);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_wake->active);
+}
+
+static void piano_mca_connector_restore_attach_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval health;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_connector_prepare(test, true), 0);
+	f->connector_input[0].error = -EIO;
+	piano_mca_test_connector_poll(f);
+	KUNIT_ASSERT_TRUE(test, f->connector_pin);
+	KUNIT_ASSERT_FALSE(test, f->mca.connector_latched);
+
+	f->connector_input[0].error = 0;
+	piano_mca_test_connector_poll(f);
+	f->mca.connector_sample_at = jiffies - HZ;
+	f->attach_on_mos_restore = true;
+	f->fail_mos_isolate = true;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_present);
+	KUNIT_EXPECT_FALSE(test, f->connector_pin);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_wake->active);
+	KUNIT_ASSERT_EQ(test,
+			piano_mca_usb_get_property(f->mca.usb, POWER_SUPPLY_PROP_HEALTH, &health),
+			0);
+	KUNIT_EXPECT_EQ(test, health.intval, POWER_SUPPLY_HEALTH_UNKNOWN);
+
+	f->fail_mos_isolate = false;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 0U);
+	f->connector_present = false;
+	f->mca.connector_sample_at = jiffies - HZ;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_FALSE(test, f->connector_pin);
+	KUNIT_EXPECT_GT(test, piano_mca_charge_limit(&f->mca), 0U);
+}
