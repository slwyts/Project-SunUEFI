+#define MCA_CONNECTOR_POLL_MS	1000
+#define MCA_CONNECTOR_IDLE_MS	5000
+#define MCA_CONNECTOR_RATE	4
+#define MCA_CONNECTOR_VBUS_UV	5000000
+#define MCA_CONNECTOR_ISOLATED_UV 4100000
+
+static const char * const piano_mca_connector_channels[] = {
+	"connector-therm", "connector-therm2",
+};
+
+enum piano_mca_connector_state {
+	MCA_CONNECTOR_UNKNOWN,
+	MCA_CONNECTOR_DETACHED,
+	MCA_CONNECTOR_ATTACHED,
+};
+
+static int piano_mca_connector_present(struct power_supply *psy, void *data)
+{
+	struct piano_mca *mca = data;
+	union power_supply_propval val;
+
+	guard(rwsem_read)(&psy->epc_sem);
+	if (psy->removing || !piano_mca_is_ucsi(mca, psy) ||
+	    power_supply_get_property_direct(psy, POWER_SUPPLY_PROP_PRESENT, &val))
+		return MCA_CONNECTOR_UNKNOWN;
+	return val.intval ? MCA_CONNECTOR_ATTACHED : MCA_CONNECTOR_DETACHED;
+}
+
+static int piano_mca_connector_state(struct piano_mca *mca)
+{
+	unsigned int generation = pmic_glink_get_generation(mca->client);
+	unsigned int connection = piano_mca_connection_generation(mca);
+	int present = power_supply_for_each_psy(mca, piano_mca_connector_present);
+	__le32 vbus;
+	u8 cid, otg;
+	int ret;
+
+	lockdep_assert_held(&mca->policy_lock);
+	if (present == MCA_CONNECTOR_ATTACHED)
+		return present;
+	if (!READ_ONCE(mca->service_up))
+		return MCA_CONNECTOR_UNKNOWN;
+	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_CID_STATUS,
+			     &cid, sizeof(cid), generation, connection);
+	ret = ret ?: piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_OTG_PLUGIN,
+				     &otg, sizeof(otg), generation, connection);
+	if (ret || cid > 1 || otg > 1)
+		return MCA_CONNECTOR_UNKNOWN;
+	if (cid || otg)
+		return MCA_CONNECTOR_ATTACHED;
+
+	/* Low VBUS only corroborates UCSI's detach report. */
+	ret = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_BUS_VOLT,
+			     &vbus, sizeof(vbus), generation, connection);
+	if (ret)
+		return MCA_CONNECTOR_UNKNOWN;
+	if (le32_to_cpu(vbus) >= MCA_CONNECTOR_ISOLATED_UV)
+		return MCA_CONNECTOR_ATTACHED;
+	return present;
+}
+
+static void piano_mca_connector_release(void *data)
+{
+	struct piano_mca *mca = data;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(mca->connector_channels); i++) {
+		if (mca->connector_channels[i]) {
+			iio_channel_release(mca->connector_channels[i]);
+			mca->connector_channels[i] = NULL;
+		}
+	}
+}
+
+static int piano_mca_connector_read(struct piano_mca *mca, int *temp)
+{
+	enum iio_chan_type type;
+	struct iio_channel *channel;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(mca->connector_channels); i++) {
+		if (!mca->connector_channels[i]) {
+			channel = iio_channel_get(mca->dev, piano_mca_connector_channels[i]);
+			if (IS_ERR(channel)) {
+				ret = PTR_ERR(channel);
+				goto failed;
+			}
+			mca->connector_channels[i] = channel;
+			ret = iio_get_channel_type(channel, &type);
+			if (ret)
+				goto failed;
+			if (type != IIO_TEMP) {
+				ret = -EINVAL;
+				goto failed;
+			}
+		}
+		ret = iio_read_channel_processed(mca->connector_channels[i], &temp[i]);
+		if (ret < 0)
+			goto failed;
+		if (temp[i] < -40000) {
+			ret = -ERANGE;
+			goto failed;
+		}
+	}
+	return 0;
+
+failed:
+	piano_mca_connector_release(mca);
+	return ret;
+}
+
+static bool piano_mca_connector_sample(struct piano_mca *mca, const int *temp,
+				       bool board_valid, int board_mc,
+				       unsigned long now)
+{
+	unsigned int elapsed = jiffies_to_msecs(now - mca->connector_sample_at);
+	int degrees[] = { temp[0] / 1000, temp[1] / 1000 };
+	int hotter = degrees[1] > degrees[0] ? 1 : 0;
+	int maximum = max(25, degrees[hotter]);
+	bool previous = mca->connector_sample_valid;
+	int rate = 0;
+
+	if (!previous || elapsed >= MCA_CONNECTOR_POLL_MS) {
+		if (previous)
+			rate = div_s64((s64)(degrees[hotter] -
+					     mca->connector_temp[hotter]) * 1000,
+					elapsed);
+		mca->connector_rate = rate;
+		mca->connector_temp[0] = degrees[0];
+		mca->connector_temp[1] = degrees[1];
+		mca->connector_sample_at = now;
+		mca->connector_sample_valid = true;
+	}
+
+	/* If the board sensor cannot be sampled, keep the lower trip. */
+	if (maximum >= 65 ||
+	    (maximum >= 60 && (!board_valid || board_mc / 1000 <= 50)) ||
+	    (maximum >= 35 && rate >= MCA_CONNECTOR_RATE))
+		WRITE_ONCE(mca->connector_latched, true);
+
+	return previous && elapsed >= MCA_CONNECTOR_POLL_MS &&
+	       maximum < 55 && rate < MCA_CONNECTOR_RATE;
+}
+
+static int piano_mca_connector_stop(struct piano_mca *mca, u32 event)
+{
+	unsigned int generation = pmic_glink_get_generation(mca->client);
+	unsigned int connection = piano_mca_connection_generation(mca);
+	__le32 vbus;
+	const u8 empty = 0;
+	u32 real_type;
+	int ret, err, attempt;
+	bool reset = false;
+	u8 otg;
+
+	lockdep_assert_held(&mca->policy_lock);
+	if (mca->connector_stop_confirmed && READ_ONCE(mca->service_up) &&
+	    event == mca->connector_stop_event &&
+	    generation == mca->connector_stop_generation &&
+	    connection == mca->connector_stop_connection)
+		return 0;
+	mca->connector_stop_confirmed = false;
+
+	/*
+	 * The zero-byte VDM has been identified in the v1 stock module.
+	 * Do not assume a v2 command number from the unrelated PDO remap.
+	 */
+	if (mca->connector_latched && mca->pd_protocol_version == 1 && READ_ONCE(mca->service_up) &&
+	    !piano_mca_read_type(mca, &real_type) && piano_mca_is_pd(real_type)) {
+		reset = true;
+		err = piano_mca_write_session(mca, MCA_PROP_VDM_VSAFE0V,
+					      &empty, 0, generation, connection);
+		if (!err)
+			msleep(50);
+	}
+	ret = piano_mca_cp_pause(mca, mca->connector_latched ?
+				"USB connector overtemperature" :
+				"USB connector temperature unavailable");
+	if (!READ_ONCE(mca->service_up))
+		return ret ?: -ENODEV;
+
+	err = piano_mca_normal_pause(mca, generation, connection);
+	ret = ret ?: err;
+	if (reset) {
+		msleep(200);
+		for (attempt = 0; attempt < 5; attempt++) {
+			err = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_BUS_VOLT,
+					     &vbus, sizeof(vbus), generation, connection);
+			if (err || le32_to_cpu(vbus) < MCA_CONNECTOR_VBUS_UV)
+				break;
+			piano_mca_write_session(mca, MCA_PROP_VDM_VSAFE0V,
+						&empty, 0, generation, connection);
+			msleep(200);
+		}
+	}
+
+	/* Client zero controls the USB source, not the wireless pen rail. */
+	err = piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_OTG_PLUGIN,
+			     &otg, sizeof(otg), generation, connection);
+	if (err || otg)
+		err = piano_mca_write_u32_session(mca, MCA_PROP_BOOST_ENABLE,
+						  0, generation, connection);
+	ret = ret ?: err;
+	if (!ret && !piano_mca_session_valid(mca, generation, connection))
+		ret = -ECONNRESET;
+	if (!ret) {
+		mca->connector_stop_event = event;
+		mca->connector_stop_generation = generation;
+		mca->connector_stop_connection = connection;
+		mca->connector_stop_confirmed = true;
+	}
+	return ret;
+}
+
+static int piano_mca_connector_isolate(struct piano_mca *mca, bool isolate)
+{
+	enum piano_mca_connector_mos state = isolate ? MCA_CONNECTOR_MOS_ISOLATED :
+						     MCA_CONNECTOR_MOS_CONDUCTING;
+	int ret;
+
+	lockdep_assert_held(&mca->policy_lock);
+	if (mca->connector_mos_state != state) {
+		ret = gpiod_set_value_cansleep(mca->connector_mos, isolate);
+		if (ret) {
+			/* A bus error does not establish whether the pin changed. */
+			mca->connector_mos_state = MCA_CONNECTOR_MOS_UNKNOWN;
+			mca->connector_stop_confirmed = false;
+			return ret;
+		}
+		mca->connector_mos_state = state;
+		if (isolate)
+			msleep(50);
+	}
+	return 0;
+}
+
+static int piano_mca_connector_verify_isolation(struct piano_mca *mca)
+{
+	__le32 value;
+	int ret;
+
+	lockdep_assert_held(&mca->policy_lock);
+	if (!READ_ONCE(mca->service_up))
+		return -ENODEV;
+
+	ret = piano_mca_read(mca, MCA_PROP_BUS_VOLT, &value, sizeof(value));
+	if (!ret && le32_to_cpu(value) >= MCA_CONNECTOR_ISOLATED_UV)
+		ret = -EIO;
+	if (ret) {
+		mca->connector_stop_confirmed = false;
+		return ret;
+	}
+
+	/* Preserve cable presence in UCSI; report measured power loss here. */
+	mca->vbus_uv = le32_to_cpu(value);
+	mca->ibus_ua = 0;
+	mca->icl_ma = 0;
+	if (mca->online || mca->real_type != MCA_TYPE_UNKNOWN) {
+		if (mca->online)
+			mca->cp_off_at = jiffies;
+		mca->online = false;
+		mca->real_type = MCA_TYPE_UNKNOWN;
+		power_supply_changed(mca->usb);
+	}
+	return 0;
+}
+
+static void piano_mca_connector_schedule(struct piano_mca *mca, u32 event, bool awake)
+{
+	guard(spinlock_irqsave)(&mca->connector_event_lock);
+	if (event != mca->connector_event) {
+		mod_delayed_work(system_percpu_wq, &mca->connector_work, 0);
+		return;
+	}
+	if (awake)
+		__pm_stay_awake(mca->connector_wake);
+	else
+		__pm_relax(mca->connector_wake);
+	mod_delayed_work(system_percpu_wq, &mca->connector_work,
+			 msecs_to_jiffies(awake ? MCA_CONNECTOR_POLL_MS :
+					 MCA_CONNECTOR_IDLE_MS));
+}
+
+static bool piano_mca_connector_can_restore(struct piano_mca *mca, int state)
+{
+	if (state == MCA_CONNECTOR_DETACHED)
+		return true;
+	/*
+	 * A normal wake may have been caused by a new cable. A deliberately
+	 * isolated, cool connector may rejoin; a fault latch never can.
+	 */
+	return mca->connector_sleep_isolated &&
+	       !mca->connector_latched && state == MCA_CONNECTOR_ATTACHED;
+}
+
+static int piano_mca_connector_restore(struct piano_mca *mca, int state, u32 event)
+{
+	int ret, current_state;
+
+	lockdep_assert_held(&mca->policy_lock);
+	scoped_guard(spinlock_irqsave, &mca->connector_event_lock) {
+		if (event != mca->connector_event)
+			return -EAGAIN;
+	}
+
+	ret = piano_mca_connector_isolate(mca, false);
+	if (!ret) {
+		/* The GPIO write can sleep while UCSI reports a new connection. */
+		current_state = piano_mca_connector_state(mca);
+		scoped_guard(spinlock_irqsave, &mca->connector_event_lock) {
+			if (state == current_state && event == mca->connector_event) {
+				WRITE_ONCE(mca->connector_latched, false);
+				mca->connector_sleep_isolated = false;
+				mca->connector_stop_confirmed = false;
+				WRITE_ONCE(mca->connector_blocked, false);
+				return 0;
+			}
+		}
+		ret = -EAGAIN;
+	}
+
+	/* Even a failed restore may have changed the GPIO. Keep power paused. */
+	mca->connector_stop_confirmed = false;
+	return piano_mca_connector_isolate(mca, true) ?: ret;
+}
+
+static void piano_mca_connector_work(struct work_struct *work)
+{
+	struct piano_mca *mca = container_of(work, struct piano_mca,
+						connector_work.work);
+	bool cool = false, was_latched, was_blocked, awake, temp_unavailable;
+	bool pin_unknown;
+	int temp[2], state, board = 0, ret;
+	u32 event;
+
+	guard(mutex)(&mca->policy_lock);
+	if (mca->policy_stopped || mca->policy_suspended)
+		return;
+	scoped_guard(spinlock_irqsave, &mca->connector_event_lock)
+		event = mca->connector_event;
+	was_latched = mca->connector_latched;
+	was_blocked = mca->connector_blocked;
+	ret = piano_mca_connector_read(mca, temp);
+	temp_unavailable = ret;
+	if (ret) {
+		mca->connector_sample_valid = false;
+		dev_warn_ratelimited(mca->dev,
+				     "USB connector temperature unavailable, power paused: %d\n",
+				     ret);
+	} else {
+		int maximum = max(temp[0], temp[1]);
+		bool board_valid = false;
+
+		/*
+		 * The stock board report uses the same five-input model as the
+		 * skin policy. A fresh board reading is only needed between
+		 * the two connector trips.
+		 */
+		if (!mca->connector_latched && mca->skin_control &&
+		    maximum >= 60000 && maximum < 65000)
+			board_valid = !piano_mca_skin_read(mca, &board);
+		cool = piano_mca_connector_sample(mca, temp, board_valid,
+						  board, jiffies);
+		if (mca->connector_sleep_isolated &&
+		    !mca->connector_latched &&
+		    max(temp[0], temp[1]) < 55000)
+			cool = true;
+	}
+
+	if (temp_unavailable || mca->connector_latched)
+		mca->connector_sleep_isolated = false;
+	WRITE_ONCE(mca->connector_blocked, temp_unavailable || mca->connector_latched ||
+		   mca->connector_mos_state != MCA_CONNECTOR_MOS_CONDUCTING);
+	ret = 0;
+	pin_unknown = mca->connector_mos_state == MCA_CONNECTOR_MOS_UNKNOWN;
+	if (pin_unknown || temp_unavailable || mca->connector_latched) {
+		int stop, verify;
+
+		/*
+		 * Open the local protection switch before any ADSP request can
+		 * block. Its VBUS readback is on the tablet side of the switch.
+		 */
+		ret = piano_mca_connector_isolate(mca, true);
+		stop = piano_mca_connector_stop(mca, event);
+		verify = ret ?: piano_mca_connector_verify_isolation(mca);
+		ret = verify ?: stop;
+		if (ret)
+			dev_err_ratelimited(mca->dev,
+					    "USB connector power removal could not be confirmed: %d\n",
+					    ret);
+	}
+
+	/* Low VBUS behind the MOS does not establish physical removal. */
+	state = piano_mca_connector_state(mca);
+	if (!pin_unknown && !ret && cool && mca->connector_blocked) {
+		if (piano_mca_connector_can_restore(mca, state)) {
+			ret = piano_mca_connector_restore(mca, state, event);
+			if (ret && ret != -EAGAIN)
+				dev_err_ratelimited(mca->dev,
+						    "USB connector restore failed, power control stays paused: %d\n",
+						    ret);
+		}
+	} else if (!mca->connector_blocked) {
+		mca->connector_stop_confirmed = false;
+	}
+
+	if (was_latched != mca->connector_latched) {
+		dev_warn(mca->dev, "USB connector protection %s at %d/%d C\n",
+			 mca->connector_latched ? "triggered" : "cleared",
+			 mca->connector_temp[0], mca->connector_temp[1]);
+	}
+	if (was_latched != mca->connector_latched || was_blocked != mca->connector_blocked)
+		power_supply_changed(mca->usb);
+	if (was_blocked != mca->connector_blocked)
+		mod_delayed_work(system_freezable_wq, &mca->poll, 0);
+
+	/*
+	 * With a powered or unclassified connector the host must keep sampling.
+	 * Allow system suspend after confirmed physical detach, not low voltage.
+	 */
+	awake = state != MCA_CONNECTOR_DETACHED || ret;
+	piano_mca_connector_schedule(mca, event, awake);
+}
+
+static void piano_mca_connector_wake_release(void *data)
+{
+	struct piano_mca *mca = data;
+	struct wakeup_source *wake;
+
+	scoped_guard(spinlock_irqsave, &mca->connector_event_lock) {
+		wake = mca->connector_wake;
+		mca->connector_control = false;
+		mca->connector_wake = NULL;
+	}
+	wakeup_source_unregister(wake);
+}
+
+static int piano_mca_register_connector(struct piano_mca *mca)
+{
+	struct wakeup_source *wake;
+	int ret;
+
+	if (!device_property_present(mca->dev, "connector-isolation-gpios"))
+		return 0;
+	mca->connector_mos = devm_gpiod_get(mca->dev, "connector-isolation", GPIOD_ASIS);
+	if (IS_ERR(mca->connector_mos))
+		return PTR_ERR(mca->connector_mos);
+	ret = gpiod_get_value_cansleep(mca->connector_mos);
+	if (ret < 0)
+		return ret;
+	/* Preserve an inherited isolation without claiming a past overheat. */
+	mca->connector_mos_state = ret ? MCA_CONNECTOR_MOS_ISOLATED :
+					MCA_CONNECTOR_MOS_CONDUCTING;
+	ret = gpiod_direction_output(mca->connector_mos, ret);
+	if (ret)
+		return ret;
+	mca->connector_blocked = true;
+	ret = devm_add_action_or_reset(mca->dev, piano_mca_connector_release, mca);
+	if (ret)
+		return ret;
+	wake = wakeup_source_register(mca->dev, "USB connector protection");
+	if (IS_ENABLED(CONFIG_PM_SLEEP) && !wake)
+		return -ENOMEM;
+	mca->connector_wake = wake;
+	ret = devm_add_action_or_reset(mca->dev, piano_mca_connector_wake_release, mca);
+	if (ret)
+		return ret;
+	mca->connector_control = true;
+	/* Initial source state is unknown until the first actual UCSI read. */
+	__pm_stay_awake(wake);
+	return 0;
+}
