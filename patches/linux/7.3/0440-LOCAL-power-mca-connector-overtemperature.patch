+static void piano_mca_connector_suspend_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_connector_prepare(test, true), 0);
+	piano_mca_test_connector_poll(f);
+	f->connector_present = true;
+	f->connector_otg = true;
+	KUNIT_EXPECT_EQ(test, piano_mca_suspend(f->mca.dev), -EBUSY);
+	KUNIT_EXPECT_FALSE(test, f->mca.policy_suspended);
+	cancel_delayed_work_sync(&f->mca.connector_work);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_wake->active);
+	f->connector_present = false;
+	f->connector_otg = false;
+	f->vbus_uv = 0;
+	KUNIT_ASSERT_EQ(test, piano_mca_suspend(f->mca.dev), 0);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_TRUE(test, f->mca.policy_suspended);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+	f->connector_present = true;
+	KUNIT_ASSERT_EQ(test, piano_mca_resume(f->mca.dev), 0);
+	cancel_delayed_work_sync(&f->mca.connector_work);
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_FALSE(test, f->connector_pin);
+	KUNIT_EXPECT_FALSE(test, f->mca.policy_suspended);
+}
