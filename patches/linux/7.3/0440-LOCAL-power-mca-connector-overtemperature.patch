+static void piano_mca_connector_offline_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_connector_prepare(test, false), 0);
+	f->mca.service_up = false;
+	f->connector_input[0].error = -EIO;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->connector_pin);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_blocked);
+	KUNIT_EXPECT_FALSE(test, f->mca.connector_latched);
+	KUNIT_EXPECT_EQ(test, f->pmic_disable_writes, 0U);
+	f->connector_input[0].error = 0;
+	f->connector_input[1].temp_mc = 65000;
+	piano_mca_test_connector_poll(f);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_latched);
+	KUNIT_EXPECT_TRUE(test, f->mca.connector_wake->active);
+}
