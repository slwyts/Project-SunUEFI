+
+	piano_mca_skin_limits_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_connector_prepare(test, true), 0);
+	f->connector_present = true;
+	f->connector_input[0].temp_mc = 61000;
