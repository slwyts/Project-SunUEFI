From b81e8ae33b75f2f08f48c35c99ad37c146c39342 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 22:14:19 +0800
Subject: [PATCH] Input: nt36532e: gate requested pen scanning on dock and
 sleep

Consume the existing SW_PEN_INSERTED switch from SC96231 or the Piano dock through an input handler. Keep the requested model while docked and restore it after removal and firmware recovery. Stop scanning before panel or system sleep; defer firmware restore until the controller is awake. Do not add a userspace interface or select an unobserved pen model.
---
 drivers/input/touchscreen/nt36532e/nt36xxx.c | 174 ++++++++++++++++++-
 drivers/input/touchscreen/nt36532e/nt36xxx.h |   7 +-
 2 files changed, 173 insertions(+), 8 deletions(-)

diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx.c b/drivers/input/touchscreen/nt36532e/nt36xxx.c
index 7caa2b68a..0460563ef 100644
--- a/drivers/input/touchscreen/nt36532e/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx.c
@@ -26,6 +26,7 @@
 #include <linux/seq_file.h>
 #include <linux/poll.h>
 #include <linux/power_supply.h>
+#include <linux/property.h>
 #include <linux/gpio/consumer.h>
 #include <linux/input/mt.h>
 #include <linux/of_irq.h>
@@ -806,6 +807,17 @@ static int nvt_thp_set_pen_switch(u8 value)
 	return ack[1] ? -ETIMEDOUT : 0;
 }
 
+static int nvt_thp_apply_stylus(u8 mode)
+{
+	bool enabled = mode && !READ_ONCE(ts->pen_docked);
+	int ret;
+
+	ret = nvt_set_custom_cmd(0x04, enabled);
+	if (!ret && enabled)
+		ret = nvt_thp_set_pen_switch(mode);
+	return ret;
+}
+
 static ssize_t nvt_thp_stylus_write(struct file *file,
 				    const char __user *buf, size_t count,
 				    loff_t *ppos)
@@ -832,9 +844,7 @@ static ssize_t nvt_thp_stylus_write(struct file *file,
 		ret = 0;
 		goto out;
 	}
-	ret = nvt_set_custom_cmd(0x04, mode != 0);
-	if (!ret && mode)
-		ret = nvt_thp_set_pen_switch(mode);
+	ret = nvt_thp_apply_stylus(mode);
 	if (!ret)
 		ts->thp_stylus_mode = mode;
 out:
@@ -894,19 +904,145 @@ int nvt_thp_restore_stylus(void)
 	u8 mode;
 	int ret;
 
+	if (!bTouchIsAwake || ts->dev_pm_suspend || !ts->thp_firmware_ready ||
+	    ts->ic_state == NVT_IC_SUSPEND_IN || ts->ic_state == NVT_IC_SUSPEND_OUT)
+		return 0;
 	mode = READ_ONCE(ts->thp_stylus_mode);
 	if (!mode)
 		return 0;
 
-	ret = nvt_set_custom_cmd(0x04, 1);
-	if (!ret)
-		ret = nvt_thp_set_pen_switch(mode);
+	ret = nvt_thp_apply_stylus(mode);
 	if (ret)
 		NVT_ERR("failed to restore THP stylus state: %d\n", ret);
 
 	return ret;
 }
 
+static void nvt_pen_scan_work(struct work_struct *work)
+{
+	struct nvt_ts_data *data = container_of(work, struct nvt_ts_data,
+						pen_scan_work);
+
+	disable_irq(data->client->irq);
+	mutex_lock(&data->lock);
+	nvt_thp_restore_stylus();
+	mutex_unlock(&data->lock);
+	enable_irq(data->client->irq);
+}
+
+static void nvt_pen_dock_event(struct input_handle *handle, unsigned int type,
+			       unsigned int code, int value)
+{
+	struct nvt_ts_data *data = handle->private;
+
+	if (type != EV_SW || code != SW_PEN_INSERTED)
+		return;
+	WRITE_ONCE(data->pen_docked, !!value);
+	queue_work(data->event_wq, &data->pen_scan_work);
+}
+
+static void nvt_pen_dock_start(struct input_handle *handle)
+{
+	struct nvt_ts_data *data = handle->private;
+	unsigned long flags;
+
+	spin_lock_irqsave(&handle->dev->event_lock, flags);
+	WRITE_ONCE(data->pen_docked, test_bit(SW_PEN_INSERTED, handle->dev->sw));
+	spin_unlock_irqrestore(&handle->dev->event_lock, flags);
+	queue_work(data->event_wq, &data->pen_scan_work);
+}
+
+static bool nvt_pen_dock_match(struct input_handler *handler, struct input_dev *input)
+{
+	struct device *parent = input->dev.parent;
+
+	return parent && (device_is_compatible(parent, "southchip,sc96231") ||
+			  device_is_compatible(parent, "xiaomi,piano-pen-dock"));
+}
+
+static int nvt_pen_dock_connect(struct input_handler *handler,
+				struct input_dev *input,
+				const struct input_device_id *id)
+{
+	struct nvt_ts_data *data = handler->private;
+	struct input_handle *handle = &data->pen_dock_handle;
+	int ret;
+
+	if (handle->dev)
+		return -EBUSY;
+	handle->dev = input_get_device(input);
+	handle->handler = handler;
+	handle->private = data;
+	handle->name = "nt36532e-pen-dock";
+	ret = input_register_handle(handle);
+	if (ret)
+		goto put_device;
+	ret = input_open_device(handle);
+	if (ret)
+		goto unregister_handle;
+	return 0;
+
+unregister_handle:
+	input_unregister_handle(handle);
+put_device:
+	input_put_device(handle->dev);
+	handle->dev = NULL;
+	return ret;
+}
+
+static void nvt_pen_dock_disconnect(struct input_handle *handle)
+{
+	struct nvt_ts_data *data = handle->private;
+
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	input_put_device(handle->dev);
+	handle->dev = NULL;
+	WRITE_ONCE(data->pen_docked, false);
+	queue_work(data->event_wq, &data->pen_scan_work);
+}
+
+static const struct input_device_id nvt_pen_dock_ids[] = {
+	{
+		.flags = INPUT_DEVICE_ID_MATCH_EVBIT | INPUT_DEVICE_ID_MATCH_SWBIT,
+		.evbit = { [BIT_WORD(EV_SW)] = BIT_MASK(EV_SW) },
+		.swbit = { [BIT_WORD(SW_PEN_INSERTED)] = BIT_MASK(SW_PEN_INSERTED) },
+	},
+	{ }
+};
+
+static int nvt_pen_dock_init(void)
+{
+	int ret;
+
+	INIT_WORK(&ts->pen_scan_work, nvt_pen_scan_work);
+	ts->pen_dock_handler = (struct input_handler) {
+		.private = ts,
+		.name = "nt36532e-pen-dock",
+		.id_table = nvt_pen_dock_ids,
+		.match = nvt_pen_dock_match,
+		.connect = nvt_pen_dock_connect,
+		.disconnect = nvt_pen_dock_disconnect,
+		.event = nvt_pen_dock_event,
+		.start = nvt_pen_dock_start,
+	};
+	ret = input_register_handler(&ts->pen_dock_handler);
+	if (!ret)
+		ts->pen_dock_registered = true;
+	else
+		cancel_work_sync(&ts->pen_scan_work);
+	return ret;
+}
+
+static void nvt_pen_dock_free(void)
+{
+	if (ts->pen_dock_registered) {
+		input_unregister_handler(&ts->pen_dock_handler);
+		ts->pen_dock_registered = false;
+	}
+	cancel_work_sync(&ts->pen_scan_work);
+}
+
 static bool nvt_thp_stream_ready(void)
 {
 	return !kfifo_is_empty(&ts->thp_stream_fifo) ||
@@ -2529,6 +2665,9 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 	}
 
 	bTouchIsAwake = 1;
+	ret = nvt_pen_dock_init();
+	if (ret)
+		goto err_create_thp_proc;
 	NVT_LOG("end\n");
 
 #if BOOT_UPDATE_FIRMWARE
@@ -2625,6 +2764,7 @@ static void nvt_ts_remove(struct spi_device *client)
 	nvt_panel_remove_follower(ts);
 
 	bTouchIsAwake = 0;
+	nvt_pen_dock_free();
 	WRITE_ONCE(ts->thp_capture_enabled, false);
 	wake_up_interruptible(&ts->thp_stream_wait);
 	proc_remove(ts->thp_game_rollback_proc);
@@ -2693,6 +2833,8 @@ static void nvt_ts_shutdown(struct spi_device *client)
 	NVT_LOG("Shutdown driver...\n");
 
 	nvt_panel_remove_follower(ts);
+	bTouchIsAwake = 0;
+	nvt_pen_dock_free();
 
 	if (ts->power_supply_registered) {
 		power_supply_unreg_notifier(&ts->power_supply_notifier);
@@ -2726,6 +2868,8 @@ return:
 *******************************************************/
 static int32_t nvt_ts_suspend(struct device *dev)
 {
+	int ret;
+
 	if (!bTouchIsAwake) {
 		NVT_LOG("Touch is already suspend\n");
 		return 0;
@@ -2740,6 +2884,11 @@ static int32_t nvt_ts_suspend(struct device *dev)
 
 	NVT_LOG("start\n");
 
+	if (ts->thp_firmware_ready && ts->thp_stylus_mode) {
+		ret = nvt_set_custom_cmd(0x04, 0);
+		if (ret)
+			NVT_ERR("failed to stop pen scanning before panel sleep: %d\n", ret);
+	}
 	bTouchIsAwake = 0;
 	nvt_input_reset();
 
@@ -2878,8 +3027,17 @@ MODULE_DEVICE_TABLE(of, nvt_match_table);
 #ifdef CONFIG_PM
 static int nvt_pm_suspend(struct device *dev)
 {
+	int ret;
+
 	NVT_LOG("system enters into pm_suspend");
 	mutex_lock(&ts->lock);
+	if (bTouchIsAwake && ts->thp_firmware_ready && ts->thp_stylus_mode) {
+		ret = nvt_set_custom_cmd(0x04, 0);
+		if (ret) {
+			mutex_unlock(&ts->lock);
+			return ret;
+		}
+	}
 	nvt_input_reset();
 	ts->dev_pm_suspend = true;
 	reinit_completion(&ts->dev_pm_suspend_completion);
@@ -2899,9 +3057,11 @@ static int nvt_pm_resume(struct device *dev)
 	 * prepared callback restores scanning instead. */
 	mutex_lock(&ts->lock);
 	if (ts->thp_firmware_ready &&
+	    ts->ic_state != NVT_IC_SUSPEND_IN && ts->ic_state != NVT_IC_SUSPEND_OUT &&
 	    (!ts->panel_follower_registered || ts->panel_on)) {
-		nvt_irq_enable(true);
 		bTouchIsAwake = 1;
+		nvt_thp_restore_stylus();
+		nvt_irq_enable(true);
 	}
 	mutex_unlock(&ts->lock);
 	NVT_LOG("system resume from pm_suspend2");
diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx.h b/drivers/input/touchscreen/nt36532e/nt36xxx.h
index 7d8bf1abb..2c0944b7a 100644
--- a/drivers/input/touchscreen/nt36532e/nt36xxx.h
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx.h
@@ -21,6 +21,7 @@
 #define		_LINUX_NVT_TOUCH_H
 
 #include <linux/delay.h>
+#include <linux/input.h>
 #include <linux/kfifo.h>
 #include <linux/notifier.h>
 #include <linux/of.h>
@@ -36,7 +37,6 @@
 #include "nt36xxx-matrix.h"
 
 struct proc_dir_entry;
-struct input_dev;
 
 struct nvt_input_slot {
 	s32 x, y;
@@ -150,6 +150,11 @@ struct nvt_ts_data {
 	int power_supply_status;
 	bool power_supply_registered;
 	bool panel_on;
+	struct input_handler pen_dock_handler;
+	struct input_handle pen_dock_handle;
+	struct work_struct pen_scan_work;
+	bool pen_docked;
+	bool pen_dock_registered;
 	struct input_dev *input;
 	struct nvt_matrix *matrix;
 	struct nvt_input_slot input_slots[NVT_MATRIX_MAX_POINTS];
