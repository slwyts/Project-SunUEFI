From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia.pukngae@linux.dev>
Date: Thu, 26 Nov 2026 07:46:45 +0800
Subject: [PATCH] wifi: ath12k: Enable Piano bus mastering after confirming
 reset

Keep PEACH from issuing new DMA requests while the old firmware
session can still use its rings. Confirm PBL, RESET or READY, and a
cleared MHICTRL.RESET before enabling PCI bus mastering. Retain the
normal hardware reset sequence on other boards. When a master-enable
readback fails, attempt to clear and check the bit before returning.

If MHI start fails and PCI is no longer reachable, stop attempting
BAR accesses in this callback. The caller must retain the existing
context until it can verify the endpoint has stopped DMA.

Codex compared the existing power-up and fourth-batch paths, adapted
the readback failure path, and built the affected ARM64 modules.

Assisted-by: LLM
Signed-off-by: Cryolitia PukNgae <cryolitia.pukngae@linux.dev>
---
 drivers/net/wireless/ath/ath12k/pci.c       | 160 +++++++++++++++++++-
 drivers/net/wireless/ath/ath12k/pci.h       |   5 +
 drivers/net/wireless/ath/ath12k/wifi7/pci.c |   5 +-
 3 files changed, 165 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 280c884bb..3fa523fb5 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -6,6 +6,7 @@
 
 #include <linux/module.h>
 #include <linux/interrupt.h>
+#include <linux/iopoll.h>
 #include <linux/msi.h>
 #include <linux/of.h>
 #include <linux/of_reserved_mem.h>
@@ -832,6 +833,64 @@ static int ath12k_pci_config_msi_data(struct ath12k_pci *ab_pci)
 	return 0;
 }
 
+static bool ath12k_pci_is_piano_wlan(struct pci_dev *pdev)
+{
+	return IS_ENABLED(CONFIG_PM_SLEEP) &&
+	       pdev->device == ATH12K_PCI_DEVICE_ID_PEACH &&
+	       of_machine_is_compatible("xiaomi,piano");
+}
+
+static int ath12k_pci_pdev_read_command(struct pci_dev *pdev, u16 *command)
+{
+	u16 pmcsr;
+
+	if (pci_channel_offline(pdev) || pdev->current_state != PCI_D0 ||
+	    !pdev->pm_cap)
+		return -EIO;
+
+	if (pci_read_config_word(pdev, pdev->pm_cap + PCI_PM_CTRL, &pmcsr) ||
+	    PCI_POSSIBLE_ERROR(pmcsr) ||
+	    (pmcsr & PCI_PM_CTRL_STATE_MASK) != PCI_D0)
+		return -EIO;
+
+	if (pci_read_config_word(pdev, PCI_COMMAND, command) ||
+	    PCI_POSSIBLE_ERROR(*command) || !(*command & PCI_COMMAND_MEMORY))
+		return -EIO;
+
+	return 0;
+}
+
+static int ath12k_pci_fence_master(struct pci_dev *pdev, bool *restore_master)
+{
+	u16 command, devsta;
+	int ret;
+
+	ret = ath12k_pci_pdev_read_command(pdev, &command);
+	if (ret)
+		return ret;
+
+	if (command & PCI_COMMAND_MASTER) {
+		if (restore_master)
+			*restore_master = true;
+		pci_clear_master(pdev);
+		ret = ath12k_pci_pdev_read_command(pdev, &command);
+		if (ret)
+			return ret;
+	}
+
+	if (command & PCI_COMMAND_MASTER)
+		return -EIO;
+
+	if (!pci_wait_for_pending_transaction(pdev))
+		return -EBUSY;
+
+	if (pcie_capability_read_word(pdev, PCI_EXP_DEVSTA, &devsta) ||
+	    PCI_POSSIBLE_ERROR(devsta) || (devsta & PCI_EXP_DEVSTA_TRPND))
+		return -EIO;
+
+	return 0;
+}
+
 static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 {
 	struct device_node *mem_node __free(device_node) =
@@ -860,6 +919,12 @@ static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 		goto out;
 	}
 
+	if (ath12k_pci_is_piano_wlan(pdev)) {
+		ret = ath12k_pci_fence_master(pdev, NULL);
+		if (ret)
+			goto disable_device;
+	}
+
 	ret = pci_request_region(pdev, ATH12K_PCI_BAR_NUM, "ath12k_pci");
 	if (ret) {
 		ath12k_err(ab, "failed to request pci region: %d\n", ret);
@@ -882,7 +947,8 @@ static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 		}
 	}
 
-	pci_set_master(pdev);
+	if (!ath12k_pci_is_piano_wlan(pdev))
+		pci_set_master(pdev);
 
 	ab->mem_len = pci_resource_len(pdev, ATH12K_PCI_BAR_NUM);
 	ab->mem = pci_iomap(pdev, ATH12K_PCI_BAR_NUM, 0);
@@ -1462,14 +1528,93 @@ static void ath12k_pci_coredump_download(struct ath12k_base *ab)
 }
 #endif
 
+static bool ath12k_pci_pdev_in_reset(struct ath12k_pci *ab_pci)
+{
+	struct mhi_controller *mhi = ab_pci->mhi_ctrl;
+	enum mhi_state state;
+	u16 command;
+	u32 ctrl;
+
+	if (ath12k_pci_pdev_read_command(ab_pci->pdev, &command) ||
+	    (command & PCI_COMMAND_MASTER) || mhi_get_exec_env(mhi) != MHI_EE_PBL)
+		return false;
+
+	ctrl = ath12k_pci_read32(ab_pci->ab, MHICTRL);
+	if (PCI_POSSIBLE_ERROR(ctrl) || (ctrl & MHICTRL_RESET_MASK))
+		return false;
+
+	state = mhi_get_mhi_state(mhi);
+	return state == MHI_STATE_RESET || state == MHI_STATE_READY;
+}
+
+static int ath12k_pci_pdev_wait_for_reset(struct ath12k_pci *ab_pci)
+{
+	const struct mhi_controller_config *config = ab_pci->ab->hw_params->mhi_config;
+	bool reset;
+
+	/* The MHI start path extends the live timeout for firmware download. */
+	return read_poll_timeout(ath12k_pci_pdev_in_reset, reset, reset, 25000,
+				 config->timeout_ms * USEC_PER_MSEC, false, ab_pci);
+}
+
+static int ath12k_pci_peach_enable_master(struct ath12k_pci *ab_pci)
+{
+	struct pci_dev *pdev = ab_pci->pdev;
+	u16 command;
+	int ret;
+
+	ret = ath12k_pci_pdev_wait_for_reset(ab_pci);
+	if (ret)
+		return ret;
+
+	pci_set_master(pdev);
+	ret = ath12k_pci_pdev_read_command(pdev, &command);
+	if (!ret && (command & PCI_COMMAND_MASTER))
+		return 0;
+
+	/* The write may have reached the endpoint despite a failed readback. */
+	ret = ath12k_pci_fence_master(pdev, NULL);
+	if (ret)
+		ath12k_err(ab_pci->ab, "failed to stop PCI DMA after master enable: %d\n", ret);
+	return ret ?: -EIO;
+}
+
 int ath12k_pci_power_up(struct ath12k_base *ab)
 {
 	struct ath12k_pci *ab_pci = ath12k_pci_priv(ab);
+	struct pci_dev *pdev = ab_pci->pdev;
+	bool piano_wlan = ath12k_pci_is_piano_wlan(pdev);
+	bool master_enabled = false;
 	int ret;
 
+	if (piano_wlan) {
+		ret = ath12k_pci_fence_master(pdev, NULL);
+		if (ret) {
+			ath12k_err(ab, "failed to fence PCI DMA before reset: %d\n", ret);
+			return ret;
+		}
+
+		/* A confirmed reset allows the usual reset sequence with DMA enabled. */
+		if (ath12k_pci_pdev_in_reset(ab_pci)) {
+			ret = ath12k_pci_peach_enable_master(ab_pci);
+			if (ret)
+				return ret;
+			master_enabled = true;
+		}
+	}
+
 	ab_pci->register_window = 0;
 	clear_bit(ATH12K_PCI_FLAG_INIT_DONE, &ab_pci->flags);
-	ath12k_pci_sw_reset(ab_pci->ab, true);
+	ath12k_pci_sw_reset(ab, true);
+
+	/* A previous PEACH session may still own DMA addresses after unbind. */
+	if (piano_wlan && !master_enabled) {
+		ret = ath12k_pci_peach_enable_master(ab_pci);
+		if (ret) {
+			ath12k_err(ab, "failed to enable PCI DMA after reset: %d\n", ret);
+			return ret;
+		}
+	}
 
 	/* Disable ASPM during firmware download due to problems switching
 	 * to AMSS state.
@@ -1484,6 +1629,17 @@ int ath12k_pci_power_up(struct ath12k_base *ab)
 	ret = ath12k_mhi_start(ab_pci);
 	if (ret) {
 		ath12k_err(ab, "failed to start mhi: %d\n", ret);
+		if (piano_wlan) {
+			int fence_ret = ath12k_pci_fence_master(pdev, NULL);
+
+			if (fence_ret) {
+				ath12k_warn(ab, "failed to fence PCI DMA after startup: %d\n",
+					    fence_ret);
+				return ret;
+			}
+		}
+		ath12k_pci_msi_disable(ab_pci);
+		ath12k_pci_aspm_restore(ab_pci);
 		return ret;
 	}
 
diff --git a/drivers/net/wireless/ath/ath12k/pci.h b/drivers/net/wireless/ath/ath12k/pci.h
index 0e0e2020c..bb56a10b5 100644
--- a/drivers/net/wireless/ath/ath12k/pci.h
+++ b/drivers/net/wireless/ath/ath12k/pci.h
@@ -9,8 +9,13 @@
 #include <linux/mhi.h>
 #include <linux/pci.h>
 
+#include <linux/mhi.h>
+#include <linux/pci.h>
+
 #include "core.h"
 
+#define ATH12K_PCI_DEVICE_ID_PEACH		0x110e
+
 #define PCIE_SOC_GLOBAL_RESET			0x3008
 #define PCIE_SOC_GLOBAL_RESET_V			1
 
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/pci.c b/drivers/net/wireless/ath/ath12k/wifi7/pci.c
index 311a10815..a408ff4c8 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/pci.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/pci.c
@@ -19,7 +19,6 @@
 
 #define QCN9274_DEVICE_ID		0x1109
 #define WCN7850_DEVICE_ID		0x1107
-#define PEACH_DEVICE_ID			0x110e
 #define QCC2072_DEVICE_ID		0x1112
 
 #define ATH12K_PCI_W7_SOC_HW_VERSION_1	1
@@ -35,7 +34,7 @@
 static const struct pci_device_id ath12k_wifi7_pci_id_table[] = {
 	{ PCI_VDEVICE(QCOM, QCN9274_DEVICE_ID) },
 	{ PCI_VDEVICE(QCOM, WCN7850_DEVICE_ID) },
-	{ PCI_VDEVICE(QCOM, PEACH_DEVICE_ID) },
+	{ PCI_VDEVICE(QCOM, ATH12K_PCI_DEVICE_ID_PEACH) },
 	{ PCI_VDEVICE(QCOM, QCC2072_DEVICE_ID) },
 	{}
 };
@@ -168,7 +167,7 @@ static int ath12k_wifi7_pci_probe(struct pci_dev *pdev,
 			return -EOPNOTSUPP;
 		}
 		break;
-	case PEACH_DEVICE_ID:
+	case ATH12K_PCI_DEVICE_ID_PEACH:
 		ab->id.bdf_search = ATH12K_BDF_SEARCH_BUS_AND_BOARD;
 		ab_pci->msi_config = &ath12k_wifi7_msi_config[1];
 		ab->static_window_map = false;
-- 
