index 541f0a8db3a..59cd80c3400 100644
--- a/drivers/input/touchscreen/nt36532e/nt36xxx.h
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx.h
@@ -35,6 +35,7 @@
 #include "nt36xxx_mem_map.h"
 
 struct proc_dir_entry;
+struct nvt_mt;
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 6, 0)
 #define HAVE_PROC_OPS
@@ -145,6 +146,7 @@ struct nvt_ts_data {
 	bool panel_on;
 	struct mutex thp_lock; /* protects the frame buffer and stream FIFO */
 	u8 *thp_frame;
+	struct nvt_mt *mt; /* finger decoding and the MT-B input device */
 	bool thp_capture_enabled;
