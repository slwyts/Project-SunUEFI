diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx_mt.c b/drivers/input/touchscreen/nt36532e/nt36xxx_mt.c
new file mode 100644
index 00000000000..936fa921868
--- /dev/null
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx_mt.c
@@ -0,0 +1,779 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Novatek NT36532E THP finger decoding.
+ *
+ * The touch IC reports a mutual-capacitance frame; a finger appears as a local
+ * maximum in the difference between the live frame and a learned reference.
+ * The stock p81 driver decodes this in the kernel and reports an MT-B input
+ * device. This one published the raw frame on /proc/nvt_thp_stream and had a
+ * userspace process decode it and report back through uinput. Decode here and
+ * report a standard input device instead; the stream stays as the diagnostic
+ * and stylus capture path.
+ *
+ * Payload layout, as parsed by the stock p81 driver
+ * (p81/nt36532/nt36xxx.c, nvt_ts_prase_data_func):
+ *
+ *   +4 u16 checksum      +8 s32 crc_len (dwords from +20)
+ *   +12 u16 ~checksum    +16 s32 ~crc_len
+ *   +28 u16 frame_no     +48 u8 columns   +49 u8 rows
+ *   +56 u8 data type     +64 s16 matrix[rows][columns]
+ *
+ * checksum == -(sum of the crc_len * 2 u16 words from +20).
+ *
+ * Landscape mapping measured on Piano: sensor columns run along screen x,
+ * sensor rows along screen y with y reversed.
+ */
+#include <linux/device.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/math.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#include "nt36xxx_mt.h"
+
+/* Piano panel mode: 3200x2136 on 239x163 mm */
+#define NVT_MT_PANEL_W_MM	239
+#define NVT_MT_PANEL_H_MM	163
+#define NVT_MT_SCREEN_W		3200
+#define NVT_MT_SCREEN_H		2136
+/* 3200/239 and 2136/163, the units/mm libinput uses for its arbitration area */
+#define NVT_MT_SCREEN_RES	13
+/* largest sensible contact size, the screen diagonal in touch units */
+#define NVT_MT_SIZE_MAX		3848
+
+/* a contact moving further than this between frames is a new finger */
+#define NVT_MT_TRACK_DIST	400
+#define NVT_MT_MAX_POINTS	10
+#define NVT_MT_MAX_NODES	4096
+#define NVT_MT_MAX_TYPES	256
+#define NVT_MT_MAX_LINE		256
+/*
+ * Cells in a palm: palm_area_num_level2 of the stock
+ * /odm/firmware/piano_nova_{boe,csot}_thp_config.ini, same 60x40 matrix.
+ */
+#define NVT_MT_PALM_AREA_CELLS	70
+
+/* 32 frames at 360 Hz; the reference is only learned with the screen clear. */
+#define NVT_MT_REF_FRAMES	32
+#define NVT_MT_PROBE_FRAMES	16
+#define NVT_MT_THRESHOLD	200
+
+struct nvt_mt_area {
+	unsigned int cells;
+	s64 weight;		/* sum of the deltas over the area */
+	s64 x, y;		/* delta-weighted centre, 1/1024 sensor pitch */
+	unsigned int major, minor;	/* touch units */
+	bool palm;
+};
+
+struct nvt_mt_point {
+	s64 x, y;		/* sensor pitch units, in 1/1024ths */
+	int peak;
+	unsigned int major, minor;
+	bool palm;
+};
+
+struct nvt_mt_slot {
+	bool active;
+	int id, x, y, px, py;
+	unsigned int major, minor;
+	bool palm;
+};
+
+struct nvt_mt {
+	struct device *dev;
+	struct input_dev *input;
+	int threshold;
+	unsigned int max_slots;
+
+	unsigned int rows, cols, nodes;
+	int ref_type;
+	unsigned int probe_count;
+	unsigned int probe_types[NVT_MT_MAX_TYPES];
+
+	s16 *samples;		/* NVT_MT_REF_FRAMES windows, nodes each */
+	unsigned int ref_count;
+	s32 *reference;
+	s32 *delta;
+	u8 *area_of;
+	unsigned int *queue;
+	struct nvt_mt_area areas[NVT_MT_MAX_POINTS];
+	unsigned int max_delta;
+
+	int next_id;
+	struct nvt_mt_slot slot[NVT_MT_MAX_POINTS];
+};
+
+static u16 nvt_mt_le16(const u8 *p)
+{
+	return (u16)(p[0] | p[1] << 8);
+}
+
+bool nvt_mt_is_pen_frame(u8 type)
+{
+	/* Stylus frames share the payload and never become the finger reference. */
+	return type == 6 || type == 7 || type == 9 || type == 0x1d;
+}
+
+/*
+ * nvt_mt_checksum() - validate the THP payload header fields
+ * @p: payload start
+ * @len: payload bytes
+ *
+ * Return: 1 for a match, 0 for a mismatch, -1 when the header fields disagree
+ * with each other or describe a payload longer than @len.
+ */
+static int nvt_mt_checksum(const u8 *p, size_t len)
+{
+	u16 csum = nvt_mt_le16(p + 4), csum_inv = nvt_mt_le16(p + 12);
+	s32 crc_len = get_unaligned_le32(p + 8);
+	s32 crc_len_inv = get_unaligned_le32(p + 16);
+	u32 sum = 0;
+	size_t i;
+
+	if (csum_inv != (u16)~csum || crc_len_inv != ~crc_len)
+		return -1;
+	if (crc_len <= 0 || 20 + (size_t)crc_len * 4 > len)
+		return -1;
+
+	for (i = 0; i < (size_t)crc_len * 2; i++)
+		sum += nvt_mt_le16(p + 20 + i * 2);
+
+	return (u16)(~sum + 1) == csum;
+}
+
+/*
+ * The median without ordering the rest of the line: only the value at @k is
+ * needed, and a frame has rows + cols of these lines. Values equal to the
+ * pivot collect between @j and @i and are read directly.
+ */
+static s32 nvt_mt_nth_smallest(s32 *values, int count, int k)
+{
+	int lo = 0, hi = count - 1;
+
+	while (lo < hi) {
+		s32 pivot = values[lo + (hi - lo) / 2];
+		int i = lo, j = hi;
+
+		while (i <= j) {
+			while (values[i] < pivot)
+				i++;
+			while (values[j] > pivot)
+				j--;
+			if (i <= j) {
+				swap(values[i], values[j]);
+				i++;
+				j--;
+			}
+		}
+		if (k <= j)
+			hi = j;
+		else if (k >= i)
+			lo = i;
+		else
+			break;
+	}
+
+	return values[k];
+}
+
+static void nvt_mt_build_reference(struct nvt_mt *mt)
+{
+	s32 line[NVT_MT_REF_FRAMES];
+	unsigned int n, k;
+
+	for (n = 0; n < mt->nodes; n++) {
+		for (k = 0; k < mt->ref_count; k++)
+			line[k] = mt->samples[k * mt->nodes + n];
+		mt->reference[n] = nvt_mt_nth_smallest(line, mt->ref_count,
+						      mt->ref_count / 2);
+	}
+}
+
+/*
+ * Reject line-wide capacitive interference before looking for local peaks.
+ * A finger occupies a small part of a row or column, so the median estimates
+ * the common component without learning the finger into the baseline. Stock
+ * THP has separate line-noise and baseline stages; this is our own
+ * implementation, not a reproduction of its algorithm.
+ */
+static void nvt_mt_remove_line_noise(struct nvt_mt *mt)
+{
+	s32 line[NVT_MT_MAX_LINE];
+	unsigned int r, c, n;
+	s32 common;
+
+	for (c = 0; c < mt->cols; c++) {
+		for (r = 0; r < mt->rows; r++)
+			line[r] = mt->delta[r * mt->cols + c];
+		common = nvt_mt_nth_smallest(line, mt->rows, mt->rows / 2);
+		for (r = 0; r < mt->rows; r++)
+			mt->delta[r * mt->cols + c] -= common;
+	}
+	for (r = 0; r < mt->rows; r++) {
+		for (c = 0; c < mt->cols; c++)
+			line[c] = mt->delta[r * mt->cols + c];
+		common = nvt_mt_nth_smallest(line, mt->cols, mt->cols / 2);
+		for (c = 0; c < mt->cols; c++)
+			mt->delta[r * mt->cols + c] -= common;
+	}
+
+	mt->max_delta = 0;
+	for (n = 0; n < mt->nodes; n++)
+		if (mt->delta[n] > (s32)mt->max_delta)
+			mt->max_delta = mt->delta[n];
+}
+
+static unsigned int nvt_mt_touch_units(s64 micrometres)
+{
+	s64 units;
+
+	if (micrometres <= 0)
+		return 0;
+	units = div_s64(micrometres * NVT_MT_SCREEN_RES, 1000);
+	return units > NVT_MT_SIZE_MAX ? NVT_MT_SIZE_MAX : (unsigned int)units;
+}
+
+/*
+ * Label the 4-connected cells at or above the touch threshold around @start
+ * and measure them. The cell count decides a palm; the second moments of a
+ * filled ellipse give the axes, four standard deviations each. Lengths stay in
+ * micrometres so the square roots are integer.
+ */
+static void nvt_mt_measure_area(struct nvt_mt *mt, unsigned int start,
+				unsigned int label)
+{
+	static const int step_r[] = { -1, 1, 0, 0 };
+	static const int step_c[] = { 0, 0, -1, 1 };
+	s64 cell_w = div_s64((s64)NVT_MT_PANEL_W_MM * 1000, mt->cols);
+	s64 cell_h = div_s64((s64)NVT_MT_PANEL_H_MM * 1000, mt->rows);
+	struct nvt_mt_area *area = &mt->areas[label - 1];
+	s64 sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0;
+	s64 vx, vy, cxy, mid, half;
+	unsigned int head = 0, tail = 0;
+	int k;
+
+	memset(area, 0, sizeof(*area));
+	mt->area_of[start] = label;
+	mt->queue[tail++] = start;
+
+	while (head < tail) {
+		unsigned int node = mt->queue[head++];
+		unsigned int r = node / mt->cols, c = node % mt->cols;
+		s64 x = div_s64((s64)(2 * c + 1) * cell_w, 2);
+		s64 y = div_s64((s64)(2 * r + 1) * cell_h, 2);
+
+		area->cells++;
+		sx += x;
+		sy += y;
+		sxx += x * x;
+		syy += y * y;
+		sxy += x * y;
+		area->weight += mt->delta[node];
+		area->x += (s64)mt->delta[node] * (2 * c + 1);
+		area->y += (s64)mt->delta[node] * (2 * r + 1);
+
+		for (k = 0; k < ARRAY_SIZE(step_r); k++) {
+			int rr = (int)r + step_r[k], cc = (int)c + step_c[k];
+			unsigned int next;
+
+			if (rr < 0 || cc < 0 || rr >= (int)mt->rows ||
+			    cc >= (int)mt->cols)
+				continue;
+			next = rr * mt->cols + cc;
+			if (mt->area_of[next] || mt->delta[next] < mt->threshold)
+				continue;
+			mt->area_of[next] = label;
+			mt->queue[tail++] = next;
+		}
+	}
+
+	if (area->weight > 0) {
+		area->x = div_s64(area->x * 512, area->weight);
+		area->y = div_s64(area->y * 512, area->weight);
+	} else {
+		area->x = (s64)start % mt->cols * 1024 + 512;
+		area->y = (s64)start / mt->cols * 1024 + 512;
+	}
+
+	vx = div_s64(area->cells * sxx - sx * sx, area->cells * area->cells) +
+	     div_s64(cell_w * cell_w, 12);
+	vy = div_s64(area->cells * syy - sy * sy, area->cells * area->cells) +
+	     div_s64(cell_h * cell_h, 12);
+	cxy = div_s64(area->cells * sxy - sx * sy,
+		      area->cells * area->cells);
+
+	/* Eigenvalues of the covariance ellipse, four standard deviations */
+	mid = div_s64(vx + vy, 2);
+	half = (s64)int_sqrt64(div_s64((vx - vy) * (vx - vy), 4) + cxy * cxy);
+	area->major = nvt_mt_touch_units(4 * (s64)int_sqrt64(mid + half));
+	area->minor = mid > half ?
+		nvt_mt_touch_units(4 * (s64)int_sqrt64(mid - half)) : 0;
+	area->palm = area->cells >= NVT_MT_PALM_AREA_CELLS;
+}
+
+/* A finger's position is the 3x3 delta-weighted centroid around its peak. */
+static void nvt_mt_centroid(struct nvt_mt *mt, int r, int c, int peak,
+			    struct nvt_mt_area *area, struct nvt_mt_point *pt)
+{
+	s64 sw = 0, sx = 0, sy = 0;
+	int dr, dc;
+
+	for (dr = -1; dr <= 1; dr++) {
+		for (dc = -1; dc <= 1; dc++) {
+			int rr = r + dr, cc = c + dc, w;
+
+			if (rr < 0 || cc < 0 || rr >= (int)mt->rows ||
+			    cc >= (int)mt->cols)
+				continue;
+			w = mt->delta[rr * mt->cols + cc];
+			if (w <= 0)
+				continue;
+			sw += w;
+			sx += (s64)w * (2 * cc + 1);
+			sy += (s64)w * (2 * rr + 1);
+		}
+	}
+
+	pt->peak = peak;
+	pt->major = area->major;
+	pt->minor = area->minor;
+	pt->palm = false;
+	if (sw > 0) {
+		pt->x = div_s64(sx * 512, sw);
+		pt->y = div_s64(sy * 512, sw);
+	} else {
+		pt->x = (s64)c * 1024 + 512;
+		pt->y = (s64)r * 1024 + 512;
+	}
+}
+
+#define NVT_MT_NEIGHBOURS 9
+
+static unsigned int nvt_mt_find_points(struct nvt_mt *mt,
+				       struct nvt_mt_point *pts)
+{
+	unsigned int r, c, n = 0, labels = 0;
+	bool reported[NVT_MT_MAX_POINTS] = { };
+
+	memset(mt->area_of, 0, mt->nodes);
+
+	for (r = 0; r < mt->rows; r++) {
+		for (c = 0; c < mt->cols; c++) {
+			unsigned int node = r * mt->cols + c;
+			struct nvt_mt_area *area;
+			s32 v = mt->delta[node];
+			bool peak = true;
+			int dr, dc;
+
+			if (v < mt->threshold)
+				continue;
+			if (!mt->area_of[node]) {
+				if (labels == mt->max_slots)
+					continue;
+				nvt_mt_measure_area(mt, node, ++labels);
+			}
+			area = &mt->areas[mt->area_of[node] - 1];
+			if (area->palm || n >= mt->max_slots)
+				continue;
+			for (dr = -1; dr <= 1 && peak; dr++) {
+				for (dc = -1; dc <= 1; dc++) {
+					int rr = (int)r + dr, cc = (int)c + dc;
+					s32 w;
+
+					if ((!dr && !dc) || rr < 0 || cc < 0 ||
+					    rr >= (int)mt->rows ||
+					    cc >= (int)mt->cols)
+						continue;
+					w = mt->delta[rr * mt->cols + cc];
+					/* ties resolve to the first node */
+					if (w > v || (w == v && (dr < 0 ||
+					    (dr == 0 && dc < 0)))) {
+						peak = false;
+						break;
+					}
+				}
+			}
+			if (peak)
+				nvt_mt_centroid(mt, (int)r, (int)c, v, area,
+						&pts[n++]);
+		}
+	}
+
+	/* A palm is one contact, at the centre of everything it covers. */
+	for (r = 0; r < mt->rows && n < mt->max_slots; r++) {
+		for (c = 0; c < mt->cols; c++) {
+			unsigned int label = mt->area_of[r * mt->cols + c];
+			struct nvt_mt_area *area;
+
+			if (!label || reported[label - 1])
+				continue;
+			area = &mt->areas[label - 1];
+			if (!area->palm)
+				continue;
+			reported[label - 1] = true;
+			pts[n].x = area->x;
+			pts[n].y = area->y;
+			pts[n].peak = mt->delta[r * mt->cols + c];
+			pts[n].major = area->major;
+			pts[n].minor = area->minor;
+			pts[n].palm = true;
+			n++;
+		}
+	}
+
+	return n;
+}
+
+/* Sensor pitch to screen pixels: columns across, rows up the screen. */
+static void nvt_mt_to_screen(struct nvt_mt *mt, const struct nvt_mt_point *pt,
+			     int *x, int *y)
+{
+	s64 pitch = (s64)mt->cols * 1024;
+	s64 vertical = (s64)mt->rows * 1024 - pt->y;
+
+	*x = clamp_t(s64, div_s64(pt->x * NVT_MT_SCREEN_W, pitch),
+		     0, NVT_MT_SCREEN_W - 1);
+	*y = clamp_t(s64, div_s64(vertical * NVT_MT_SCREEN_H,
+				  (s64)mt->rows * 1024),
+		     0, NVT_MT_SCREEN_H - 1);
+}
+
+/* Match this frame's points to the slots of the previous one, nearest first. */
+static void nvt_mt_track(struct nvt_mt *mt, const struct nvt_mt_point *pts,
+			 unsigned int count)
+{
+	int px[NVT_MT_MAX_POINTS], py[NVT_MT_MAX_POINTS];
+	bool taken[NVT_MT_MAX_POINTS] = { };
+	unsigned int i;
+	int s;
+
+	for (i = 0; i < count; i++)
+		nvt_mt_to_screen(mt, &pts[i], &px[i], &py[i]);
+
+	for (s = 0; s < mt->max_slots; s++) {
+		struct nvt_mt_slot *slot = &mt->slot[s];
+		int best = -1, best_d = NVT_MT_TRACK_DIST * NVT_MT_TRACK_DIST;
+
+		if (!slot->active)
+			continue;
+		for (i = 0; i < count; i++) {
+			int dx = px[i] - slot->x, dy = py[i] - slot->y;
+
+			if (!taken[i] && dx * dx + dy * dy < best_d) {
+				best = i;
+				best_d = dx * dx + dy * dy;
+			}
+		}
+		if (best < 0) {
+			slot->active = false;
+			continue;
+		}
+		taken[best] = 1;
+		slot->px = slot->x;
+		slot->py = slot->y;
+		slot->x = px[best];
+		slot->y = py[best];
+		slot->major = pts[best].major;
+		slot->minor = pts[best].minor;
+		/* A palm stays a palm until it lifts: a moving palm can lose the
+		 * area size that identified it between two frames.
+		 */
+		slot->palm |= pts[best].palm;
+	}
+
+	for (i = 0; i < count; i++) {
+		if (taken[i])
+			continue;
+		for (s = 0; s < mt->max_slots; s++)
+			if (!mt->slot[s].active)
+				break;
+		if (s == mt->max_slots)
+			break;
+		mt->slot[s].active = true;
+		mt->slot[s].id = mt->next_id++ & 0xffff;
+		mt->slot[s].x = mt->slot[s].px = px[i];
+		mt->slot[s].y = mt->slot[s].py = py[i];
+		mt->slot[s].major = pts[i].major;
+		mt->slot[s].minor = pts[i].minor;
+		mt->slot[s].palm = pts[i].palm;
+	}
+}
+
+/*
+ * Report the slots as one MT-B frame. Palms never press BTN_TOUCH and never
+ * move the single-touch axes, so those are reported after input_mt_sync_frame()
+ * instead of letting the pointer emulation derive them from every contact.
+ */
+static void nvt_mt_report(struct nvt_mt *mt)
+{
+	struct input_dev *input = mt->input;
+	int s, first = -1, touching = 0;
+
+	for (s = 0; s < mt->max_slots; s++) {
+		struct nvt_mt_slot *slot = &mt->slot[s];
+
+		input_mt_slot(input, s);
+		if (!slot->active) {
+			input_mt_report_slot_state(input, MT_TOOL_FINGER, false);
+			continue;
+		}
+		input_mt_report_slot_state(input,
+					   slot->palm ? MT_TOOL_PALM : MT_TOOL_FINGER,
+					   true);
+		input_report_abs(input, ABS_MT_POSITION_X, slot->x);
+		input_report_abs(input, ABS_MT_POSITION_Y, slot->y);
+		input_report_abs(input, ABS_MT_TOUCH_MAJOR, slot->major);
+		input_report_abs(input, ABS_MT_TOUCH_MINOR, slot->minor);
+		if (!slot->palm && first < 0)
+			first = s;
+		if (!slot->palm)
+			touching++;
+	}
+	input_mt_sync_frame(input);
+
+	if (first >= 0) {
+		input_report_abs(input, ABS_X, mt->slot[first].x);
+		input_report_abs(input, ABS_Y, mt->slot[first].y);
+	}
+	input_report_key(input, BTN_TOUCH, touching > 0);
+	input_sync(input);
+}
+
+/* No contact survives the reference being forgotten. */
+static void nvt_mt_release_contacts(struct nvt_mt *mt)
+{
+	int s;
+
+	for (s = 0; s < mt->max_slots; s++)
+		mt->slot[s].active = false;
+	nvt_mt_report(mt);
+	mt->ref_count = 0;
+	mt->ref_type = -1;
+	memset(mt->probe_types, 0, sizeof(mt->probe_types));
+	mt->probe_count = 0;
+}
+
+static int nvt_mt_set_geometry(struct nvt_mt *mt, unsigned int rows,
+			       unsigned int cols)
+{
+	unsigned int nodes = rows * cols;
+
+	if (!rows || !cols || nodes > NVT_MT_MAX_NODES)
+		return -EINVAL;
+	if (mt->nodes == nodes && mt->rows == rows && mt->cols == cols)
+		return 0;
+
+	kfree(mt->samples);
+	kfree(mt->reference);
+	kfree(mt->delta);
+	kfree(mt->area_of);
+	kfree(mt->queue);
+
+	mt->samples = kvmalloc_array((size_t)NVT_MT_REF_FRAMES * nodes,
+				     sizeof(*mt->samples), GFP_KERNEL);
+	mt->reference = kvmalloc_array(nodes, sizeof(*mt->reference), GFP_KERNEL);
+	mt->delta = kvmalloc_array(nodes, sizeof(*mt->delta), GFP_KERNEL);
+	mt->area_of = kvcalloc(nodes, sizeof(*mt->area_of), GFP_KERNEL);
+	mt->queue = kvmalloc_array(nodes, sizeof(*mt->queue), GFP_KERNEL);
+	if (!mt->samples || !mt->reference || !mt->delta || !mt->area_of ||
+	    !mt->queue)
+		return -ENOMEM;
+
+	mt->rows = rows;
+	mt->cols = cols;
+	mt->nodes = nodes;
+	mt->ref_count = 0;
+
+	return 0;
+}
+
+static void nvt_mt_lock_type(struct nvt_mt *mt)
+{
+	unsigned int type, best = 0;
+
+	for (type = 0; type < NVT_MT_MAX_TYPES; type++)
+		if (mt->probe_types[type] > mt->probe_types[best])
+			best = type;
+	mt->ref_type = best;
+}
+
+/**
+ * nvt_mt_feed() - decode one THP payload into the input device
+ * @mt: decoder state
+ * @payload: payload start, after the 257-byte event buffer
+ * @bytes: payload bytes available
+ *
+ * Frames of other types (stylus) are ignored. The first frames after a reset
+ * only learn the reference; nothing is reported until it exists.
+ */
+void nvt_mt_feed(struct nvt_mt *mt, const u8 *payload, size_t bytes)
+{
+	unsigned int rows, cols, nodes, n;
+	unsigned int type;
+	bool have_reference;
+	size_t plen = bytes;
+	int ret;
+
+	if (plen < 64)
+		return;
+
+	type = payload[56];
+	rows = payload[49];
+	cols = payload[48];
+
+	ret = nvt_mt_checksum(payload, plen);
+	if (ret <= 0)
+		return;
+	nodes = rows * cols;
+	if (!nodes || nodes > NVT_MT_MAX_NODES || 64 + (size_t)nodes * 2 > plen)
+		return;
+
+	if (mt->ref_type < 0) {
+		if (nvt_mt_is_pen_frame(type))
+			return;
+		mt->probe_types[type]++;
+		if (++mt->probe_count < NVT_MT_PROBE_FRAMES)
+			return;
+		nvt_mt_lock_type(mt);
+		return;
+	}
+	if (type != mt->ref_type)
+		return;
+
+	if (nvt_mt_set_geometry(mt, rows, cols)) {
+		nvt_mt_release_contacts(mt);
+		return;
+	}
+
+	have_reference = mt->reference != NULL && mt->ref_count >= NVT_MT_REF_FRAMES;
+
+	if (!have_reference) {
+		for (n = 0; n < nodes; n++)
+			mt->samples[mt->ref_count * nodes + n] =
+				(s16)nvt_mt_le16(payload + 64 + n * 2);
+		if (++mt->ref_count < NVT_MT_REF_FRAMES)
+			return;
+		nvt_mt_build_reference(mt);
+		return;
+	}
+
+	for (n = 0; n < nodes; n++)
+		mt->delta[n] = (s16)nvt_mt_le16(payload + 64 + n * 2) -
+			       mt->reference[n];
+
+	nvt_mt_remove_line_noise(mt);
+
+	/* Follow slow baseline drift while nothing is near the threshold. */
+	if (mt->max_delta < (unsigned int)mt->threshold / 2)
+		for (n = 0; n < nodes; n++)
+			mt->reference[n] +=
+				((s16)nvt_mt_le16(payload + 64 + n * 2) -
+				 mt->reference[n]) / 8;
+
+	{
+		struct nvt_mt_point pts[NVT_MT_MAX_POINTS];
+		unsigned int count = nvt_mt_find_points(mt, pts);
+
+		nvt_mt_track(mt, pts, count);
+		nvt_mt_report(mt);
+	}
+}
+
+/**
+ * nvt_mt_pen_frame() - a stylus frame arrived
+ * @mt: decoder state
+ *
+ * Contacts still down are the hand holding the pen: lift them as palms so
+ * libinput cancels them instead of delivering a tap.
+ */
+void nvt_mt_pen_frame(struct nvt_mt *mt)
+{
+	int s, active = 0;
+
+	for (s = 0; s < mt->max_slots; s++) {
+		if (!mt->slot[s].active)
+			continue;
+		mt->slot[s].palm = true;
+		active++;
+	}
+	if (!active)
+		return;
+
+	nvt_mt_report(mt);
+	nvt_mt_release_contacts(mt);
+}
+
+void nvt_mt_release(struct nvt_mt *mt)
+{
+	nvt_mt_release_contacts(mt);
+}
+
+struct nvt_mt *nvt_mt_create(struct device *dev)
+{
+	struct nvt_mt *mt;
+	struct input_dev *input;
+	int ret;
+
+	mt = devm_kzalloc(dev, sizeof(*mt), GFP_KERNEL);
+	if (!mt)
+		return ERR_PTR(-ENOMEM);
+
+	input = devm_input_allocate_device(dev);
+	if (!input)
+		return ERR_PTR(-ENOMEM);
+
+	mt->dev = dev;
+	mt->input = input;
+	mt->threshold = NVT_MT_THRESHOLD;
+	mt->max_slots = NVT_MT_MAX_POINTS;
+	mt->ref_type = -1;
+
+	input->name = "Novatek NT36532E touchscreen";
+	input->id.bustype = BUS_SPI;
+	input->id.vendor = 0x0603;	/* Novatek */
+	input->id.product = 0x6532;
+	input->id.version = 1;
+	input->dev.parent = dev;
+
+	input_set_abs_params(input, ABS_X, 0, NVT_MT_SCREEN_W - 1, 0, 0);
+	input_set_abs_params(input, ABS_Y, 0, NVT_MT_SCREEN_H - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0, NVT_MT_SCREEN_W - 1,
+			     0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0, NVT_MT_SCREEN_H - 1,
+			     0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, NVT_MT_SIZE_MAX, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MINOR, 0, NVT_MT_SIZE_MAX, 0, 0);
+	input_abs_set_res(input, ABS_X, NVT_MT_SCREEN_RES);
+	input_abs_set_res(input, ABS_Y, NVT_MT_SCREEN_RES);
+	input_abs_set_res(input, ABS_MT_POSITION_X, NVT_MT_SCREEN_RES);
+	input_abs_set_res(input, ABS_MT_POSITION_Y, NVT_MT_SCREEN_RES);
+
+	input_set_capability(input, EV_KEY, BTN_TOUCH);
+	__set_bit(INPUT_PROP_DIRECT, input->propbit);
+
+	ret = input_mt_init_slots(input, mt->max_slots, INPUT_MT_DIRECT);
+	if (ret)
+		return ERR_PTR(ret);
+
+	ret = input_register_device(input);
+	if (ret)
+		return ERR_PTR(ret);
+
+	return mt;
+}
+
+void nvt_mt_destroy(struct nvt_mt *mt)
+{
+	if (!mt)
+		return;
+	kvfree(mt->samples);
+	kvfree(mt->reference);
+	kvfree(mt->delta);
+	kvfree(mt->area_of);
+	kvfree(mt->queue);
+}
