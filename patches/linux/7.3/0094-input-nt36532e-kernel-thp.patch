+++ b/drivers/input/touchscreen/nt36532e/nt36xxx_mt.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Novatek NT36532E THP finger decoding.
+ *
+ * The stock p81 driver decodes the touch computing payload in the kernel and
+ * reports an MT-B input device. This driver published the raw frame on
+ * /proc/nvt_thp_stream and left the same work to a userspace process that
+ * reported back through uinput. Decode here instead; the stream stays as the
+ * diagnostic and stylus capture path.
+ */
+#ifndef _LINUX_NVT_TOUCH_MT_H
+#define _LINUX_NVT_TOUCH_MT_H
+
+#include <linux/err.h>
+#include <linux/types.h>
+
+struct device;
+struct nvt_mt;
+
+struct nvt_mt *nvt_mt_create(struct device *dev);
+void nvt_mt_destroy(struct nvt_mt *mt);
+
+/*
+ * Decode one THP payload (the frame after the 257-byte event buffer). The
+ * first frames after a reset only learn the reference and report nothing.
+ */
+void nvt_mt_feed(struct nvt_mt *mt, const u8 *payload, size_t bytes);
+
+/* A stylus frame arrived: lift contacts held by the hand holding the pen. */
+void nvt_mt_pen_frame(struct nvt_mt *mt);
+
+/* Does this payload data type carry a stylus frame? */
+bool nvt_mt_is_pen_frame(u8 type);
+
+/* Lift every contact and forget the reference; the panel is going away. */
+void nvt_mt_release(struct nvt_mt *mt);
+
+#endif /* _LINUX_NVT_TOUCH_MT_H */

