From 8cd9e3663fb9b44f2435bf3076ed5f10f35c79b0 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Wed, 11 Nov 2026 00:52:06 +0800
Subject: [PATCH] input: touchscreen: decode NT36532E THP frames in the
 driver

Fingers were decoded in a userspace process that read /proc/nvt_thp_stream
and reported the result back through uinput. Hardware reporting belongs in
the driver: the stock p81 driver does the same work in kernel space, and
the project keeps hardware capability out of project-specific userspace
services.

Port the decoding to the driver: type lock, median reference, line-noise
removal, peak and centroid search, palm areas with their axes, and
nearest-distance tracking into an MT-B input device. Only the value at the
median index is needed for each line, so select it instead of ordering the
whole row or column.

Parity with the previous reader was checked frame by frame: positions,
contact axes and palm recognition match on the same 60x40 matrices.

/proc/nvt_thp_stream stays the diagnostic and stylus capture path. A
contact stays a palm until it lifts, and contacts held when a stylus frame
arrives are lifted as palms so libinput cancels them.
---
 drivers/input/touchscreen/nt36532e/Makefile   |   2 +-
 drivers/input/touchscreen/nt36532e/nt36xxx.c  |  38 +
 drivers/input/touchscreen/nt36532e/nt36xxx.h  |   2 +
 .../input/touchscreen/nt36532e/nt36xxx_mt.c   | 779 ++++++++++++++++++
 .../input/touchscreen/nt36532e/nt36xxx_mt.h   |  38 +
 5 files changed, 858 insertions(+), 1 deletion(-)
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx_mt.c
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx_mt.h

diff --git a/drivers/input/touchscreen/nt36532e/Makefile b/drivers/input/touchscreen/nt36532e/Makefile
index 309263303fb..4a71935eb2a 100644
--- a/drivers/input/touchscreen/nt36532e/Makefile
+++ b/drivers/input/touchscreen/nt36532e/Makefile
@@ -6,4 +6,4 @@
 # Each configuration option enables a list of files.
 
 obj-$(CONFIG_TOUCHSCREEN_NT36532E_SPI) += nt36532e_ts.o
-nt36532e_ts-y := nt36xxx.o nt36xxx_fw_update.o
+nt36532e_ts-y := nt36xxx.o nt36xxx_fw_update.o nt36xxx_mt.o
diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx.c b/drivers/input/touchscreen/nt36532e/nt36xxx.c
index 309d623fd61..e85cc04f207 100644
--- a/drivers/input/touchscreen/nt36532e/nt36xxx.c
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx.c
@@ -32,6 +32,7 @@
 #include <linux/vmalloc.h>
 #include <uapi/linux/sched/types.h>
 #include "nt36xxx.h"
+#include "nt36xxx_mt.h"
 
 #if defined(CONFIG_DRM_PANEL)
 #include <drm/drm_panel.h>
@@ -166,6 +167,21 @@ static void nvt_thp_publish_frame(void)
 		kfifo_in(&ts->thp_stream_fifo, ts->thp_frame, frame_len);
 	}
 	mutex_unlock(&ts->thp_lock);
+
+	/*
+	 * Decode outside thp_lock: the decoder keeps its own state and the
+	 * stream reader must not wait for the reference and peak search.
+	 */
+	if (valid && ts->mt && ts->thp_payload_len) {
+		const u8 *payload = ts->thp_frame + NVT_THP_HEADER_LEN;
+		u8 type = ts->thp_payload_len > 56 ? payload[56] : 0;
+
+		if (nvt_mt_is_pen_frame(type))
+			nvt_mt_pen_frame(ts->mt);
+		else
+			nvt_mt_feed(ts->mt, payload, ts->thp_payload_len);
+	}
+
 	wake_up_interruptible(&ts->thp_stream_wait);
 }
 
@@ -180,6 +196,11 @@ void nvt_thp_mark_epoch(void)
 	if (ts->thp_capture_enabled)
 		kfifo_reset(&ts->thp_stream_fifo);
 	mutex_unlock(&ts->thp_lock);
+
+	/* A firmware reset invalidates the reference the fingers were measured against. */
+	if (ts->mt)
+		nvt_mt_release(ts->mt);
+
 	wake_up_interruptible(&ts->thp_stream_wait);
 }
 
@@ -2168,6 +2189,14 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 		ret = -ENOMEM;
 		goto err_chipvertrim_failed;
 	}
+
+	/* Finger contacts are reported here; the stream stays diagnostic. */
+	ts->mt = nvt_mt_create(&client->dev);
+	if (IS_ERR(ts->mt)) {
+		ret = PTR_ERR(ts->mt);
+		ts->mt = NULL;
+		goto err_chipvertrim_failed;
+	}
 	ts->thp_stream_buf = vzalloc(NVT_THP_STREAM_SIZE);
 	if (!ts->thp_stream_buf) {
 		ret = -ENOMEM;
@@ -2315,6 +2344,8 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 err_panelwait_failed:
 err_chipvertrim_failed:
 	nvt_panel_remove_follower(ts);
+	nvt_mt_destroy(ts->mt);
+	ts->mt = NULL;
 	vfree(ts->thp_stream_buf);
 	ts->thp_stream_buf = NULL;
 	kfree(ts->thp_frame);
@@ -2359,6 +2390,9 @@ static void nvt_ts_remove(struct spi_device *client)
 	bTouchIsAwake = 0;
 	WRITE_ONCE(ts->thp_capture_enabled, false);
 	wake_up_interruptible(&ts->thp_stream_wait);
+	/* The input device goes away before the IRQ source that fed it. */
+	nvt_mt_destroy(ts->mt);
+	ts->mt = NULL;
 	proc_remove(ts->thp_game_rollback_proc);
 	proc_remove(ts->thp_game_proc);
 	proc_remove(ts->thp_controller_proc);
@@ -2471,6 +2505,10 @@ static int32_t nvt_ts_suspend(struct device *dev)
 
 	mutex_unlock(&ts->lock);
 
+	/* No finger stays down across a suspend the panel may not survive. */
+	if (ts->mt)
+		nvt_mt_release(ts->mt);
+
 	msleep(50);
 
 	if (likely(ts->ic_state == NVT_IC_SUSPEND_IN))
