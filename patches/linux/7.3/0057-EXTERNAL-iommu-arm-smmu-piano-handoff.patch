index 0000000000000000000000000000000000000000..470fd9fb638fdd6518e08388ddb0684ea6c3c8cd
--- /dev/null
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom-handoff.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef ARM_SMMU_QCOM_HANDOFF_H
+#define ARM_SMMU_QCOM_HANDOFF_H
+
+/* Raw bounded architectural observations; these selectors grant no DMA lease. */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <stdint.h>
+typedef uint32_t u32;
+typedef uint64_t u64;
+#endif
+
+#define QCOM_HANDOFF_MAX_SMR 128
+#define QCOM_HANDOFF_MAX_CB 256
+#define QCOM_HANDOFF_SMR_VALID (1U << 31)
+#define QCOM_HANDOFF_SCTLR_M 1U
+
+struct qcom_smmu_handoff_snapshot {
+	unsigned int num_smr, num_cb, num_s2_cb;
+	u32 smr[QCOM_HANDOFF_MAX_SMR];
+	u32 s2cr[QCOM_HANDOFF_MAX_SMR];
+	u32 sctlr[QCOM_HANDOFF_MAX_CB];
+};
+
+/* Stage-1 readback versus the real owning domain's programmed state. */
+struct piano_smmu_context_snapshot {
+	u64 ttbr[2];
+	u32 tcr[2], mair[2];
+	u32 sctlr, cbar, cba2r, fsr;
+};
+
+static inline bool piano_smmu_stage1_equal(const struct piano_smmu_context_snapshot *hw,
+					 const struct piano_smmu_context_snapshot *owned)
+{
+	return hw && owned && (hw->sctlr & 1) && !((hw->fsr) & 0xc00001feU) &&
+		!((hw->sctlr ^ owned->sctlr) & 0x1017U) &&
+		(hw->cba2r & 1) && hw->cba2r == owned->cba2r &&
+		((hw->cbar >> 16) & 3) == 1 &&
+		hw->ttbr[0] == owned->ttbr[0] && hw->ttbr[1] == owned->ttbr[1] &&
+		hw->tcr[0] == owned->tcr[0] && hw->tcr[1] == owned->tcr[1] &&
+		hw->mair[0] == owned->mair[0] && hw->mair[1] == owned->mair[1] &&
+		(!(hw->tcr[0] & (1U << 7)) || !(hw->tcr[0] & (1U << 23))) &&
+		((hw->tcr[0] & (1U << 7)) || (hw->ttbr[0] & 0x0000fffffffff000ULL)) &&
+		((hw->tcr[0] & (1U << 23)) || (hw->ttbr[1] & 0x0000fffffffff000ULL));
+}
+
+/* Compare actual hardware with kernel-private expected register encodings. */
+static inline bool qcom_smmu_handoff_route_equal(u32 smr, u32 wanted_smr,
+					       u32 s2cr, u32 expected_s2cr,
+					       u32 smr_mask, u32 s2cr_mask)
+{
+	return (smr & smr_mask) == wanted_smr &&
+		(s2cr & s2cr_mask) == expected_s2cr;
+}
+
+static inline bool qcom_smmu_handoff_geometry(const struct qcom_smmu_handoff_snapshot *s)
+{
+	return s && s->num_smr && s->num_smr <= QCOM_HANDOFF_MAX_SMR &&
+		s->num_cb && s->num_cb <= QCOM_HANDOFF_MAX_CB && s->num_s2_cb <= s->num_cb;
+}
+
+static inline bool qcom_smmu_handoff_cb_referenced(const struct qcom_smmu_handoff_snapshot *s,
+						 unsigned int cb)
+{
+	unsigned int i;
+
+	if (!qcom_smmu_handoff_geometry(s) || cb >= s->num_cb)
+		return true;
+	for (i = 0; i < s->num_smr; i++)
+		if ((s->smr[i] & QCOM_HANDOFF_SMR_VALID) &&
+		    ((s->s2cr[i] >> 16) & 3) == 0 && (s->s2cr[i] & 0xff) == cb)
+			return true;
+	return false;
+}
+
+static inline int qcom_smmu_handoff_probe_slot(const struct qcom_smmu_handoff_snapshot *s)
+{
+	unsigned int i;
+
+	if (!qcom_smmu_handoff_geometry(s))
+		return -1;
+	for (i = 0; i < s->num_smr; i++)
+		if (!(s->smr[i] & QCOM_HANDOFF_SMR_VALID))
+			return i;
+	return -1;
+}
+
+static inline int qcom_smmu_handoff_bypass_cb(const struct qcom_smmu_handoff_snapshot *s)
+{
+	unsigned int i;
+
+	if (!qcom_smmu_handoff_geometry(s))
+		return -1;
+	for (i = s->num_cb; i-- > s->num_s2_cb;)
+		if (!(s->sctlr[i] & QCOM_HANDOFF_SCTLR_M) &&
+		    !qcom_smmu_handoff_cb_referenced(s, i))
+			return i;
+	return -1;
+}
+
+#endif
