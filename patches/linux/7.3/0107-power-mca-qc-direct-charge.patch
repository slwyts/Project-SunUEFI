+static int piano_mca_qc_prepare(struct kunit *test, u32 type)
+{
+	struct piano_mca_test *f = test->priv;
+	int ret = piano_mca_test_register_gauges(test);
+
+	if (ret)
+		return ret;
+	ret = piano_mca_test_start_cp(test);
+	if (ret)
+		return ret;
+	ret = piano_mca_cp_stop(&f->mca, "prepare QC");
+	if (ret)
+		return ret;
+	cp_charge = charge_current = hv_charge = true;
+	mipps_auth = true;
+	f->gauge[0].charge_now_uah = f->gauge[1].charge_now_uah = 2250000;
+	f->real_type = f->mca.real_type = type;
+	f->mca.cp = MCA_CP_OFF;
+	f->mca.vbus_uv = f->vbus_uv = 5000000;
+	return 0;
+}
