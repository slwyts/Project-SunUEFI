+static void piano_mca_qc_direction_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct piano_mca_qc_limits limits;
+	static const struct {
+		u32 type;
+		int vbat, ibat, vbus, ibus, direction;
+	} rows[] = {
+		{ MCA_TYPE_HVDCP_3_B, 4400, 4200, 9000, 1699, 1 },
+		{ MCA_TYPE_HVDCP_3_B, 4400, 4200, 9000, 1700, 0 },
+		{ MCA_TYPE_HVDCP_3_B, 4430, 4200, 9000, 1600, 0 },
+		{ MCA_TYPE_HVDCP_3_B, 4429, 4300, 9000, 1600, 0 },
+		{ MCA_TYPE_HVDCP_3_B, 4429, 4299, 9300, 1600, 1 },
+		{ MCA_TYPE_HVDCP_3_B, 4400, 4200, 9301, 1600, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4100, 9000, 1999, 1 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4100, 9000, 2000, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4460, 4100, 9000, 1900, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4459, 4150, 9000, 1900, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4459, 4149, 9980, 1900, 1 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4100, 9981, 1900, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4250, 9000, 2000, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4251, 9000, 2000, -1 },
+		{ MCA_TYPE_HVDCP_3P5, 4470, 4200, 9000, 2000, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4471, 4200, 9000, 2000, -1 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4200, 9000, 2150, 0 },
+		{ MCA_TYPE_HVDCP_3P5, 4400, 4200, 9000, 2151, -1 },
+	};
