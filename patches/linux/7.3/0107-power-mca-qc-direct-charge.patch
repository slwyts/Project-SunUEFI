+
+	piano_mca_qc_limits(&f->mca, MCA_TYPE_HVDCP_3_B, &limits);
+	KUNIT_EXPECT_EQ(test, limits.target_ibat_ma, 5000U);
+	KUNIT_EXPECT_EQ(test, limits.target_ibus_ma, 2500U);
+	piano_mca_qc_limits(&f->mca, MCA_TYPE_HVDCP_3P5, &limits);
+	KUNIT_EXPECT_EQ(test, limits.target_ibat_ma, 4200U);
+	KUNIT_EXPECT_EQ(test, limits.target_ibus_ma, 2100U);
+	f->mca.skin_control = true;
+	f->mca.skin_limit_ma = 2000;
+	piano_mca_qc_limits(&f->mca, MCA_TYPE_HVDCP_3_B, &limits);
+	KUNIT_EXPECT_EQ(test, limits.target_ibat_ma, 2000U);
+	KUNIT_EXPECT_EQ(test, limits.target_ibus_ma, 1100U);
+}
