+static void piano_mca_qc_start_limits_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	static const struct { u32 type, mv, bus, battery, start; } rows[] = {
+		{ MCA_TYPE_HVDCP_3_B, 9500, 2500, 5000, 8000 },
+		{ MCA_TYPE_HVDCP_3P5, 10000, 2100, 4200, 7900 },
+	};
+	int i;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_qc_prepare(test, rows[0].type), 0);
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		f->real_type = f->mca.real_type = rows[i].type;
+		f->mca.cp = MCA_CP_OFF;
+		piano_mca_cp_try_start(&f->mca, f->remote_generation);
+		KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_OPENING);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_max_mv, rows[i].mv);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_ma, rows[i].bus);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, rows[i].bus);
+		KUNIT_EXPECT_EQ(test, f->mca.cp_start_ibat_ma, rows[i].battery);
+		KUNIT_EXPECT_EQ(test, f->qc_voltage_mv, rows[i].start);
+		KUNIT_EXPECT_EQ(test, f->pps_writes, 0U);
+		KUNIT_EXPECT_EQ(test, f->fixed_voltage_writes, 0U);
+		KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+		KUNIT_ASSERT_EQ(test, piano_mca_cp_stop(&f->mca, "QC limit checked"), 0);
+		KUNIT_EXPECT_EQ(test, f->qc_voltage_mv, 9000U);
+		KUNIT_EXPECT_GT(test, f->last_qc_event, f->last_stop_event);
+	}
+}
