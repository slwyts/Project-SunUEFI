From 028e3daa5e2509148050c82c3599be0a5844dd65 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 03:28:55 +0800
Subject: [PATCH] feat(power): add stock QC voltage and direct-charge control

Use the Piano 4.0.6 QC voltage property and pulse commands. Keep QC2 and low-power QC3 on the buck path, and regulate QC3-B/QC3+ through the 2:1 stage with separate bus and battery limits, opening timeout and confirmed pump shutdown.

Retain existing temperature, cycle, user-limit and session checks. Cover QC boundary decisions, real pump readings, failed stops and stale sessions in the existing MCA KUnit suite.

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index e0b9da45b..ff400449d 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -234,10 +234,49 @@ MODULE_PARM_DESC(charge_current,
 #define MCA_HV_PPS_MIN_MA	500
 #define MCA_HV_PPS_MAX_MA	3000
 
+/* HyperOS 4.0.6 QC wire IDs and pulse commands, not the older public enum. */
+#define MCA_PROP_QC_VOLT_CMD	0x201d
+#define MCA_PROP_QC_VOLT	0x2011
+#define MCA_QC_CMD_FORCE_5V	0
+#define MCA_QC_CMD_DECREMENT	0x10
+#define MCA_QC_CMD_INCREMENT	0x20
+#define MCA_QC_STABLE_SAMPLES	5
+#define MCA_QC_POLL_MS		700
+#define MCA_QC_SETTLE_MS		3000
+#define MCA_QC_OPEN_TRIES		40
+#define MCA_QC_TUNE_WINDOW_MV	200
+#define MCA_QC3_STEP_MV		200
+#define MCA_QC3P5_STEP_MV		20
+/* Same-device qc3_* and qc3p5_* limits. Currents use mA on their own side. */
+#define MCA_QC3_MAX_VBUS_MV	9500
+#define MCA_QC3_MAX_IBUS_MA	2500
+#define MCA_QC3_MAX_IBAT_MA	5000
+#define MCA_QC3P5_MAX_VBUS_MV	10000
+#define MCA_QC3P5_MAX_IBUS_MA	2100
+#define MCA_QC3P5_MAX_IBAT_MA	4200
+/* Guard bands of mca_qc_get_vbus_change_trend, per adapter class */
+#define MCA_QC3_UP_IBUS_MA	800
+#define MCA_QC3_UP_IBAT_MA	700
+#define MCA_QC3_UP_VBAT_MV	50
+#define MCA_QC3_DOWN_VBAT_MV	15
+#define MCA_QC3_DOWN_IBUS_MA	300
+#define MCA_QC3_DOWN_SAMPLES	2
+#define MCA_QC3P5_UP_IBUS_MA	100
+#define MCA_QC3P5_UP_IBAT_MA	50
+#define MCA_QC3P5_UP_VBAT_MV	20
+#define MCA_QC3P5_DOWN_VBAT_MV	10
+#define MCA_QC3P5_DOWN_IBUS_MA	50
+#define MCA_QC3P5_DOWN_IBAT_MA	50
+#define MCA_QC_IBUS_BIAS_MA	100
+#define MCA_QC_TAPER_MA		2400
+#define MCA_QC3_TAPER_MV		25
+#define MCA_QC3P5_TAPER_MV		20
+#define MCA_QC_TAPER_FV_HYS_MV	4
+
 static bool hv_charge = true;
 module_param(hv_charge, bool, 0444);
 MODULE_PARM_DESC(hv_charge,
-		 "Ask PD sources with a fixed 9 V PDO for 9 V; needs charge_policy (default: on, may be disabled for debugging)");
+		 "Request higher input voltage from PD/PPS and Quick Charge sources; needs charge_policy (default: on, may be disabled for debugging)");
 
 /*
  * pan_ack: the ADSP reports each USB-C port change (orientation, mux state)
@@ -452,7 +491,7 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 static bool cp_charge = true;
 module_param(cp_charge, bool, 0444);
 MODULE_PARM_DESC(cp_charge,
-		 "Charge through the SC8541 switched-capacitor stage from PPS sources; needs hv_charge and charge_current (default: on, may be disabled for debugging)");
+		 "Charge through SC8541 from PPS or QC3-B/3+ sources; needs hv_charge and charge_current (default: on, may be disabled for debugging)");
 
 static unsigned int cp_ibus_max = 6000;
 module_param(cp_ibus_max, uint, 0444);
@@ -571,11 +610,21 @@ struct piano_mca {
 	int hv_renegs;		/* times the source went back to 5 V on its own */
 	bool hv_pps;		/* 9 V is asked of a PPS APDO */
 	u32 hv_pps_ma;		/* its requested current limit */
+	/* Quick Charge trend samples belong to one direct-charge attempt. */
+	int qc_vbat_mv;
+	int qc_ibat_ma;
+	u8 qc_vbat_steady;
+	u8 qc_ibat_steady;
+	u8 qc_down_count;	/* QC3 needs two down votes, not necessarily adjacent. */
+	bool qc_sampled;
+	unsigned long qc_at;
+	unsigned long qc_ready_at;
 	enum piano_mca_cp cp;
 	struct power_supply *cp_psy;	/* the stage, held while not MCA_CP_OFF */
 	unsigned int cp_generation;
 	unsigned int cp_connection_generation;
-	u32 cp_mv;		/* voltage asked of the PPS source */
+	u32 cp_real_type;	/* source type selected before enabling the pump */
+	u32 cp_mv;		/* voltage asked of the direct-charge source */
 	u32 cp_ma;		/* its current limit */
 	u32 cp_max_mv;		/* the most the source offers */
 	u32 cp_ibus_ma;		/* bus current target */
@@ -968,6 +1017,25 @@ static bool piano_mca_pps_word_ok(u32 val)
 	       ma <= MCA_CP_PPS_MAX_MA;
 }
 
+/* Every QC step this driver sends is a single raise, lower or 5 V command */
+static bool piano_mca_qc_cmd_ok(u32 val)
+{
+	return val == MCA_QC_CMD_FORCE_5V || val == MCA_QC_CMD_INCREMENT ||
+	       val == MCA_QC_CMD_DECREMENT;
+}
+
+static bool piano_mca_is_qc(u32 real_type)
+{
+	return real_type == MCA_TYPE_HVDCP || real_type == MCA_TYPE_HVDCP_3 ||
+	       real_type == MCA_TYPE_HVDCP_3_B || real_type == MCA_TYPE_HVDCP_3P5;
+}
+
+/* The stock direct-charge entry excludes the lower-power QC3 class. */
+static bool piano_mca_is_qc_cp(u32 real_type)
+{
+	return real_type == MCA_TYPE_HVDCP_3_B || real_type == MCA_TYPE_HVDCP_3P5;
+}
+
 static bool piano_mca_write_allowed(struct piano_mca *mca, u32 prop,
 				    const void *data, size_t len)
 {
@@ -1017,6 +1085,13 @@ static bool piano_mca_write_allowed(struct piano_mca *mca, u32 prop,
 	case MCA_PROP_PD_FIXED_VOLT:
 		return hv_charge && len == sizeof(u32) &&
 		       (val == 5000 || val == MCA_HV_MV);
+	case MCA_PROP_QC_VOLT_CMD:
+		return hv_charge && len == sizeof(u32) && piano_mca_qc_cmd_ok(val);
+	case MCA_PROP_QC_VOLT:
+		return hv_charge && len == sizeof(u32) &&
+		       (val == 5000 || val == MCA_HV_MV ||
+			(cp_charge && val >= MCA_CP_PPS_MIN_MV &&
+			 val <= MCA_QC3P5_MAX_VBUS_MV && !(val % MCA_QC3P5_STEP_MV)));
 	case MCA_PROP_PPS_SELECT:
 		return hv_charge && len == sizeof(u32) &&
 		       piano_mca_pps_word_ok(val);
@@ -1541,22 +1616,32 @@ static const char *piano_mca_type_name(u32 type)
 	return type < MCA_TYPE_MAX ? mca_real_type_names[type] : NULL;
 }
 
+/*
+ * Stock buck strategy in_* input limits (mA): in_cdp 900, in_float 1000,
+ * in_dcp 1500, in_hvdcp 1200, in_hvdcp3 / in_hvdcp3p5 1600, in_pd 1600.
+ * The stock PPS branch uses in_pd unless its fast-charge boost applies,
+ * which asks for in_pps 2500; that boost belongs to the direct-charge path
+ * here.
+ */
 static u32 piano_mca_policy_icl(u32 real_type)
 {
 	switch (real_type) {
 	case MCA_TYPE_CDP:
 		return 900;
-	/* QC and PD sources stay at 5 V, so they count as DCPs here */
+	case MCA_TYPE_FLOAT:
+		return 1000;
 	case MCA_TYPE_DCP:
 	case MCA_TYPE_DCP_B:
+		return 1500;
 	case MCA_TYPE_HVDCP:
+		return 1200;
 	case MCA_TYPE_HVDCP_3:
 	case MCA_TYPE_HVDCP_3_B:
 	case MCA_TYPE_HVDCP_3P5:
 	case MCA_TYPE_PD:
 	case MCA_TYPE_PD_VERIFY:
 	case MCA_TYPE_PD_PPS:
-		return 1500;
+		return 1600;
 	default:
 		return MCA_ICL_DEFAULT_MA;
 	}
@@ -1806,10 +1891,12 @@ static int piano_mca_request_volt_session(struct piano_mca *mca, u32 mv,
 					 unsigned int generation,
 					 unsigned int connection)
 {
-	u32 icl = piano_mca_pd_5v_ma(mca, generation, connection);
+	bool qc = piano_mca_is_qc(mca->real_type);
+	u32 icl = qc ? piano_mca_policy_icl(mca->real_type) :
+		piano_mca_pd_5v_ma(mca, generation, connection);
 	int ret;
 
-	if (mv == MCA_HV_MV) {
+	if (mv == MCA_HV_MV && !qc) {
 		if (icl < MCA_ICL_MIN_MA)
 			return -EINVAL;
 		icl = min(icl, mca->hv_pps_ma);
@@ -1833,6 +1920,9 @@ static int piano_mca_request_volt_session(struct piano_mca *mca, u32 mv,
 			return ret;
 		mca->icl_set_ma = icl;
 	}
+	if (qc)
+		return piano_mca_write_u32_session(mca, MCA_PROP_QC_VOLT, mv,
+						   generation, connection);
 	if (mv == MCA_HV_MV && mca->hv_pps)
 		return piano_mca_write_u32_session(mca, MCA_PROP_PPS_SELECT,
 						   piano_mca_pps_word(mv, mca->hv_pps_ma),
@@ -1890,6 +1980,8 @@ static u32 piano_mca_hv_step(struct piano_mca *mca, unsigned int generation,
 
 	if (piano_mca_is_pd(mca->real_type))
 		ma = piano_mca_pd_9v_ma(mca, &pps, generation, connection);
+	else if (piano_mca_is_qc(mca->real_type))
+		ma = piano_mca_policy_icl(mca->real_type);
 	if (!piano_mca_session_valid(mca, generation, connection))
 		return 0;
 
@@ -1956,7 +2048,115 @@ static u32 piano_mca_hv_step(struct piano_mca *mca, unsigned int generation,
  */
 static u32 piano_mca_hv_icl(u32 real_type)
 {
-	return real_type == MCA_TYPE_PD ? 1600 : MCA_ICL_HV_MAX_MA;
+	if (piano_mca_is_qc(real_type) || real_type == MCA_TYPE_PD)
+		return piano_mca_policy_icl(real_type);
+	return MCA_ICL_HV_MAX_MA;
+}
+
+struct piano_mca_qc_limits {
+	u32 max_vbus_mv;
+	u32 max_ibus_ma;
+	u32 max_ibat_ma;
+	u32 target_ibus_ma;
+	u32 target_ibat_ma;
+	u32 up_ibus_ma;
+	u32 up_ibat_ma;
+	u32 up_vbat_mv;
+	u32 down_vbat_mv;
+	u32 down_ibus_ma;
+	u32 down_ibat_ma;
+	u32 step_mv;
+	u8 down_samples;
+};
+
+static void piano_mca_qc_limits(struct piano_mca *mca, u32 real_type,
+				struct piano_mca_qc_limits *limits)
+{
+	u32 budget = piano_mca_charge_limit(mca);
+	bool p5 = real_type == MCA_TYPE_HVDCP_3P5;
+
+	limits->max_vbus_mv = p5 ? MCA_QC3P5_MAX_VBUS_MV : MCA_QC3_MAX_VBUS_MV;
+	limits->max_ibus_ma = p5 ? MCA_QC3P5_MAX_IBUS_MA : MCA_QC3_MAX_IBUS_MA;
+	limits->max_ibat_ma = p5 ? MCA_QC3P5_MAX_IBAT_MA : MCA_QC3_MAX_IBAT_MA;
+	limits->target_ibat_ma = min(budget, limits->max_ibat_ma);
+	limits->target_ibus_ma = min(budget / 2 +
+				     MCA_QC_IBUS_BIAS_MA, limits->max_ibus_ma);
+	limits->up_ibus_ma = p5 ? MCA_QC3P5_UP_IBUS_MA : MCA_QC3_UP_IBUS_MA;
+	limits->up_ibat_ma = p5 ? MCA_QC3P5_UP_IBAT_MA : MCA_QC3_UP_IBAT_MA;
+	limits->up_vbat_mv = p5 ? MCA_QC3P5_UP_VBAT_MV : MCA_QC3_UP_VBAT_MV;
+	limits->down_vbat_mv = p5 ? MCA_QC3P5_DOWN_VBAT_MV : MCA_QC3_DOWN_VBAT_MV;
+	limits->down_ibus_ma = p5 ? MCA_QC3P5_DOWN_IBUS_MA : MCA_QC3_DOWN_IBUS_MA;
+	limits->down_ibat_ma = p5 ? MCA_QC3P5_DOWN_IBAT_MA : 0;
+	limits->step_mv = p5 ? MCA_QC3P5_STEP_MV : MCA_QC3_STEP_MV;
+	limits->down_samples = p5 ? 1 : MCA_QC3_DOWN_SAMPLES;
+}
+
+static void piano_mca_qc_clear(struct piano_mca *mca)
+{
+	mca->qc_vbat_mv = 0;
+	mca->qc_ibat_ma = 0;
+	mca->qc_vbat_steady = 0;
+	mca->qc_ibat_steady = 0;
+	mca->qc_down_count = 0;
+	mca->qc_sampled = false;
+	mca->qc_at = 0;
+	mca->qc_ready_at = 0;
+}
+
+/* Recheck an unchanged gauge reading after five monitor intervals. */
+static bool piano_mca_qc_reading_changed(int value, int *previous, u8 *steady)
+{
+	if (value == *previous && *steady < MCA_QC_STABLE_SAMPLES) {
+		(*steady)++;
+		return false;
+	}
+	*previous = value;
+	*steady = 0;
+	return true;
+}
+
+/* Stock QC regulation uses pump-side VBUS/IBUS and combined gauge current. */
+static int piano_mca_qc_direction(struct piano_mca *mca,
+				   const struct piano_mca_qc_limits *limits,
+				   int vbat, int ibat, int vbus, int ibus, int fv)
+{
+	bool vbat_changed, ibat_changed;
+	int direction = 0;
+
+	if (!mca->qc_sampled) {
+		mca->qc_sampled = true;
+		mca->qc_vbat_mv = vbat;
+		mca->qc_ibat_ma = ibat;
+		vbat_changed = true;
+		ibat_changed = true;
+	} else {
+		vbat_changed = piano_mca_qc_reading_changed(vbat, &mca->qc_vbat_mv,
+							   &mca->qc_vbat_steady);
+		ibat_changed = piano_mca_qc_reading_changed(ibat, &mca->qc_ibat_ma,
+							   &mca->qc_ibat_steady);
+	}
+
+	/* Do not send a pulse that would cross this adapter's voltage ceiling. */
+	if (vbus + limits->step_mv <= limits->max_vbus_mv &&
+	    ibus < (int)limits->target_ibus_ma - (int)limits->up_ibus_ma &&
+	    vbat_changed && vbat < fv - (int)limits->up_vbat_mv &&
+	    ibat_changed && ibat < (int)limits->target_ibat_ma -
+				   (int)limits->up_ibat_ma)
+		direction = 1;
+
+	/* Down votes persist between samples, as in the stock QC3 loop. */
+	if ((vbat_changed &&
+	     vbat > fv - (int)limits->down_vbat_mv) ||
+	    (ibat_changed && ibat > (int)limits->target_ibat_ma +
+				   (int)limits->down_ibat_ma) ||
+	    ibus > (int)limits->target_ibus_ma + (int)limits->down_ibus_ma ||
+	    vbus > limits->max_vbus_mv) {
+		if (++mca->qc_down_count >= limits->down_samples) {
+			mca->qc_down_count = 0;
+			direction = -1;
+		}
+	}
+	return direction;
 }
 
 /*
@@ -2830,12 +3030,22 @@ static int piano_mca_cp_set_busocp(struct piano_mca *mca, u32 ma)
 
 static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
 {
+	u32 quantum = mca->cp_real_type == MCA_TYPE_HVDCP_3_B ?
+		MCA_QC3_STEP_MV : MCA_QC3P5_STEP_MV;
 	int ret;
 
 	if (!piano_mca_cp_session_valid(mca))
 		return -ECONNRESET;
-	mv = clamp(rounddown(mv, 20), (u32)MCA_CP_PPS_MIN_MV,
-		   min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV));
+	mv = clamp(rounddown(mv, quantum), (u32)MCA_CP_PPS_MIN_MV,
+		   rounddown(min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV), quantum));
+	if (piano_mca_is_qc_cp(mca->cp_real_type)) {
+		/* A lost acknowledgement can still leave the adapter at this voltage. */
+		mca->cp_mv = mv;
+		ret = piano_mca_write_u32_session(mca, MCA_PROP_QC_VOLT, mv,
+						  mca->cp_generation,
+						  mca->cp_connection_generation);
+		return ret;
+	}
 	/* Stock sends every regulation request, including an unchanged target. */
 
 	ret = piano_mca_write_u32_session(mca, MCA_PROP_PPS_SELECT,
@@ -2907,6 +3117,17 @@ static int piano_mca_cp_stop(struct piano_mca *mca, const char *why)
 				    ret ?: -EBUSY);
 		return ret ?: -EBUSY;
 	}
+	/* The stock QC path returns to the buck's 9 V only after switching stops. */
+	if (piano_mca_is_qc_cp(mca->cp_real_type) && mca->cp_mv &&
+	    mca->real_type == mca->cp_real_type && mca->online &&
+	    piano_mca_cp_session_valid(mca)) {
+		ret = piano_mca_write_u32_session(mca, MCA_PROP_QC_VOLT, MCA_HV_MV,
+						  mca->cp_generation,
+						  mca->cp_connection_generation);
+		if (ret)
+			return ret;
+		piano_mca_qc_clear(mca);
+	}
 	power_supply_put(mca->cp_psy);
 	mca->cp_psy = NULL;
 	dev_info(mca->dev, "direct charging stopped: %s\n", why);
@@ -3018,6 +3239,8 @@ static bool piano_mca_cp_after_auth(struct piano_mca *mca)
 static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generation)
 {
 	struct piano_mca_cp_limits limits;
+	struct piano_mca_qc_limits qc = {};
+	bool is_qc = piano_mca_is_qc_cp(mca->real_type);
 	int vbat, ibat, tcool, twarm, ret;
 	u32 start_mv, ma, src_ma, max_mv = 0;
 
@@ -3027,7 +3250,10 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		mca->cp = MCA_CP_OFF;
 	if (!cp_charge || !hv_charge || !charge_current ||
 	    mca->cp != MCA_CP_OFF ||
-	    (mca->hv != MCA_HV_ON && !piano_mca_cp_after_auth(mca)))
+	    (mca->hv != MCA_HV_ON && !is_qc &&
+	     !piano_mca_cp_after_auth(mca)))
+		return;
+	if (!is_qc && !piano_mca_is_pd(mca->real_type))
 		return;
 
 	mca->cp_generation = generation;
@@ -3039,8 +3265,13 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	piano_mca_normal_temperature(mca, tcool, twarm);
 	if (piano_mca_update_ffc(mca, tcool, twarm))
 		return;
-	if (piano_mca_cp_normal_limits(mca, vbat, ibat, tcool, twarm, &limits) ||
-	    limits.ma < MCA_CP_BUCK_MA + 4 * MCA_CP_OPEN_IBUS_MA ||
+	if (piano_mca_cp_normal_limits(mca, vbat, ibat, tcool, twarm, &limits))
+		return;
+	if (is_qc) {
+		piano_mca_qc_limits(mca, mca->real_type, &qc);
+		limits.ma = min(limits.ma, qc.target_ibat_ma);
+	}
+	if (limits.ma < MCA_CP_BUCK_MA + 4 * MCA_CP_OPEN_IBUS_MA ||
 	    piano_mca_normal_voltage_stop(mca, vbat, limits.fv_mv) ||
 	    vbat < MCA_CP_VBAT_MIN_MV || vbat >= limits.cv_mv ||
 	    !piano_mca_cp_entry_allowed(mca, vbat, &limits) ||
@@ -3061,24 +3292,37 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		return;
 	}
 	/* PD requests in the middle of the authentication break it */
-	if (mipps_auth && !piano_mca_authenticated(mca) &&
+	if (!is_qc && mipps_auth && !piano_mca_authenticated(mca) &&
 	    time_before(jiffies, mca->cp_on_at +
 				 msecs_to_jiffies(MCA_CP_AUTH_WAIT_MS)))
 		return;
 
 	start_mv = 2 * vbat + MCA_CP_DELTA_MV;
-	ma = piano_mca_cp_apdo(mca, start_mv, &max_mv);
-	if (ma < MCA_CP_BUCK_MA + 1000)
+	if (is_qc) {
+		/* QC has no APDO current request. Keep bus and battery units separate. */
+		max_mv = qc.max_vbus_mv;
+		ma = qc.max_ibus_ma;
+		start_mv = roundup(start_mv, qc.step_mv);
+	} else {
+		ma = piano_mca_cp_apdo(mca, start_mv, &max_mv);
+	}
+	if (!ma || ma < MCA_CP_BUCK_MA + 1000)
 		return;
 
 	mca->cp_ma = min_t(u32, ma, MCA_CP_PPS_MAX_MA);
 	mca->cp_max_mv = max_mv;
-	src_ma = mca->cp_ma;
-	src_ma -= min_t(u32, src_ma, MCA_CP_BUCK_MA + 200);
-	mca->cp_ibus_ma = min(clamp(cp_ibus_max, 500U, (u32)MCA_CP_IBUS_MAX_MA),
-			      src_ma);
-	mca->cp_ibus_ma = min(mca->cp_ibus_ma, (limits.ma - MCA_CP_BUCK_MA) / 2);
-	if (!piano_mca_adapter_verified(mca))
+	mca->cp_real_type = mca->real_type;
+	if (is_qc) {
+		mca->cp_ibus_ma = min3(clamp(cp_ibus_max, 500U, (u32)MCA_CP_IBUS_MAX_MA),
+					qc.max_ibus_ma, limits.ma / 2);
+	} else {
+		src_ma = mca->cp_ma;
+		src_ma -= min_t(u32, src_ma, MCA_CP_BUCK_MA + 200);
+		mca->cp_ibus_ma = min(clamp(cp_ibus_max, 500U, (u32)MCA_CP_IBUS_MAX_MA),
+				      src_ma);
+		mca->cp_ibus_ma = min(mca->cp_ibus_ma, (limits.ma - MCA_CP_BUCK_MA) / 2);
+	}
+	if (!is_qc && !piano_mca_adapter_verified(mca))
 		mca->cp_ibus_ma = min_t(u32, mca->cp_ibus_ma,
 					MCA_CP_THIRD_IBUS_MA);
 	if (mca->cp_ibus_ma < 2 * MCA_CP_OPEN_IBUS_MA) {
@@ -3109,6 +3353,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	}
 
 	mca->cp_mv = 0;
+	piano_mca_qc_clear(mca);
