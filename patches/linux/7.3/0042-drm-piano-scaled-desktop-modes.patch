diff --git a/include/drm/drm_panel_piano.h b/include/drm/drm_panel_piano.h
new file mode 100644
index 000000000..60ea22be8
--- /dev/null
+++ b/include/drm/drm_panel_piano.h
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __DRM_PANEL_PIANO_H__
+#define __DRM_PANEL_PIANO_H__
+
+#include <linux/of.h>
+#include <drm/drm_modes.h>
+
+/*
+ * Xiaomi Pad 8 Pro panels, following the downstream "p81 42 02 0a" (BOE)
+ * and "p81 35 02 0b" (CSOT) video mode dual-DSI DSC panel descriptions.
+ *
+ * The link runs at a fixed 1197.5 Mbps per lane and the refresh rate is
+ * selected by the horizontal front porch. With RGB101010 and 8 bpp DSC the
+ * modes below reproduce exactly that link rate. The lower refresh rates
+ * keep the 120 Hz panel timing and extend vertical blanking, as specified
+ * by the downstream dfps_immediate_porch_mode_vfp configuration.
+ */
+#define PIANO_HDISPLAY	3200
+#define PIANO_HSYNC	32
+#define PIANO_HBP	32
+#define PIANO_VDISPLAY	2136
+#define PIANO_VFP	68
+#define PIANO_VSYNC	2
+#define PIANO_VBP	104
+#define PIANO_VTOTAL	(PIANO_VDISPLAY + PIANO_VFP + PIANO_VSYNC + PIANO_VBP)
+
+#define PIANO_MODE(_hfp, _vfp, _vrefresh) {					\
+	.clock = (PIANO_HDISPLAY + (_hfp) + PIANO_HSYNC + PIANO_HBP) *		\
+		 (PIANO_VDISPLAY + (_vfp) + PIANO_VSYNC + PIANO_VBP) *		\
+		 (_vrefresh) / 1000,						\
+	.hdisplay = PIANO_HDISPLAY,						\
+	.hsync_start = PIANO_HDISPLAY + (_hfp),					\
+	.hsync_end = PIANO_HDISPLAY + (_hfp) + PIANO_HSYNC,			\
+	.htotal = PIANO_HDISPLAY + (_hfp) + PIANO_HSYNC + PIANO_HBP,		\
+	.vdisplay = PIANO_VDISPLAY,						\
+	.vsync_start = PIANO_VDISPLAY + (_vfp),					\
+	.vsync_end = PIANO_VDISPLAY + (_vfp) + PIANO_VSYNC,			\
+	.vtotal = PIANO_VDISPLAY + (_vfp) + PIANO_VSYNC + PIANO_VBP,		\
+	.width_mm = 239,							\
+	.height_mm = 163,							\
+}
+
+/* All low-rate modes retain the 120 Hz pixel clock and horizontal timing.
+ * Both P81_35 and P81_42 advertise 30/48/50/60/90/120/144 in the stock DT.
+ * These are fixed modes; seamless updates require DSI host/DPU support.
+ */
+#define PIANO_VFP_MODE(_vrefresh) \
+	PIANO_MODE(234, PIANO_VFP + PIANO_VTOTAL * 120 / (_vrefresh) - \
+		   PIANO_VTOTAL, (_vrefresh))
+
+static const struct drm_display_mode piano_display_modes[] = {
+	PIANO_MODE(42, PIANO_VFP, 144),
+	PIANO_MODE(234, PIANO_VFP, 120),
+	PIANO_MODE(618, PIANO_VFP, 90),
+	PIANO_VFP_MODE(60),
+	PIANO_VFP_MODE(50),
+	PIANO_VFP_MODE(48),
+	PIANO_VFP_MODE(30),
+};
+
+/* The panel always receives its native timing. These modes describe the
+ * framebuffer coordinate space before the DPU's two SSPP scalers.
+ */
+static inline bool drm_piano_panel_can_scale(const struct drm_display_mode *mode)
+{
+	unsigned int refresh = drm_mode_vrefresh(mode);
+
+	return refresh == 60 || refresh == 90 || refresh == 120;
+}
+
+static inline void drm_piano_panel_scaled_mode(const struct drm_display_mode *native,
+					       struct drm_display_mode *scaled)
+{
+	drm_mode_copy(scaled, native);
+	scaled->clock = DIV_ROUND_CLOSEST(native->clock, 4);
+	scaled->hdisplay /= 2;
+	scaled->hsync_start /= 2;
+	scaled->hsync_end /= 2;
+	scaled->htotal /= 2;
+	scaled->vdisplay /= 2;
+	scaled->vsync_start /= 2;
+	scaled->vsync_end /= 2;
+	scaled->vtotal /= 2;
+	scaled->type = DRM_MODE_TYPE_DRIVER;
+	drm_mode_set_name(scaled);
+	drm_mode_set_crtcinfo(scaled, 0);
+}
+
+static inline const struct drm_display_mode *
+drm_piano_panel_native_mode(const struct drm_display_mode *mode)
+{
+	struct drm_display_mode scaled;
+	unsigned int i;
+
+	if (!of_machine_is_compatible("xiaomi,piano") ||
+	    mode->hdisplay != 1600 || mode->vdisplay != 1068)
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(piano_display_modes); i++) {
+		const struct drm_display_mode *native = &piano_display_modes[i];
+
+		if (!drm_piano_panel_can_scale(native))
+			continue;
+		drm_piano_panel_scaled_mode(native, &scaled);
+		if (drm_mode_match(mode, &scaled, DRM_MODE_MATCH_TIMINGS |
+				   DRM_MODE_MATCH_CLOCK | DRM_MODE_MATCH_FLAGS))
+			return native;
+	}
+
+	return NULL;
+}
+
+#endif /* __DRM_PANEL_PIANO_H__ */
