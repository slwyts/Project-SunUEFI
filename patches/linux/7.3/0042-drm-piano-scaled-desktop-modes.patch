+		for (i = 0; i < panel_info->num_modes; i++) {
+			struct drm_display_mode *mode;
+
+			if (!drm_piano_panel_can_scale(&panel_info->modes[i]))
+				continue;
+			mode = drm_mode_duplicate(connector->dev, &panel_info->modes[i]);
+			if (!mode)
+				return -ENOMEM;
+			drm_piano_panel_scaled_mode(&panel_info->modes[i], mode);
+			drm_mode_probed_add(connector, mode);
+			count++;
+		}
+	}
+
 	connector->display_info.width_mm = panel_info->modes[0].width_mm;
 	connector->display_info.height_mm = panel_info->modes[0].height_mm;
 	if (panel_info->format == MIPI_DSI_FMT_RGB101010 && panel_info->dsc_cfg)
 		connector->display_info.bpc = panel_info->dsc_cfg->bits_per_component;
 	ctx->connector = connector;
 
-	return panel_info->num_modes;
+	return count;
 }
 
