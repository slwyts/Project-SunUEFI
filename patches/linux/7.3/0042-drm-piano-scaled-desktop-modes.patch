@@ -533,6 +540,22 @@ static enum drm_mode_status dsi_mgr_bridge_mode_valid(struct drm_bridge *bridge,
 	return msm_dsi_host_check_dsc(host, mode);
 }
 
+static int dsi_mgr_bridge_atomic_check(struct drm_bridge *bridge,
+				       struct drm_bridge_state *bridge_state,
+				       struct drm_crtc_state *crtc_state,
+				       struct drm_connector_state *conn_state)
+{
+	const struct drm_display_mode *native;
+
+	native = drm_piano_panel_native_mode(&crtc_state->mode);
+	if (native) {
+		drm_mode_copy(&crtc_state->adjusted_mode, native);
+		drm_mode_set_crtcinfo(&crtc_state->adjusted_mode, 0);
+	}
+
+	return 0;
+}
+
 static int dsi_mgr_bridge_attach(struct drm_bridge *bridge,
 				 struct drm_encoder *encoder,
 				 enum drm_bridge_attach_flags flags)
@@ -555,6 +578,7 @@ static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
 	.atomic_post_disable = dsi_mgr_bridge_post_disable,
 	.mode_set = dsi_mgr_bridge_mode_set,
 	.mode_valid = dsi_mgr_bridge_mode_valid,
+	.atomic_check = dsi_mgr_bridge_atomic_check,
 };
 
 /* initialize bridge */
