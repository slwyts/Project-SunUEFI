+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _DPU_HW_GAMUTV43_H
+#define _DPU_HW_GAMUTV43_H
+
+#include <linux/types.h>
+
+#define DPU_GAMUTV43_ENTRIES (17 * 17 * 17)
+#define DPU_GAMUTV43_DATA_WORDS (4 * 1229 * 3 / 2)
+#define DPU_GAMUTV43_LUT_WORDS (DPU_GAMUTV43_DATA_WORDS + 9)
+
+struct dpu_hw_gamut_lut {
+	u16 rgb[DPU_GAMUTV43_ENTRIES][3];
+};
+
+int dpu_hw_gamutv43_pack_regdma(__le32 *words, size_t capacity,
+			      u32 dspp_mask, const struct dpu_hw_gamut_lut *lut);
+
+#endif
