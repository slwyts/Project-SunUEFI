From 514035ab6afa2c5f0f3899c3b0891ec967a116c1 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@tuta.io>
Date: Fri, 20 Nov 2026 14:30:34 +0800
Subject: [PATCH] media: v4l2-flash: Preserve the selected torch intensity

The volatile torch intensity control uses val for both the selected
setting and LED brightness readback. Reading the control while the
torch is off can reset val to the default. A later change to torch mode
then applies that default instead of the user's setting. A TRY request
can similarly change val without committing the setting or the mode.

Store the last accepted, aligned torch intensity separately. Outside
torch mode report this setting without calling the LED driver. With
the torch selected, keep using the LED brightness readback and do not
replace the setting. Use the committed mode for direct intensity writes
and reopen, and explicitly apply the setting when entering torch mode.
Do not replace it when a synchronous LED write fails.

In ARM64 QEMU, exercise VIDIOC control helpers, first-open
synchronization and the real LED class with fake brightness and strobe
callbacks. The original wrapper resets a selected 35 mA to the default
100 mA after an off-mode read; the updated wrapper keeps the 35 mA
setting with both default and driver-provided conversions.

Fixes: 42bd6f59ae90 ("media: Add registration helpers for V4L2 flash sub-devices")
Assisted-by: LLM
---
 .../media/v4l2-core/v4l2-flash-led-class.c    | 86 +++++++++++++------
 1 file changed, 59 insertions(+), 27 deletions(-)

diff --git a/drivers/media/v4l2-core/v4l2-flash-led-class.c b/drivers/media/v4l2-core/v4l2-flash-led-class.c
index 163badeef76f2e5de05c4cf24df8857229a762f6..96bbe051566285bd98e78326609e3adb4a88d58c 100644
--- a/drivers/media/v4l2-core/v4l2-flash-led-class.c
+++ b/drivers/media/v4l2-core/v4l2-flash-led-class.c
@@ -40,6 +40,16 @@ enum ctrl_init_data_id {
 	NUM_FLASH_CTRLS,
 };
 
+struct v4l2_flash_device {
+	struct v4l2_flash flash;
+	s32 torch_intensity;
+};
+
+static struct v4l2_flash_device *to_flash_device(struct v4l2_flash *flash)
+{
+	return container_of(flash, struct v4l2_flash_device, flash);
+}
+
 static enum led_brightness __intensity_to_led_brightness(
 					struct v4l2_ctrl *ctrl, s32 intensity)
 {
@@ -77,7 +87,8 @@ static s32 __led_brightness_to_intensity(struct v4l2_ctrl *ctrl,
 }
 
 static int v4l2_flash_set_led_brightness(struct v4l2_flash *v4l2_flash,
-					 struct v4l2_ctrl *ctrl)
+					 struct v4l2_ctrl *ctrl, s32 *intensity,
+					 bool apply)
 {
 	struct v4l2_ctrl **ctrls = v4l2_flash->ctrls;
 	struct led_classdev *led_cdev;
@@ -86,9 +97,9 @@ static int v4l2_flash_set_led_brightness(struct v4l2_flash *v4l2_flash,
 	if (has_flash_op(v4l2_flash, intensity_to_led_brightness))
 		brightness = call_flash_op(v4l2_flash,
 					intensity_to_led_brightness,
-					ctrl->val);
+					*intensity);
 	else
-		brightness = __intensity_to_led_brightness(ctrl, ctrl->val);
+		brightness = __intensity_to_led_brightness(ctrl, *intensity);
 	/*
 	 * In case a LED Flash class driver provides ops for custom
 	 * brightness <-> intensity conversion, it also must have defined
@@ -97,14 +108,13 @@ static int v4l2_flash_set_led_brightness(struct v4l2_flash *v4l2_flash,
 	 * aligned intensity value.
 	 */
 	if (has_flash_op(v4l2_flash, led_brightness_to_intensity))
-		ctrl->val = call_flash_op(v4l2_flash,
-					led_brightness_to_intensity,
-					brightness);
+		*intensity = call_flash_op(v4l2_flash, led_brightness_to_intensity,
+					   brightness);
 
-	if (ctrl == ctrls[TORCH_INTENSITY]) {
-		if (ctrls[LED_MODE]->val != V4L2_FLASH_LED_MODE_TORCH)
-			return 0;
+	if (!apply)
+		return 0;
 
+	if (ctrl == ctrls[TORCH_INTENSITY]) {
 		if (WARN_ON_ONCE(!v4l2_flash->fled_cdev))
 			return -EINVAL;
 
@@ -119,6 +129,15 @@ static int v4l2_flash_set_led_brightness(struct v4l2_flash *v4l2_flash,
 	return led_set_brightness_sync(led_cdev, brightness);
 }
 
+static int v4l2_flash_apply_torch_intensity(struct v4l2_flash *v4l2_flash)
+{
+	s32 intensity = to_flash_device(v4l2_flash)->torch_intensity;
+
+	return v4l2_flash_set_led_brightness(v4l2_flash,
+					    v4l2_flash->ctrls[TORCH_INTENSITY],
+					    &intensity, true);
+}
+
 static int v4l2_flash_update_led_brightness(struct v4l2_flash *v4l2_flash,
 					struct v4l2_ctrl *ctrl)
 {
@@ -127,14 +146,11 @@ static int v4l2_flash_update_led_brightness(struct v4l2_flash *v4l2_flash,
 	int ret;
 
 	if (ctrl == ctrls[TORCH_INTENSITY]) {
-		/*
-		 * Update torch brightness only if in TORCH_MODE. In other modes
-		 * torch led is turned off, which would spuriously inform the
-		 * user space that V4L2_CID_FLASH_TORCH_INTENSITY control value
-		 * has changed to 0.
-		 */
-		if (ctrls[LED_MODE]->val != V4L2_FLASH_LED_MODE_TORCH)
+		/* Outside torch mode, report the saved setting. */
+		if (ctrls[LED_MODE]->cur.val != V4L2_FLASH_LED_MODE_TORCH) {
+			ctrl->val = to_flash_device(v4l2_flash)->torch_intensity;
 			return 0;
+		}
 
 		if (WARN_ON_ONCE(!v4l2_flash->fled_cdev))
 			return -EINVAL;
@@ -217,12 +233,18 @@ static int v4l2_flash_s_ctrl(struct v4l2_ctrl *c)
 	struct led_classdev *led_cdev;
 	struct v4l2_ctrl **ctrls = v4l2_flash->ctrls;
 	bool external_strobe;
+	bool torch;
 	int ret = 0;
 
 	switch (c->id) {
 	case V4L2_CID_FLASH_TORCH_INTENSITY:
+		torch = ctrls[LED_MODE]->cur.val == V4L2_FLASH_LED_MODE_TORCH;
+		ret = v4l2_flash_set_led_brightness(v4l2_flash, c, &c->val, torch);
+		if (!ret)
+			to_flash_device(v4l2_flash)->torch_intensity = c->val;
+		return ret;
 	case V4L2_CID_FLASH_INDICATOR_INTENSITY:
-		return v4l2_flash_set_led_brightness(v4l2_flash, c);
+		return v4l2_flash_set_led_brightness(v4l2_flash, c, &c->val, true);
 	}
 
 	if (!fled_cdev)
@@ -261,8 +283,7 @@ static int v4l2_flash_s_ctrl(struct v4l2_ctrl *c)
 			if (ret < 0)
 				return ret;
 
-			return v4l2_flash_set_led_brightness(v4l2_flash,
-							     ctrls[TORCH_INTENSITY]);
+			return v4l2_flash_apply_torch_intensity(v4l2_flash);
 		}
 		break;
 	case V4L2_CID_FLASH_STROBE_SOURCE:
@@ -491,6 +512,10 @@ static int v4l2_flash_init_controls(struct v4l2_flash *v4l2_flash,
 		goto error_free_handler;
 	}
 
+	if (v4l2_flash->ctrls[TORCH_INTENSITY])
+		to_flash_device(v4l2_flash)->torch_intensity =
+			v4l2_flash->ctrls[TORCH_INTENSITY]->default_value;
+
 	v4l2_ctrl_handler_setup(&v4l2_flash->hdl);
 
 	v4l2_flash->sd.ctrl_handler = &v4l2_flash->hdl;
@@ -506,18 +531,24 @@ static int __sync_device_with_v4l2_controls(struct v4l2_flash *v4l2_flash)
 {
 	struct led_classdev_flash *fled_cdev = v4l2_flash->fled_cdev;
 	struct v4l2_ctrl **ctrls = v4l2_flash->ctrls;
+	bool torch;
 	int ret = 0;
 
-	if (ctrls[TORCH_INTENSITY]) {
-		ret = v4l2_flash_set_led_brightness(v4l2_flash,
-						    ctrls[TORCH_INTENSITY]);
+	guard(mutex)(v4l2_flash->hdl.lock);
+
+	torch = ctrls[LED_MODE] &&
+		ctrls[LED_MODE]->cur.val == V4L2_FLASH_LED_MODE_TORCH;
+	if (torch) {
+		ret = v4l2_flash_apply_torch_intensity(v4l2_flash);
 		if (ret < 0)
 			return ret;
 	}
 
 	if (ctrls[INDICATOR_INTENSITY]) {
 		ret = v4l2_flash_set_led_brightness(v4l2_flash,
-						    ctrls[INDICATOR_INTENSITY]);
+						    ctrls[INDICATOR_INTENSITY],
+						    &ctrls[INDICATOR_INTENSITY]->val,
+						    true);
 		if (ret < 0)
 			return ret;
 	}
@@ -548,8 +579,7 @@ static int __sync_device_with_v4l2_controls(struct v4l2_flash *v4l2_flash)
 	 * mode. For torch mode case it will get synchronized upon switching
 	 * to flash mode.
 	 */
-	if (ctrls[STROBE_SOURCE] &&
-	    ctrls[LED_MODE]->val != V4L2_FLASH_LED_MODE_TORCH)
+	if (ctrls[STROBE_SOURCE] && !torch)
 		ret = call_flash_op(v4l2_flash, external_strobe_set,
 					ctrls[STROBE_SOURCE]->val);
 
@@ -654,6 +684,7 @@ static struct v4l2_flash *__v4l2_flash_init(
 	struct led_classdev_flash *fled_cdev, struct led_classdev *iled_cdev,
 	const struct v4l2_flash_ops *ops, struct v4l2_flash_config *config)
 {
+	struct v4l2_flash_device *flash;
 	struct v4l2_flash *v4l2_flash;
 	struct v4l2_subdev *sd;
 	int ret;
@@ -661,10 +692,11 @@ static struct v4l2_flash *__v4l2_flash_init(
 	if (!config)
 		return ERR_PTR(-EINVAL);
 
-	v4l2_flash = devm_kzalloc(dev, sizeof(*v4l2_flash), GFP_KERNEL);
-	if (!v4l2_flash)
+	flash = devm_kzalloc(dev, sizeof(*flash), GFP_KERNEL);
+	if (!flash)
 		return ERR_PTR(-ENOMEM);
 
+	v4l2_flash = &flash->flash;
 	sd = &v4l2_flash->sd;
 	v4l2_flash->fled_cdev = fled_cdev;
 	v4l2_flash->iled_cdev = iled_cdev;
