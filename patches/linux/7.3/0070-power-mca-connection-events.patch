+static void piano_mca_sync_connection(struct piano_mca *mca)
+{
+	unsigned int connection = piano_mca_connection_generation(mca);
+
+	if (mca->polled_connection_generation == connection)
+		return;
+
+	/* VBUS may already be back: discard policy learned from the old source. */
+	mca->auth_ok = false;
+	if (mca->mipps_attempted)
+		mca->mipps_cleanup_pending = true;
+	mca->mipps_attempted = false;
+	mca->auth_tried = false;
+	piano_mca_cp_stop(mca, "connection changed");
+	mca->cp = MCA_CP_OFF;
+	mca->cp_ibus_cap = 0;
+	mca->hv = MCA_HV_OFF;
+	mca->hv_renegs = 0;
+	mca->online = false;
+	mca->polled_connection_generation = connection;
+}
+
 static void piano_mca_poll(struct work_struct *work)
 {
 	struct piano_mca *mca = container_of(work, struct piano_mca, poll.work);
 	bool online, changed;
 	u32 real_type = MCA_TYPE_UNKNOWN;
 
+	piano_mca_sync_connection(mca);
 	/* Finish an uncertain VERIFY_PROCESS write before any charging policy. */
 	if (piano_mca_mipps_cleanup(mca))
 		goto requeue;
@@ -2241,6 +2345,9 @@ static void piano_mca_poll(struct work_struct *work)
 		piano_mca_pen_boost_on(mca);
 	mutex_unlock(&mca->pen_boost_lock);
 
+	if (mca->polled_connection_generation != piano_mca_connection_generation(mca))
+		goto requeue;
+
 	if (!online) {
 		/* UCSI ONLINE follows the connector, not VBUS. Preserve an
 		 * authentication reset only while its cable remains connected.
@@ -2267,7 +2374,8 @@ static void piano_mca_poll(struct work_struct *work)
 		piano_mca_cp_step(mca);
 	} else if (charge_policy) {
 		piano_mca_mipps_authenticate(mca);
-		if (!mca->mipps_cleanup_pending) {
+		if (!mca->mipps_cleanup_pending &&
+		    mca->polled_connection_generation == piano_mca_connection_generation(mca)) {
 			piano_mca_cp_try_start(mca);
 			if (!piano_mca_cp_active(mca))
 				piano_mca_apply_policy(mca);
@@ -2743,6 +2851,7 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 	mutex_init(&mca->pen_boost_lock);
 	init_completion(&mca->ack);
 	INIT_DELAYED_WORK(&mca->poll, piano_mca_poll);
+	atomic_set(&mca->connection_generation, 0);
 
 	/* Allocated first so it outlives the poll work on unbind */
 	mca->client = devm_pmic_glink_client_alloc(dev, PMIC_GLINK_OWNER_BATTMGR,
@@ -2774,6 +2883,16 @@ static int piano_mca_probe(struct auxiliary_device *adev,
 			    &piano_mca_dbg_summary_fops);
 	devm_add_action_or_reset(dev, piano_mca_dbg_remove, mca->dbg);
 
+	/* Resources are ready; unregister before the earlier poll-stop action. */
+	mca->connection_notifier.notifier_call = piano_mca_connection_changed;
+	ret = power_supply_reg_notifier(&mca->connection_notifier);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(dev, piano_mca_unregister_connection_notifier,
+				       mca);
+	if (ret)
+		return ret;
+
 	pmic_glink_client_register(mca->client);
 
 	if (pan_ack)
diff --git a/drivers/power/supply/power_supply_core.c b/drivers/power/supply/power_supply_core.c
index 127978564..c45a7f1e0 100644
--- a/drivers/power/supply/power_supply_core.c
+++ b/drivers/power/supply/power_supply_core.c
@@ -161,6 +161,24 @@ void power_supply_changed(struct power_supply *psy)
 }
 EXPORT_SYMBOL_GPL(power_supply_changed);
 
+/**
+ * power_supply_connection_changed - Report a physical connection change
+ * @psy: the power supply whose connection changed
+ *
+ * Notify listeners synchronously before queuing the ordinary property update.
+ * Unlike property notifications, connection changes must not be coalesced: a
+ * disconnect and reconnect can invalidate state even when ONLINE stays true
+ * by the time the queued update runs. Callers must be in sleepable context;
+ * listeners must not query properties requiring locks held by the caller.
+ */
+void power_supply_connection_changed(struct power_supply *psy)
+{
+	blocking_notifier_call_chain(&power_supply_notifier,
+				     PSY_EVENT_CONNECTION_CHANGED, psy);
+	power_supply_changed(psy);
+}
+EXPORT_SYMBOL_GPL(power_supply_connection_changed);
+
 /*
  * Notify that power supply was registered after parent finished the probing.
  *
diff --git a/drivers/usb/typec/ucsi/psy.c b/drivers/usb/typec/ucsi/psy.c
index c8ebab8ba..ba8592a4e 100644
--- a/drivers/usb/typec/ucsi/psy.c
+++ b/drivers/usb/typec/ucsi/psy.c
@@ -353,3 +353,11 @@ void ucsi_port_psy_changed(struct ucsi_connector *con)
 
 	power_supply_changed(con->psy);
 }
+
+void ucsi_port_psy_connection_changed(struct ucsi_connector *con)
+{
+	if (IS_ERR_OR_NULL(con->psy))
+		return;
+
+	power_supply_connection_changed(con->psy);
+}
