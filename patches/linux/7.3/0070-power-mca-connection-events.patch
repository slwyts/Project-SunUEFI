 /*
@@ -824,9 +874,10 @@ static bool piano_mca_write_allowed(struct piano_mca *mca, u32 prop,
 }
 
 /* Every write passes the allowlist and is bound to one ADSP instance. */
-static int piano_mca_write_generation(struct piano_mca *mca, u32 prop,
-				      const void *data, size_t len,
