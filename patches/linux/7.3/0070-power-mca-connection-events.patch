@@ -747,7 +796,8 @@ static int piano_mca_xfer(struct piano_mca *mca, u32 opcode, u32 prop,
 static int piano_mca_read(struct piano_mca *mca, u32 prop, void *buf, size_t len)
 {
 	return piano_mca_xfer(mca, MCA_OP_READ, prop, buf, len,
-			      pmic_glink_get_generation(mca->client));
+			      pmic_glink_get_generation(mca->client),
+			      piano_mca_connection_generation(mca));
