 drivers/media/i2c/Kconfig  |  10 ++
 drivers/media/i2c/Makefile |   1 +
 drivers/media/i2c/gt9764.c | 313 +++++++++++++++++++++++++++++++++++++
 4 files changed, 325 insertions(+)
 create mode 100644 drivers/media/i2c/gt9764.c

