+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+"""Exercise the real THP control functions with a scripted SPI/IRQ transport.
+
+Run with python3 test_thp_control.py. No device access or kernel build is used.
+The harness compiles functions extracted from nt36xxx.c, so it tests production
+retry/cleanup/state transitions rather than a second protocol implementation.
+"""
+from pathlib import Path
+import os
+import re
+import subprocess
+import tempfile
+
+
+def function(source, name):
+    match = re.search(r"^(?:static )?(?:int|bool|void|ssize_t) " + name +
+                      r"\(", source, re.MULTILINE)
+    if not match:
+        raise RuntimeError("Missing production function: " + name)
+    opening = source.index("{", match.start())
+    depth = 1
+    cursor = opening + 1
+    while depth:
+        depth += (source[cursor] == "{") - (source[cursor] == "}")
+        cursor += 1
+    return source[match.start():cursor]
+
+
+PRELUDE = r"""
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+#define EVENT_MAP_HOST_CMD 0x50
+#define NVT_IC_SUSPEND_IN 1
+#define NVT_IC_SUSPEND_OUT 2
+#define __user
+#define NVT_ERR(...) do {} while (0)
+struct file {};
+struct spi_device { int irq; };
+struct nvt_ts_mem_map { u32 EVENT_BUF_ADDR; };
+struct nvt_ts_data {
+    struct spi_device *client;
+    struct nvt_ts_mem_map *mmap;
+    int lock, ic_state;
+    bool dev_pm_suspend, irq_enabled, thp_firmware_ready;
+    bool thp_game_valid, thp_game_prior_valid;
+    u8 fw_ver, thp_game_fw_ver, thp_game_requested, thp_game_prior;
+    u16 nvt_pid, thp_game_fw_pid;
+    u32 thp_firmware_crc, thp_game_fw_crc;
+};
+static struct spi_device client = { .irq = 7 };
+static struct nvt_ts_mem_map mmap = { .EVENT_BUF_ADDR = 0x11c400 };
+static struct nvt_ts_data state, *ts = &state;
+static u8 bTouchIsAwake;
+static int irq_depth, sleeps;
+struct step {
+    char kind;
+    int error, len;
+    u8 cmd, status;
+    bool read;
+    u16 value;
+    u32 addr;
+};
+static struct step steps[256];
+static int step_count, step_cursor;
+static struct step *take(char kind)
+{
+    assert(step_cursor < step_count);
+    struct step *s = &steps[step_cursor++];
+    assert(s->kind == kind);
+    return s;
+}
+static void plan_page(u32 addr, int error)
+{
+    steps[step_count++] = (struct step){ .kind='P', .addr=addr, .error=error };
+}
+static void plan_write(u8 cmd, bool read, u16 value, int error)
+{
+    steps[step_count++] = (struct step){
+        .kind='W', .cmd=cmd, .read=read, .value=value, .error=error };
+}
+static void plan_read(bool read, u8 status, u16 value, int error)
+{
+    steps[step_count++] = (struct step){
+        .kind='R', .len=read ? 6 : 2, .status=status, .value=value, .error=error };
+}
+static void plan_command(u8 cmd, bool read, u16 value, u16 response)
+{
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0);
+    plan_write(cmd, read, value, 0);
+    plan_read(read, 0, response, 0);
+    plan_page(mmap.EVENT_BUF_ADDR, 0);
+}
+static void plan_game(bool read, u16 value)
+{
+    plan_command(0x0f, read, read ? 0 : value, read ? value : 0);
+}
+static void plan_game_write_error(u16 value)
+{
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0);
+    plan_write(0x0f, false, value, -EIO);
+    plan_page(mmap.EVENT_BUF_ADDR, 0);
+}
+static int nvt_set_page(u32 addr)
+{
+    struct step *s = take('P');
+    assert(s->addr == addr);
+    return s->error;
+}
+static int CTP_SPI_WRITE(struct spi_device *dev, u8 *buf, int len)
+{
+    struct step *s = take('W');
+    assert(dev == &client && len == (s->read ? 4 : 6));
+    assert(buf[0] == 0x50 && buf[1] == 0xbf && buf[2] == s->cmd);
+    assert(buf[3] == (s->read ? 1 : 0));
+    if (!s->read)
+        assert(buf[4] == (s->value & 255) && buf[5] == (s->value >> 8));
+    buf[0] |= 0x80; /* The production SPI wrapper mutates the write offset. */
+    return s->error;
+}
+static int CTP_SPI_READ(struct spi_device *dev, u8 *buf, int len)
+{
+    struct step *s = take('R');
+    assert(dev == &client && len == s->len);
+    assert(buf[0] == 0x50 && buf[1] == 0xff);
+    for (int i=2; i<len; i++) assert(buf[i] == 0);
+    if (!s->error) {
+        buf[1] = s->status;
+        if (len == 6) { buf[4] = s->value & 255; buf[5] = s->value >> 8; }
+    }
+    return s->error;
+}
+static void usleep_range(int lower, int upper)
+{
+    assert(lower == 10000 && upper == 11000);
+    sleeps++;
+}
+static u16 get_unaligned_le16(const void *ptr)
+{
+    const u8 *p = ptr;
+    return p[0] | (p[1] << 8);
+}
+static void disable_irq(int irq) { assert(irq == 7); irq_depth++; }
+static void enable_irq(int irq) { assert(irq == 7 && irq_depth > 0); irq_depth--; }
+static void mutex_lock(int *lock) { assert(!*lock); *lock = 1; }
+static void mutex_unlock(int *lock) { assert(*lock); *lock = 0; }
+static int kstrtou8_from_user(const char *buf, size_t count, int base, u8 *value)
+{
+    char tmp[32], *end;
+    if (!count || count >= sizeof(tmp)) return -EINVAL;
+    memcpy(tmp, buf, count); tmp[count]=0;
+    unsigned long result = strtoul(tmp, &end, base);
+    if (end == tmp || (*end && strcmp(end, "\n")) || result > 255) return -EINVAL;
+    *value = result;
+    return 0;
+}
+static void reset(void)
+{
+    assert(step_cursor == step_count);
+    state = (struct nvt_ts_data){
+        .client=&client, .mmap=&mmap, .irq_enabled=true,
+        .thp_firmware_ready=true, .fw_ver=0x13, .nvt_pid=0x59b0,
+        .thp_firmware_crc=0x12345678 };
+    bTouchIsAwake=1; irq_depth=0; step_count=0; step_cursor=0; sleeps=0;
+}
+static void confirmed_request(u8 value)
+{
+    ts->thp_game_valid=true; ts->thp_game_requested=value;
+    ts->thp_game_fw_crc=ts->thp_firmware_crc;
+    ts->thp_game_fw_ver=ts->fw_ver; ts->thp_game_fw_pid=ts->nvt_pid;
+}
+"""
+
+TESTS = r"""
+int main(void)
+{
+    u16 value=0x9999;
+    reset();
+    plan_command(0x0a, true, 0, 0x0168);
+    assert(!nvt_thp_extended_cmd(0x0a, true, &value) && value == 360);
+    assert(sleeps == 1); /* A returned 360 is data, not a guessed setter. */
+
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0);
+    plan_write(0x09, true, 0, 0);
+    plan_read(true, 0xbf, 0, 0); plan_read(true, 0xbf, 0, 0);
+    plan_read(true, 0, 0xabcd, 0); plan_page(mmap.EVENT_BUF_ADDR, 0);
+    assert(!nvt_thp_extended_cmd(0x09, true, &value) && value == 0xabcd);
+    assert(sleeps == 3); /* Pending requests are polled without resubmission. */
+
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0);
+    plan_write(0x08, true, 0, 0); plan_read(true, 0x7f, 0, 0);
+    plan_write(0x08, true, 0, 0); plan_read(true, 0, 4, 0);
+    plan_page(mmap.EVENT_BUF_ADDR, 0);
+    assert(!nvt_thp_extended_cmd(0x08, true, &value) && value == 4);
+
+    reset(); value=123;
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0); plan_write(0x0a, true, 0, 0);
+    for (int i=0; i<10; i++) plan_read(true, 0xbf, 0, 0);
+    plan_page(mmap.EVENT_BUF_ADDR, 0);
+    assert(nvt_thp_extended_cmd(0x0a, true, &value) == -ETIMEDOUT);
+    assert(value == 123 && sleeps == 10);
+
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, -EIO);
+    plan_page(mmap.EVENT_BUF_ADDR, -ENOSPC);
+    assert(nvt_thp_extended_cmd(0x0a, true, &value) == -EIO);
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0); plan_write(0x0a, true, 0, -EIO);
+    plan_page(mmap.EVENT_BUF_ADDR, 0);
+    assert(nvt_thp_extended_cmd(0x0a, true, &value) == -EIO);
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0); plan_write(0x0a, true, 0, 0);
+    plan_read(true, 0, 360, -EIO); plan_page(mmap.EVENT_BUF_ADDR, 0);
+    assert(nvt_thp_extended_cmd(0x0a, true, &value) == -EIO && value == 123);
+    reset();
+    plan_page(mmap.EVENT_BUF_ADDR | 0x50, 0); plan_write(0x0a, true, 0, 0);
+    plan_read(true, 0, 360, 0); plan_page(mmap.EVENT_BUF_ADDR, -ENOSPC);
+    assert(nvt_thp_extended_cmd(0x0a, true, &value) == -ENOSPC && value == 123);
+    puts("PASS: vendor packets, pending/resubmit ACKs, timeout, SPI/page cleanup");
+
+    reset(); ts->thp_firmware_ready=false;
+    assert(nvt_thp_control_begin() == -EAGAIN && !irq_depth && !ts->lock);
+    reset(); bTouchIsAwake=0;
+    assert(nvt_thp_control_begin() == -EAGAIN && !irq_depth && !ts->lock);
+    reset(); ts->dev_pm_suspend=true;
+    assert(nvt_thp_control_begin() == -EAGAIN && !irq_depth && !ts->lock);
+    reset(); ts->ic_state=NVT_IC_SUSPEND_IN;
+    assert(nvt_thp_control_begin() == -EAGAIN && !irq_depth && !ts->lock);
+    reset(); irq_depth=1; ts->irq_enabled=false;
+    assert(!nvt_thp_control_begin() && irq_depth == 2 && ts->lock);
+    nvt_thp_control_end();
+    assert(irq_depth == 1 && !ts->lock && !ts->irq_enabled);
+    puts("PASS: not-ready/suspend gates and preservation of an existing IRQ disable");
+
+    reset();
+    assert(nvt_thp_game_write(NULL, "2", 1, NULL) == -EINVAL && !irq_depth);
+    assert(nvt_thp_game_rollback_write(NULL, "1", 1, NULL) == -ENODATA);
+    assert(!irq_depth && !ts->lock);
+    plan_game(true, 0); plan_game(false, 1); plan_game(true, 1);
+    assert(nvt_thp_game_write(NULL, "1", 1, NULL) == 1);
+    assert(ts->thp_game_valid && ts->thp_game_prior_valid);
+    assert(ts->thp_game_requested == 1 && ts->thp_game_prior == 0);
+    assert(!irq_depth && !ts->lock);
+    plan_game(true, 1); plan_game(false, 1); plan_game(true, 1);
+    assert(nvt_thp_game_write(NULL, "1", 1, NULL) == 1);
+    assert(ts->thp_game_prior == 0); /* Idempotent writes keep the baseline. */
+    plan_game(true, 1); plan_game(false, 0); plan_game(true, 0);
+    assert(nvt_thp_game_write(NULL, "0", 1, NULL) == 1);
+    assert(ts->thp_game_prior == 0); /* Opposite writes also keep the baseline. */
+    plan_game(true, 0); plan_game(false, 0); plan_game(true, 0);
+    assert(nvt_thp_game_rollback_write(NULL, "1", 1, NULL) == 1);
+    assert(!ts->thp_game_prior_valid && ts->thp_game_requested == 0);
+    assert(!irq_depth && !ts->lock);
+    puts("PASS: typed 0/1 writes, readback validation, oldest baseline and rollback");
+
+    reset();
+    plan_game(true, 2);
+    assert(nvt_thp_game_write(NULL, "1", 1, NULL) == -ERANGE);
+    assert(!ts->thp_game_valid && !irq_depth && !ts->lock);
+    reset();
+    plan_game(true, 0); plan_game(false, 1); plan_game(true, 0);
+    plan_game(false, 0); plan_game(true, 0);
+    assert(nvt_thp_game_write(NULL, "1", 1, NULL) == -EIO);
+    assert(!ts->thp_game_valid && !irq_depth && !ts->lock);
+    reset(); confirmed_request(0); ts->thp_game_prior_valid=true;
+    plan_game(true, 0); plan_game_write_error(1); plan_game_write_error(0);
+    assert(nvt_thp_game_write(NULL, "1", 1, NULL) == -EIO);
+    assert(!ts->thp_game_valid && !ts->thp_game_prior_valid);
+    assert(!irq_depth && !ts->lock);
+    puts("PASS: out-of-range/readback failures and uncertain rollback invalidate state");
+
+    reset(); nvt_thp_restore_game(); /* Default: no automatic command. */
+    confirmed_request(1); ts->thp_firmware_crc++;
+    nvt_thp_restore_game();
+    assert(!ts->thp_game_valid && !ts->thp_game_prior_valid);
+    reset(); confirmed_request(1); ts->fw_ver++;
+    nvt_thp_restore_game(); assert(!ts->thp_game_valid);
+    reset(); confirmed_request(1); ts->nvt_pid++;
+    nvt_thp_restore_game(); assert(!ts->thp_game_valid);
+    reset(); confirmed_request(1); ts->thp_firmware_ready=false;
+    nvt_thp_restore_game(); assert(!ts->thp_game_valid);
+    reset(); confirmed_request(1); ts->thp_game_prior_valid=true; ts->thp_game_prior=0;
+    plan_game(true, 0); plan_game(false, 1); plan_game(true, 1);
+    nvt_thp_restore_game();
+    assert(ts->thp_game_valid && ts->thp_game_requested == 1);
