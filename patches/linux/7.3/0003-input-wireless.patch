+void nvt_set_doze_delay(u16 value)
+{
+	u8 buf[3] = {0};
+
+	nvt_set_page(0x113718);
+	buf[0] = 0x113718 & 0x7F;
+	buf[1] = value & 0xFF;
+	buf[2] = value >> 8;
+	CTP_SPI_WRITE(ts->client, buf, 3);
+}
