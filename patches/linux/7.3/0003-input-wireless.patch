+static int nanosic_wn8030_xm_auth_init(struct nanosic_wn8030 *nanosic)
+{
+	u8 buf[XM_WN8030_I2C_WRITE] = { 0x32, 0x00, 0x4F, 0x31,
+					0x80, 0x38, 0x31, 0x06,
+					0x4d, 0x49, 0x41, 0x55, 0x54, 0x48,
+					0x00 };
+
+	buf[14] = nanosic_wn8030_checksum8(&buf[2], 13);
