+			container_of(led_cdev, struct nanosic_wn8030, kbd_backlight_led);
+	int ret = 0;
+
+	if (brightness > 100)
+		return -EINVAL;
+
+	mutex_lock(&nanosic->conn_mutex);
+	ret = nanosic_wn8030_sync_kbd_backlight(nanosic);
+	mutex_unlock(&nanosic->conn_mutex);
+
+	return ret;
