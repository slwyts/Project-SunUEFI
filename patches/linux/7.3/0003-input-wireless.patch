+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/gpio.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/poll.h>
+#include <linux/power_supply.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of_irq.h>
+#include <linux/unaligned.h>
+#include <linux/vmalloc.h>
+#include <uapi/linux/sched/types.h>
+#include "nt36xxx.h"
+
+#if defined(CONFIG_DRM_PANEL)
+#include <drm/drm_panel.h>
+#endif
+
+static int32_t nvt_ts_suspend(struct device *dev);
+static int32_t nvt_ts_resume(struct device *dev);
+struct nvt_ts_data *ts;
+static uint8_t bTouchIsAwake;
+
+#if BOOT_UPDATE_FIRMWARE
+static struct workqueue_struct *nvt_fwu_wq;
+extern void Boot_Update_Firmware(struct work_struct *work);
+#endif
+
+#if defined(CONFIG_DRM_PANEL)
+static struct drm_panel_follower_funcs nt36xxx_panel_follower_funcs;
+#endif
+
+/* The follower lives inside ts, so it must not outlive manual ts cleanup.
+ * drm_panel_remove_follower() takes the panel follower lock, waits for
+ * callbacks and invokes unprepare while our work/IRQ/locks still exist.
+ */
+static void nvt_panel_remove_follower(struct nvt_ts_data *data)
+{
+#if defined(CONFIG_DRM_PANEL)
+	if (data->panel_follower_registered) {
+		drm_panel_remove_follower(&data->panel_follower);
+		data->panel_follower_registered = false;
+	}
+#endif
+}
+#define NVT_THP_HEADER_LEN 257
+/* sheng payload length, used when the firmware has no polling info */
+#define NVT_THP_DEFAULT_PAYLOAD_LEN 5160
+/* one SPI read must fit rbuf together with the dummy byte */
+#define NVT_THP_MAX_PAYLOAD_LEN (NVT_READ_LEN - NVT_THP_HEADER_LEN - DUMMY_BYTES)
+#define NVT_THP_MAX_FRAME_LEN (NVT_THP_HEADER_LEN + NVT_THP_MAX_PAYLOAD_LEN)
+#define NVT_THP_POLL_INFO_LEN 39
+#define NVT_THP_STREAM_SIZE (4 * 1024 * 1024)
+#define NVT_THP_STREAM_MAGIC 0x3150544e
+#define NVT_THP_STREAM_FLAG_VALID BIT(0)
+#define NVT_THP_STREAM_FLAG_EPOCH BIT(1)
+
+struct nvt_thp_stream_header {
+	__le32 magic;
+	__le16 header_len;
+	__le16 frame_len;
+	__le64 sequence;
+	__le64 timestamp_ns;
+	__le16 header_crc;
+	__le16 flags;
+	__le32 firmware_magic;
+} __packed;
+
+static bool nvt_thp_header_valid(const u8 *frame, u16 *header_crc,
+				 u32 *magic)
+{
+	u16 crc = get_unaligned_le16(frame + NVT_THP_HEADER_LEN + 4);
+	u32 marker = get_unaligned_le32(frame + NVT_THP_HEADER_LEN + 8);
+	u16 crc_inv = get_unaligned_le16(frame + NVT_THP_HEADER_LEN + 12);
+	u32 marker_inv = get_unaligned_le32(frame + NVT_THP_HEADER_LEN + 16);
+
+	*header_crc = crc;
+	*magic = marker;
+
+	return crc_inv == (u16)~crc && marker_inv == ~marker;
+}
+
+static u16 nvt_thp_frame_len(void)
+{
+	return NVT_THP_HEADER_LEN + ts->thp_payload_len;
+}
+
+static int nvt_thp_read_frame(u8 *fw_state)
+{
+	int ret;
+
+	mutex_lock(&ts->thp_lock);
+	nvt_set_page(ts->mmap->EVENT_BUF_ADDR);
+	ts->thp_frame[0] = 0;
+	ret = CTP_SPI_READ(ts->client, ts->thp_frame, nvt_thp_frame_len());
+	if (ret < 0)
+		ts->thp_read_errors++;
+	else {
+		memcpy(fw_state, ts->thp_frame, 7);
+		ts->thp_timestamp = ktime_get_boottime();
+	}
+	mutex_unlock(&ts->thp_lock);
+
+	return ret;
+}
+
+static void nvt_thp_publish_frame(void)
+{
+	struct nvt_thp_stream_header header;
+	u16 frame_len = nvt_thp_frame_len();
+	size_t record_len = sizeof(header) + frame_len;
+	u16 header_crc;
+	u32 magic;
+	bool valid;
+	bool epoch;
+
+	mutex_lock(&ts->thp_lock);
+	valid = nvt_thp_header_valid(ts->thp_frame, &header_crc, &magic);
+	ts->thp_frame_count++;
+	ts->thp_frame_valid = valid;
+	ts->thp_header_crc = header_crc;
+	ts->thp_magic = magic;
+	if (!valid)
+		ts->thp_header_errors++;
+	epoch = valid && ts->thp_epoch_pending;
+	if (epoch)
+		ts->thp_epoch_pending = false;
+
+	header.magic = cpu_to_le32(NVT_THP_STREAM_MAGIC);
+	header.header_len = cpu_to_le16(sizeof(header));
+	header.frame_len = cpu_to_le16(frame_len);
+	header.sequence = cpu_to_le64(ts->thp_frame_count);
+	header.timestamp_ns = cpu_to_le64(ktime_to_ns(ts->thp_timestamp));
+	header.header_crc = cpu_to_le16(header_crc);
+	header.flags = cpu_to_le16((valid ? NVT_THP_STREAM_FLAG_VALID : 0) |
+				       (epoch ? NVT_THP_STREAM_FLAG_EPOCH : 0));
+	header.firmware_magic = cpu_to_le32(magic);
+
+	if (!ts->thp_capture_enabled) {
+		/* statistics only */
+	} else if (kfifo_avail(&ts->thp_stream_fifo) < record_len) {
+		ts->thp_stream_drops++;
+	} else {
+		kfifo_in(&ts->thp_stream_fifo, &header, sizeof(header));
+		kfifo_in(&ts->thp_stream_fifo, ts->thp_frame, frame_len);
+	}
+	mutex_unlock(&ts->thp_lock);
+	wake_up_interruptible(&ts->thp_stream_wait);
+}
+
+void nvt_thp_mark_epoch(void)
+{
+	if (!ts)
+		return;
+
+	mutex_lock(&ts->thp_lock);
+	ts->thp_epoch_pending = true;
+	ts->thp_epoch_count++;
+	if (ts->thp_capture_enabled)
+		kfifo_reset(&ts->thp_stream_fifo);
+	mutex_unlock(&ts->thp_lock);
+	wake_up_interruptible(&ts->thp_stream_wait);
+}
+
+static ssize_t nvt_thp_raw_write(struct file *file, const char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	bool enable;
+	int ret;
+
+	if (!ts)
+		return -ENODEV;
+
+	ret = kstrtobool_from_user(buf, count, &enable);
+	if (ret)
+		return ret;
+
+	mutex_lock(&ts->thp_lock);
+	if (enable && !ts->thp_capture_enabled)
+		kfifo_reset(&ts->thp_stream_fifo);
+	WRITE_ONCE(ts->thp_capture_enabled, enable);
+	mutex_unlock(&ts->thp_lock);
+	wake_up_interruptible(&ts->thp_stream_wait);
+	NVT_ERR("THP passive capture %s, event buffer 0x%06X\n",
+		enable ? "enabled" : "disabled", ts->mmap->EVENT_BUF_ADDR);
+
+	return count;
+}
+
+/*
+ * Xiaomi p81/NT36532 THP ABI, also verified against the captured Piano
+ * nt36532_touch.ko (SHA256 d3ef0e85f98147d50784fc6b32d1d55e53834e8aa406e682e86c048ef663bac0):
+ * https://github.com/MiCode/vendor_xiaomi_proprietary_touch-driver/blob/piano-w-oss/p81/nt36532/nt36xxx_ext_proc.c
+ * nvt_{get,set}_extend_custom_cmd and nvt_xm_htc_{get,set}_game_mode.
+ * 0x08 is a frequency selection number; 0x0a/0x0b are scan-rate getters.
+ * The vendor source supplies no index-to-Hz mapping or 360-Hz command.
+ * Caller holds ts->lock; a read request itself writes the host mailbox.
+ */
+static int nvt_thp_extended_cmd(u8 cmd, bool read, u16 *value)
+{
+	u8 buf[6] = { 0 };
+	u8 status = 0;
+	u16 result = 0;
+	int retry, ret, page_ret;
+
+	ret = nvt_set_page(ts->mmap->EVENT_BUF_ADDR | EVENT_MAP_HOST_CMD);
+	if (ret < 0)
+		goto out;
+
+	for (retry = 0; retry < 10; retry++) {
+		/* 0xbf means the preceding request is still pending. */
+		if (status != 0xbf) {
+			buf[0] = EVENT_MAP_HOST_CMD;
+			buf[1] = 0xbf;
+			buf[2] = cmd;
+			buf[3] = read ? 0x01 : 0x00;
+			buf[4] = *value & 0xff;
+			buf[5] = *value >> 8;
+			ret = CTP_SPI_WRITE(ts->client, buf, read ? 4 : 6);
+			if (ret < 0)
+				goto out;
+		}
+
+		usleep_range(10000, 11000);
+		memset(buf, 0, sizeof(buf));
+		buf[0] = EVENT_MAP_HOST_CMD;
+		buf[1] = 0xff;
+		ret = CTP_SPI_READ(ts->client, buf, read ? 6 : 2);
+		if (ret < 0)
+			goto out;
+		status = buf[1];
+		if (!status) {
+			result = get_unaligned_le16(buf + 4);
+			break;
+		}
+	}
+	ret = retry == 10 ? -ETIMEDOUT : 0;
+out:
+	/* Restore the frame-read page on every exit, including SPI errors. */
+	page_ret = nvt_set_page(ts->mmap->EVENT_BUF_ADDR);
+	if (!ret && page_ret < 0)
+		ret = page_ret;
+	if (!ret && read)
+		*value = result;
+	return ret;
+}
+
+static int nvt_thp_control_begin(void)
+{
+	/*
+	 * Balance our own IRQ-disable reference without changing irq_enabled.
+	 * This preserves a concurrent suspend/boot disable, and avoids waiting
+	 * for the IRQ thread while holding the mutex that thread needs.
+	 */
+	disable_irq(ts->client->irq);
+	mutex_lock(&ts->lock);
+	if (!bTouchIsAwake || ts->dev_pm_suspend ||
+	    !ts->thp_firmware_ready || ts->ic_state == NVT_IC_SUSPEND_IN ||
+	    ts->ic_state == NVT_IC_SUSPEND_OUT) {
+		mutex_unlock(&ts->lock);
+		enable_irq(ts->client->irq);
+		return -EAGAIN;
+	}
+	return 0;
+}
+
+static void nvt_thp_control_end(void)
+{
+	mutex_unlock(&ts->lock);
+	enable_irq(ts->client->irq);
+}
+
+static bool nvt_thp_game_firmware_matches(void)
+{
+	return ts->thp_firmware_ready &&
+	       ts->thp_game_fw_crc == ts->thp_firmware_crc &&
+	       ts->thp_game_fw_ver == ts->fw_ver &&
+	       ts->thp_game_fw_pid == ts->nvt_pid;
+}
+
+static void nvt_thp_game_forget(void)
+{
+	ts->thp_game_valid = false;
+	ts->thp_game_prior_valid = false;
+}
+
+static int nvt_thp_game_get(u16 *value)
+{
+	int ret = nvt_thp_extended_cmd(0x0f, true, value);
+
+	if (!ret && *value > 1)
+		ret = -ERANGE;
+	return ret;
+}
+
+/* Caller holds ts->lock. Only confirmed writes become reload requests. */
+static int nvt_thp_game_apply(u8 requested, bool save_prior)
+{
+	u16 before = 0, after = 0, target = requested;
+	int ret, rollback_ret;
+
+	ret = nvt_thp_game_get(&before);
+	if (ret)
+		return ret;
+	ret = nvt_thp_extended_cmd(0x0f, false, &target);
+	if (!ret)
+		ret = nvt_thp_game_get(&after);
+	if (!ret && after != requested)
+		ret = -EIO;
+	if (ret) {
+		/* A timed-out write may have taken effect: verify the rollback. */
+		rollback_ret = nvt_thp_extended_cmd(0x0f, false, &before);
+		if (!rollback_ret)
+			rollback_ret = nvt_thp_game_get(&after);
+		if (!rollback_ret && after != before)
+			rollback_ret = -EIO;
+		if (rollback_ret) {
+			nvt_thp_game_forget();
+			NVT_ERR("game-mode rollback unconfirmed: %d\n", rollback_ret);
+		}
+		return ret;
+	}
+
+	/* Keep the first verified baseline until rollback is consumed. */
+	if (save_prior && (!ts->thp_game_prior_valid ||
+			   !nvt_thp_game_firmware_matches())) {
+		ts->thp_game_prior = before;
+		ts->thp_game_prior_valid = true;
+	}
+	ts->thp_game_requested = requested;
+	ts->thp_game_fw_crc = ts->thp_firmware_crc;
+	ts->thp_game_fw_ver = ts->fw_ver;
+	ts->thp_game_fw_pid = ts->nvt_pid;
+	ts->thp_game_valid = true;
+	return 0;
+}
+
+void nvt_thp_restore_game(void)
+{
+	int ret;
+
+	if (!ts->thp_game_valid)
+		return;
+	if (!nvt_thp_game_firmware_matches()) {
+		nvt_thp_game_forget();
+		return;
+	}
+	ret = nvt_thp_game_apply(ts->thp_game_requested, false);
+	if (ret) {
+		nvt_thp_game_forget();
+		NVT_ERR("game-mode restore unconfirmed: %d\n", ret);
+	}
+}
+
+static void nvt_thp_game_show_cache(struct seq_file *m)
+{
+	bool matches = nvt_thp_game_firmware_matches();
+
+	seq_printf(m, "requested_known: %u\n", ts->thp_game_valid && matches);
+	if (ts->thp_game_valid && matches)
+		seq_printf(m, "requested_game_mode: %u\n", ts->thp_game_requested);
+	seq_printf(m, "rollback_known: %u\n", ts->thp_game_prior_valid && matches);
+	if (ts->thp_game_prior_valid && matches)
+		seq_printf(m, "rollback_game_mode: %u\n", ts->thp_game_prior);
+}
+
+/* Explicit controller queries; nvt_thp_status remains entirely passive. */
+static int nvt_thp_controller_show(struct seq_file *m, void *v)
+{
+	static const u8 commands[] = { 0x0f, 0x08, 0x09, 0x0a, 0x0b };
+	static const char * const names[] = {
+		"game_mode", "scan_freq_no", "scan_freq", "hand_scan_rate", "pen_scan_rate"
+	};
+	u16 values[ARRAY_SIZE(commands)] = { 0 };
+	int i, ret;
+
+	if (!ts)
+		return -ENODEV;
+	ret = nvt_thp_control_begin();
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(commands); i++) {
+		ret = nvt_thp_extended_cmd(commands[i], true, &values[i]);
+		if (ret)
+			goto out;
+	}
+	seq_printf(m, "firmware: %s\nfw_ver: 0x%02x\nfw_pid: 0x%04x\n",
+		   ts->fw_name, ts->fw_ver, ts->nvt_pid);
+	seq_printf(m, "firmware_crc32: 0x%08x\n", ts->thp_firmware_crc);
+	for (i = 0; i < ARRAY_SIZE(commands); i++)
+		seq_printf(m, "%s: %d\n", names[i], (s16)values[i]);
+	nvt_thp_game_show_cache(m);
+out:
+	nvt_thp_control_end();
+	return ret;
+}
+
+static int nvt_thp_game_show(struct seq_file *m, void *v)
+{
+	u16 value = 0;
+	int ret;
+
+	if (!ts)
+		return -ENODEV;
+	ret = nvt_thp_control_begin();
+	if (ret)
+		return ret;
+	ret = nvt_thp_game_get(&value);
+	if (!ret) {
+		seq_printf(m, "game_mode: %u\n", value);
+		nvt_thp_game_show_cache(m);
+	}
+	nvt_thp_control_end();
+	return ret;
+}
+
+static ssize_t nvt_thp_game_write(struct file *file, const char __user *buf,
+				size_t count, loff_t *ppos)
+{
+	u8 mode;
+	int ret;
+
+	if (!ts)
+		return -ENODEV;
+	ret = kstrtou8_from_user(buf, count, 0, &mode);
+	if (ret)
+		return ret;
+	if (mode > 1)
+		return -EINVAL;
+	ret = nvt_thp_control_begin();
+	if (ret)
+		return ret;
+	ret = nvt_thp_game_apply(mode, true);
+	nvt_thp_control_end();
+	if (ret)
+		return ret;
+	return count;
+}
+
+static ssize_t nvt_thp_game_rollback_write(struct file *file,
+					 const char __user *buf, size_t count,
+					 loff_t *ppos)
+{
+	u8 rollback;
+	int ret;
+
+	if (!ts)
+		return -ENODEV;
+	ret = kstrtou8_from_user(buf, count, 0, &rollback);
+	if (ret)
+		return ret;
+	if (rollback != 1)
+		return -EINVAL;
+	ret = nvt_thp_control_begin();
+	if (ret)
+		return ret;
+	if (!ts->thp_game_prior_valid || !nvt_thp_game_firmware_matches()) {
+		ret = -ENODATA;
+	} else {
+		ret = nvt_thp_game_apply(ts->thp_game_prior, false);
+		if (!ret)
+			ts->thp_game_prior_valid = false;
+	}
+	nvt_thp_control_end();
+	if (ret)
+		return ret;
+	return count;
+}
