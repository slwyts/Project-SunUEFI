+						enable ? 0xFD : 0xFC);
+}
+
+static int nanosic_wn8030_sync_micmute_led(struct nanosic_wn8030 *nanosic, bool enable)
+{
+	if (!nanosic->keyboard_attached || READ_ONCE(nanosic->suspended) ||
+	    !nanosic->input_enabled || nanosic->micmute_key_down)
+		return 0;
