+int ath12k_qmi_apply_ol_cpr(struct ath12k_base *ab,
+			    const struct qmi_wlanfw_cap_resp_msg_v01 *resp)
+{
+	struct pwrseq_qcom_wcn_pmu_param *params;
+	u32 num_params;
