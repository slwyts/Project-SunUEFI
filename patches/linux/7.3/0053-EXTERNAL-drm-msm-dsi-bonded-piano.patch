+static int dsi_mgr_link_panel_backlight(struct drm_bridge *bridge,
+				       const struct drm_bridge *next_bridge)
+{
+	struct device *dev = bridge->dev->dev;
+	struct backlight_device *backlight;
+	struct device_node *node;
+
+	if (!IS_REACHABLE(CONFIG_BACKLIGHT_CLASS_DEVICE) ||
+	    !next_bridge || !drm_bridge_is_panel(next_bridge))
+		return 0;
+
+	node = of_parse_phandle(next_bridge->of_node, "backlight", 0);
+	if (!node)
+		return 0;
+
+	backlight = of_find_backlight_by_node(node);
+	of_node_put(node);
+	if (!backlight)
+		return dev_err_probe(dev, -EPROBE_DEFER, "panel backlight not registered\n");
+
+	/*
+	 * KMS shuts down the panel through the bridge chain. Keep the
+	 * external backlight and its bus available until that completes.
+	 */
+	if (!device_link_add(dev, &backlight->dev, DL_FLAG_STATELESS)) {
+		put_device(&backlight->dev);
+		return dev_err_probe(dev, -EINVAL, "failed to link panel backlight\n");
+	}
+
+	bridge->driver_private = &backlight->dev;
+
+	return 0;
+}
+
+static void dsi_mgr_bridge_detach(struct drm_bridge *bridge)
+{
+	struct device *backlight = bridge->driver_private;
+
+	if (!backlight)
+		return;
+
+	/* The device core might already have purged the link. */
+	device_link_remove(bridge->dev->dev, backlight);
+	put_device(backlight);
+	bridge->driver_private = NULL;
+}
