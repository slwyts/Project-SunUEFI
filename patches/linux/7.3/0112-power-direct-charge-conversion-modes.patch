+	*min_mv = max_t(u32, lo[selected], selected ?
+			MCA_CP_PPS_MIN_MV : MCA_CP_BYPASS_MIN_MV);
+	*max_mv = min_t(u32, hi[selected], selected ?
+			MCA_CP_PPS_MAX_MV : MCA_CP_BYPASS_MAX_MV);
+	return ma[selected];
