From 7679892741f7c03527300a76f2c008eb59bf3891 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 05:10:30 +0800
Subject: [PATCH] feat(power): support factory 1:1 direct-charge selection

Expose SC8541 Standard and Bypass charge types with stopped-only mode writes and register readback. Retain stop guards before re-enabling the stage.

Select 1:1 or 2:1 from authenticated adapter capabilities and use the actual conversion ratio for voltage requests, current budgets, PMIC sharing and regulation steps. Apply the factory 4.5 A single-pump bypass limit, wait for low input voltage before enabling bypass and keep dynamic mode switching disabled.

diff --git a/drivers/power/supply/Kconfig b/drivers/power/supply/Kconfig
index 2e6dd6637..e56d78da9 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -902,8 +902,17 @@ config CHARGER_SC8541
 	select REGMAP_I2C
 	help
 	  Say Y to enable support for the Southchip SC8541 single-cell 2:1
-	  switched-capacitor direct charger.  It only exposes the charger;
-	  the USB PD sink driver decides when to use it.
+	  switched-capacitor and 1:1 bypass direct charger. It only exposes the
+	  charger; the USB PD sink driver decides when to use it.
+
+config CHARGER_SC8541_KUNIT_TEST
+	bool "KUnit tests for SC8541 conversion modes" if !KUNIT_ALL_TESTS
+	depends on KUNIT=y && UML && CHARGER_SC8541=y
+	default KUNIT_ALL_TESTS
+	help
+	  Exercise the real power-supply callbacks and register sequences with
+	  a memory-backed regmap. Check stopped-only mode changes, readback
+	  failures, protection settings and delayed stop confirmation.
 
 config CHARGER_BQ25630
 	tristate "TI BQ25630 battery charger driver"
diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index 7cf5c17a3..18000b969 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -299,12 +299,11 @@ MODULE_PARM_DESC(mipps_auth,
 		 "Authenticate Xiaomi MiPPS adapters before PPS negotiation (default: on, may be disabled for debugging)");
 
 /*
- * cp_charge: direct charging through the SC8541 2:1 switched-capacitor
- * stage (driver sc8541_charger), which is how stock charges fast
- * (mca_strategy_quickchg): a PPS source is held at about twice the battery
- * voltage and the stage halves it into the battery at twice the bus
- * current, with a bounded PMIC share. The sequence
- * follows stock: ask the source for twice the battery voltage plus
+ * cp_charge: direct charging through the SC8541 switched-capacitor stage
+ * (driver sc8541_charger), following stock mca_strategy_quickchg. The
+ * stage converts the programmable source at the selected 1:1 or 2:1 ratio,
+ * with a bounded PMIC share. The sequence
+ * follows stock: ask the source for ratio times the battery voltage plus
  * MCA_CP_DELTA_MV, enable the stage, raise the voltage MCA_CP_STEP_MV at a
  * time until current flows, then regulate the voltage every MCA_CP_POLL_MS
  * so the bus current stays at its target and the battery current (both
@@ -444,6 +443,11 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 #define MCA_CP_REQ_MAX_DELTA_MV	2000
 #define MCA_CP_PPS_MIN_MV	6000
 #define MCA_CP_PPS_MAX_MV	11000
+#define MCA_CP_BYPASS_MIN_MV	3600
+#define MCA_CP_BYPASS_MAX_MV	5500
+#define MCA_CP_BYPASS_IBAT_MA	4500	/* one pump: div_single_curr */
+#define MCA_CP_BYPASS_SELECT_MA	5000	/* initial mode comparison: div_max_curr */
+#define MCA_CP_BYPASS_OPEN_MA	800	/* stock open_path_th[0] */
 #define MCA_CP_BUCK_MA		500	/* buck input limit and charge current */
 /*
  * Retain this board's validated 2 A PMIC share to distribute heat. The
@@ -625,6 +629,7 @@ struct piano_mca {
 	unsigned int cp_generation;
 	unsigned int cp_connection_generation;
 	u32 cp_real_type;	/* source type selected before enabling the pump */
+	u32 cp_ratio;		/* selected once per attempt: 1:1 or 2:1 */
 	bool cp_verified;	/* Xiaomi proof used for this attempt's source limits */
 	u32 cp_mv;		/* voltage asked of the direct-charge source */
 	u32 cp_ma;		/* its current limit */
@@ -1008,7 +1013,7 @@ static u32 piano_mca_pps_word(u32 mv, u32 ma)
 	return (mv / 20) << 16 | ma / 50;
 }
 
-static bool piano_mca_pps_word_ok(u32 val)
+static bool piano_mca_pps_word_ok(struct piano_mca *mca, u32 val)
 {
 	u32 mv = (val >> 16) * 20, ma = (val & 0xffff) * 50;
 
@@ -1016,6 +1021,10 @@ static bool piano_mca_pps_word_ok(u32 val)
 		return false;
 	if (mv == MCA_HV_MV && ma <= MCA_HV_PPS_MAX_MA)
 		return true;
+	if (cp_charge && mca->cp_ratio == 1 && mca->cp_verified &&
+	    (mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON) &&
+	    mv >= MCA_CP_BYPASS_MIN_MV && mv <= MCA_CP_BYPASS_MAX_MV)
+		return ma <= MCA_CP_PPS_MAX_MA;
 
 	return cp_charge && mv >= MCA_CP_PPS_MIN_MV && mv <= MCA_CP_PPS_MAX_MV &&
 	       ma <= MCA_CP_PPS_MAX_MA;
@@ -1098,7 +1107,7 @@ static bool piano_mca_write_allowed(struct piano_mca *mca, u32 prop,
 			 val <= MCA_QC3P5_MAX_VBUS_MV && !(val % MCA_QC3P5_STEP_MV)));
 	case MCA_PROP_PPS_SELECT:
 		return hv_charge && len == sizeof(u32) &&
-		       piano_mca_pps_word_ok(val);
+		       piano_mca_pps_word_ok(mca, val);
 	case MCA_PROP_VDM_VERSION:
 	case MCA_PROP_VDM_VOLTAGE:
 	case MCA_PROP_VDM_TEMP:
@@ -3064,17 +3073,41 @@ static int piano_mca_cp_set_busocp(struct piano_mca *mca, u32 ma)
 					 &pv);
 }
 
+static int piano_mca_cp_set_ratio(struct piano_mca *mca)
+{
+	union power_supply_propval pv = {
+		.intval = mca->cp_ratio == 1 ? POWER_SUPPLY_CHARGE_TYPE_BYPASS :
+			POWER_SUPPLY_CHARGE_TYPE_STANDARD,
+	};
+	int type, ret;
+
+	if (!piano_mca_cp_session_valid(mca))
+		return -ECONNRESET;
+	ret = power_supply_set_property(mca->cp_psy, POWER_SUPPLY_PROP_CHARGE_TYPE, &pv);
+	ret = ret ?: piano_mca_cp_get(mca, POWER_SUPPLY_PROP_CHARGE_TYPE, &type);
+	if (!ret && type != pv.intval)
+		ret = -EIO;
+	if (!ret && !piano_mca_cp_session_valid(mca))
+		ret = -ECONNRESET;
+	return ret;
+}
+
 static int piano_mca_cp_request(struct piano_mca *mca, u32 mv)
 {
 	u32 quantum = mca->cp_real_type == MCA_TYPE_HVDCP_3_B ?
 		MCA_QC3_STEP_MV : MCA_QC3P5_STEP_MV;
-	u32 minimum = max_t(u32, mca->cp_min_mv, MCA_CP_PPS_MIN_MV);
+	u32 minimum = max_t(u32, mca->cp_min_mv, mca->cp_ratio == 1 ?
+			   MCA_CP_BYPASS_MIN_MV : MCA_CP_PPS_MIN_MV);
+	u32 maximum = min_t(u32, mca->cp_max_mv, mca->cp_ratio == 1 ?
+			   MCA_CP_BYPASS_MAX_MV : MCA_CP_PPS_MAX_MV);
 	int ret;
 
 	if (!piano_mca_cp_session_valid(mca))
 		return -ECONNRESET;
+	if (roundup(minimum, quantum) > rounddown(maximum, quantum))
+		return -ERANGE;
 	mv = clamp(rounddown(mv, quantum), roundup(minimum, quantum),
-		   rounddown(min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV), quantum));
+		   rounddown(maximum, quantum));
 	if (piano_mca_is_qc_cp(mca->cp_real_type)) {
 		/* A lost acknowledgement can still leave the adapter at this voltage. */
 		mca->cp_mv = mv;
@@ -3222,12 +3255,12 @@ static int piano_mca_pause_charging(struct piano_mca *mca,
 }
 
