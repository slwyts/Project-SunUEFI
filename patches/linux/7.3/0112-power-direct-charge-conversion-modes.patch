+	KUNIT_EXPECT_EQ(test, f->cp_charge_type, POWER_SUPPLY_CHARGE_TYPE_STANDARD);
+	KUNIT_EXPECT_LT(test, f->last_stop_event, f->last_cp_mode_event);
+	KUNIT_EXPECT_LT(test, f->last_cp_mode_event, f->last_pps_event);
