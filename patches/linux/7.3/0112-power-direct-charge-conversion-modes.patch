+static int sc8541_set_charge_type(struct sc8541 *sc, int type)
+{
+	unsigned int ctrl;
+	bool bypass;
+	int ret;
+
+	if (type != POWER_SUPPLY_CHARGE_TYPE_STANDARD &&
+	    type != POWER_SUPPLY_CHARGE_TYPE_BYPASS)
+		return -EINVAL;
+	bypass = type == POWER_SUPPLY_CHARGE_TYPE_BYPASS;
+	mutex_lock(&sc->lock);
+	if (sc->enabled || sc->stop_pending) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = regmap_read(sc->regmap, SC8541_CTRL2, &ctrl);
+	if (ret)
+		goto out;
+	if (ctrl & SC8541_CHG_EN) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = sc8541_write_check(sc, SC8541_CTRL2, SC8541_EN_BYPASS,
+				 bypass ? SC8541_EN_BYPASS : 0);
+	if (!ret)
+		sc->bypass = bypass;
+out:
+	mutex_unlock(&sc->lock);
+	return ret;
+}
