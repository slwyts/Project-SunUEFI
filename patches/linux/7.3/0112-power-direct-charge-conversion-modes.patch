+static void piano_mca_pps_bypass_regulation_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int mode_writes;
+	int i;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_pause(&f->mca, "select bypass"), 0);
+	f->mca.auth_ok = true;
+	f->mca.auth_generation = f->remote_generation;
+	f->pd_verified = 1;
+	mipps_auth = true;
+	f->mca.real_type = f->real_type = MCA_TYPE_PD_VERIFY;
+	f->apdo_min_mv = 3300;
+	f->apdo_max_mv = 5500;
+	f->mca.hv = MCA_HV_ON;
+	piano_mca_cp_try_start(&f->mca, f->remote_generation);
+	KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_OPENING);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ratio, 1U);
+	KUNIT_EXPECT_EQ(test, f->cp_charge_type, POWER_SUPPLY_CHARGE_TYPE_BYPASS);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_start_ibat_ma, 4500U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 4000U);
+	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 5000U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_mv, 4100U);
+	KUNIT_EXPECT_LT(test, f->last_cp_mode_event, f->last_pps_event);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_request(&f->mca, 5900), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_mv, 5500U);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_request(&f->mca, 3000), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_mv, 3600U);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_request(&f->mca, 4100), 0);
+	piano_mca_cp_step(&f->mca);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	f->mca.vbus_uv = 4100000;
+	f->cp_voltage_uv = 4100000;
+	f->cp_current_ua = 1000000;
+	piano_mca_cp_step(&f->mca);
+	piano_mca_cp_step(&f->mca);
+	KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_ON);
+	f->cp_current_ua = 3900000;
+	for (i = 0; i < ARRAY_SIZE(f->gauge); i++)
+		f->gauge[i].current_ua = 2250000;
+	mode_writes = f->cp_mode_writes;
+	piano_mca_cp_step(&f->mca);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_mv, 4100U);
+	f->cp_current_ua = 4100000;
+	piano_mca_cp_step(&f->mca);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_mv, 4080U);
+	KUNIT_EXPECT_EQ(test, f->cp_mode_writes, mode_writes);
+	/* A valid bypass voltage below the ordinary 4 V attach threshold stays online. */
+	for (i = 0; i < ARRAY_SIZE(f->gauge); i++)
+		f->gauge[i].voltage_uv = 3500000;
+	f->vbus_uv = f->cp_voltage_uv = 3800000;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->mca.online);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_ON);
+	/* A ratio change is never used to recover from an unsafe bypass bus. */
+	f->cp_voltage_uv = 5501000;
+	piano_mca_cp_step(&f->mca);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_EQ(test, f->cp_mode_writes, mode_writes);
+}
