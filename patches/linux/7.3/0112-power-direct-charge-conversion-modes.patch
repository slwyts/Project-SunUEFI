+static void piano_mca_pps_conversion_selection_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	static const struct {
+		u32 type, lo, hi, source_ma, other_current, ratio;
+		bool verified;
+	} rows[] = {
+		{ MCA_TYPE_PD_VERIFY, 3300, 5500, 6000, 0, 1, true },
+		{ MCA_TYPE_PD_VERIFY, 3600, 5500, 3000, 0, 1, true },
+		{ MCA_TYPE_PD_VERIFY, 3601, 5500, 6000, 0, 0, true },
+		{ MCA_TYPE_PD_VERIFY, 3300, 4499, 6000, 0, 0, true },
+		{ MCA_TYPE_PD_VERIFY, 3300, 5500, 6000, 0, 0, false },
+		{ MCA_TYPE_PD_PPS, 3300, 5500, 6000, 0, 0, true },
+		{ MCA_TYPE_PD_VERIFY, 3300, 11000, 3000, 0, 2, true },
+		{ MCA_TYPE_PD_VERIFY, 3300, 5500, 6000, 3000, 2, true },
+		{ MCA_TYPE_PD_VERIFY, 3300, 5500, 6000, 2500, 1, true },
+		{ MCA_TYPE_PD_PPS, 3300, 11000, 6000, 0, 2, false },
+	};
+	u32 lo, hi, ratio, ma;
+	int i;
+
+	f->offer_cp_apdo = true;
+	f->mca.cp_generation = f->remote_generation;
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		f->mca.real_type = rows[i].type;
+		f->apdo_min_mv = rows[i].lo;
+		f->apdo_max_mv = rows[i].hi;
+		f->apdo_ma = rows[i].source_ma;
+		f->extra_apdo = (struct piano_mca_pdo) {
+			.min_mv = cpu_to_le32(6000), .max_mv = cpu_to_le32(11000),
+			.max_ma = cpu_to_le32(rows[i].other_current),
+		};
+		ratio = 0;
+		ma = piano_mca_cp_apdo(&f->mca, 3800, rows[i].verified, &lo, &hi, &ratio);
+		KUNIT_EXPECT_EQ_MSG(test, ratio, rows[i].ratio, "row %d", i);
+		KUNIT_EXPECT_EQ(test, ma != 0, rows[i].ratio != 0);
+		if (ratio == 1) {
+			KUNIT_EXPECT_EQ(test, lo, 3600U);
+			KUNIT_EXPECT_EQ(test, hi, 5500U);
+		}
+	}
+	f->restart_on_pdos = true;
+	KUNIT_EXPECT_EQ(test, piano_mca_cp_apdo(&f->mca, 3800, true,
+		&lo, &hi, &ratio), 0U);
+}
