diff --git a/drivers/power/supply/sc8541_charger_test.c b/drivers/power/supply/sc8541_charger_test.c
new file mode 100644
index 000000000..eb49459fb
--- /dev/null
+++ b/drivers/power/supply/sc8541_charger_test.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by the driver to exercise its callbacks through a real regmap. */
+#include <kunit/device.h>
+#include <kunit/test.h>
+
+struct sc8541_test {
+	struct sc8541 sc;
+	u8 regs[SC8541_MAX_REG + 1];
+	unsigned int writes;
+	int read_error;
+	bool ignore_write;
+};
+
+static int sc8541_test_read(void *context, unsigned int reg, unsigned int *val)
+{
+	struct sc8541_test *f = context;
+
+	if (f->read_error)
+		return f->read_error;
+	*val = f->regs[reg];
+	return 0;
+}
+
+static int sc8541_test_write(void *context, unsigned int reg, unsigned int val)
+{
+	struct sc8541_test *f = context;
+
+	f->writes++;
+	if (!f->ignore_write)
+		f->regs[reg] = val;
+	return 0;
+}
+
+static const struct regmap_bus sc8541_test_bus = {
+	.reg_read = sc8541_test_read,
+	.reg_write = sc8541_test_write,
+};
+
+static int sc8541_test_init(struct kunit *test)
+{
+	struct sc8541_test *f = kunit_kzalloc(test, sizeof(*f), GFP_KERNEL);
+	struct power_supply_config cfg = {};
+
+	if (!f)
+		return -ENOMEM;
+	cfg.drv_data = &f->sc;
+	test->priv = f;
+	f->sc.dev = kunit_device_register(test, "sc8541-mode");
+	if (IS_ERR(f->sc.dev))
+		return PTR_ERR(f->sc.dev);
+	mutex_init(&f->sc.lock);
+	INIT_DELAYED_WORK(&f->sc.watch, sc8541_watch);
+	f->sc.busocp_ma = SC8541_BUSOCP_MA;
+	f->sc.regmap = devm_regmap_init(f->sc.dev, &sc8541_test_bus, f,
+				      &sc8541_regmap_config);
+	if (IS_ERR(f->sc.regmap))
+		return PTR_ERR(f->sc.regmap);
+	f->sc.psy = devm_power_supply_register(f->sc.dev, &sc8541_desc, &cfg);
+	return PTR_ERR_OR_ZERO(f->sc.psy);
+}
+
+static void sc8541_test_exit(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+
+	cancel_delayed_work_sync(&f->sc.watch);
+}
+
+static int sc8541_test_set(struct sc8541_test *f, enum power_supply_property prop,
+			   int val)
+{
+	union power_supply_propval pv = { .intval = val };
+
+	return power_supply_set_property(f->sc.psy, prop, &pv);
+}
+
+static void sc8541_conversion_modes_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+	union power_supply_propval pv;
+	int mode;
+
+	f->regs[SC8541_CTRL2] = BIT(1);
+	for (mode = 0; mode < 2; mode++) {
+		int type = mode ? POWER_SUPPLY_CHARGE_TYPE_STANDARD :
+			POWER_SUPPLY_CHARGE_TYPE_BYPASS;
+
+		KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE, type), 0);
+		KUNIT_ASSERT_EQ(test, power_supply_get_property(f->sc.psy,
+			POWER_SUPPLY_PROP_CHARGE_TYPE, &pv), 0);
+		KUNIT_EXPECT_EQ(test, pv.intval, type);
+		KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 1), 0);
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_CTRL2],
+			(u8)(BIT(1) | SC8541_CHG_EN | (mode ? 0 : SC8541_EN_BYPASS)));
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_BUSOVP], (u8)120);
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_BATOVP], (u8)96);
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_BATOVP_ALM], (u8)76);
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_BUSOCP] & 0x9f, (u8)10);
+		KUNIT_EXPECT_EQ(test, f->regs[SC8541_CTRL3] & SC8541_WATCHDOG_MASK,
+			(u8)SC8541_WATCHDOG_5S);
+		KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 0), 0);
+		KUNIT_EXPECT_FALSE(test, f->sc.stop_pending);
+	}
+}
+
+static void sc8541_mode_requires_stopped_stage_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+	unsigned int writes = f->writes;
+
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_FAST), -EINVAL);
+	f->sc.enabled = true;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EBUSY);
+	f->sc.enabled = false;
+	f->sc.stop_pending = true;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EBUSY);
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 1), -EBUSY);
+	f->sc.stop_pending = false;
+	f->regs[SC8541_CTRL2] = SC8541_CHG_EN;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EBUSY);
+	KUNIT_EXPECT_EQ(test, f->writes, writes);
+}
+
+static void sc8541_mode_readback_error_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+
+	f->read_error = -EREMOTEIO;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EREMOTEIO);
+	KUNIT_EXPECT_FALSE(test, f->sc.bypass);
+	f->read_error = 0;
+	f->ignore_write = true;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EIO);
+	KUNIT_EXPECT_FALSE(test, f->sc.bypass);
+}
+
+static void sc8541_mode_waits_for_stop_confirmation_test(struct kunit *test)
+{
+	struct sc8541_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 1), 0);
+	f->ignore_write = true;
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 0), -EIO);
+	KUNIT_EXPECT_TRUE(test, f->sc.stop_pending);
+	KUNIT_EXPECT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), -EBUSY);
+	f->ignore_write = false;
+	KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_ONLINE, 0), 0);
+	KUNIT_ASSERT_EQ(test, sc8541_test_set(f, POWER_SUPPLY_PROP_CHARGE_TYPE,
+		POWER_SUPPLY_CHARGE_TYPE_BYPASS), 0);
+}
+
+static struct kunit_case sc8541_test_cases[] = {
+	KUNIT_CASE(sc8541_conversion_modes_test),
+	KUNIT_CASE(sc8541_mode_requires_stopped_stage_test),
+	KUNIT_CASE(sc8541_mode_readback_error_test),
+	KUNIT_CASE(sc8541_mode_waits_for_stop_confirmation_test),
+	{}
+};
+
+static struct kunit_suite sc8541_test_suite = {
+	.name = "sc8541-charger",
+	.init = sc8541_test_init,
+	.exit = sc8541_test_exit,
+	.test_cases = sc8541_test_cases,
+};
+kunit_test_suite(sc8541_test_suite);
