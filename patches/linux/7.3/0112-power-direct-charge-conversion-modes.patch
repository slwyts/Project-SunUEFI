 {
 	struct piano_mca_pdo pdos[MCA_PD_MAX_PDOS];
-	u32 ma = 0;
-	int i;
+	u32 ma[2] = {}, lo[2] = {}, hi[2] = {}, battery[2] = {};
+	int i, mode, selected;
 
 	if (piano_mca_xfer(mca, MCA_OP_READ, MCA_PROP_PDOS, pdos, sizeof(pdos),
 			    mca->cp_generation, mca->cp_connection_generation))
@@ -3236,17 +3269,44 @@ static u32 piano_mca_cp_apdo(struct piano_mca *mca, u32 start_mv,
 	for (i = 0; i < MCA_PD_MAX_PDOS; i++) {
 		u32 lo_mv = le32_to_cpu(pdos[i].min_mv);
 		u32 hi_mv = le32_to_cpu(pdos[i].max_mv);
+		u32 source_ma = min_t(u32, le32_to_cpu(pdos[i].max_ma), MCA_CP_PPS_MAX_MA);
 
-		if (lo_mv < hi_mv && lo_mv <= start_mv &&
-		    hi_mv >= 2 * MCA_CP_VBAT_MAX_MV + MCA_CP_DELTA_MV &&
-		    le32_to_cpu(pdos[i].max_ma) > ma) {
-			ma = le32_to_cpu(pdos[i].max_ma);
-			*min_mv = lo_mv;
-			*max_mv = hi_mv;
+		if (lo_mv >= hi_mv || !source_ma)
+			continue;
+		for (mode = 0; mode < ARRAY_SIZE(ma); mode++) {
+			u32 r = mode + 1;
+			u32 capability;
+
+			/* 4.0.6 enables bypass only for PD_VERIFY, not generic PPS. */
+			if (!mode && (!verified || mca->real_type != MCA_TYPE_PD_VERIFY ||
+			    lo_mv > MCA_CP_BYPASS_MIN_MV || hi_mv < MCA_CP_VBAT_MAX_MV))
+				continue;
+			if (mode && hi_mv < 2 * MCA_CP_VBAT_MAX_MV + MCA_CP_DELTA_MV)
+				continue;
+			if (lo_mv > r * vbat + MCA_CP_DELTA_MV ||
+			    hi_mv < r * vbat + MCA_CP_DELTA_MV)
+				continue;
+			capability = min_t(u32, source_ma * r, mode ?
+				2 * MCA_CP_IBUS_MAX_MA : MCA_CP_BYPASS_SELECT_MA);
+			if (capability >= battery[mode] && source_ma >= ma[mode]) {
+				ma[mode] = source_ma;
+				lo[mode] = lo_mv;
+				hi[mode] = hi_mv;
+				battery[mode] = capability;
+			}
 		}
 	}
 
-	return ma;
+	/* Equal battery capability retains 1:1, as in the factory selection. */
+	selected = battery[1] > battery[0] ? 1 : 0;
+	if (!ma[selected])
