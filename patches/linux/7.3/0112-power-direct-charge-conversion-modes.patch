+static void piano_mca_pps_bypass_stop_failure_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	unsigned int writes;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	f->mca.cp_ratio = 1;
+	f->cp_charge_type = POWER_SUPPLY_CHARGE_TYPE_BYPASS;
+	f->mca.cp_mv = 4100;
+	f->cp_stop_failures = 1;
+	writes = f->pps_writes;
+	KUNIT_EXPECT_EQ(test, piano_mca_cp_pause(&f->mca, "bypass stop"), -EIO);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_STOPPING);
+	KUNIT_EXPECT_TRUE(test, f->cp_enabled);
+	KUNIT_EXPECT_EQ(test, f->pps_writes, writes);
+	KUNIT_EXPECT_EQ(test, f->cp_mode_writes, 0U);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_pause(&f->mca, "bypass stop"), 0);
