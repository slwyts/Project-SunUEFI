-		{ 50, false, 4060 },
+		{ 50, false, 4090 },
 		{ 47, false, 4060 },
 		{ 46, false, 4060 },
 		{ 45, true, 4480 },
@@ -1925,7 +1925,7 @@ static void piano_mca_inhibit_jeita_warm_high_test(struct kunit *test)
 		0);
 	KUNIT_EXPECT_EQ(test, f->fv_mv, 4480U);
 	piano_mca_poll(&f->mca.poll.work);
-	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
