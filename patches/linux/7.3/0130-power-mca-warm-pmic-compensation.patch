 	KUNIT_EXPECT_EQ(test, fixture->icl_ma, 1600U);
 	KUNIT_EXPECT_GT(test, fixture->last_pmic_disable_event, 0U);
 	KUNIT_EXPECT_GT(test, fixture->last_fv_event,
@@ -1158,7 +1158,7 @@ static void piano_mca_warm_exit_low_fv_test(struct kunit *test)
 		bool enabled;
