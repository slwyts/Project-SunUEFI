From cf1c06b6a93271b80b2a861d9b4f39ffba783da6 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@tuta.io>
Date: Wed, 18 Nov 2026 04:18:12 +0800
Subject: [PATCH] fix(power): apply factory warm-zone PMIC voltage compensation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add the factory 30 mV offset in the ordinary PMIC setter for measured temperatures of 48–54 C. Keep the JEITA stop/restart tests on the unadjusted target, and leave the authenticated FFC setter unchanged.
---
 drivers/power/supply/piano_mca.c      |  7 +++-
 drivers/power/supply/piano_mca_test.c | 54 +++++++++++++++++++--------
 2 files changed, 44 insertions(+), 17 deletions(-)

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index 1aa4bf142c8b604eb12cead0f96df8e449325629..86e4493bdf558ee775a77007e925298cb1a5e03f 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -1094,7 +1094,7 @@ static bool piano_mca_write_allowed(struct piano_mca *mca, u32 prop,
 	case MCA_PROP_FV:
 		if (!cp_charge || !charge_current || len != sizeof(u32))
 			return false;
-		if (val == 4060 || val == 4480 || val == 4500)
+		if (val == 4060 || val == 4090 || val == 4480 || val == 4500)
 			return true;
 		if (!mca->battery_authentic)
 			return false;
@@ -2781,7 +2781,8 @@ static int piano_mca_normal_set_fv(struct piano_mca *mca, u32 mv, u32 iterm_ma,
 static u32 piano_mca_pmic_voltage(struct piano_mca *mca, u32 fv_mv, int twarm)
 {
 	if (!mca->ffc)
-		return fv_mv;
+		/* Compensation changes the PMIC register, not JEITA thresholds. */
+		return fv_mv + (twarm >= 48 && twarm <= 54 ? 30 : 0);
 	if (mca->cp_ffc && !mca->cp_buck_disabled)
 		fv_mv = MCA_FFC_BUCK_FV_MV;
 	/* Same-device base-flip-same buck compensation. */
@@ -3024,6 +3025,8 @@ static int piano_mca_normal_buck(struct piano_mca *mca, int *tbat,
 				return ret;
 		}
 	}
+	if (!mca->ffc)
+		fv = piano_mca_pmic_voltage(mca, fv, twarm);
 	ret = piano_mca_normal_set_fv(mca, fv, iterm, generation, connection);
 	if (ret) {
 		piano_mca_normal_pause(mca, generation, connection);
