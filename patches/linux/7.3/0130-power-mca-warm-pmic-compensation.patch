 }
 
+static void piano_mca_warm_pmic_compensation_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	static const struct { int temperature; u32 expected; } rows[] = {
+		{ 45, 4060 }, { 46, 4060 }, { 47, 4060 }, { 48, 4090 },
+		{ 50, 4090 }, { 54, 4090 }, { 55, 4060 }, { 56, 4060 },
+	};
+	int i;
+
+	f->mca.normal_warm = true;
+	for (i = 0; i < ARRAY_SIZE(rows); i++) {
+		KUNIT_EXPECT_EQ(test, piano_mca_pmic_voltage(&f->mca, 4060,
+			rows[i].temperature), rows[i].expected);
+	}
+	/* Do not apply the 30 mV offset to the JEITA voltage decisions. */
+	KUNIT_EXPECT_TRUE(test, piano_mca_normal_voltage_stop(&f->mca, 4055, 4060));
+	KUNIT_EXPECT_TRUE(test, piano_mca_normal_voltage_stop(&f->mca, 3910, 4060));
+	KUNIT_EXPECT_FALSE(test, piano_mca_normal_voltage_stop(&f->mca, 3909, 4060));
+	f->mca.ffc = true;
+	KUNIT_EXPECT_EQ(test, piano_mca_pmic_voltage(&f->mca, 4550, 25), 4590U);
+	KUNIT_EXPECT_EQ(test, piano_mca_pmic_voltage(&f->mca, 4550, 40), 4595U);
+}
+
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_warm_pmic_compensation_test),
 	KUNIT_CASE(piano_mca_response_identity_test),
 	KUNIT_CASE(piano_mca_short_notification_test),
 	KUNIT_CASE(piano_mca_inhibit_does_not_create_full_test),
