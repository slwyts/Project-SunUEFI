@@ -1949,7 +1949,7 @@ static void piano_mca_inhibit_jeita_warm_below_term_test(struct kunit *test)
 				  POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
 		0);
 	piano_mca_poll(&f->mca.poll.work);
-	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
+	KUNIT_EXPECT_EQ(test, f->fv_mv, 4090U);
