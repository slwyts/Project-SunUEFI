 	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
@@ -1987,7 +1987,7 @@ static void piano_mca_inhibit_jeita_auto_hysteresis_test(struct kunit *test)
 		f->gauge[0].voltage_uv = f->gauge[1].voltage_uv =
 			rows[i].mv * 1000;
 		piano_mca_poll(&f->mca.poll.work);
