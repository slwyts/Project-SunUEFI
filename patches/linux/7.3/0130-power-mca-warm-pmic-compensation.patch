 	KUNIT_EXPECT_EQ(test, f->icl_writes, 0U);
 	f->lose_fv_ack = false;
 	piano_mca_poll(&f->mca.poll.work);
-	KUNIT_EXPECT_EQ(test, f->mca.fv_set_mv, 4060U);
+	KUNIT_EXPECT_EQ(test, f->mca.fv_set_mv, 4090U);
 	KUNIT_EXPECT_EQ(test, f->icl_ma, 1600U);
 	KUNIT_EXPECT_EQ(test, f->fcc_positive_writes, 0U);
 	KUNIT_EXPECT_EQ(test, f->pmic_enable_writes, 0U);
@@ -2072,13 +2072,13 @@ static void piano_mca_inhibit_jeita_iterm_error_test(struct kunit *test)
 		0);
 	f->iterm_write_failures = -1;
 	piano_mca_poll(&f->mca.poll.work);
-	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
