 	KUNIT_EXPECT_FALSE(test, f->mca.normal_voltage_stop);
 	KUNIT_EXPECT_TRUE(test, f->pmic_enabled);
-	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
