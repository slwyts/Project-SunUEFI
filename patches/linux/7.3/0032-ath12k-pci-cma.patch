From d3e19064a5e585dba10e4d488712bf56a15b555f Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Sun, 8 Nov 2026 01:57:30 +0800
Subject: [PATCH] wifi: ath12k: attach PCI DMA pools before DMA allocations

Source: Cryolitia/xiaomi-piano-nixos, packages/kernel/patches/ath12k-pci-cma.patch
---
 drivers/net/wireless/ath/ath12k/pci.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 27cdaed7bf4..1d3e566122c 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -7,6 +7,8 @@
 #include <linux/module.h>
 #include <linux/interrupt.h>
 #include <linux/msi.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
 #include <linux/pci.h>
 #include <linux/time.h>
 #include <linux/vmalloc.h>
@@ -830,6 +832,8 @@ static int ath12k_pci_config_msi_data(struct ath12k_pci *ab_pci)
 
 static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 {
+	struct device_node *mem_node __free(device_node) =
+		of_parse_phandle(pdev->dev.of_node, "memory-region", 0);
 	struct ath12k_base *ab = ab_pci->ab;
 	u16 device_id;
 	int ret = 0;
@@ -867,6 +871,15 @@ static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 		goto release_region;
 	}
 
+	/* Bind a DMA pool before allocating MHI and CE rings. */
+	if (of_device_is_compatible(mem_node, "shared-dma-pool")) {
+		ret = devm_of_reserved_mem_device_init(&pdev->dev);
+		if (ret) {
+			ath12k_err(ab, "failed to initialize reserved memory: %d\n", ret);
+			goto release_region;
+		}
+	}
+
 	pci_set_master(pdev);
 
 	ab->mem_len = pci_resource_len(pdev, ATH12K_PCI_BAR_NUM);
