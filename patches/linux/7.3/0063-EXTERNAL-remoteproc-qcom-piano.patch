From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: remoteproc: qcom: support the Piano processor handoff

Carry the PAS resource, clock and processor handover changes used on Piano.

The port retains changes from these linux-piano commits:
piano: NT36532 THP touch bring-up (milestone-touch) (#11) (bluseliu50 <265648257+bluseliu50@users.noreply.github.com>)
piano: FS19xx speakers on LPAIF TDM and the q6v5 handover IRQ fixes (bluseliu50 <265648257+bluseliu50@users.noreply.github.com>)

Co-authored-by: bluseliu50 <265648257+bluseliu50@users.noreply.github.com>

Link: https://github.com/blu-sharky/linux-piano/commit/00b055cd9c1634371cd501530ba5c29de4ab91d4
Link: https://github.com/blu-sharky/linux-piano/commit/2f6c29345edf991b04ce15d2231e6060412335aa
Link: https://github.com/slwyts/Project-SunUEFI/commit/e8fcf33971263f28085dbc0dbe5039438bf76c13

Scope the unavailable interconnect fallback to the explicit Piano
board compatible. Scope the XO, clock, regulator and reserved-memory
exceptions to that board as well. Keep upstream dependency and
SCM failure handling on other boards.
---
 drivers/remoteproc/qcom_q6v5.c     |  14 +++-
 drivers/remoteproc/qcom_q6v5_pas.c | 123 ++++++++++++++++++++++++-----
 2 files changed, 116 insertions(+), 21 deletions(-)

diff --git a/drivers/remoteproc/qcom_q6v5.c b/drivers/remoteproc/qcom_q6v5.c
index fe148b4b3775fc98f3ea86fed60a6eb495bb5a0a..4474990b0a2840f29654a748373b6a7500f492b3 100644
--- a/drivers/remoteproc/qcom_q6v5.c
+++ b/drivers/remoteproc/qcom_q6v5.c
@@ -372,9 +372,17 @@ int qcom_q6v5_init(struct qcom_q6v5 *q6v5, struct platform_device *pdev,
 	}
 
 	q6v5->path = devm_of_icc_get(&pdev->dev, NULL);
-	if (IS_ERR(q6v5->path))
-		return dev_err_probe(&pdev->dev, PTR_ERR(q6v5->path),
-				     "failed to acquire interconnect path\n");
+	if (IS_ERR(q6v5->path)) {
+		ret = PTR_ERR(q6v5->path);
+
+		/* The vendor Piano DT can reference an unsupported provider. */
+		if (ret != -EPROBE_DEFER || !of_machine_is_compatible("xiaomi,piano"))
+			return dev_err_probe(&pdev->dev, ret,
+					     "failed to acquire interconnect path\n");
+
+		dev_warn(&pdev->dev, "Piano interconnect provider unbound, continuing without it\n");
+		q6v5->path = NULL;
+	}
 
 	return 0;
 }
diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index a005546c265d0eccbdd6a984b04e88c3089ba690..0f909d20e69085160f021ddafe4c4eb89e7a3622 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -617,27 +617,50 @@ static const struct rproc_ops qcom_pas_minidump_ops = {
 
 static int qcom_pas_init_clock(struct qcom_pas *pas)
 {
-	pas->xo = devm_clk_get(pas->dev, "xo");
-	if (IS_ERR(pas->xo))
-		return dev_err_probe(pas->dev, PTR_ERR(pas->xo),
-				     "failed to get xo clock");
+	bool piano = of_machine_is_compatible("xiaomi,piano");
+	int ret;
+
+	/* The vendor Piano DT can reference clocks without a provider. */
+	if (piano)
+		pas->xo = devm_clk_get_optional(pas->dev, "xo");
+	else
+		pas->xo = devm_clk_get(pas->dev, "xo");
+	if (IS_ERR(pas->xo)) {
+		ret = PTR_ERR(pas->xo);
+		if (!piano || ret != -EPROBE_DEFER)
+			return dev_err_probe(pas->dev, ret, "failed to get xo clock");
+
+		dev_warn(pas->dev, "Piano xo clock provider unbound, continuing without it\n");
+		pas->xo = NULL;
+	}
 
 	pas->aggre2_clk = devm_clk_get_optional(pas->dev, "aggre2");
-	if (IS_ERR(pas->aggre2_clk))
-		return dev_err_probe(pas->dev, PTR_ERR(pas->aggre2_clk),
-				     "failed to get aggre2 clock");
+	if (IS_ERR(pas->aggre2_clk)) {
+		ret = PTR_ERR(pas->aggre2_clk);
+		if (!piano || ret != -EPROBE_DEFER)
+			return dev_err_probe(pas->dev, ret, "failed to get aggre2 clock");
+
+		dev_warn(pas->dev, "Piano aggre2 clock provider unbound, continuing without it\n");
+		pas->aggre2_clk = NULL;
+	}
 
 	return 0;
 }
 
 static int qcom_pas_init_regulator(struct qcom_pas *pas)
 {
+	bool piano = of_machine_is_compatible("xiaomi,piano");
+	int ret;
+
+	/* The vendor Piano DT uses power domains for these rail votes. */
 	pas->cx_supply = devm_regulator_get_optional(pas->dev, "cx");
 	if (IS_ERR(pas->cx_supply)) {
-		if (PTR_ERR(pas->cx_supply) == -ENODEV)
-			pas->cx_supply = NULL;
-		else
-			return PTR_ERR(pas->cx_supply);
+		ret = PTR_ERR(pas->cx_supply);
+		if (ret != -ENODEV && (!piano || ret != -EPROBE_DEFER))
+			return ret;
+		if (ret == -EPROBE_DEFER)
+			dev_warn(pas->dev, "Piano cx supply unresolved, using power domain\n");
+		pas->cx_supply = NULL;
 	}
 
 	if (pas->cx_supply)
@@ -645,10 +668,12 @@ static int qcom_pas_init_regulator(struct qcom_pas *pas)
 
 	pas->px_supply = devm_regulator_get_optional(pas->dev, "px");
 	if (IS_ERR(pas->px_supply)) {
-		if (PTR_ERR(pas->px_supply) == -ENODEV)
-			pas->px_supply = NULL;
-		else
-			return PTR_ERR(pas->px_supply);
+		ret = PTR_ERR(pas->px_supply);
+		if (ret != -ENODEV && (!piano || ret != -EPROBE_DEFER))
+			return ret;
+		if (ret == -EPROBE_DEFER)
+			dev_warn(pas->dev, "Piano px supply unresolved, using power domain\n");
+		pas->px_supply = NULL;
 	}
 
 	return 0;
@@ -788,8 +813,16 @@ static int qcom_pas_assign_memory_region(struct qcom_pas *pas)
 					  &pas->region_assign_owners[offset],
 					  perm, perm_size);
 		if (ret < 0) {
-			dev_err(pas->dev, "assign memory %d failed\n", offset);
-			return ret;
+			if (!of_machine_is_compatible("xiaomi,piano")) {
+				dev_err(pas->dev, "assign memory %d failed\n", offset);
+				return ret;
+			}
+			/* The vendor Piano DT can use a different region layout. */
+			dev_warn(pas->dev, "Piano assign memory %d failed: %d (continuing)\n",
+				 offset, ret);
+			pas->region_assign_phys[offset] = 0;
+			pas->region_assign_size[offset] = 0;
+			continue;
 		}
 	}
 
@@ -860,7 +893,14 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	}
 
 	rproc->has_iommu = of_property_present(pdev->dev.of_node, "iommus");
-	rproc->auto_boot = desc->auto_boot;
+	/*
+	 * Some vendor firmware revisions touch shared PMIC/display resources
+	 * during ADSP handover.  Let the device tree opt out of the descriptor's
+	 * historical auto-boot default so bring-up can probe the remoteproc and
+	 * inspect its state before starting firmware.
+	 */
+	rproc->auto_boot = desc->auto_boot &&
+		!of_property_read_bool(pdev->dev.of_node, "qcom,no-auto-boot");
 	rproc_coredump_set_elf_info(rproc, ELFCLASS32, EM_NONE);
 
 	pas = rproc->priv;
@@ -1823,6 +1863,47 @@ static const struct qcom_pas_data eliza_cdsp_resource = {
 	.region_assign_vmid = QCOM_SCM_VMID_CDSP,
 };
 
+static const struct qcom_pas_data sm8750_adsp_resource = {
+	.crash_reason_smem = 423,
+	.firmware_name = "adsp.mdt",
+	.dtb_firmware_name = "adsp_dtb.mdt",
+	.pas_id = 1,
+	.dtb_pas_id = 0x24,
+	.minidump_id = 5,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"lcx",
+		"lmx",
+		NULL
+	},
+	.load_state = "adsp",
+	.ssr_name = "lpass",
+	.sysmon_name = "adsp",
+	.ssctl_id = 0x14,
+	.smem_host_id = 2,
+};
+
+static const struct qcom_pas_data sm8750_cdsp_resource = {
+	.crash_reason_smem = 601,
+	.firmware_name = "cdsp.mdt",
+	.dtb_firmware_name = "cdsp_dtb.mdt",
+	.pas_id = 18,
+	.dtb_pas_id = 0x25,
+	.minidump_id = 7,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		"mxc",
+		"nsp",
+		NULL
+	},
+	.load_state = "cdsp",
+	.ssr_name = "cdsp",
+	.sysmon_name = "cdsp",
+	.ssctl_id = 0x17,
+	.smem_host_id = 5,
+};
+
 static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,eliza-adsp-pas", .data = &sm8550_adsp_resource },
 	{ .compatible = "qcom,eliza-cdsp-pas", .data = &eliza_cdsp_resource },
@@ -1906,6 +1987,12 @@ static const struct of_device_id qcom_pas_of_match[] = {
 	{ .compatible = "qcom,sm8650-cdsp-pas", .data = &sm8650_cdsp_resource },
 	{ .compatible = "qcom,sm8650-mpss-pas", .data = &sm8650_mpss_resource },
 	{ .compatible = "qcom,sm8750-mpss-pas", .data = &sm8750_mpss_resource },
+	/* piano: the stock sun vendor tree names these qcom,sun-*-pas; accept
+	 * both spellings so the mainline driver can bind the vendor nodes. */
+	{ .compatible = "qcom,sm8750-adsp-pas", .data = &sm8750_adsp_resource },
+	{ .compatible = "qcom,sm8750-cdsp-pas", .data = &sm8750_cdsp_resource },
+	{ .compatible = "qcom,sun-adsp-pas", .data = &sm8750_adsp_resource },
+	{ .compatible = "qcom,sun-cdsp-pas", .data = &sm8750_cdsp_resource },
 	{ .compatible = "qcom,x1e80100-adsp-pas", .data = &x1e80100_adsp_resource },
 	{ .compatible = "qcom,x1e80100-cdsp-pas", .data = &x1e80100_cdsp_resource },
 	{ },
