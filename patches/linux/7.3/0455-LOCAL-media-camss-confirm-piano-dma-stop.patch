 drivers/media/platform/qcom/camss/camss-vfe.c | 99 ++++++++++++++++++-
 drivers/media/platform/qcom/camss/camss-vfe.h |  5 +
 .../media/platform/qcom/camss/camss-video.c   | 29 +++++-
 drivers/media/platform/qcom/camss/camss.c     | 95 +++++++++++++++++-
 drivers/media/platform/qcom/camss/camss.h     |  6 ++
 6 files changed, 259 insertions(+), 6 deletions(-)

diff --git a/drivers/media/platform/qcom/camss/camss-vfe-980.c b/drivers/media/platform/qcom/camss/camss-vfe-980.c
index a7fcda94e81a380a374e5358bdc22f24bc1eb5b8..4815bb560a91bb47830a386622cac08b60ef8597 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-980.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-980.c
@@ -59,6 +59,7 @@
 #define VFE_BUS_WM_MMU_PREFETCH_CFG(n)		(BUS_REG_BASE + 0x560 + (n) * 0x100)
 #define VFE_BUS_WM_MMU_PREFETCH_MAX_OFFSET(n)	(BUS_REG_BASE + 0x564 + (n) * 0x100)
 #define VFE_BUS_WM_CTXT_CFG(n)			(BUS_REG_BASE + 0x578 + (n) * 0x100)
+#define VFE_BUS_WM_LAST_ADDR(n)			(BUS_REG_BASE + 0x590 + (n) * 0x100)
 #define VFE_BUS_CTXT_SEL			(BUS_REG_BASE + 0x124)
 
 #define		WM_PACKER_PLAIN_8_LSB_MSB_10		3
@@ -552,6 +553,13 @@ static u32 vfe_check_bus_error(struct vfe_device *vfe)
 		if (!(vfe->bus_active_lines & BIT(id)))
 			continue;
 		output->frame_timeline_error = true;
+		if (vfe->camss->check_dma_stop) {
+			output->dma_error = true;
+			if (output->state == VFE_OUTPUT_DRAINING)
+				complete(&output->dma_drained);
+			else if (output->state == VFE_OUTPUT_ON)
+				vb2_queue_error(&vfe->line[id].video_out.vb2_q);
+		}
 		trace_camss_frame_error(vfe->id, id, output->frame_sequence,
 					status, irq_ns);
 	}
@@ -696,6 +704,28 @@ static void vfe_wm_update(struct vfe_device *vfe, u8 wm, u32 addr,
 	dev_dbg(vfe->camss->dev, "wm:%d, image buf addr:0x%x\n", wm, addr);
 }
 
+static bool vfe_980_dma_done(struct vfe_device *vfe, struct vfe_line *line,
+			     u32 addr)
+{
+	unsigned int wm = RDI_WM(line->output.wm_idx[0]);
+	u32 done;
+
+	if (vfe->camss->check_dma_stop && !vfe_is_lite(vfe) &&
+	    line->id == VFE_LINE_PIX) {
+		struct v4l2_pix_format_mplane *pix =
+			&line->video_out.active_fmt.fmt.pix_mp;
+		u32 chroma = addr + pix->plane_fmt[0].bytesperline * pix->height;
+
+		done = readl(vfe->base + VFE_BUS_WM_LAST_ADDR(FD_C_WM));
+		if (done != chroma >> VFE_GEN4_ADDR_SHIFT)
+			return false;
+		wm = FD_Y_WM;
+	}
+
+	done = readl(vfe->base + VFE_BUS_WM_LAST_ADDR(wm));
+	return done == addr >> VFE_GEN4_ADDR_SHIFT;
+}
+
 static void vfe_reg_update(struct vfe_device *vfe, enum vfe_line_id line_id)
 {
 	int port_id = line_id;
@@ -782,6 +812,7 @@ const struct vfe_hw_ops vfe_ops_980 = {
 	.vfe_wm_stop = vfe_wm_stop,
 	.vfe_buf_done = vfe_buf_done,
 	.check_bus_error = vfe_check_bus_error,
+	.dma_done = vfe_980_dma_done,
 	.vfe_wm_update = vfe_wm_update,
 	.vfe_isp_update = vfe_isp_update,
 };
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index 2f23aa0e759ccc04d2e6f383de30623d8fd89378..d07cdb7bb1b7d75f3efe9b6909bd9f4196f7c380 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -628,6 +628,19 @@ void vfe_frame_sync(struct vfe_device *vfe, int port_id, bool start,
 	}
 }
 
+static void vfe_stop_980_port(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_output *output = &line->output;
+	unsigned int i;
+
+	lockdep_assert_held(&vfe->output_lock);
+	csid_980_stop_port(&vfe->camss->csid[vfe->id], line->id);
+	for (i = 0; i < output->wm_num; i++)
+		vfe->res->hw_ops->vfe_wm_stop(vfe, output->wm_idx[i]);
+	output->state = VFE_OUTPUT_STOPPING;
+}
+
 void vfe_buf_done(struct vfe_device *vfe, int wm)
 {
 	struct vfe_line *line;
@@ -638,8 +651,11 @@ void vfe_buf_done(struct vfe_device *vfe, int wm)
 	u32 index;
 	u64 ts = ktime_get_ns();
 	bool frame_valid = true;
+	bool verify_dma = vfe->camss->check_dma_stop;
 
 	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (unlikely(READ_ONCE(vfe->camss->dma_faulted)))
+		goto out_unlock;
 
 	if (vfe->wm_output_map[wm] == VFE_LINE_NONE) {
 		dev_err_ratelimited(vfe->camss->dev,
@@ -648,18 +664,40 @@ void vfe_buf_done(struct vfe_device *vfe, int wm)
 	}
 	line = &vfe->line[vfe->wm_output_map[wm]];
 	output = &line->output;
-	if (output->state != VFE_OUTPUT_ON)
+	if (output->state != VFE_OUTPUT_ON && output->state != VFE_OUTPUT_DRAINING)
 		goto out_unlock;
 
 	/* CSID forwards DMA completion independently of the VFE BUS error IRQ.
 	 * Serialize both paths so a delayed error IRQ cannot publish a bad frame.
 	 */
 	if (ops->check_bus_error) {
-		ops->check_bus_error(vfe);
+		if (ops->check_bus_error(vfe))
+			output->dma_error = true;
 		frame_valid = !output->frame_timeline_error;
 	}
 
 	ready_buf = output->buf[0];
+	if (output->state == VFE_OUTPUT_DRAINING)
+		ready_buf = output->buf[output->drain_count];
+	if (verify_dma && ready_buf &&
+	    (output->dma_error ||
+	     (output->buf[1] && output->buf[0]->addr[0] == output->buf[1]->addr[0]) ||
+	     !ops->dma_done(vfe, line, ready_buf->addr[0]))) {
+		output->dma_error = true;
+		if (output->state == VFE_OUTPUT_DRAINING)
+			complete(&output->dma_drained);
+		else
+			vb2_queue_error(&line->video_out.vb2_q);
+		goto out_unlock;
+	}
+	if (output->state == VFE_OUTPUT_DRAINING) {
+		/* Keep ownership of both buffers until the write masters stop. */
+		if (ready_buf && ++output->drain_count == output->gen2.active_num) {
+			vfe_stop_980_port(line);
+			complete(&output->dma_drained);
+		}
+		goto out_unlock;
+	}
 	if (!ready_buf) {
 		dev_err_ratelimited(vfe->camss->dev,
 				    "Missing ready buf %d!\n", output->state);
@@ -724,6 +762,7 @@ static void vfe_arm_output_v2(struct vfe_line *line)
 	unsigned int i;
 
 	lockdep_assert_held(&vfe->output_lock);
+	output->dma_error = false;
 	output->state = VFE_OUTPUT_ON;
 	ops->vfe_wm_start(vfe, output->wm_idx[0], line);
 
@@ -842,7 +881,8 @@ int vfe_queue_buffer_v2(struct camss_video *vid,
 
 	spin_lock_irqsave(&vfe->output_lock, flags);
 
-	if (output->state == VFE_OUTPUT_ON &&
+	if (!READ_ONCE(vfe->camss->dma_faulted) &&
+	    output->state == VFE_OUTPUT_ON &&
 	    output->gen2.active_num < 2) {
 		output->buf[output->gen2.active_num++] = buf;
 		ops->vfe_wm_update(vfe, output->wm_idx[0],
@@ -1106,6 +1146,53 @@ static int vfe_disable_output(struct vfe_line *line)
 	return vfe_reset(vfe);
 }
 
+static int vfe_stop_980_dma(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_output *output = &line->output;
+	struct camss *camss = vfe->camss;
+	unsigned long flags;
+	bool wait = false;
+	bool drained;
+
+	lockdep_assert_held(&camss->dma_lock);
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (output->state == VFE_OUTPUT_RESERVED) {
+		/* No DMA address is published until start_output succeeds. */
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return 0;
+	}
+
+	if (!camss->dma_isolated && !output->dma_error && output->gen2.active_num) {
+		reinit_completion(&output->dma_drained);
+		output->drain_count = 0;
+		output->state = VFE_OUTPUT_DRAINING;
+		wait = true;
+	} else {
+		vfe_stop_980_port(line);
+	}
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+
+	if (wait)
+		wait_for_completion_timeout(&output->dma_drained, msecs_to_jiffies(1000));
+
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	drained = output->state == VFE_OUTPUT_STOPPING && !output->dma_error &&
+		  (!wait || output->drain_count == output->gen2.active_num);
+	if (output->state == VFE_OUTPUT_DRAINING)
+		vfe_stop_980_port(line);
+	output->gen2.active_num = 0;
+	output->frame_timeline_initialized = false;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+
+	synchronize_irq(vfe->irq);
+	synchronize_irq(camss->csid[vfe->id].irq);
+	if (!drained)
+		camss_wait_for_dma_isolation(camss);
+
+	return 0;
+}
+
