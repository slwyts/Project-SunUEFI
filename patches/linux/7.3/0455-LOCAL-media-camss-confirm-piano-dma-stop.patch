  * vfe_disable - Disable streaming on VFE line
  * @line: VFE line
@@ -1118,7 +1205,10 @@ int vfe_disable(struct vfe_line *line)
 	int ret;
 
 	mutex_lock(&vfe->stream_lock);
-	ret = vfe_disable_output(line);
+	if (vfe->camss->check_dma_stop)
+		ret = vfe_stop_980_dma(line);
+	else
+		ret = vfe_disable_output(line);
 	if (!ret) {
 		vfe_put_output(line);
 		vfe->stream_count--;
@@ -2286,6 +2376,7 @@ int msm_vfe_subdev_init(struct camss *camss, struct vfe_device *vfe,
 		l->id = i;
 		init_completion(&l->output.sof);
 		init_completion(&l->output.reg_update);
+		init_completion(&l->output.dma_drained);
 
 		if (i == VFE_LINE_PIX) {
 			l->nformats = res->vfe.formats_pix->nformats;
