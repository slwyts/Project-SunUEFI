 {
 	struct camss *camss = platform_get_drvdata(pdev);
 
+	camss_stop_queues(camss);
 	v4l2_async_nf_unregister(&camss->notifier);
 	v4l2_async_nf_cleanup(&camss->notifier);
 	camss_unregister_entities(camss);
@@ -6592,8 +6674,18 @@ static int __maybe_unused camss_runtime_resume(struct device *dev)
 	return 0;
 }
 
+static int __maybe_unused camss_suspend(struct device *dev)
+{
+	struct camss *camss = dev_get_drvdata(dev);
+
+	if (READ_ONCE(camss->dma_faulted))
+		return -EBUSY;
+
+	return pm_runtime_force_suspend(dev);
+}
+
 static const struct dev_pm_ops camss_pm_ops = {
-	SET_SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend,
+	SET_SYSTEM_SLEEP_PM_OPS(camss_suspend,
 				pm_runtime_force_resume)
 	SET_RUNTIME_PM_OPS(camss_runtime_suspend, camss_runtime_resume, NULL)
 };
@@ -6601,6 +6693,7 @@ static const struct dev_pm_ops camss_pm_ops = {
 static struct platform_driver qcom_camss_driver = {
 	.probe = camss_probe,
 	.remove = camss_remove,
+	.shutdown = camss_shutdown,
 	.driver = {
 		.name = "qcom-camss",
 		.of_match_table = camss_dt_match,
diff --git a/drivers/media/platform/qcom/camss/camss.h b/drivers/media/platform/qcom/camss/camss.h
index 4812043391d07abddf8f972a6495818367e03488..78cf32c895c03da4e086361737133586fd5cb5d2 100644
--- a/drivers/media/platform/qcom/camss/camss.h
+++ b/drivers/media/platform/qcom/camss/camss.h
@@ -136,7 +136,11 @@ struct camss {
