From a067a06c4ff15e3a743cdb75f4d787419908860b Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 23:03:04 +0800
Subject: [PATCH] dt-bindings: media: document OmniVision OV32D40

Describe the OV32D40 sensor using the common video-device and CSI-2
endpoint schemas. Document its single MCLK, three named supplies, reset
input, four data lanes and optional power domain.

Use the existing driver author as the binding contact. The example selects
the 19.2 MHz clock and 842.4 MHz link used by the current sensor modes.
---
 .../bindings/media/i2c/ovti,ov32d40.yaml      | 122 ++++++++++++++++++
 1 file changed, 122 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/ovti,ov32d40.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov32d40.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov32d40.yaml
new file mode 100644
index 000000000..baf6a2c3a
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov32d40.yaml
@@ -0,0 +1,122 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov32d40.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV32D40 Image Sensor
+
+maintainers:
+  - map220v <map220v300@gmail.com>
+
+description:
+  The OmniVision OV32D40 is a 32-megapixel CMOS image sensor controlled
+  through an I2C-compatible SCCB bus. Image data is transferred over a
+  four-lane MIPI CSI-2 D-PHY interface.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov32d40
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: External sensor clock (MCLK), 19.2 MHz.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog circuit power supply.
+
+  dvdd-supply:
+    description: Digital core power supply.
+
+  vddio-supply:
+    description: Digital I/O power supply.
+
+  reset-gpios:
+    description: GPIO connected to the active-low reset input.
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 4 # MIPI CSI-2 D-PHY
+
+          clock-lanes:
+            const: 0
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - vddio-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@10 {
+            compatible = "ovti,ov32d40";
+            reg = <0x10>;
+
+            assigned-clock-rates = <19200000>;
+            assigned-clocks = <&camera_mclk>;
+            avdd-supply = <&camera_avdd>;
+            clocks = <&camera_mclk>;
+            dvdd-supply = <&camera_dvdd>;
+            orientation = <0>;
+            reset-gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
+            rotation = <0>;
+            vddio-supply = <&camera_vddio>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <842400000>;
+                    remote-endpoint = <&csiphy_in>;
+                };
+            };
+        };
+    };
+...
-- 
2.56.1
