+/* A failed firmware temperature read must not look like a cold, valid pack. */
+static int piano_mca_cp_gauges(struct piano_mca *mca, int *vbat, int *ibat,
+			       int *tcool, int *twarm)
+{
+	__le32 pack;
+	int ret, temp;
+
+	ret = piano_mca_gauges(vbat, ibat, tcool, twarm);
+	ret = ret ?: piano_mca_read(mca, MCA_PROP_PACK_TBAT, &pack, sizeof(pack));
+	if (ret)
+		return ret;
+	temp = (s32)le32_to_cpu(pack);
+	*tcool = min(*tcool, temp);
+	*twarm = max(*twarm, temp);
+	return 0;
+}
+
+static int piano_mca_cp_temp_profile(int temp)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(piano_mca_cp_profiles); i++)
+		if (temp >= piano_mca_cp_profiles[i].low &&
+		    temp < piano_mca_cp_profiles[i].high)
+			return i;
+	return -ERANGE;
+}
+
+/* Tighten immediately; require temperature headroom before restoring FV. */
+static void piano_mca_normal_temperature(struct piano_mca *mca, int tcool,
+					 int twarm)
+{
+	if (tcool < -9)
+		mca->normal_cold = true;
+	else if (tcool >= -8)
+		mca->normal_cold = false;
+	if (twarm >= 55)
+		mca->cp_hot = true;
+	else if (twarm <= 53)
+		mca->cp_hot = false;
+	if (twarm >= 48)
+		mca->normal_warm = true;
+	else if (twarm <= 46)
+		mca->normal_warm = false;
+}
+
+/*
+ * Evaluate the CN normal tables against both cells and the firmware pack.
+ * The colder/hotter cell may request different profiles: use the lower FV
+ * and both current limits. This extra per-cell check is local protection.
+ * CC/CV stages advance within a temperature pair, including across suspend.
+ */
+static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
+				      int tcool, int twarm,
+				      struct piano_mca_cp_limits *limits)
+{
+	const struct piano_mca_cp_profile *cold, *hot, *profile;
+	const struct piano_mca_cp_voltage *voltage;
+	u32 key, ma;
+	int a, b, stage;
+
+	piano_mca_normal_temperature(mca, tcool, twarm);
+	if (tcool < 8)
+		mca->cp_cold = true;
+	if (twarm >= 55)
+		mca->cp_hot = true;
+	/* Factory restart hysteresis after leaving the charging window. */
+	if ((mca->cp_cold && tcool <= 8) || (mca->cp_hot && twarm > 53))
+		return -ERANGE;
+	a = piano_mca_cp_temp_profile(tcool);
+	b = piano_mca_cp_temp_profile(mca->normal_warm ? max(twarm, 48) : twarm);
+	if (a < 0 || b < 0)
+		return -ERANGE;
+	mca->cp_cold = false;
+	mca->cp_hot = false;
+	cold = &piano_mca_cp_profiles[a];
+	hot = &piano_mca_cp_profiles[b];
+	profile = cold->fv_mv < hot->fv_mv ? cold : hot;
+	key = a * ARRAY_SIZE(piano_mca_cp_profiles) + b + 1;
+	if (key != mca->cp_profile) {
+		mca->cp_profile = key;
+		mca->cp_stage = 0;
+		mca->cp_taper_at = 0;
+	}
+	ma = min3(clamp(cp_ibat_max, 1000U, (u32)MCA_CP_IBAT_MAX_MA),
+		  (u32)cold->voltage[0].max_ma, (u32)hot->voltage[0].max_ma);
+	stage = min_t(u32, mca->cp_stage / 2, profile->count - 1);
+	voltage = &profile->voltage[stage];
+	if (vbat >= voltage->mv) {
+		if (ibat <= min_t(int, voltage->min_ma, ma) &&
+		    stage + 1 < profile->count) {
+			stage++;
+			mca->cp_stage = 2 * stage;
+			voltage = &profile->voltage[stage];
+		} else {
+			mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
+		}
+	}
+	limits->ma = min_t(u32, ma, voltage->max_ma);
+	limits->last = stage + 1 == profile->count;
+	limits->cv_mv = voltage->mv - (limits->last ? MCA_CP_TAPER_DELTA_MV : 0);
+	limits->fv_mv = profile->fv_mv;
+	if (vbat >= limits->cv_mv)
+		mca->cp_stage = max_t(u32, mca->cp_stage, 2 * stage + 1);
+	return 0;
+}
+
+/* Acknowledgment and readback are both required before increasing voltage. */
+static int piano_mca_normal_set_fv(struct piano_mca *mca, u32 mv,
+				   unsigned int generation,
+				   unsigned int connection)
+{
+	__le32 value;
+	int ret;
+
+	if (!piano_mca_session_valid(mca, generation, connection))
+		return -ENODEV;
+	if (mca->fv_set_mv == mv && mca->fv_generation == generation &&
+	    mca->fv_connection == connection)
+		return 0;
+	/* A lost ACK can still have applied the write: discard the old cache. */
+	mca->fv_set_mv = 0;
+	ret = piano_mca_write_u32_session(mca, MCA_PROP_FV, mv, generation, connection);
+	ret = ret ?: piano_mca_read(mca, MCA_PROP_FV, &value, sizeof(value));
+	if (ret)
+		return ret;
+	if (!piano_mca_session_valid(mca, generation, connection))
+		return -ENODEV;
+	if (le32_to_cpu(value) != mv)
+		return -EIO;
+	if (mca->fv_generation != generation || mca->fv_connection != connection)
+		mca->fcc_set_ma = 0;
+	mca->fv_set_mv = mv;
+	mca->fv_generation = generation;
+	mca->fv_connection = connection;
+	return 0;
+}
+
+static int piano_mca_normal_pause(struct piano_mca *mca,
+				  unsigned int generation,
+				  unsigned int connection)
+{
+	__le32 value;
+	int ret;
+
+	ret = piano_mca_write_u32_session(mca, MCA_PROP_FCC, 0,
+					  generation, connection);
+	ret = ret ?: piano_mca_read(mca, MCA_PROP_FCC, &value, sizeof(value));
+	if (!ret && le32_to_cpu(value))
+		ret = -EIO;
+	if (!ret && !piano_mca_session_valid(mca, generation, connection))
+		ret = -ENODEV;
+	mca->fcc_set_ma = 0;
+	/* The lowest normal FV is safe while sensor readings are unavailable. */
+	return piano_mca_normal_set_fv(mca, 4060, generation, connection) ?: ret;
+}
+
+static int piano_mca_normal_buck(struct piano_mca *mca, int *tbat)
+{
+	/* Piano CN buckchg JEITA. The PMIC itself remains capped at 3 A. */
+	static const struct {
+		int low, high, ma, fv;
+	} jeita[] = {
+		{ -9, 3, 880, 4500 },
+		{ 3, 8, 1768, 4500 },
+		{ 8, 13, 4520, 4500 },
+		{ 13, 18, 7232, 4500 },
+		{ 18, 48, 8000, 4480 },
+		{ 48, 55, 4520, 4060 },
+	};
+	int vbat, ibat, tcool, twarm, fv = 4500, ma = MCA_FCC_MAX_MA;
+	unsigned int generation = pmic_glink_get_generation(mca->client);
+	unsigned int connection = piano_mca_connection_generation(mca);
+	int i, cool = -1, warm = -1, ret;
+
+	ret = piano_mca_cp_gauges(mca, &vbat, &ibat, &tcool, &twarm);
+	if (ret) {
+		piano_mca_normal_pause(mca, generation, connection);
+		return ret;
+	}
+	*tbat = twarm;
+	piano_mca_normal_temperature(mca, tcool, twarm);
+	for (i = 0; i < ARRAY_SIZE(jeita); i++) {
+		if (tcool >= jeita[i].low && tcool < jeita[i].high)
+			cool = i;
+		if (twarm >= jeita[i].low && twarm < jeita[i].high)
+			warm = i;
+	}
+	if (cool < 0 || warm < 0 || mca->normal_cold || mca->cp_hot) {
+		ret = piano_mca_normal_pause(mca, generation, connection);
+		return ret ?: -ERANGE;
+	}
+	if (mca->normal_warm)
+		warm = ARRAY_SIZE(jeita) - 1;
+	fv = min(jeita[cool].fv, jeita[warm].fv);
+	ma = min3(ma, jeita[cool].ma, jeita[warm].ma);
+	ma = min_t(u32, ma, piano_mca_policy_fcc(mca->real_type));
+	ret = piano_mca_normal_set_fv(mca, fv, generation, connection);
+	if (ret) {
+		piano_mca_normal_pause(mca, generation, connection);
+		return ret;
+	}
+	if (mca->fcc_set_ma == ma)
+		return piano_mca_session_valid(mca, generation, connection) ? 0 : -ENODEV;
+	ret = piano_mca_write_u32_session(mca, MCA_PROP_FCC, ma,
+					  generation, connection);
+	if (!ret)
+		mca->fcc_set_ma = ma;
+	return ret;
+}
