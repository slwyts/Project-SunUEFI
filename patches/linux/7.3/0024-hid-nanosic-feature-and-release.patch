From 7b2c4d08da38b128641a62d5783e73ab349d7b5f Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Thu, 22 Oct 2026 18:25:53 +0800
Subject: [PATCH] HID: nanosic: describe unsupported reports and release full
 touch frames

The vendor MCU adapter does not implement a HID feature/output report
transport. Returning success leaves the allocated feature buffer empty,
so hid-multitouch reports mismatched report IDs during every probe.
Mark the touchpad as having no initial feature queries and reject raw
requests that have no transport. Keep the descriptor-provided limits.

Use the actual variant report size when releasing contacts: Piano uses
27 bytes, while the other supported layout uses 21. Sending a short
frame can leave the tail contact/count fields unprocessed at lid close.
Set the no-query flag in the low-level start callback, after HID core resets
quirks and before hidinput performs its feature mappings.
---
 drivers/hid/hid-nanosic-wn8030.c | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/drivers/hid/hid-nanosic-wn8030.c b/drivers/hid/hid-nanosic-wn8030.c
index 0b25473de75..ff14a782555 100644
--- a/drivers/hid/hid-nanosic-wn8030.c
+++ b/drivers/hid/hid-nanosic-wn8030.c
@@ -613,6 +613,10 @@ static int nanosic_wn8030_hid_parse(struct hid_device *hid)
 
 static int nanosic_wn8030_hid_start(struct hid_device *hid)
 {
+	/* HID core resets quirks before probe; set this before input mapping. */
+	if (hid->product == 0x00A1)
+		hid->quirks |= HID_QUIRK_NO_INIT_REPORTS;
+
 	return 0;
 }
 
@@ -635,7 +639,8 @@ static int nanosic_wn8030_raw_request(struct hid_device *hid,
 				      __u8 *buf, size_t len,
 				      unsigned char rtype, int reqtype)
 {
-	return len;
+	/* The MCU protocol has no HID feature/output report transport. */
+	return -EOPNOTSUPP;
 }
 
 static inline u32 nanosic_wn8030_checksum32(const u8 *data, int size)
@@ -1501,7 +1506,7 @@ static void nanosic_wn8030_release_inputs(struct nanosic_wn8030 *nanosic)
 {
 	u8 keyboard[9] = { 0x05 };
 	u8 consumer[3] = { 0x06 };
-	u8 touchpad[21] = { 0x19 };
+	u8 touchpad[27] = { 0x19 };
 
 	if (nanosic->hid_keyboard) {
 		hid_input_report(nanosic->hid_keyboard, HID_INPUT_REPORT,
@@ -1511,7 +1516,7 @@ static void nanosic_wn8030_release_inputs(struct nanosic_wn8030 *nanosic)
 	}
 	if (nanosic->hid_touchpad)
 		hid_input_report(nanosic->hid_touchpad, HID_INPUT_REPORT,
-				 touchpad, sizeof(touchpad), 0);
+				 touchpad, nanosic->variant->touchpad_len, 0);
 	WRITE_ONCE(nanosic->micmute_key_down, false);
 	nanosic->fn_held = 0;
 }
