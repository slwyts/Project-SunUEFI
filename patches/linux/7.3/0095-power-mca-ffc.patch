 	profile = cold->fv_mv < hot->fv_mv ? cold : hot;
-	key = a * ARRAY_SIZE(piano_mca_cp_profiles) + b + 1;
+	/* A hotter FFC row has the stricter tail-termination current. */
+	if (mca->ffc)
