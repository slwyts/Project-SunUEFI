+/* Factory weighted board temperature; individual sensors stay unmodified. */
+static int piano_mca_board_temperature(struct thermal_zone_device *zone, int *temp)
+{
+	static const char * const names[] = { "quiet", "charger", "wifi", "cpu" };
+	static const int weights[] = { 131, -9, 89, 232 };
+	struct piano_mca *mca = thermal_zone_device_priv(zone);
+	union power_supply_propval battery_temp;
+	struct power_supply *psy;
+	s64 weighted;
+	int i, ret, reading;
+
+	guard(mutex)(&mca->board_temp_lock);
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (!mca->board_channels[i]) {
+			struct iio_channel *channel;
+
+			channel = devm_iio_channel_get(mca->dev, names[i]);
+			if (IS_ERR(channel))
+				return PTR_ERR(channel);
+			mca->board_channels[i] = channel;
+		}
+	}
+	psy = power_supply_get_by_name("battery");
+	if (!psy)
+		return -ENODEV;
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_TEMP, &battery_temp);
+	power_supply_put(psy);
+	if (ret)
+		return ret;
+	weighted = (s64)battery_temp.intval * 100 * 500;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		ret = iio_read_channel_processed(mca->board_channels[i], &reading);
+		if (ret < 0)
+			return ret;
+		if (reading < -40000 || reading > 125000)
+			return -ERANGE;
+		weighted += (s64)reading * weights[i];
+	}
+	*temp = div_s64(weighted, 1000) + 1600;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops piano_mca_board_thermal_ops = {
+	.get_temp = piano_mca_board_temperature,
+};
