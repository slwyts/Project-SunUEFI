 			le32_to_cpu(resp->property), len);
-		mod_delayed_work(system_percpu_wq, &mca->poll, 0);
+		mod_delayed_work(system_freezable_wq, &mca->poll, 0);
 		return;
 	}
 
@@ -609,7 +613,7 @@ static void piano_mca_pdr_notify(void *priv, int state)
 	mca->mipps_attempted = false;
 	mca->hv = MCA_HV_OFF;
 	mca->hv_renegs = 0;
-	mod_delayed_work(system_percpu_wq, &mca->poll, 0);
+	mod_delayed_work(system_freezable_wq, &mca->poll, 0);
 }
 
 /* pmic_glink calls back under its client spinlock: requests go from a work */
@@ -1774,10 +1778,10 @@ static void piano_mca_apply_policy(struct piano_mca *mca)
 static char *piano_mca_supplied_to[] = { "bq27z561-0", "bq27z561-1" };
 
 /*
- * Both fuel gauges: the higher cell voltage (mV) and temperature (degC) and
- * the sum of the currents (mA, positive while charging)
+ * Both fuel gauges: the higher cell voltage (mV), the sum of the currents
+ * (mA, positive while charging), and both temperature extremes (degC).
  */
-static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tbat)
+static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tcool, int *twarm)
 {
 	union power_supply_propval v, i, t;
 	struct power_supply *psy;
@@ -1785,7 +1789,8 @@ static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tbat)
 
 	*vbat_mv = 0;
 	*ibat_ma = 0;
-	*tbat = INT_MIN;
+	*tcool = INT_MAX;
+	*twarm = INT_MIN;
 	for (n = 0; n < ARRAY_SIZE(piano_mca_supplied_to); n++) {
 		psy = power_supply_get_by_name(piano_mca_supplied_to[n]);
 		if (!psy)
@@ -1798,7 +1803,8 @@ static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tbat)
 			return ret;
 		*vbat_mv = max(*vbat_mv, v.intval / 1000);
 		*ibat_ma += i.intval / 1000;
-		*tbat = max(*tbat, t.intval / 10);
+		*tcool = min(*tcool, t.intval / 10);
+		*twarm = max(*twarm, t.intval / 10);
 	}
 
 	return 0;
@@ -1806,7 +1812,14 @@ static int piano_mca_gauges(int *vbat_mv, int *ibat_ma, int *tbat)
 
 static bool piano_mca_cp_active(struct piano_mca *mca)
 {
-	return mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON;
+	return mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON ||
+	       mca->cp == MCA_CP_STOPPING;
+}
+
+static bool piano_mca_cp_session_valid(struct piano_mca *mca)
+{
+	return piano_mca_session_valid(mca, mca->cp_generation,
+				       mca->cp_connection_generation);
 }
 
 static int piano_mca_cp_get(struct piano_mca *mca,
@@ -1825,9 +1838,17 @@ static int piano_mca_cp_get(struct piano_mca *mca,
 static int piano_mca_cp_set_online(struct piano_mca *mca, bool on)
 {
 	union power_supply_propval pv = { .intval = on };
+	int ret;
 
-	return power_supply_set_property(mca->cp_psy, POWER_SUPPLY_PROP_ONLINE,
-					 &pv);
+	if (on && !piano_mca_cp_session_valid(mca))
+		return -ECONNRESET;
+	ret = power_supply_set_property(mca->cp_psy, POWER_SUPPLY_PROP_ONLINE,
+					&pv);
+	/* A connection can change during the I2C transaction. The caller stops. */
+	if (!ret && on && !piano_mca_cp_session_valid(mca))
+		return -ECONNRESET;
+
+	return ret;
