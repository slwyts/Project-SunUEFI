+	int ret;
+
+	if (!piano_mca_cp_session_valid(mca))
+		return -ECONNRESET;
 	mv = clamp(rounddown(mv, 20), (u32)MCA_CP_PPS_MIN_MV,
 		   min_t(u32, mca->cp_max_mv, MCA_CP_PPS_MAX_MV));
 	if (mv == mca->cp_mv)
 		return 0;
 
-	mca->cp_mv = mv;
-	return piano_mca_write_u32(mca, MCA_PROP_PPS_SELECT,
-				   piano_mca_pps_word(mv, mca->cp_ma));
+	ret = piano_mca_write_u32_session(mca, MCA_PROP_PPS_SELECT,
+					  piano_mca_pps_word(mv, mca->cp_ma),
+					  mca->cp_generation,
+					  mca->cp_connection_generation);
