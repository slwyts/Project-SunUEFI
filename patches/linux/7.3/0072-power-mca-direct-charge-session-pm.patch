-					   max(tbat, tpack));
+	ibat_max = piano_mca_cp_ibat_limit(mca, vbat, tcool, twarm);
 	/* a lowered limit is regulated down to before it trips */
 	if (ibat_max >= (int)mca->cp_ibat_trip) {
 		mca->cp_ibat_trip = ibat_max;
