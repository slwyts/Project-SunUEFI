@@ -2068,50 +2122,54 @@ static void piano_mca_cp_try_start(struct piano_mca *mca)
 	ret = piano_mca_cp_set_buck(mca, MCA_CP_BUCK_MA, MCA_CP_BUCK_MA);
 	ret = ret ?: piano_mca_cp_request(mca, start_mv);
 	if (ret) {
