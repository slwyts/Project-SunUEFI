+static int piano_mca_suspend(struct device *dev)
+{
+	struct piano_mca *mca = dev_get_drvdata(dev);
+	bool cp;
+	int ret;
+
+	/* Also prevents GLINK callbacks from requeueing while the stage sleeps. */
+	disable_delayed_work_sync(&mca->poll);
+	cp = piano_mca_cp_active(mca);
+	ret = piano_mca_cp_stop(mca, "suspend");
+	if (ret) {
+		enable_delayed_work(&mca->poll);
+		mod_delayed_work(system_freezable_wq, &mca->poll, 0);
+		return ret;
+	}
+	if (cp)
+		mca->cp = MCA_CP_OFF;
+	return 0;
+}
+
+static int piano_mca_resume(struct device *dev)
+{
+	struct piano_mca *mca = dev_get_drvdata(dev);
+
+	enable_delayed_work(&mca->poll);
+	mod_delayed_work(system_freezable_wq, &mca->poll, 0);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(piano_mca_pm_ops, piano_mca_suspend,
