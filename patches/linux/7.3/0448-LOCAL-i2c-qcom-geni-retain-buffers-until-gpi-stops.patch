+	struct geni_i2c_gpi_multi_desc_xfer *multi = &gi2c->i2c_multi_desc_config;
+
+	for (;;) {
+		scoped_guard(spinlock_irqsave, &gi2c->lock) {
+			if (gi2c->err)
+				return gi2c->err;
+			if (multi->irq_cnt == multi->msg_idx_cnt)
