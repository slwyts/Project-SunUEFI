+			reinit_completion(&gi2c->done);
 		}
+		if (!timeout)
+			break;
+		timeout = wait_for_completion_timeout(&gi2c->done, timeout);
 	}
-	return 0;
+	dev_err(gi2c->se.dev, "GPI multi-message transfer timed out\n");
+	return -ETIMEDOUT;
