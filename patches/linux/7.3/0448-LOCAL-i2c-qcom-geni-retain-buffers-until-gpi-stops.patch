+static void geni_i2c_gpi_unmap(struct geni_i2c_dev *gi2c,
+			       struct geni_i2c_gpi_buffer *buffer, bool read,
+			       struct i2c_msg *msg)
 {
-	if (tx_buf) {
-		dma_unmap_single(gi2c->se.dev->parent, tx_addr, msg->len, DMA_TO_DEVICE);
-		i2c_put_dma_safe_msg_buf(tx_buf, msg, !gi2c->err);
-	}
+	if (!buffer->data)
+		return;
 
-	if (rx_buf) {
