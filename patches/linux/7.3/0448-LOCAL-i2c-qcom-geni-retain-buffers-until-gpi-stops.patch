+	for (i = tx_multi_xfer->unmap_msg_cnt; i < completed; i++)
+		geni_i2c_gpi_unmap(gi2c, &tx_multi_xfer->buffers[i], false, NULL);
+	tx_multi_xfer->unmap_msg_cnt = completed;
+}
 
-	/* Unmap the processed DMA buffers based on the received interrupt count */
-	for (; tx_multi_xfer->unmap_msg_cnt < msg_xfer_cnt; tx_multi_xfer->unmap_msg_cnt++) {
-		wr_idx = tx_multi_xfer->unmap_msg_cnt;
-		geni_i2c_gpi_unmap(gi2c, &msgs[wr_idx],
-				   tx_multi_xfer->dma_buf[wr_idx],
-				   tx_multi_xfer->dma_addr[wr_idx],
-				   NULL, 0);
+static void geni_i2c_gpi_free_buffers(struct geni_i2c_dev *gi2c)
+{
+	struct geni_i2c_gpi_multi_desc_xfer *multi = &gi2c->i2c_multi_desc_config;
 
-		if (tx_multi_xfer->unmap_msg_cnt == gi2c->num_msgs - 1) {
-			kfree(tx_multi_xfer->dma_buf);
-			kfree(tx_multi_xfer->dma_addr);
-			break;
-		}
+	if (multi->buffers) {
+		geni_i2c_gpi_multi_desc_unmap(gi2c, multi->msg_idx_cnt);
+		kfree(multi->buffers);
+		multi->buffers = NULL;
 	}
+	geni_i2c_gpi_unmap(gi2c, &gi2c->gpi_tx, false, NULL);
+	geni_i2c_gpi_unmap(gi2c, &gi2c->gpi_rx, true, NULL);
+}
+
+static int geni_i2c_gpi_terminate(struct geni_i2c_dev *gi2c)
+{
+	int tx_ret, rx_ret;
+
+	tx_ret = dmaengine_terminate_sync(gi2c->tx_c);
+	rx_ret = dmaengine_terminate_sync(gi2c->rx_c);
+	return tx_ret ?: rx_ret;
+}
+
+static int geni_i2c_gpi_recover(struct geni_i2c_dev *gi2c)
+{
+	int ret = geni_i2c_gpi_terminate(gi2c);
+
+	if (ret)
+		return ret;
+
+	geni_i2c_gpi_free_buffers(gi2c);
+	WRITE_ONCE(gi2c->gpi_failed, false);
+	return 0;
 }
 
