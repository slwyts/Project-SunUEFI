+
+&usb {
+	status = "okay";
+};
+
+&usb_dp_qmpphy {
+	vdda-phy-supply = <&vreg_l2d_0p88>;		/* (M), OQ#14 */
+	vdda-pll-supply = <&vreg_l3g_1p2>;		/* (M), OQ#14 */
+
+	status = "okay";
+};
+
+&usb_dp_qmpphy_out {
+	remote-endpoint = <&pmic_glink_ss_in>;
