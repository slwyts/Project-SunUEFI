@@ -0,0 +1,94 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/novatek,nvt-ts-spi.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36532E SPI touchscreen controller
+
+maintainers:
+  - Xiaomi Pad 8 Pro (piano) mainline contributors
+
+description: |
+  Novatek NT36532E "no-flash" touchscreen controller connected over
+  SPI. The controller has no internal flash and downloads its firmware
+  from the host on every power-up; the firmware blob is requested via
+  the firmware-name property. Binding written for the driver ported
+  from the Xiaomi sheng (Pad 6S Pro) tree.
+
+allOf:
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: novatek,NVT-ts-spi
+
+  reg:
+    maxItems: 1
+
+  spi-max-frequency: true
+
+  novatek,irq-gpios:
+    maxItems: 1
+    description: Interrupt GPIO from the touch controller.
+
+  novatek,lcd-id-gpios:
+    maxItems: 1
+    description: |
+      Panel vendor identification input, read once at probe. Its level
+      selects the entry of firmware-name to download (Xiaomi piano:
+      0 = CSOT panel, 1 = BOE panel).
+
+  novatek,spi-rd-fast-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      Register address written to disable SPI fast-read mode during
+      bootloader reset. Optional; fast-read stays enabled when absent.
+
+  firmware-name:
+    $ref: /schemas/types.yaml#/definitions/string-array
+    minItems: 1
+    maxItems: 2
+    description: |
+      Firmware blob(s) downloaded at boot. With two entries the level of
+      novatek,lcd-id-gpios selects one. No firmware is requested when this
+      property is absent.
+
+  pinctrl-0: true
+  pinctrl-1: true
+  pinctrl-names: true
+
+  panel:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: |
+      Phandle to the DRM panel this touch controller follows. When present,
+      the driver registers as a DRM panel follower and defers probe until
+      the panel is prepared. When absent, the panel is assumed to be powered
+      by the bootloader (e.g. continuous splash on a simple framebuffer).
+
+required:
+  - compatible
+  - reg
+  - spi-max-frequency
+  - novatek,irq-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "novatek,NVT-ts-spi";
+            reg = <0>;
+            spi-max-frequency = <19200000>;
+            novatek,irq-gpios = <&tlmm 162 GPIO_ACTIVE_HIGH>;
+            novatek,lcd-id-gpios = <&tlmm 100 GPIO_ACTIVE_HIGH>;
+            firmware-name = "novatek/novatek_nt36532_piano_fw_csot.bin",
+                            "novatek/novatek_nt36532_piano_fw_boe.bin";
+        };
+    };
+...
