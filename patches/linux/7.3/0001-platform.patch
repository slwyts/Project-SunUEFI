+
+description:
+  The FS1958 and the FS19xx family are boosted mono class-D speaker
+  amplifiers with an I2S/TDM input and voltage/current sense output.
+  The board specific register setup, including the TDM slot selection,
+  comes from a preset file made with FourSemi's tuning tool. One preset
+  file holds a block per amplifier, selected by the I2C address.
+
+properties:
+  compatible:
+    const: foursemi,fs19xx
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+  vdd-supply:
+    description: Regulator for the digital supply.
+
+  reset-gpios:
+    maxItems: 1
+    description:
+      The shutdown pin, active low.
+
+  firmware-name:
+    maxItems: 1
+    description:
+      Name of the preset file, "fs19xx.fsm" if absent.
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+allOf:
+  - $ref: dai-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-codec@34 {
+            compatible = "foursemi,fs19xx";
+            reg = <0x34>;
+            #sound-dai-cells = <0>;
+            reset-gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
+            firmware-name = "qcom/sm8750/xiaomi/piano/fs19xx.fsm";
+            sound-name-prefix = "Top Left";
+        };
+    };
