diff --git a/.github/workflows/piano-dtb.yml b/.github/workflows/piano-dtb.yml
new file mode 100644
index 00000000000..d2f092d8fb4
--- /dev/null
+++ b/.github/workflows/piano-dtb.yml
@@ -0,0 +1,58 @@
+name: piano-dtb
+
+on:
+  pull_request:
+  push:
+    branches: ['piano-*']
+
+permissions:
+  contents: read
+
+jobs:
+  piano-dtb:
+    name: piano-dtb
+    runs-on: ubuntu-24.04-arm
+    steps:
+      - uses: actions/checkout@v5
+
+      - name: Install toolchain
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+              ccache \
+              clang lld llvm bc flex bison libssl-dev libelf-dev cpio \
+              dwarves device-tree-compiler
+
+      # Rolling compiler cache: every run saves a fresh entry (run_id key),
+      # restore falls back to the most recent one. First run is cold.
+      - name: Restore ccache
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/ccache
+          key: ccache-${{ runner.arch }}-${{ github.run_id }}
+          restore-keys: ccache-${{ runner.arch }}-
+
+      - name: Build piano_defconfig, Image and dtbs
+        env:
+          # Runner image clang updates must invalidate, not mis-hit
+          CCACHE_COMPILERCHECK: content
+        run: |
+          ccache --zero-stats
+          make ARCH=arm64 LLVM=1 CC="ccache clang" O=out piano_defconfig
+          make ARCH=arm64 LLVM=1 CC="ccache clang" O=out -j"$(nproc)" Image dtbs
+          ccache --show-stats
+
+      - name: Verify piano artifacts
+        run: |
+          test -s out/arch/arm64/boot/Image
+          test -s out/arch/arm64/boot/dts/qcom/sm8750-xiaomi-piano.dtb
+
+      - name: Upload artifacts
+        uses: actions/upload-artifact@v4
+        with:
+          name: piano-build
+          path: |
+            out/arch/arm64/boot/Image
+            out/arch/arm64/boot/dts/qcom/sm8750-xiaomi-piano.dtb
+          retention-days: 7
+          if-no-files-found: error
diff --git a/Documentation/ABI/testing/procfs-nvt-thp-control b/Documentation/ABI/testing/procfs-nvt-thp-control
new file mode 100644
index 00000000000..84487392392
--- /dev/null
+++ b/Documentation/ABI/testing/procfs-nvt-thp-control
@@ -0,0 +1,63 @@
+What:           /proc/nvt_thp_controller_state
+Date:           October 2026
+Description:
+                Explicitly query the NT36532 THP firmware host mailbox. Reading
+                this file sends the vendor getter commands, temporarily pauses
+                the IRQ thread, and returns game_mode (0x0f), scan_freq_no
+                (0x08), scan_freq (0x09), hand_scan_rate (0x0a), pen_scan_rate
+                (0x0b), firmware identity and the validated game/rollback cache.
+
+                A failed query returns its errno without presenting initialized
+                zero values as controller state. Before a successful firmware
+                download/info read, or during suspend, reads return EAGAIN.
+                The frequency-selection number has no documented Hz mapping.
+                No scan-rate setter or 360-Hz command is exposed here.
+
+                /proc/nvt_thp_status remains passive: reading its frame, IRQ and
+                error counters never sends a firmware command.
+
+What:           /proc/nvt_thp_game_mode
+Date:           October 2026
+Description:
+                Reading queries the controller's game_mode and reports whether
+                a requested mode and a rollback baseline are known. Values for
+                unknown cached states are omitted.
+
+                Writing the integer 0 or 1 selects the vendor game-mode setting.
+                The driver reads the old mode, sends the setting, and reads it
+                back. A successful write requires the returned mode to match.
+                A timeout, SPI error or mismatching readback returns an errno
+                and attempts to restore and verify the mode read before writing.
+                An unconfirmed recovery invalidates the cached requested mode
+                and rollback baseline.
+
+                The first successful write saves the verified prior mode.
+                Further writes, including idempotent writes, retain that
+                baseline until explicit rollback succeeds. Firmware reloading
+                restores a requested mode only if a prior write was confirmed
+                for the same downloaded firmware CRC32, reported version and
+                project ID. With no validated request, no game-mode command is
+                automatically sent. Firmware identity mismatch forgets both
+                cached states. An untracked 0x0f write through nvt_thp_cmd also
+                invalidates both states.
+
+                Command acknowledgement and game-mode readback do not prove a
+                particular scan, raw-frame or coordinate-report frequency.
+
+What:           /proc/nvt_thp_game_rollback
+Date:           October 2026
+Description:
+                Writing the integer 1 restores and verifies the saved baseline
+                for the current firmware, then consumes the rollback snapshot.
+                It returns ENODATA if no matching snapshot exists. Other input
+                values return EINVAL. A failed rollback retains the snapshot
+                only if recovery to the immediate pre-write mode was confirmed.
+
+                These interfaces use the Piano p81/NT36532 extended command ABI
+                from MiCode/vendor_xiaomi_proprietary_touch-driver, piano-w-oss,
+                p81/nt36532/nt36xxx_ext_proc.c. The ABI was also checked against
+                the captured stock nt36532_touch.ko. Root-only proc permissions
+                restrict explicit controller operations.
+
+                Host verification without hardware:
+                python3 drivers/input/touchscreen/nt36532e/test_thp_control.py
diff --git a/Documentation/ABI/testing/sysfs-devices-piano-dma-route b/Documentation/ABI/testing/sysfs-devices-piano-dma-route
new file mode 100644
index 00000000000..bbe9261da74
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-devices-piano-dma-route
@@ -0,0 +1,46 @@
+What:           /sys/devices/.../piano_dma_route
+Date:           October 2026
+Contact:        Linux IOMMU developers <iommu@lists.linux.dev>
+Description:
+                Read-only diagnostic for an actual ARM SMMU configured master
+                attached to the driver's identity domain. Returns EAGAIN when
+                not attached and an error for changed/faulted hardware.
+
+                The first line is "piano-dma-route-v1 domain=identity ids=N".
+                Subsequent lines contain sid, mask, slot, origin, actual smr,
+                actual s2cr, kernel-private expected hardware encoding, cb,
+                sctlr, cbar and fsr. Origin is firmware-adopted or
+                kernel-installed, preserving that ownership distinction.
+                QCOM's emulated bypass bank is compared using its real
+                hardware encoding. Hardware is read twice under stream-map
+                serialization; faults are observed, never cleared.
+
+                This snapshot is not a DMA completion, boot-ready flag,
+                external firmware lease or memory ownership authorization.
+                It does not allocate or program routes. Runtime PM uses
+                the driver's normal resource APIs while reading registers.
+
+What:           /sys/devices/.../piano_dma_context
+Date:           October 2026
+Contact:        Linux IOMMU developers <iommu@lists.linux.dev>
+Description:
+                Admin-only readback of an actually attached ARM64 stage1 DMA
+                or unmanaged domain. Group serialization pins the attached
+                domain, and the driver's init/stream locks protect private
+                state. The getter compares actual SMR/S2CR, TTBR0/TTBR1,
+                TCR/TCR2 and MAIR with that owning domain's programmed state.
+                It rejects firmware-adopted routes, invalid table roots,
+                disabled translation, faults, mismatches and changes across
+                repeated hardware/private-state reads. No register is written
+                by the getter; normal runtime PM may power the bound provider.
+
+                The first line is
+                "piano-dma-context-v1 domain=stage1 ids=N", followed by at most
+                eight stream records. The prior identity route fields remain,
+                with ttbr0/ttbr1 (16 hexadecimal digits) and tcr/tcr2/mair0/mair1
+                (eight hexadecimal digits). All records belong to one context.
+                Context fields are diagnostics, not CPU read permission,
+                a successful device transfer or global hardware readiness.
+
+                The identity getter also uses group serialization so a domain
+                cannot be detached/freed during either readback callback.
