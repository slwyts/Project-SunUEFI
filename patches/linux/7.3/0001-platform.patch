diff --git a/arch/arm64/boot/dts/qcom/sm8750-xiaomi-piano.dts b/arch/arm64/boot/dts/qcom/sm8750-xiaomi-piano.dts
new file mode 100644
index 00000000000..9312b3e3cf0
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8750-xiaomi-piano.dts
@@ -0,0 +1,1433 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026, Xiaomi Pad 8 Pro (piano) mainline contributors
+ *
+ * Xiaomi Pad 8 Pro (codename "piano") bring-up skeleton, structured after
+ * the in-tree SM8750 MTP board device tree.
+ *
+ * v0 scope: first-boot links only — UART7 console, UFS storage, USB DWC3
+ * with the eUSB2/QMP PHY stack and the pmic-glink-managed USB-C connector.
+ * Display/DSI, audio, WLAN/BT, PCIe, SD, LEDs, touch, keyboard, sensors,
+ * GPU and all remoteproc firmware users are intentionally not enabled
+ * until they are validated on real hardware.
+ *
+ * Value provenance markers:
+ *   (M) value carried over from the in-tree SM8750 MTP board file
+ *   (R) value cross-checked against the Xiaomi downstream kernel
+ *       (refer/MiCode_piano/kernel_devicetree)
+ * Open questions refer to docs/hardware-facts.md in the umbrella repo.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include "sm8750.dtsi"
+#include "pm8010.dtsi"
+#include "pm8550.dtsi"
+#define PMK8550VE_SID 8
+#include "pm8550ve.dtsi"
+#include "pmd8028.dtsi"
+#include "pmih0108.dtsi"
+#include "pmk8550.dtsi"
+#include "pmr735d_a.dtsi"
+#include "sm8750-pmics.dtsi"
+
+/ {
+	model = "Xiaomi Pad 8 Pro";
+	compatible = "xiaomi,piano", "qcom,sm8750";
+	chassis-type = "tablet";
+
+	/*
+	 * (R) Qualcomm ABL matches these properties against the hardware.
+	 * Stock Android reports soc_id=639 (SUNP), revision=2.0 and dtb_idx=4;
+	 * use the IDs from the selected stock vendor_boot DTB, not index 0.
+	 */
+	qcom,msm-id = <0x100027f 0x20000>;
+	qcom,board-id = <0x00 0x00>;
+
+	aliases {
+		serial0 = &uart7;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	clocks {
+		xo_board: xo-board {
+			compatible = "fixed-clock";
+			clock-frequency = <76800000>;		/* (M) */
+			#clock-cells = <0>;
+		};
+
+		sleep_clk: sleep-clk {
+			compatible = "fixed-clock";
+			clock-frequency = <32000>;		/* (M) */
+			#clock-cells = <0>;
+		};
+
+		bi_tcxo_div2: bi-tcxo-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+
+		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
+			compatible = "fixed-factor-clock";
+			#clock-cells = <0>;
+
+			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
+			clock-mult = <1>;
+			clock-div = <2>;
+		};
+	};
+
+	pmic-glink {
+		compatible = "qcom,sm8750-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;	/* (M), OQ#11 */
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_dp_qmpphy_out>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&wcd_usbss_sbu_mux>;
+					};
+				};
+			};
+		};
+	};
+
+	/*
+	 * WCD9395 headset codec. Reset pin and supplies match stock vbdtb
+	 * (tlmm 101 wcd939x_reset_active; L15B/BOB1/L2I rails, dtbo
+	 * fragment@110). Headset audio exits via the USB-C mux above.
+	 * (R)
+	 */
+	wcd939x: audio-codec {
+		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
+
+		pinctrl-0 = <&wcd_default>;
+		pinctrl-names = "default";
+
+		qcom,micbias1-microvolt = <1800000>;
+		qcom,micbias2-microvolt = <1800000>;
+		qcom,micbias3-microvolt = <1800000>;
+		qcom,micbias4-microvolt = <1800000>;
+		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
+		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
+		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
+		qcom,rx-device = <&wcd_rx>;
+		qcom,tx-device = <&wcd_tx>;
+
+		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;		/* (R) */
+
+		vdd-buck-supply = <&vreg_l15b_1p8>;			/* (R) */
+		vdd-rxtx-supply = <&vreg_l15b_1p8>;			/* (R) */
+		vdd-io-supply = <&vreg_l15b_1p8>;			/* (R) */
+		vdd-mic-bias-supply = <&vreg_bob1>;			/* (R) */
+		vdd-px-supply = <&vreg_l2i_1p2>;			/* (R) */
+
+		#sound-dai-cells = <1>;
+
+		mode-switch;
+		orientation-switch;
+
+		port {
+			wcd_codec_headset_in: endpoint {
+				remote-endpoint = <&wcd_usbss_headset_out>;
+			};
+		};
+	};
+
+	/*
+	 * Audioreach sound card, MTP link set with the quad-speaker
+	 * pattern from x1e80100-yoga-slim7x (both WSA buses on one
+	 * wsa-dai-link). Speaker amps: stock dtbo instantiates WSA884x
+	 * candidates on swr0/swr3 (wsa884x@02170220/21, with WSA883x
+	 * fallback variants); WSA884x chosen as primary guess, OQ#21.
+	 */
+	sound {
+		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
+		model = "Xiaomi Pad 8 Pro";
+
+		audio-routing = "SpkrFL IN", "WSA WSA_SPK1 OUT",
+				"SpkrFR IN", "WSA WSA_SPK2 OUT",
+				"SpkrRL IN", "WSA2 WSA_SPK1 OUT",
+				"SpkrRR IN", "WSA2 WSA_SPK2 OUT",
+				"IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC2", "MIC BIAS2",
+				"VA DMIC0", "MIC BIAS3",
+				"VA DMIC1", "MIC BIAS3",
+				"VA DMIC2", "MIC BIAS1",
+				"VA DMIC3", "MIC BIAS1",
+				"VA DMIC0", "VA MIC BIAS3",
+				"VA DMIC1", "VA MIC BIAS3",
+				"VA DMIC2", "VA MIC BIAS1",
+				"VA DMIC3", "VA MIC BIAS1",
+				"TX SWR_INPUT1", "ADC2_OUTPUT";
+
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			codec {
+				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			codec {
+				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wsa-dai-link {
+			link-name = "WSA Playback";
+
+			codec {
+				sound-dai = <&spkr_fl>, <&spkr_fr>,
+					    <&swr0 0>, <&lpass_wsamacro 0>,
+					    <&spkr_rl>, <&spkr_rr>,
+					    <&swr3 0>, <&lpass_wsa2macro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai WSA_CODEC_DMA_RX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		va-dai-link {
+			link-name = "VA Capture";
+
+			codec {
+				sound-dai = <&lpass_vamacro 0>;
+			};
+
+			cpu {
+				sound-dai = <&q6apmbedai VA_CODEC_DMA_TX_0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;		/* (M) */
+		regulator-max-microvolt = <3700000>;		/* (M) */
+
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * AMOLED panel module power (ELVDD/ELVSS ~5.8 V, enabled by TLMM GPIOs
+	 * driving the panel's dedicated supply ICs). Downstream: dtbo entry 0,
+	 * display_gpio_regulator_vsp/vsn (tlmm 117/118, boot-on). (R)
+	 *
+	 * always-on is an experimental first-light measure: the upstream NT37801
+	 * driver manages vddio/vci/vdd only, so nothing else would hold these
+	 * rails up. OQ#16: teach the panel chain to gate them properly.
+	 */
+	display_panel_vsp: regulator-vsp {
+		compatible = "regulator-fixed";
+
+		regulator-name = "display_panel_vsp";
+		regulator-min-microvolt = <5800000>;		/* (R) */
+		regulator-max-microvolt = <5800000>;		/* (R) */
+
+		gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;	/* (R) */
+		enable-active-high;
+
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	display_panel_vsn: regulator-vsn {
+		compatible = "regulator-fixed";
+
+		regulator-name = "display_panel_vsn";
+		regulator-min-microvolt = <5800000>;		/* (R) */
+		regulator-max-microvolt = <5800000>;		/* (R) */
+
+		gpios = <&tlmm 118 GPIO_ACTIVE_HIGH>;	/* (R) */
+		enable-active-high;
+
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	/*
+	 * WLAN/BT combo power sequencing: Qualcomm "peach" — the WCN7850
+	 * family compute SKU used on piano (downstream: qcom,cnss-peach with
+	 * PCI function 17cb:110e, dtbo fragment@80; stock firmware dirs
+	 * wlan/qca_cld/{peach,peach_v2} and non-hlos/image/peach/bdwlan.*).
+	 * Rail assignment and GPIO numbers match the in-tree SM8750 MTP
+	 * reference platform and the stock dtbo. (M)/(R), OQ#20
+	 */
+	wcn7850-pmu {
+		compatible = "qcom,wcn7850-pmu";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en>, <&bt_default>;
+
+		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;
+
+		vdd-supply = <&vreg_s5f_0p85>;
+		vddio-supply = <&vreg_l3f_1p8>;
+		vddio1p2-supply = <&vreg_l2f_1p2>;
+		vddaon-supply = <&vreg_s4d_0p85>;
+		vdddig-supply = <&vreg_s5f_0p85>;
+		vddrfa1p2-supply = <&vreg_s7i_1p2>;
+		vddrfa1p8-supply = <&vreg_s3g_1p8>;
+
+		clocks = <&rpmhcc RPMH_RF_CLK1>;
+
+		regulators {
+			vreg_pmu_rfa_cmn: ldo0 {
+				regulator-name = "vreg_pmu_rfa_cmn";
+			};
+
+			vreg_pmu_aon_0p59: ldo1 {
+				regulator-name = "vreg_pmu_aon_0p59";
+			};
+
+			vreg_pmu_wlcx_0p8: ldo2 {
+				regulator-name = "vreg_pmu_wlcx_0p8";
+			};
+
+			vreg_pmu_wlmx_0p85: ldo3 {
+				regulator-name = "vreg_pmu_wlmx_0p85";
+			};
+
+			vreg_pmu_btcmx_0p85: ldo4 {
+				regulator-name = "vreg_pmu_btcmx_0p85";
+			};
+
+			vreg_pmu_rfa_0p8: ldo5 {
+				regulator-name = "vreg_pmu_rfa_0p8";
+			};
+
+			vreg_pmu_rfa_1p2: ldo6 {
+				regulator-name = "vreg_pmu_rfa_1p2";
+			};
+
+			vreg_pmu_rfa_1p8: ldo7 {
+				regulator-name = "vreg_pmu_rfa_1p8";
+			};
+
+			vreg_pmu_pcie_0p9: ldo8 {
+				regulator-name = "vreg_pmu_pcie_0p9";
+			};
+
+			vreg_pmu_pcie_1p8: ldo9 {
+				regulator-name = "vreg_pmu_pcie_1p8";
+			};
+		};
+	};
+};
+
+/*
+ * Piano hardware omits the second PM8010 die (downstream comment:
+ * "Remove PM8010 N for hardware design", refer/MiCode_piano
+ * kernel_devicetree/qcom/piano-sm8750.dtsi). (R)
+ */
+&pm8010_n {
+	status = "disabled";
+};
+
+/ {
+	thermal-zones {
+		/delete-node/ pm8010-n-thermal;
+	};
+};
+
