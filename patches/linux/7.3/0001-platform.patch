+static int pwrseq_qcom_wcn_adjust_voltage(u32 voltage, u32 ir_drop,
+					  u32 *adjusted)
+{
+	u32 rounded;
+
+	if (check_add_overflow(voltage, 3U, &rounded))
+		return -ERANGE;
+
+	rounded &= ~3U;
+	if (rounded < 16U)
+		return -ERANGE;
+
+	if (check_add_overflow(rounded - 16U, ir_drop, adjusted))
+		return -ERANGE;
+
+	return 0;
+}
