+
+&i2c3 {
+	status = "okay";
+
+	/*
+	 * WCD9395 USBSS SBU/orientation switch for the USB-C connector.
+	 * Presence on piano confirmed downstream (sun.dtsi wcd939x_i2c@e,
+	 * referenced by &usb0 qcom,wcd_usbss). (R)
+	 */
+	wcd_usbss: typec-mux@e {
+		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
+		reg = <0xe>;				/* (R) */
+
+		vdd-supply = <&vreg_l15b_1p8>;		/* (M) */
+		reset-gpios = <&tlmm 152 GPIO_ACTIVE_HIGH>;	/* (M), OQ#11 */
+
+		mode-switch;
+		orientation-switch;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
