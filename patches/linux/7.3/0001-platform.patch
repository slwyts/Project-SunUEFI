--- /dev/null
+++ b/arch/arm64/configs/piano_rootfs.config
@@ -0,0 +1,52 @@
+# GNOME/userdata bring-up profile, merged after piano_defconfig.
+# ABL appends stock ramdisks: /pianoinit must not collide with Android /init.
+CONFIG_LOCALVERSION="-piano-gnome"
+# iommu.passthrough=1: the MDSS keeps its bootloader stream route (identity)
+# until msm attaches its own domain; a DMA domain would fault the splash.
+CONFIG_CMDLINE="console=tty0 loglevel=6 consoleblank=0 fbcon=font:TER16x32 rdinit=/pianoinit root=PARTLABEL=userdata rootfstype=ext4 rootwait ro pd_ignore_unused clk_ignore_unused panic=0 iommu.passthrough=1"
+CONFIG_CMDLINE_FORCE=y
+# simpledrm keeps the bootloader framebuffer until piano-display loads the
+# native display/GPU stack. msm and the SMMU driver are modules so that the
+# apps SMMU is only taken over after /pianoinit has installed every stream
+# match the running masters need (the driver adopts valid matches as bypass).
+CONFIG_DRM_MSM=m
+CONFIG_ARM_SMMU=m
+CONFIG_QCOM_Q6V5_PAS=m
