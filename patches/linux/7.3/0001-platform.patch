diff --git a/tools/testing/selftests/iommu/qcom-handoff-snapshot.c b/tools/testing/selftests/iommu/qcom-handoff-snapshot.c
new file mode 100644
index 00000000000..80ee8421bf5
--- /dev/null
+++ b/tools/testing/selftests/iommu/qcom-handoff-snapshot.c
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* cc -Wall -Wextra -Werror -fsanitize=address,undefined qcom-handoff-snapshot.c */
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+#include "../../../../drivers/iommu/arm/arm-smmu/arm-smmu-qcom-handoff.h"
+
+static struct qcom_smmu_handoff_snapshot s;
+
+int main(void)
+{
+	unsigned int i;
+	struct piano_smmu_context_snapshot owned = {
+		.ttbr = { 0x00070000bd980000ULL, 0x0007000000000000ULL },
+		.tcr = { 1U << 23, 0x70014 }, .mair = { 0xff44, 0 },
+		.sctlr = 0x1007, .cba2r = 1,
+	};
+	struct piano_smmu_context_snapshot hw = owned;
+
+	hw.sctlr = 0x1007;
+	hw.cbar = 1U << 16;
+	hw.fsr = 0x400; /* FORMAT is not a fault. */
+	assert(piano_smmu_stage1_equal(&hw, &owned));
+	assert(!piano_smmu_stage1_equal(NULL, &owned));
+	for (i = 1; i <= 8; i <<= 1) {
+		hw.fsr = i << 1;
+		assert(!piano_smmu_stage1_equal(&hw, &owned));
+	}
+	hw.fsr = 0x400;
+	hw.ttbr[0] ^= 0x1000;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.ttbr[0] = owned.ttbr[0];
+	hw.tcr[1] ^= 1;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.tcr[1] = owned.tcr[1];
+	hw.mair[0] ^= 1;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.mair[0] = owned.mair[0];
+	hw.sctlr = 0;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.sctlr = 0x1007;
+	hw.cba2r = 0;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.cba2r = 1;
+	hw.sctlr |= 0x10; /* Wrong endian despite a matching table root. */
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.sctlr = 0x1007;
+	hw.cbar = 0;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	hw.cbar = 1U << 16;
+	/* Reject enabled table with only an ASID, or both walks disabled. */
+	owned.ttbr[0] = hw.ttbr[0] = 0x0007000000000000ULL;
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	owned.tcr[0] = hw.tcr[0] = (1U << 23) | (1U << 7);
+	assert(!piano_smmu_stage1_equal(&hw, &owned));
+	/* GPU TTBR1-only configuration is a real stage1 domain too. */
+	owned.tcr[0] = hw.tcr[0] = 1U << 7;
+	owned.ttbr[1] = hw.ttbr[1] = 0x00070000bd982000ULL;
+	assert(piano_smmu_stage1_equal(&hw, &owned));
+
+	s.num_smr = 4;
+	s.num_cb = 4;
+	s.num_s2_cb = 1;
+	assert(qcom_smmu_handoff_geometry(&s));
+	assert(qcom_smmu_handoff_probe_slot(&s) == 0);
+	assert(qcom_smmu_handoff_bypass_cb(&s) == 3);
+	assert(qcom_smmu_handoff_route_equal(0x80000040, 0x80000040,
+					    3, 3, 0xffffffff, 0x030300ff));
+	assert(!qcom_smmu_handoff_route_equal(0x40, 0x80000040,
+					     3, 3, 0xffffffff, 0x030300ff));
+	assert(!qcom_smmu_handoff_route_equal(0x80000040, 0x80000040,
+					     0x01000003, 3, 0xffffffff, 0x030300ff));
+	/* Last bank is live even with M=0: reference alone reserves it. */
+	s.smr[3] = QCOM_HANDOFF_SMR_VALID | 0x800;
+	s.s2cr[3] = 3;
+	assert(qcom_smmu_handoff_cb_referenced(&s, 3));
+	assert(qcom_smmu_handoff_bypass_cb(&s) == 2);
+	/* Enabled but unreferenced firmware context must not be reclaimed. */
+	s.sctlr[2] = QCOM_HANDOFF_SCTLR_M;
+	assert(qcom_smmu_handoff_bypass_cb(&s) == 1);
+	s.sctlr[1] = QCOM_HANDOFF_SCTLR_M;
+	assert(qcom_smmu_handoff_bypass_cb(&s) == -1);
+	/* Stage-2-only CB0 is not an alternative when all stage1 banks are busy. */
+	assert(s.sctlr[0] == 0);
+	for (i = 0; i < s.num_smr; ++i)
+		s.smr[i] = QCOM_HANDOFF_SMR_VALID | i;
+	assert(qcom_smmu_handoff_probe_slot(&s) == -1);
+	/* Empty row keeps the live last row intact; no fixed last-slot policy. */
+	s.smr[1] = 0;
+	assert(qcom_smmu_handoff_probe_slot(&s) == 1);
+	s.num_smr = 129;
+	assert(!qcom_smmu_handoff_geometry(&s));
+	assert(qcom_smmu_handoff_probe_slot(&s) == -1);
+	s.num_smr = 4;
+	s.num_cb = 257;
+	assert(!qcom_smmu_handoff_geometry(&s));
+	s.num_cb = 4;
+	s.num_s2_cb = 5;
+	assert(!qcom_smmu_handoff_geometry(&s));
+	s.num_s2_cb = 1;
+	/* FAULT/BYPASS type fields do not name a translating context bank. */
+	s.s2cr[3] = (1U << 16) | 3;
+	assert(!qcom_smmu_handoff_cb_referenced(&s, 3));
+	s.sctlr[3] = 0;
+	assert(qcom_smmu_handoff_bypass_cb(&s) == 3);
+	puts("qcom SMMU handoff and real stage1 register comparator assertions passed.");
+	return 0;
+}
