From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 22:04:44 +0800
Subject: [PATCH] HID: xiaomi: expose Focus Pen pressure through evdev

Validate the private Report 5 layout and report only its first little-endian word as ABS_PRESSURE, with separate M80p and P81c ranges. Preserve hidraw and independent keyboard and mouse applications. Do not advertise coordinates, proximity, touch, tilt or tool buttons on the pressure-only device.

Signed-off-by: slwyts <slwyts@foxmail.com>
---
 drivers/hid/Kconfig      |   7 +-
 drivers/hid/hid-xiaomi.c | 169 ++++++++++++++++++++++++++++++++-------
 2 files changed, 145 insertions(+), 31 deletions(-)

diff --git a/drivers/hid/Kconfig b/drivers/hid/Kconfig
index 2481ae88e..69cb1ae74 100644
--- a/drivers/hid/Kconfig
+++ b/drivers/hid/Kconfig
@@ -566,9 +566,10 @@ config HID_XIAOMI
 	tristate "Xiaomi"
 	help
 	  Adds support for side buttons of Xiaomi Mi Dual Mode Wireless
-	  Mouse Silent Edition, prevents private Focus Pen Pro pressure
-	  reports from being interpreted as keyboard plus keys, and reports
-	  Focus Pen Pro body slides as Page Up and Page Down.
+	  Mouse Silent Edition, reports Focus Pen and Focus Pen Pro pressure
+	  through evdev instead of keyboard plus keys, and maps Focus Pen Pro
+	  body slides to Page Up and Page Down. Pen coordinates are supplied
+	  separately by the touchscreen controller.
 
 config HID_GYRATION
 	tristate "Gyration remote control"
diff --git a/drivers/hid/hid-xiaomi.c b/drivers/hid/hid-xiaomi.c
index d7f096740..48c0c927b 100644
--- a/drivers/hid/hid-xiaomi.c
+++ b/drivers/hid/hid-xiaomi.c
@@ -8,6 +8,9 @@
 #include <linux/init.h>
 #include <linux/module.h>
 #include <linux/hid.h>
+#include <linux/input.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
 
 #include "hid-ids.h"
 
@@ -88,23 +91,60 @@ static bool xiaomi_p81c_body_keys(struct hid_report *report,
 	       field->logical_maximum == 0x6e && field->flags == 0;
 }
 
-/* Focus Pens expose their private 14-byte pressure packet as keyboard Usage 0x57.
- * Keep that packet available to hidraw; it must never become KEY_KPPLUS.
- * Match the parsed layout, rather than replacing a firmware report map.
- * Report 2's real squeeze button is consumed by the tablet-tool owner.
+struct xiaomi_pen {
+	struct hid_device *hdev;
+	struct input_dev *pressure;
+	unsigned int pressure_max;
+};
+
+static bool xiaomi_is_pen(struct hid_device *hdev)
+{
+	return hdev->bus == BUS_BLUETOOTH &&
+	       hdev->vendor == BT_VENDOR_ID_XIAOMI_P81C &&
+	       (hdev->product == BT_DEVICE_ID_XIAOMI_P81C ||
+		hdev->product == BT_DEVICE_ID_XIAOMI_M80P);
+}
+
+static bool xiaomi_pen_pressure_report(struct hid_report *report)
+{
+	struct hid_field *first, *second;
+	unsigned int i;
+
+	if (report->type != HID_INPUT_REPORT || report->id != 5 ||
+	    report->size != 112 || report->maxfield != 2)
+		return false;
+
+	first = report->field[0];
+	second = report->field[1];
+	if (first->report_offset != 0 || first->report_size != 16 ||
+	    first->report_count != 4 || first->logical_minimum != 0 ||
+	    first->logical_maximum != 16384 || first->maxusage != 4 ||
+	    second->report_offset != 64 || second->report_size != 8 ||
+	    second->report_count != 6 || second->logical_minimum != 0 ||
+	    second->logical_maximum != 255 || second->maxusage != 6 ||
+	    first->flags != (HID_MAIN_ITEM_VARIABLE | HID_MAIN_ITEM_RELATIVE) ||
+	    second->flags != (HID_MAIN_ITEM_VARIABLE | HID_MAIN_ITEM_RELATIVE))
+		return false;
+
+	for (i = 0; i < first->maxusage; i++)
+		if (first->usage[i].hid != (HID_UP_KEYBOARD | 0x57))
+			return false;
+	for (i = 0; i < second->maxusage; i++)
+		if (second->usage[i].hid != (HID_UP_KEYBOARD | 0x57))
+			return false;
+	return true;
+}
+
+/* Report 5 describes private data as relative keyboard Usage 0x57. Only its
+ * first word is a known pressure sample; none of it is a KEY_KPPLUS event.
  */
 static int xiaomi_input_mapping(struct hid_device *hdev, struct hid_input *hi,
 			       struct hid_field *field, struct hid_usage *usage,
 			       unsigned long **bit, int *max)
 {
 	struct hid_report *report = field->report;
-	struct hid_field *first, *second;
 
-	if (hdev->bus != BUS_BLUETOOTH ||
-	    hdev->vendor != BT_VENDOR_ID_XIAOMI_P81C ||
-	    (hdev->product != BT_DEVICE_ID_XIAOMI_P81C &&
-	     hdev->product != BT_DEVICE_ID_XIAOMI_M80P) ||
-	    report->type != HID_INPUT_REPORT)
+	if (!xiaomi_is_pen(hdev) || report->type != HID_INPUT_REPORT)
 		return 0;
 
 	if (hdev->product == BT_DEVICE_ID_XIAOMI_M80P &&
@@ -136,42 +176,114 @@ static int xiaomi_input_mapping(struct hid_device *hdev, struct hid_input *hi,
 		}
 	}
 
-	if (report->id != 5 ||
-	    report->size != 112 || report->maxfield != 2 ||
-	    usage->hid != (HID_UP_KEYBOARD | 0x57))
+	return xiaomi_pen_pressure_report(report) ? -1 : 0;
+}
+
+static int xiaomi_pen_open(struct input_dev *input)
+{
+	struct xiaomi_pen *pen = input_get_drvdata(input);
+
+	return hid_hw_open(pen->hdev);
+}
+
+static void xiaomi_pen_close(struct input_dev *input)
+{
+	struct xiaomi_pen *pen = input_get_drvdata(input);
+
+	hid_hw_close(pen->hdev);
+}
+
+static int xiaomi_pen_init(struct hid_device *hdev)
+{
+	struct hid_report *report;
+	struct xiaomi_pen *pen;
+	struct input_dev *input;
+
+	if (!xiaomi_is_pen(hdev))
+		return 0;
+	report = hdev->report_enum[HID_INPUT_REPORT].report_id_hash[5];
+	if (!report || !xiaomi_pen_pressure_report(report))
 		return 0;
 
-	first = report->field[0];
-	second = report->field[1];
-	if (first->report_offset != 0 || first->report_size != 16 ||
-	    first->report_count != 4 || first->logical_minimum != 0 ||
-	    first->logical_maximum != 16384 ||
-	    second->report_offset != 64 || second->report_size != 8 ||
-	    second->report_count != 6 || second->logical_minimum != 0 ||
-	    second->logical_maximum != 255 ||
-	    first->flags != (HID_MAIN_ITEM_VARIABLE | HID_MAIN_ITEM_RELATIVE) ||
-	    second->flags != (HID_MAIN_ITEM_VARIABLE | HID_MAIN_ITEM_RELATIVE))
+	pen = devm_kzalloc(&hdev->dev, sizeof(*pen), GFP_KERNEL);
+	if (!pen)
+		return -ENOMEM;
+	input = devm_input_allocate_device(&hdev->dev);
+	if (!input)
+		return -ENOMEM;
+
+	pen->hdev = hdev;
+	pen->pressure = input;
+	pen->pressure_max = hdev->product == BT_DEVICE_ID_XIAOMI_M80P ?
+		8191 : 16383;
+	input->name = hdev->product == BT_DEVICE_ID_XIAOMI_M80P ?
+		"Xiaomi Focus Pen pressure" : "Xiaomi Focus Pen Pro pressure";
+	input->phys = hdev->phys;
+	input->uniq = hdev->uniq;
+	input->id.bustype = hdev->bus;
+	input->id.vendor = hdev->vendor;
+	input->id.product = hdev->product;
+	input->id.version = hdev->version;
+	input->dev.parent = &hdev->dev;
+	input->open = xiaomi_pen_open;
+	input->close = xiaomi_pen_close;
+	input_set_drvdata(input, pen);
+	/* BLE has no coordinates or proximity; do not advertise a tablet tool. */
+	input_set_abs_params(input, ABS_PRESSURE, 0, pen->pressure_max, 0, 0);
+	hid_set_drvdata(hdev, pen);
+	return 0;
+}
+
+static int xiaomi_raw_event(struct hid_device *hdev, struct hid_report *report,
+			    u8 *data, int size)
+{
+	struct xiaomi_pen *pen = hid_get_drvdata(hdev);
+	unsigned int pressure;
+
+	if (!pen || !xiaomi_pen_pressure_report(report))
+		return 0;
+	/* HID core pads short reports. Never interpret that padding as release. */
+	if (size != 15 || data[0] != 5)
+		return 0;
+	pressure = get_unaligned_le16(data + 1);
+	if (pressure > pen->pressure_max)
 		return 0;
 
-	return -1;
+	input_report_abs(pen->pressure, ABS_PRESSURE, pressure);
+	input_sync(pen->pressure);
+	/* Keep the unchanged report available to existing hidraw consumers. */
+	return 0;
 }
 
 static int xiaomi_probe(struct hid_device *hdev, const struct hid_device_id *id)
 {
+	struct xiaomi_pen *pen;
 	int ret;
 
+	hid_set_drvdata(hdev, NULL);
 	/* Keep the independent mouse and keyboard applications as hid-generic
 	 * exposed them; combining them would change libinput classification.
 	 */
-	if (hdev->vendor == BT_VENDOR_ID_XIAOMI_P81C &&
-	    (hdev->product == BT_DEVICE_ID_XIAOMI_P81C ||
-	     hdev->product == BT_DEVICE_ID_XIAOMI_M80P))
+	if (xiaomi_is_pen(hdev))
 		hdev->quirks |= HID_QUIRK_INPUT_PER_APP;
 
 	ret = hid_parse(hdev);
 	if (ret)
 		return ret;
-	return hid_hw_start(hdev, HID_CONNECT_DEFAULT);
+	ret = xiaomi_pen_init(hdev);
+	if (ret)
+		return ret;
+	ret = hid_hw_start(hdev, HID_CONNECT_DEFAULT);
+	if (ret)
+		return ret;
+
+	pen = hid_get_drvdata(hdev);
+	if (pen) {
+		ret = input_register_device(pen->pressure);
+		if (ret)
+			hid_hw_stop(hdev);
+	}
+	return ret;
 }
 
 static const struct hid_device_id xiaomi_devices[] = {
@@ -188,6 +300,7 @@ static struct hid_driver xiaomi_driver = {
 	.probe = xiaomi_probe,
 	.report_fixup = xiaomi_report_fixup,
 	.input_mapping = xiaomi_input_mapping,
+	.raw_event = xiaomi_raw_event,
 };
 module_hid_driver(xiaomi_driver);
 
