From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 12:00:00 +0000
Subject: arm64: show the board model in proc cpuinfo

Expose the model already declared by the board device tree.

Link: https://github.com/slwyts/Project-SunUEFI/commit/e8fcf33971263f28085dbc0dbe5039438bf76c13
Signed-off-by: slwyts <slwyts@foxmail.com>
---
 arch/arm64/kernel/cpuinfo.c | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/kernel/cpuinfo.c b/arch/arm64/kernel/cpuinfo.c
index 45c63f3d75c53de540b144aa9b015a60203c36fd..9be8516f23016e7de37d11702161e74b40e2680e 100644
--- a/arch/arm64/kernel/cpuinfo.c
+++ b/arch/arm64/kernel/cpuinfo.c
@@ -17,6 +17,7 @@
 #include <linux/elf.h>
 #include <linux/init.h>
 #include <linux/kernel.h>
+#include <linux/of.h>
 #include <linux/personality.h>
 #include <linux/preempt.h>
 #include <linux/printk.h>
@@ -219,6 +220,19 @@ static const char *const compat_hwcap2_str[] = {
 };
 #endif /* CONFIG_COMPAT */
 
+static void cpuinfo_show_model(struct seq_file *m, int cpu, u32 midr, bool compat)
+{
+	struct device_node *node = of_get_cpu_node(cpu, NULL);
+	const char *model;
+
+	if (node && !of_property_read_string(node, "model", &model))
+		seq_printf(m, "model name\t: %s\n", model);
+	else if (compat)
+		seq_printf(m, "model name\t: ARMv8 Processor rev %d (%s)\n",
+			   MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
+	of_node_put(node);
+}
+
 static int c_show(struct seq_file *m, void *v)
 {
 	int j;
@@ -233,9 +247,7 @@ static int c_show(struct seq_file *m, void *v)
 	 * "processor".  Give glibc what it expects.
 	 */
 	seq_printf(m, "processor\t: %d\n", cpu);
-	if (compat)
-		seq_printf(m, "model name\t: ARMv8 Processor rev %d (%s)\n",
-			   MIDR_REVISION(midr), COMPAT_ELF_PLATFORM);
+	cpuinfo_show_model(m, cpu, midr, compat);
 
 	seq_printf(m, "BogoMIPS\t: %lu.%02lu\n",
 		   loops_per_jiffy / (500000UL/HZ),
