From 44f17a42a812287acb2fe19633cbaf1144c6a25a Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Sat, 14 Nov 2026 03:41:04 +0800
Subject: [PATCH] fix(power): enforce stock third-party PPS source limits

Cap the complete adapter request, not just the pump, at the Piano CN third_pps voltage and current limits. Apply the stock 200 mA battery-current reduction and stop before rebuilding after verified adapter proof is lost.

Use the same-device 13 V SC8541 bus overvoltage threshold so the allowed 11 V PPS request does not hit the old 11 V protection setting. Keep software voltage windows and alarm thresholds.

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index ff400449d..16c4804ea 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -446,7 +446,7 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 #define MCA_CP_VBUS_MAX_DELTA_MV 1200
 #define MCA_CP_REQ_MAX_DELTA_MV	2000
 #define MCA_CP_PPS_MIN_MV	6000
-#define MCA_CP_PPS_MAX_MV	10000
+#define MCA_CP_PPS_MAX_MV	11000
 #define MCA_CP_BUCK_MA		500	/* buck input limit and charge current */
 /*
  * Retain this board's validated 2 A PMIC share to distribute heat. The
@@ -463,6 +463,9 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 /* Stock div_max_curr for 2:1 is 12000 mA battery, i.e. 6000 mA bus. */
 #define MCA_CP_IBUS_MAX_MA	6000
 #define MCA_CP_THIRD_IBUS_MA	4100
+#define MCA_CP_THIRD_VBUS_MV	11000
+#define MCA_CP_THIRD_IBAT_MA	8000
+#define MCA_CP_THIRD_DELTA_MA	200
 /* bus over-current protection of the stage, above the target */
 #define MCA_CP_BUSOCP_MARGIN_MA	1000
 /* Stock SC8541 bus OCP is 7000 mA. */
@@ -624,6 +627,7 @@ struct piano_mca {
 	unsigned int cp_generation;
 	unsigned int cp_connection_generation;
 	u32 cp_real_type;	/* source type selected before enabling the pump */
+	bool cp_verified;	/* Xiaomi proof used for this attempt's source limits */
 	u32 cp_mv;		/* voltage asked of the direct-charge source */
 	u32 cp_ma;		/* its current limit */
 	u32 cp_max_mv;		/* the most the source offers */
@@ -3216,6 +3220,13 @@ static bool piano_mca_adapter_verified(struct piano_mca *mca)
 	       piano_mca_read_u32(mca, MCA_PROP_PD_VERIFIED) == 1;
 }
 
+/* Piano CN third_pps_* with support_pps_100w disabled. */
+static u32 piano_mca_third_pps_current(u32 ma)
+{
+	return min_t(u32, ma - min_t(u32, ma, MCA_CP_THIRD_DELTA_MA),
+		     MCA_CP_THIRD_IBAT_MA);
+}
+
 /*
  * Direct charging after the authentication, from 5 V by PPS and without
  * asking for 9 V first.  A Xiaomi adapter does not reset: it stays at 5 V
@@ -3241,6 +3252,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	struct piano_mca_cp_limits limits;
 	struct piano_mca_qc_limits qc = {};
 	bool is_qc = piano_mca_is_qc_cp(mca->real_type);
+	bool verified;
 	int vbat, ibat, tcool, twarm, ret;
 	u32 start_mv, ma, src_ma, max_mv = 0;
 
@@ -3271,6 +3283,9 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		piano_mca_qc_limits(mca, mca->real_type, &qc);
 		limits.ma = min(limits.ma, qc.target_ibat_ma);
 	}
+	verified = !is_qc && piano_mca_adapter_verified(mca);
+	if (!is_qc && !verified)
+		limits.ma = piano_mca_third_pps_current(limits.ma);
 	if (limits.ma < MCA_CP_BUCK_MA + 4 * MCA_CP_OPEN_IBUS_MA ||
 	    piano_mca_normal_voltage_stop(mca, vbat, limits.fv_mv) ||
 	    vbat < MCA_CP_VBAT_MIN_MV || vbat >= limits.cv_mv ||
@@ -3305,6 +3320,10 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 		start_mv = roundup(start_mv, qc.step_mv);
 	} else {
 		ma = piano_mca_cp_apdo(mca, start_mv, &max_mv);
+		if (!verified) {
+			ma = min_t(u32, ma, MCA_CP_THIRD_IBUS_MA);
+			max_mv = min_t(u32, max_mv, MCA_CP_THIRD_VBUS_MV);
+		}
 	}
 	if (!ma || ma < MCA_CP_BUCK_MA + 1000)
 		return;
@@ -3312,6 +3331,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	mca->cp_ma = min_t(u32, ma, MCA_CP_PPS_MAX_MA);
 	mca->cp_max_mv = max_mv;
 	mca->cp_real_type = mca->real_type;
+	mca->cp_verified = verified;
 	if (is_qc) {
 		mca->cp_ibus_ma = min3(clamp(cp_ibus_max, 500U, (u32)MCA_CP_IBUS_MAX_MA),
 					qc.max_ibus_ma, limits.ma / 2);
@@ -3322,9 +3342,6 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 				      src_ma);
 		mca->cp_ibus_ma = min(mca->cp_ibus_ma, (limits.ma - MCA_CP_BUCK_MA) / 2);
 	}
-	if (!is_qc && !piano_mca_adapter_verified(mca))
-		mca->cp_ibus_ma = min_t(u32, mca->cp_ibus_ma,
-					MCA_CP_THIRD_IBUS_MA);
 	if (mca->cp_ibus_ma < 2 * MCA_CP_OPEN_IBUS_MA) {
 		mca->cp = MCA_CP_DONE;
 		return;
@@ -3471,6 +3488,10 @@ static void piano_mca_cp_step(struct piano_mca *mca)
 		piano_mca_cp_stop(mca, "charger type changed");
 		return;
 	}
+	if (mca->cp_verified && !piano_mca_adapter_verified(mca)) {
+		piano_mca_cp_pause(mca, "adapter proof lost");
+		return;
+	}
 	if (piano_mca_cp_gauges(mca, &vbat, &ibat, &tcool, &twarm) ||
 	    piano_mca_cp_get(mca, POWER_SUPPLY_PROP_ONLINE, &on)) {
 		if (!piano_mca_cp_stop_io(mca, "read failed"))
@@ -3500,6 +3521,8 @@ static void piano_mca_cp_step(struct piano_mca *mca)
 		piano_mca_qc_limits(mca, mca->cp_real_type, &qc);
 		limits.ma = min(limits.ma, qc.target_ibat_ma);
 	}
+	if (!is_qc && !mca->cp_verified)
+		limits.ma = piano_mca_third_pps_current(limits.ma);
 	if (piano_mca_normal_voltage_stop(mca, vbat, limits.fv_mv)) {
 		if (!piano_mca_cp_pause(mca, "warm voltage limit")) {
 			piano_mca_normal_pause(mca, mca->cp_generation,
diff --git a/drivers/power/supply/piano_mca_test.c b/drivers/power/supply/piano_mca_test.c
