 }
 
@@ -3664,6 +3666,34 @@ static void piano_mca_ffc_tail_does_not_reenter_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
 }
 
+static void piano_mca_third_pps_limits_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	static const struct { u32 input, result; } rows[] = {
+		{ 0, 0 }, { 100, 0 }, { 200, 0 }, { 201, 1 },
+		{ 8000, 7800 }, { 8200, 8000 }, { 12400, 8000 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(rows); i++)
+		KUNIT_EXPECT_EQ(test, piano_mca_third_pps_current(rows[i].input),
+				rows[i].result);
+	KUNIT_ASSERT_EQ(test, piano_mca_source_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_pause(&f->mca, "third PPS limits"), 0);
+	f->apdo_max_mv = 20000;
+	f->mca.hv = MCA_HV_ON;
+	piano_mca_cp_try_start(&f->mca, f->remote_generation);
+	KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_OPENING);
+	KUNIT_EXPECT_FALSE(test, f->mca.cp_verified);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ma, 4100U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_max_mv, 11000U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_start_ibat_ma, 7800U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 3400U);
+	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 4400U);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_request(&f->mca, 12000), 0);
+	KUNIT_EXPECT_EQ(test, f->last_pps_word, piano_mca_pps_word(11000, 4100));
+}
+
 static void piano_mca_qc_limits_test(struct kunit *test)
 {
 	struct piano_mca_test *f = test->priv;
@@ -3948,6 +3978,7 @@ static void piano_mca_cp_entry_gate_test(struct kunit *test)
 }
 
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_third_pps_limits_test),
 	KUNIT_CASE(piano_mca_qc_limits_test),
 	KUNIT_CASE(piano_mca_qc_direction_test),
 	KUNIT_CASE(piano_mca_qc_repeated_samples_test),
diff --git a/drivers/power/supply/sc8541_charger.c b/drivers/power/supply/sc8541_charger.c
index 7aa48b927..8b3fc406d 100644
--- a/drivers/power/supply/sc8541_charger.c
+++ b/drivers/power/supply/sc8541_charger.c
@@ -69,12 +69,13 @@
  * use Piano's factory 4800/4600 mV thresholds. The caller regulates the
  * normal charge voltage below these limits; the alarm only asserts INT
  * and cannot replace software voltage regulation. The bus limits fit
- * a 2:1 stage fed from an 11 V PPS source; the bus over-current limit can
+ * a 2:1 stage fed from an 11 V PPS source, with the stock 13 V bus OVP;
+ * the bus over-current limit can
  * be raised for sources that offer more than 3 A, up to the stock value.
  */
 #define SC8541_BATOVP_MV	4800
 #define SC8541_BATOVP_ALM_MV	4600
-#define SC8541_BUSOVP_MV	11000
+#define SC8541_BUSOVP_MV	13000
 #define SC8541_BUSOVP_ALM_MV	10500
 #define SC8541_BUSOCP_MA	3500
 #define SC8541_BUSOCP_MIN_MA	1000
