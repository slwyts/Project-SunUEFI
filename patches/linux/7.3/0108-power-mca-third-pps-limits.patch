@@ -136,6 +136,7 @@ struct piano_mca_test {
 	bool replug_on_enable_read;
 	bool restart_on_enable_read;
 	bool offer_cp_apdo;
+	u32 apdo_max_mv;
 	bool only_5v;
 	unsigned int fv_writes;
 	unsigned int fcc_writes;
@@ -396,7 +397,7 @@ static int piano_mca_test_send(struct pmic_glink_client *client, void *data,
 			pdo[1].max_ma = cpu_to_le32(fixture->fixed_9v_ma);
 			if (fixture->offer_cp_apdo) {
 				pdo[2].min_mv = cpu_to_le32(6000);
-				pdo[2].max_mv = cpu_to_le32(10000);
+				pdo[2].max_mv = cpu_to_le32(fixture->apdo_max_mv);
 				pdo[2].max_ma = cpu_to_le32(6000);
 			}
 			if (fixture->restart_on_pdos) {
@@ -543,6 +544,7 @@ static int piano_mca_test_init(struct kunit *test)
 	mca->polled_generation = fixture->remote_generation;
 	fixture->fixed_9v_ma = 2000;
 	fixture->fixed_5v_ma = 3000;
+	fixture->apdo_max_mv = 10000;
 	fixture->vbus_uv = 5000000;
 	fixture->real_type = MCA_TYPE_PD;
 	fixture->charge_status = 4;
@@ -2347,9 +2349,9 @@ static void piano_mca_source_drop_restores_budget_test(struct kunit *test)
 	for (n = 0; n < 6; n++)
 		piano_mca_poll(&f->mca.poll.work);
 	KUNIT_ASSERT_EQ(test, f->mca.cp, MCA_CP_ON);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_ma, 6000U);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 1750U);
-	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 2750U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ma, 4100U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 1650U);
+	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 2650U);
 	KUNIT_EXPECT_LT(test, f->last_cp_ocp_event, f->last_cp_enable_event);
 	KUNIT_EXPECT_EQ(test, f->fv_mv, 4060U);
 
@@ -2361,11 +2363,11 @@ static void piano_mca_source_drop_restores_budget_test(struct kunit *test)
 	for (n = 0; n < 8; n++)
 		piano_mca_poll(&f->mca.poll.work);
 	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_ON);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 3750U);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_hot, 3750U);
-	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 4750U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 3400U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_hot, 3400U);
+	KUNIT_EXPECT_EQ(test, f->cp_busocp_ma, 4400U);
 	KUNIT_EXPECT_LT(test, f->last_cp_ocp_event, f->last_cp_enable_event);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_start_ibat_ma, 8000U);
+	KUNIT_EXPECT_EQ(test, f->mca.cp_start_ibat_ma, 7800U);
 	KUNIT_EXPECT_EQ(test, f->fv_mv, 4480U);
 	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 1U);
 }
@@ -2413,7 +2415,7 @@ static void piano_mca_source_drop_retry_limit_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, f->mca.cp_errors, 0U);
 	KUNIT_EXPECT_EQ(test, f->mca.polled_connection_generation, 1U);
 	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_ON);
-	KUNIT_EXPECT_EQ(test, f->mca.cp_ibus_ma, 1750U);
