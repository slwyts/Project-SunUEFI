 .../devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml    | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml b/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
index c58e8a6c7fe1063f7eb3762115e16fdd06914b21..07d88d27ad279db384b00e3e8e738fa7e57b3ca3 100644
--- a/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
+++ b/Documentation/devicetree/bindings/remoteproc/qcom,sm8550-pas.yaml
@@ -70,6 +70,13 @@ properties:
       - description: Firmware name of the Hexagon core
       - description: Firmware name of the Hexagon Devicetree
 
+  qcom,no-auto-boot:
+    type: boolean
+    description:
+      Do not start the remote processor automatically when the PAS driver
+      probes.  This is intended for controlled bring-up of vendor firmware
+      whose handover may affect shared board resources.
+
   memory-region:
     minItems: 2
