 	profile = cold->fv_mv < hot->fv_mv ? cold : hot;
-	key = a * ARRAY_SIZE(piano_mca_cp_profiles) + b + 1;
+	/* Use the hotter row's factory termination current across mixed zones. */
+	if (mca->ffc)
+		profile = hot;
