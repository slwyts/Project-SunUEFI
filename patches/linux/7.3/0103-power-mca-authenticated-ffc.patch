+static void piano_mca_ffc_tail_does_not_reenter_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int tbat;
+
+	piano_mca_ffc_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	f->charge_status = 5;
+	f->gauge[0].charge_now_uah = f->gauge[1].charge_now_uah = 4455000;
