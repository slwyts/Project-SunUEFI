+static void piano_mca_ffc_prepare(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	int i;
+
+	piano_mca_skin_limits_prepare(test);
+	mipps_auth = true;
+	for (i = 0; i < ARRAY_SIZE(f->gauge); i++)
+		f->gauge[i].charge_now_uah = 2250000;
+	f->mca.auth_ok = true;
+	f->mca.auth_generation = f->remote_generation;
+	f->pd_verified = 1;
+	f->mca.charge_limit_ua = MCA_FFC_IBAT_MAX_MA * 1000;
+	cp_ibat_max = MCA_FFC_IBAT_MAX_MA;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_skin(&f->mca), 0);
+}
+
+static void piano_mca_ffc_requires_both_gauges_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	piano_mca_ffc_prepare(test);
+	f->gauge[1].authentic = false;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+	f->gauge[1].authentic = true;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_EXPECT_TRUE(test, f->mca.ffc);
+	KUNIT_EXPECT_EQ(test, f->gauge[0].charge_type, POWER_SUPPLY_CHARGE_TYPE_FAST);
+	KUNIT_EXPECT_EQ(test, f->gauge[1].charge_type, POWER_SUPPLY_CHARGE_TYPE_FAST);
+}
+
+static void piano_mca_ffc_temperature_and_thermal_budget_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct piano_mca_cp_limits limits;
+
+	piano_mca_ffc_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 17, 25), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 18, 25), 0);
+	KUNIT_ASSERT_TRUE(test, f->mca.ffc);
+	KUNIT_ASSERT_EQ(test,
+		piano_mca_cp_normal_limits(&f->mca, 3800, 10000, 25, 25, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.ma, 12300U);
+	f->mca.skin_limit_ma = piano_mca_skin_current(&f->mca, 39000);
+	KUNIT_ASSERT_EQ(test,
+		piano_mca_cp_normal_limits(&f->mca, 3800, 10000, 25, 25, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.ma, 4400U);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 48), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+}
+
+static void piano_mca_ffc_partial_mode_write_rolls_back_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	piano_mca_ffc_prepare(test);
+	f->gauge[1].mode_failures = 1;
+	KUNIT_EXPECT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), -EIO);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+	KUNIT_EXPECT_TRUE(test, f->mca.ffc_mode_known);
+	KUNIT_EXPECT_EQ(test, f->gauge[0].charge_type, POWER_SUPPLY_CHARGE_TYPE_STANDARD);
+	KUNIT_EXPECT_EQ(test, f->gauge[1].charge_type, POWER_SUPPLY_CHARGE_TYPE_STANDARD);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+}
+
+static void piano_mca_ffc_inhibition_and_full_survive_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	piano_mca_ffc_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_ASSERT_TRUE(test, f->mca.ffc);
+	f->mca.inhibit_charge = true;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_charge);
+	f->mca.inhibit_charge = false;
+	f->mca.normal_full = true;
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.ffc);
+	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
+}
