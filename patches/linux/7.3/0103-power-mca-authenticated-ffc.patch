+static void piano_mca_ffc_stop_retries_pmic_pause_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	piano_mca_ffc_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	f->mca.cp_ffc = true;
+	f->pmic_enable_write_failures = 1;
+	KUNIT_EXPECT_EQ(test, piano_mca_cp_pause(&f->mca, "FFC limit"), -EIO);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_TRUE(test, f->mca.cp_retry);
+	KUNIT_EXPECT_TRUE(test, f->mca.pmic_pause_pending);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_stop(&f->mca, "stop confirmation"), 0);
+	KUNIT_EXPECT_FALSE(test, f->mca.pmic_pause_pending);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+}
