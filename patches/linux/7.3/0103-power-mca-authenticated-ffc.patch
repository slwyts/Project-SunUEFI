+	f->gauge[0].charge_full_uah = f->gauge[1].charge_full_uah = 3600000;
+	KUNIT_ASSERT_EQ(test, piano_mca_battery_state(&f->mca), 0);
+	KUNIT_ASSERT_EQ(test,
+		piano_mca_cp_normal_limits(&f->mca, 3800, 9000, 25, 25, &limits), 0);
+	KUNIT_EXPECT_EQ(test, limits.fv_mv, 4490U);
