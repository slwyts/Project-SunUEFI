+	}
 	if (vbat >= voltage->mv) {
 		if (ibat <= min_t(int, voltage->min_ma, ma) &&
 		    stage + 1 < profile->count) {
@@ -2115,10 +2361,17 @@ static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
