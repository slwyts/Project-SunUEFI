+static void piano_mca_ffc_voltage_cutoff_keeps_buck_off_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	piano_mca_ffc_prepare(test);
+	KUNIT_ASSERT_EQ(test, piano_mca_update_ffc(&f->mca, 25, 25), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	f->mca.cp_ffc = true;
+	f->mca.cp_buck_disabled = true;
+	KUNIT_ASSERT_EQ(test, piano_mca_cp_set_buck(&f->mca, 0, 0), 0);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, f->icl_ma, (u32)MCA_ICL_MIN_MA);
+	KUNIT_EXPECT_EQ(test, piano_mca_pmic_voltage(&f->mca, 4550, 25), 4590U);
