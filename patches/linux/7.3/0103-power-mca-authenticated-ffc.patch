+static int piano_mca_test_gauge_set(struct power_supply *psy,
+				    enum power_supply_property property,
+				    const union power_supply_propval *value)
+{
+	struct piano_mca_test_gauge *gauge = power_supply_get_drvdata(psy);
+
+	if (property != POWER_SUPPLY_PROP_CHARGE_TYPE)
+		return -EINVAL;
+	gauge->mode_writes++;
+	if (gauge->mode_failures) {
+		gauge->mode_failures--;
+		return -EIO;
+	}
+	gauge->charge_type = value->intval;
+	return 0;
+}
