+#define DPU_GCV2_DSPP_MASK GENMASK(20, 17)
+#define DPU_GCV2_REG_BASE 0x17c0
+#define DPU_GCV2_LUT_WORDS (2 + 3 * (2 + 2 + 512) + 2 + 2)
