From 41f787a6ee254c060904c4c883fa04cbdb734e4a Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 20 Oct 2026 14:00:00 +0000
Subject: [PATCH] fix(drm/msm): adapt LUT DMA allocation to Linux 7.3

Use an independent reservation object for the internal LUT DMA buffer, matching the other kernel GEM clients.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
index 7b2839e0370..29e6703354d 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_lutdma.c
@@ -300,7 +300,7 @@ struct dpu_lutdma *dpu_lutdma_init(struct dpu_kms *kms)
 			goto unmap;
 		}
 	}
-	dma->bo = msm_gem_new(kms->dev, REGDMA_BUFFER_SIZE, MSM_BO_WC);
+	dma->bo = msm_gem_new(kms->dev, REGDMA_BUFFER_SIZE, MSM_BO_WC, NULL);
 	if (IS_ERR(dma->bo)) {
 		ret = PTR_ERR(dma->bo);
 		goto unmap;
