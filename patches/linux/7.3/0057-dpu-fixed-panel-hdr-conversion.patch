diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_output_color.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_output_color.c
new file mode 100644
index 00000000000..194c242489c
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_output_color.c
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/firmware.h>
+#include <linux/hdmi.h>
+#include <linux/of.h>
+#include <linux/unaligned.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_property.h>
+
+#include "dpu_crtc.h"
+#include "dpu_kms.h"
+#include "dpu_lutdma.h"
+#include "dpu_output_color.h"
+
+#define COLOR_HEADER_SIZE 32
+#define COLOR_IGC_BYTES (2 * DPU_IGCV5_LUT_SIZE * sizeof(struct drm_color_lut))
+#define COLOR_GC_BYTES (3 * (PGC_TBL_LEN + PGC_TBL_LEN_EXTENDED) * sizeof(u32))
+#define COLOR_GAMUT_BYTES (DPU_GAMUTV43_ENTRIES * 3 * sizeof(u16))
+#define COLOR_FIRMWARE_SIZE (COLOR_HEADER_SIZE + COLOR_IGC_BYTES + COLOR_GC_BYTES + COLOR_GAMUT_BYTES)
+
+static int parse_color(struct dpu_output_color *color, const struct firmware *fw,
+		       unsigned int panel_id)
+{
+	const u8 *p;
+	u32 *channels[] = { color->gamma.c0, color->gamma.c1, color->gamma.c2 };
+	unsigned int table, channel, i;
+
+	if (fw->size != COLOR_FIRMWARE_SIZE || memcmp(fw->data, "DPUCOLR1", 8) ||
+	    get_unaligned_le32(fw->data + 8) != 1 ||
+	    get_unaligned_le32(fw->data + 12) != panel_id ||
+	    get_unaligned_le32(fw->data + 24) != COLOR_FIRMWARE_SIZE ||
+	    get_unaligned_le32(fw->data + 28))
+		return -EINVAL;
+	p = fw->data + COLOR_HEADER_SIZE;
+	for (table = 0; table < 2; table++) {
+		for (i = 0; i < DPU_IGCV5_LUT_SIZE; i++, p += 8) {
+			struct drm_color_lut *entry = &color->degamma[table][i];
+
+			entry->red = get_unaligned_le16(p);
+			entry->green = get_unaligned_le16(p + 2);
+			entry->blue = get_unaligned_le16(p + 4);
+			if (get_unaligned_le16(p + 6) ||
+			    (i && (entry->red < entry[-1].red ||
+				   entry->green < entry[-1].green ||
+				   entry->blue < entry[-1].blue)))
+				return -EINVAL;
+		}
+	}
+	for (channel = 0; channel < 3; channel++)
+		for (i = 0; i < PGC_TBL_LEN + PGC_TBL_LEN_EXTENDED; i++, p += 4) {
+			u32 word = get_unaligned_le32(p);
+
+			if (word & ~0x03ff03ff)
+				return -EINVAL;
+			if (i < PGC_TBL_LEN)
+				channels[channel][i] = word;
+			else
+				color->gamma.extended[channel][i - PGC_TBL_LEN] = word;
+		}
+	for (i = 0; i < DPU_GAMUTV43_ENTRIES; i++)
+		for (channel = 0; channel < 3; channel++, p += 2) {
+			color->gamut.rgb[i][channel] = get_unaligned_le16(p);
+			if (color->gamut.rgb[i][channel] > 4095)
+				return -EINVAL;
+		}
+	color->gamma.flags = PGC_HIGH_PRECISION;
+	return 0;
+}
+
+void dpu_output_color_init(struct msm_kms *kms, struct drm_connector *connector,
+			   const struct device_node *panel)
+{
+	struct dpu_kms *dpu_kms = to_dpu_kms(kms);
+	struct dpu_output_color *color;
+	const struct firmware *fw;
+	const char *name;
+	unsigned int panel_id;
+	int ret;
+
+	if (!panel || dpu_kms->output_color || !dpu_lutdma_ready(dpu_kms->lutdma) ||
+	    dpu_kms->catalog->mdss_ver->core_major_ver != 12)
+		return;
+	if (of_device_is_compatible(panel, "xiaomi,piano-boe-nt36532")) {
+		name = "qcom/sm8750/piano-boe-display.bin";
+		panel_id = 1;
+	} else if (of_device_is_compatible(panel, "xiaomi,piano-csot-nt36532")) {
+		name = "qcom/sm8750/piano-csot-display.bin";
+		panel_id = 2;
+	} else {
+		return;
+	}
+	ret = firmware_request_nowarn(&fw, name, kms->dev->dev);
+	if (ret) {
+		drm_dbg_kms(kms->dev, "Output color calibration unavailable: %d\n", ret);
+		return;
+	}
+	color = drmm_kzalloc(kms->dev, sizeof(*color), GFP_KERNEL);
+	ret = color ? parse_color(color, fw, panel_id) : -ENOMEM;
+	release_firmware(fw);
+	if (ret) {
+		drm_warn(kms->dev, "Invalid output color calibration: %d\n", ret);
+		return;
+	}
+	ret = drm_mode_create_hdmi_colorspace_property(connector,
+		BIT(DRM_MODE_COLORIMETRY_BT2020_RGB));
+	if (ret)
+		return;
+	drm_connector_attach_colorspace_property(connector);
+	drm_connector_attach_hdr_output_metadata_property(connector);
+	color->connector = connector;
+	dpu_kms->output_color = color;
+}
+
+int dpu_output_color_check(struct drm_crtc_state *state)
+{
+	struct msm_drm_private *priv = state->crtc->dev->dev_private;
+	struct dpu_kms *kms = to_dpu_kms(priv->kms);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+	struct drm_connector_state *conn_state;
+	struct dpu_output_color *color = kms->output_color;
+	struct drm_connector *connector;
+	unsigned int mode = 0;
+	int ret;
+
+	if (!color)
+		return 0;
+	connector = color->connector;
+	conn_state = drm_atomic_get_connector_state(state->state, connector);
+	if (IS_ERR(conn_state))
+		return PTR_ERR(conn_state);
+	if (state->enable && conn_state->crtc == state->crtc) {
+		struct hdr_output_metadata *metadata;
+
+		if (conn_state->hdr_output_metadata &&
+		    conn_state->hdr_output_metadata->length != sizeof(*metadata))
+			return -EINVAL;
+		metadata = conn_state->hdr_output_metadata ?
+			conn_state->hdr_output_metadata->data : NULL;
+		if (metadata && (metadata->metadata_type ||
+		    metadata->hdmi_metadata_type1.metadata_type ||
+		    metadata->hdmi_metadata_type1.eotf != HDMI_EOTF_SMPTE_ST2084))
+			return -EINVAL;
+		if (metadata && conn_state->colorspace != DRM_MODE_COLORIMETRY_BT2020_RGB)
+			return -EINVAL;
+		if (conn_state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB)
+			mode = metadata ? 1 : 2;
+		if (mode && (hweight32(state->encoder_mask) != 1 || state->ctm ||
+			     state->gamma_lut || state->degamma_lut))
+			return -EINVAL;
+	}
+	if (mode != cstate->output_color_mode)
+		state->color_mgmt_changed = true;
+	cstate->output_color_mode = mode;
+	ret = mode && !dpu_lutdma_ready(kms->lutdma) ? -EIO : 0;
+	return ret;
+}
+
+MODULE_FIRMWARE("qcom/sm8750/piano-boe-display.bin");
+MODULE_FIRMWARE("qcom/sm8750/piano-csot-display.bin");
