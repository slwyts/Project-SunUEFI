diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_gamutv43.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_gamutv43.c
new file mode 100644
index 00000000000..24d04bf8acd
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_gamutv43.c
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Gamut v4.3 LUTBUS programming follows Qualcomm's published driver. */
+#include <linux/bitops.h>
+#include <linux/byteorder/generic.h>
+#include <linux/errno.h>
+
+#include "dpu_hw_gcv2.h"
+#include "dpu_hw_gamutv43.h"
+
+#define GAMUT_BASE 0x1000
+#define REGDMA_DECODE_SELECT 0x18180114
+#define REGDMA_SINGLE_WRITE BIT(28)
+#define REGDMA_LUTBUS_WRITE (BIT(30) | BIT(29))
+#define GAMUT_ENABLE BIT(0)
+#define GAMUT_LUTBUS_BLOCK 1
+#define GAMUT_TRANSFER_WORDS 6
+
+static u16 gamut_component(const struct dpu_hw_gamut_lut *lut, unsigned int i)
+{
+	if (i / 3 >= DPU_GAMUTV43_ENTRIES)
+		return 0;
+	return lut->rgb[i / 3][i % 3] << 4;
+}
+
+int dpu_hw_gamutv43_pack_regdma(__le32 *words, size_t capacity,
+			      u32 dspp_mask, const struct dpu_hw_gamut_lut *lut)
+{
+	unsigned int i, n = 0;
+
+	if (!words || !dspp_mask || (dspp_mask & ~DPU_GCV2_DSPP_MASK))
+		return -EINVAL;
+	if (capacity < (lut ? DPU_GAMUTV43_LUT_WORDS : 4))
+		return -ENOSPC;
+	if (lut)
+		for (i = 0; i < DPU_GAMUTV43_ENTRIES; i++)
+			if ((lut->rgb[i][0] | lut->rgb[i][1] | lut->rgb[i][2]) > 4095)
+				return -EINVAL;
+
+	words[n++] = cpu_to_le32(REGDMA_DECODE_SELECT);
+	words[n++] = cpu_to_le32(dspp_mask);
+	if (lut) {
+		/* The four interleaved tables form a red-fastest 17^3 grid.
+		 * Pad its final three entries to a complete six-word transfer.
+		 */
+		words[n++] = cpu_to_le32(REGDMA_LUTBUS_WRITE | GAMUT_LUTBUS_BLOCK);
+		words[n++] = cpu_to_le32((GAMUT_TRANSFER_WORDS << 16) |
+					(DPU_GAMUTV43_DATA_WORDS / GAMUT_TRANSFER_WORDS));
+		for (i = 0; i < DPU_GAMUTV43_DATA_WORDS; i++)
+			words[n++] = cpu_to_le32(gamut_component(lut, i * 2) |
+					((u32)gamut_component(lut, i * 2 + 1) << 16));
+		/* The published LUTBUS residual-data workaround needs three NOPs. */
+		words[n++] = 0;
+		words[n++] = 0;
+		words[n++] = 0;
+	}
+	words[n++] = cpu_to_le32(REGDMA_SINGLE_WRITE | GAMUT_BASE);
+	words[n++] = cpu_to_le32(lut ? GAMUT_ENABLE : 0);
+	return n;
+}
