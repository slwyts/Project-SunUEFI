-int dpu_lutdma_submit_color(struct dpu_lutdma *dma, struct dpu_hw_ctl *ctl,
+static int submit_color(struct dpu_lutdma *dma, struct dpu_hw_ctl *ctl,
 			u32 dspp_mask, const struct dpu_hw_gc_lut *gc_lut,
-			const struct drm_color_lut *igc_lut, bool update_igc)
+			const struct drm_color_lut *igc_lut, bool update_igc,
+			const struct dpu_hw_gamut_lut *gamut, bool update_gamut)
 {
 	u32 done, errors, descriptor;
 	__le32 *last;
@@ -185,6 +187,13 @@ int dpu_lutdma_submit_color(struct dpu_lutdma *dma, struct dpu_hw_ctl *ctl,
 		}
 		words += igc_words;
 	}
+	if (update_gamut) {
+		ret = dpu_hw_gamutv43_pack_regdma(dma->commands + words,
+						capacity - words, dspp_mask, gamut);
+		if (ret < 0)
+			goto unlock;
+		words += ret;
+	}
 	ret = dpu_hw_color_regdma_last_offset(words, REGDMA_BUFFER_SIZE, &last_offset);
 	if (ret)
 		goto unlock;
@@ -238,6 +247,21 @@ int dpu_lutdma_submit_color(struct dpu_lutdma *dma, struct dpu_hw_ctl *ctl,
 	return ret;
 }
 
+int dpu_lutdma_submit_color(struct dpu_lutdma *dma, struct dpu_hw_ctl *ctl,
