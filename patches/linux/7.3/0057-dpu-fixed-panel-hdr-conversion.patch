+static void nt36532_edid_checksum(u8 *block)
+{
+	u8 sum = 0;
+	unsigned int i;
+
+	for (i = 0; i < 127; i++)
+		sum += block[i];
+	block[127] = -sum;
+}
+
+static void nt36532_update_edid(struct nt36532 *ctx, struct drm_connector *connector)
+{
+	const struct drm_display_mode *mode = &ctx->panel_info->modes[1];
+	const struct drm_edid *edid;
+	u8 data[384] = { 0 };
+	u8 *cta = data + 128, *displayid = data + 256, *timing = displayid + 8;
+	/* P3-D65 primaries from the matching stock panel calibration. */
+	static const u16 primaries[] = { 696, 328, 271, 707, 154, 61, 320, 337 };
+	unsigned int i;
+	u32 clock = mode->clock - 1;
+	u8 sum = 0;
+
+	if (!ctx->panel_info->hdr_max_luminance || !connector->colorspace_property)
+		return;
+	/* Synthesized description of the complete DPU + fixed-panel output.
+	 * The sink accepts PQ only through the driver's calibrated conversion;
+	 * the panel/DDIC and DSC transport remain native-encoded at 10 bpc.
+	 */
+	memcpy(data, "\x00\xff\xff\xff\xff\xff\xff\x00", 8);
+	data[8] = 0x61; /* XMI */
+	data[9] = 0xa9;
+	put_unaligned_le16(0x81, data + 10);
+	data[16] = 0;
+	data[17] = 35; /* 2025 panel generation, not a per-unit manufacture date. */
+	data[18] = 1;
+	data[19] = 4;
+	data[20] = DRM_EDID_INPUT_DIGITAL | DRM_EDID_DIGITAL_DEPTH_10;
+	data[21] = 24;
+	data[22] = 16;
+	data[23] = 120; /* Gamma 2.2. */
+	for (i = 0; i < ARRAY_SIZE(primaries); i++) {
+		data[27 + i] = primaries[i] >> 2;
+		data[25 + i / 4] |= (primaries[i] & 3) << (6 - 2 * (i % 4));
+	}
+	memset(data + 38, 1, 16); /* Unused standard timings. */
+	data[57] = 0xfc;
+	memcpy(data + 59, "Piano display", 13);
+	data[75] = 0xfe;
+	memcpy(data + 77, "DPU synthesis", 13);
+	data[93] = 0x10;
+	data[111] = 0x10;
+	data[126] = 2;
+	nt36532_edid_checksum(data);
+
+	cta[0] = CEA_EXT;
+	cta[1] = 3;
+	cta[2] = 15;
+	cta[4] = (7 << 5) | 3;
+	cta[5] = 5; /* Colorimetry data block. */
+	cta[6] = BIT(7); /* BT.2020 RGB. */
+	cta[8] = (7 << 5) | 6;
+	cta[9] = 6; /* HDR static metadata data block. */
+	cta[10] = BIT(0) | BIT(2); /* Traditional SDR and SMPTE ST 2084. */
+	cta[11] = BIT(0); /* Static metadata type 1. */
+	cta[12] = ctx->panel_info->hdr_max_luminance;
+	cta[13] = ctx->panel_info->hdr_max_luminance;
+	cta[14] = ctx->panel_info->hdr_min_luminance;
+	nt36532_edid_checksum(cta);
+
+	/* Native 120 Hz exceeds the base EDID's 655.35 MHz timing limit.
+	 * DisplayID type VII describes the actual clock without truncation.
+	 */
+	displayid[0] = DISPLAYID_EXT;
+	displayid[1] = 0x20;
+	displayid[2] = 23;
+	displayid[3] = 2;
+	displayid[5] = 0x22;
+	displayid[7] = 20;
+	timing[0] = clock;
+	timing[1] = clock >> 8;
+	timing[2] = clock >> 16;
+	timing[3] = BIT(7);
+	put_unaligned_le16(mode->hdisplay - 1, timing + 4);
+	put_unaligned_le16(mode->htotal - mode->hdisplay - 1, timing + 6);
+	put_unaligned_le16(mode->hsync_start - mode->hdisplay - 1, timing + 8);
+	put_unaligned_le16(mode->hsync_end - mode->hsync_start - 1, timing + 10);
+	put_unaligned_le16(mode->vdisplay - 1, timing + 12);
+	put_unaligned_le16(mode->vtotal - mode->vdisplay - 1, timing + 14);
+	put_unaligned_le16(mode->vsync_start - mode->vdisplay - 1, timing + 16);
+	put_unaligned_le16(mode->vsync_end - mode->vsync_start - 1, timing + 18);
+	for (i = 1; i < 28; i++)
+		sum += displayid[i];
+	displayid[28] = -sum;
+	nt36532_edid_checksum(displayid);
+	edid = drm_edid_alloc(data, sizeof(data));
+	if (!edid)
+		return;
+	drm_edid_connector_update(connector, edid);
+	drm_edid_free(edid);
+}
