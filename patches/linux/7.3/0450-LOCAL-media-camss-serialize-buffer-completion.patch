 	val = RDI_CFG0_TIMESTAMP_EN | CSID_TIMESTAMP_STROBE;
 	val |= RDI_CFG0_RETIME_BS;	/* SOF retiming off, as downstream */
 	val |= format->decode_format << RDI_CFG0_DECODE_FORMAT;
@@ -650,6 +640,45 @@ static void __csid_configure_ipp_stream(struct csid_device *csid, u8 enable,
 	writel(val, csid->base + CSID_IPP_CFG0);
 }
 
+void csid_980_prepare_port(struct csid_device *csid, int port)
+{
+	if (csid->phy.need_vc_update) {
+		__csid_configure_rx(csid, &csid->phy);
+		__csid_configure_rx_vc(csid, 0);
+		csid->phy.need_vc_update = false;
+	}
+	if (csid_port_is_ipp(csid, port))
+		__csid_configure_ipp_stream(csid, 0);
+	else
+		__csid_configure_rdi_stream(csid, true, port, 0);
+}
+
+void csid_980_start_port(struct csid_device *csid, int port, unsigned int buffers)
+{
+	unsigned int i;
+
+	/* Each address needs an AUP before resuming at a frame boundary. */
+	for (i = 0; i < buffers; i++) {
+		__csid_addr_update(csid, port);
+		__csid_reg_update(csid, port);
+	}
+	if (!buffers)
+		__csid_reg_update(csid, port);
+
+	if (csid_port_is_ipp(csid, port))
+		writel(RDI_CTRL_START_CMD, csid->base + CSID_IPP_CTRL);
+	else
+		__csid_ctrl_rdi(csid, true, port);
+}
+
+void csid_980_stop_port(struct csid_device *csid, int port)
+{
+	if (csid_port_is_ipp(csid, port))
+		writel(0, csid->base + CSID_IPP_CTRL);
+	else
+		__csid_ctrl_rdi(csid, false, port);
+}
+
 static void csid_configure_stream(struct csid_device *csid, u8 enable)
 {
 	u8 i, k;
@@ -658,10 +687,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 
 	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS_980; i++) {
 		if (csid->phy.en_vc & BIT(i)) {
-			if (csid_port_is_ipp(csid, i))
-				__csid_configure_ipp_stream(csid, enable, 0);
-			else
-				__csid_configure_rdi_stream(csid, enable, i, 0);
+			__csid_configure_rdi_stream(csid, enable, i, 0);
 			__csid_configure_rx_vc(csid, 0);
 
 			for (k = 0; k < CAMSS_INIT_BUF_COUNT; k++) {
@@ -669,11 +695,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 				__csid_reg_update(csid, i);
 			}
 
-			if (csid_port_is_ipp(csid, i))
-				writel(enable ? RDI_CTRL_START_CMD : 0,
-				       csid->base + CSID_IPP_CTRL);
-			else
-				__csid_ctrl_rdi(csid, enable, i);
+			__csid_ctrl_rdi(csid, enable, i);
 		}
 	}
 }
