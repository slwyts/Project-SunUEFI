 	output = &line->output;
+	if (output->state != VFE_OUTPUT_ON)
+		goto out_unlock;
 
 	/* CSID forwards DMA completion independently of the VFE BUS error IRQ.
 	 * Serialize both paths so a delayed error IRQ cannot publish a bad frame.
@@ -714,6 +716,56 @@ void vfe_buf_done(struct vfe_device *vfe, int wm)
 	spin_unlock_irqrestore(&vfe->output_lock, flags);
 }
 
+static void vfe_arm_output_v2(struct vfe_line *line)
+{
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_output *output = &line->output;
+	const struct vfe_hw_ops *ops = vfe->res->hw_ops;
+	unsigned int i;
+
+	lockdep_assert_held(&vfe->output_lock);
+	output->state = VFE_OUTPUT_ON;
+	ops->vfe_wm_start(vfe, output->wm_idx[0], line);
+
+	for (i = 0; i < CAMSS_INIT_BUF_COUNT; i++) {
+		output->buf[i] = vfe_buf_get_pending(output);
+		if (!output->buf[i])
+			break;
+		output->gen2.active_num++;
+		ops->vfe_wm_update(vfe, output->wm_idx[0],
+				   output->buf[i]->addr[0], line);
+
+		if (!ops->addr_update)
+			ops->reg_update(vfe, line->id);
+	}
+}
+
+int vfe_start_output_980(struct camss_video *vid)
+{
+	struct vfe_line *line = container_of(vid, struct vfe_line, video_out);
+	struct vfe_device *vfe = to_vfe(line);
+	struct vfe_output *output = &line->output;
+	struct csid_device *csid = &vfe->camss->csid[vfe->id];
+	unsigned long flags;
+
+	mutex_lock(&vfe->stream_lock);
+	if (WARN_ON(output->state != VFE_OUTPUT_RESERVED)) {
+		mutex_unlock(&vfe->stream_lock);
+		return -EINVAL;
+	}
+
+	/* Configure the receiver with its path closed, then arm the WM. */
+	csid_980_prepare_port(csid, line->id);
+	spin_lock_irqsave(&vfe->output_lock, flags);
+	vfe_arm_output_v2(line);
+	csid_980_start_port(csid, line->id, output->gen2.active_num);
+	vfe->was_streaming = 1;
+	spin_unlock_irqrestore(&vfe->output_lock, flags);
+	mutex_unlock(&vfe->stream_lock);
+
+	return 0;
+}
+
 int vfe_enable_output_v2(struct vfe_line *line)
 {
 	struct vfe_device *vfe = to_vfe(line);
@@ -722,7 +774,6 @@ int vfe_enable_output_v2(struct vfe_line *line)
 	struct media_pad *sensor_pad;
 	unsigned long flags;
 	unsigned int frame_skip = 0;
-	unsigned int i;
 
