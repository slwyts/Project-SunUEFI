 	if (output->last_buffer) {
 		vb2_buffer_done(&output->last_buffer->vb.vb2_buf, state);
@@ -2100,6 +2158,8 @@ int msm_vfe_subdev_init(struct camss *camss, struct vfe_device *vfe,
 	if (!res->vfe.line_num)
 		return -EINVAL;
 
+	vfe->camss = camss;
+	vfe->id = id;
 	vfe->res = &res->vfe;
 	vfe->res->hw_ops->subdev_init(dev, vfe);
 
@@ -2152,8 +2212,6 @@ int msm_vfe_subdev_init(struct camss *camss, struct vfe_device *vfe,
 	 * Its zero active-line mask prevents MMIO until clocked WM start.
 	 */
 	spin_lock_init(&vfe->output_lock);
-	vfe->camss = camss;
