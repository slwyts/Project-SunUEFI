 	WARN_ON(output->gen2.active_num);
 
-	output->state = VFE_OUTPUT_ON;
-
 	output->sequence = 0;
 	output->frame_sequence = 0;
 	output->last_sof_ticks = 0;
@@ -762,19 +811,8 @@ int vfe_enable_output_v2(struct vfe_line *line)
 	output->wait_reg_update = 0;
 	reinit_completion(&output->reg_update);
 
-	ops->vfe_wm_start(vfe, output->wm_idx[0], line);
-
-	for (i = 0; i < CAMSS_INIT_BUF_COUNT; i++) {
-		output->buf[i] = vfe_buf_get_pending(output);
-		if (!output->buf[i])
-			break;
-		output->gen2.active_num++;
-		ops->vfe_wm_update(vfe, output->wm_idx[0],
-				   output->buf[i]->addr[0], line);
-
-		if (!ops->addr_update)
-			ops->reg_update(vfe, line->id);
-	}
+	if (!vfe->video_ops.start_output)
+		vfe_arm_output_v2(line);
 
 	spin_unlock_irqrestore(&vfe->output_lock, flags);
 
@@ -850,7 +888,8 @@ int vfe_enable_v2(struct vfe_line *line)
 	if (ret < 0)
 		goto error_enable_output;
 
-	vfe->was_streaming = 1;
+	if (!vfe->video_ops.start_output)
+		vfe->was_streaming = 1;
 
 	return 0;
 
@@ -1035,17 +1074,35 @@ static int vfe_disable_output(struct vfe_line *line)
 {
 	struct vfe_device *vfe = to_vfe(line);
 	struct vfe_output *output = &line->output;
+	struct camss *camss = vfe->camss;
+	const struct vfe_hw_ops *ops = vfe->res->hw_ops;
 	unsigned long flags;
 	unsigned int i;
 
 	spin_lock_irqsave(&vfe->output_lock, flags);
+	if (vfe->video_ops.start_output && output->state == VFE_OUTPUT_RESERVED) {
+		/* An upstream start failed before publishing any buffer. */
+		spin_unlock_irqrestore(&vfe->output_lock, flags);
+		return 0;
+	}
+	output->state = VFE_OUTPUT_STOPPING;
 	for (i = 0; i < output->wm_num; i++)
-		vfe->res->hw_ops->vfe_wm_stop(vfe, output->wm_idx[i]);
+		ops->vfe_wm_stop(vfe, output->wm_idx[i]);
+	if (vfe->video_ops.start_output)
+		csid_980_stop_port(&camss->csid[vfe->id], line->id);
 	output->gen2.active_num = 0;
 	output->frame_timeline_error = true;
 	output->frame_timeline_initialized = false;
 	spin_unlock_irqrestore(&vfe->output_lock, flags);
 
+	/*
+	 * A completion may still be returning a buffer removed from the FIFO
+	 * before STOPPING. Wait for it before the capture queue is flushed.
+	 */
+	synchronize_irq(vfe->irq);
+	if (ops->vfe_buf_done && vfe->id < camss->res->csid_num)
+		synchronize_irq(camss->csid[vfe->id].irq);
+
 	return vfe_reset(vfe);
 }
 
