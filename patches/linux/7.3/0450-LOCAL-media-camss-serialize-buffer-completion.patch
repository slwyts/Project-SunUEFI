 	struct vfe_device *vfe = to_vfe(line);
 	int ret;
 
-	ret = vfe_disable_output(line);
-	if (ret)
-		goto error;
-
-	vfe_put_output(line);
-
 	mutex_lock(&vfe->stream_lock);
-
-	vfe->stream_count--;
+	ret = vfe_disable_output(line);
+	if (!ret) {
+		vfe_put_output(line);
+		vfe->stream_count--;
+	}
 
 	mutex_unlock(&vfe->stream_lock);
 
-error:
 	return ret;
 }
 
@@ -1437,6 +1490,7 @@ int vfe_flush_buffers(struct camss_video *vid,
 	struct vfe_device *vfe = to_vfe(line);
 	struct vfe_output *output;
 	unsigned long flags;
+	unsigned int i;
 
 	output = &line->output;
 
@@ -1444,11 +1498,15 @@ int vfe_flush_buffers(struct camss_video *vid,
 
 	vfe_buf_flush_pending(output, state);
 
-	if (output->buf[0])
-		vb2_buffer_done(&output->buf[0]->vb.vb2_buf, state);
+	for (i = 0; i < ARRAY_SIZE(output->buf); i++) {
+		struct camss_buffer *buffer = output->buf[i];
+
+		if (!buffer)
+			continue;
 
-	if (output->buf[1])
