+static int nvt_input_init(void)
+{
+	const unsigned int capacity = TOUCH_DEFAULT_NUM_X * TOUCH_DEFAULT_NUM_Y;
+	struct input_dev *input;
+	void *memory;
+	int ret;
+
+	memory = kvzalloc(nvt_matrix_size(capacity), GFP_KERNEL);
+	if (!memory)
+		return -ENOMEM;
+	ts->matrix = nvt_matrix_init(memory, capacity);
+	if (!ts->matrix) {
+		kvfree(memory);
+		return -EINVAL;
+	}
+	input = input_allocate_device();
+	if (!input) {
+		ret = -ENOMEM;
+		goto free_matrix;
+	}
+	input->name = "piano NT36532 THP touchscreen";
+	input->dev.parent = &ts->client->dev;
+	input->id.bustype = BUS_SPI;
+	input->id.vendor = 0x0603;
+	input->id.product = 0x6532;
+	input->id.version = 1;
+	input_set_capability(input, EV_KEY, BTN_TOUCH);
+	input_set_abs_params(input, ABS_X, 0, NVT_MATRIX_SCREEN_WIDTH - 1, 0, 0);
+	input_set_abs_params(input, ABS_Y, 0, NVT_MATRIX_SCREEN_HEIGHT - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_X, 0,
+			     NVT_MATRIX_SCREEN_WIDTH - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_POSITION_Y, 0,
+			     NVT_MATRIX_SCREEN_HEIGHT - 1, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MAJOR, 0, NVT_MATRIX_SHAPE_MAX, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOUCH_MINOR, 0, NVT_MATRIX_SHAPE_MAX, 0, 0);
+	input_set_abs_params(input, ABS_MT_TOOL_TYPE, 0, MT_TOOL_MAX, 0, 0);
+	input_abs_set_res(input, ABS_X, NVT_MATRIX_RESOLUTION);
+	input_abs_set_res(input, ABS_Y, NVT_MATRIX_RESOLUTION);
+	input_abs_set_res(input, ABS_MT_POSITION_X, NVT_MATRIX_RESOLUTION);
+	input_abs_set_res(input, ABS_MT_POSITION_Y, NVT_MATRIX_RESOLUTION);
+	input_abs_set_res(input, ABS_MT_TOUCH_MAJOR, NVT_MATRIX_RESOLUTION);
+	input_abs_set_res(input, ABS_MT_TOUCH_MINOR, NVT_MATRIX_RESOLUTION);
+	ret = input_mt_init_slots(input, NVT_MATRIX_MAX_POINTS, INPUT_MT_DIRECT);
+	if (ret)
+		goto free_input;
+	ret = input_register_device(input);
+	if (ret)
+		goto free_input;
+	ts->input = input;
+	return 0;
+
+free_input:
+	input_free_device(input);
+free_matrix:
+	kvfree(ts->matrix);
+	ts->matrix = NULL;
+	return ret;
+}
+
+static void nvt_input_free(void)
+{
+	if (ts->input) {
+		nvt_input_release(false);
+		input_unregister_device(ts->input);
+		ts->input = NULL;
+	}
+	kvfree(ts->matrix);
+	ts->matrix = NULL;
+}
