+static void nvt_input_release(bool palms)
+{
+	bool active = false;
+	unsigned int s;
+
+	if (!ts->input)
+		return;
+	for (s = 0; s < NVT_MATRIX_MAX_POINTS; s++) {
+		struct nvt_input_slot *slot = &ts->input_slots[s];
+
+		if (!slot->active)
+			continue;
+		input_mt_slot(ts->input, s);
+		if (palms)
+			input_report_abs(ts->input, ABS_MT_TOOL_TYPE, MT_TOOL_PALM);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, false);
+		slot->active = false;
+		slot->palm = false;
+		active = true;
+	}
+	if (active) {
+		input_report_key(ts->input, BTN_TOUCH, 0);
+		input_sync(ts->input);
+	}
+}
+
+static void nvt_input_reset(void)
+{
+	nvt_input_release(false);
+	if (ts->matrix)
+		nvt_matrix_reset(ts->matrix);
+}
