 .../touchscreen/nt36532e/nt36xxx-matrix.c     | 509 ++++++++++++++++++
 .../touchscreen/nt36532e/nt36xxx-matrix.h     |  40 ++
 drivers/input/touchscreen/nt36532e/nt36xxx.c  | 349 +++++++++++-
 drivers/input/touchscreen/nt36532e/nt36xxx.h  |  10 +
 .../touchscreen/nt36532e/nt36xxx_fw_update.c  |   2 +-
 6 files changed, 881 insertions(+), 31 deletions(-)
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx-matrix.c
 create mode 100644 drivers/input/touchscreen/nt36532e/nt36xxx-matrix.h

