+static void nvt_input_report(const struct nvt_matrix_frame *frame)
+{
+	bool taken[NVT_MATRIX_MAX_POINTS] = { false };
+	bool ended[NVT_MATRIX_MAX_POINTS] = { false };
+	int matches[NVT_MATRIX_MAX_POINTS];
+	unsigned int s, p;
+	int first = -1;
+
+	if (!frame->count) {
+		nvt_input_release(false);
+		return;
+	}
+
+	for (s = 0; s < NVT_MATRIX_MAX_POINTS; s++) {
+		struct nvt_input_slot *slot = &ts->input_slots[s];
+		int best = -1, distance = 400 * 400;
+
+		matches[s] = -1;
+		if (!slot->active)
+			continue;
+		for (p = 0; p < frame->count; p++) {
+			int dx = frame->points[p].x - slot->x;
+			int dy = frame->points[p].y - slot->y;
+			int d = dx * dx + dy * dy;
+
+			if (!taken[p] && d < distance) {
+				best = p;
+				distance = d;
+			}
+		}
+		if (best < 0) {
+			ended[s] = true;
+			continue;
+		}
+		taken[best] = true;
+		matches[s] = best;
+	}
+	for (p = 0; p < frame->count; p++) {
+		if (taken[p])
+			continue;
+		for (s = 0; s < NVT_MATRIX_MAX_POINTS; s++)
+			if (!ts->input_slots[s].active && matches[s] < 0)
+				break;
+		if (s == NVT_MATRIX_MAX_POINTS)
+			break;
+		matches[s] = p;
+	}
+	for (s = 0; s < NVT_MATRIX_MAX_POINTS; s++) {
+		struct nvt_input_slot *slot = &ts->input_slots[s];
+		const struct nvt_matrix_point *point;
+
+		if (ended[s]) {
+			input_mt_slot(ts->input, s);
+			input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, false);
+			slot->active = false;
+			slot->palm = false;
+			continue;
+		}
+		if (matches[s] < 0)
+			continue;
+		point = &frame->points[matches[s]];
+		slot->palm |= point->palm;
+		slot->active = true;
+		slot->x = point->x;
+		slot->y = point->y;
+		input_mt_slot(ts->input, s);
+		/* libinput must see a palm's type before its tracking ID. */
+		input_report_abs(ts->input, ABS_MT_TOOL_TYPE,
+				 slot->palm ? MT_TOOL_PALM : MT_TOOL_FINGER);
+		input_mt_report_slot_state(ts->input,
+					   slot->palm ? MT_TOOL_PALM : MT_TOOL_FINGER,
+					   true);
+		input_report_abs(ts->input, ABS_MT_POSITION_X, point->x);
+		input_report_abs(ts->input, ABS_MT_POSITION_Y, point->y);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MAJOR, point->major);
+		input_report_abs(ts->input, ABS_MT_TOUCH_MINOR, point->minor);
+		if (!slot->palm && first < 0)
+			first = s;
+	}
+	if (first >= 0) {
+		input_report_abs(ts->input, ABS_X, ts->input_slots[first].x);
+		input_report_abs(ts->input, ABS_Y, ts->input_slots[first].y);
+	}
+	/* Pointer emulation counts palms as touches; count fingers here. */
+	input_report_key(ts->input, BTN_TOUCH, first >= 0);
+	input_sync(ts->input);
+}
