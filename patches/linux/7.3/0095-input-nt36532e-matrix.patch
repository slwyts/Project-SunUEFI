+/* The outer checksum was checked by nvt_matrix_process(). A type29 must
+ * also contain its four pen arrays, inner checksum and valid hand quarter.
+ */
+static bool nvt_input_pen_frame_valid(const u8 *payload, size_t bytes)
+{
+	const u8 *metadata;
+	size_t nodes, pen_nodes, trailer, required, outer_end, inner_end, i;
+	u32 count, sum = 0;
+	u16 checksum;
+
+	if (bytes < 100 || payload[56] != 29)
+		return false;
+	metadata = payload + 64;
+	nodes = (size_t)payload[48] * payload[49];
+	pen_nodes = (size_t)metadata[7] * metadata[8] +
+		    (size_t)metadata[9] * metadata[10];
+	if (nodes != TOUCH_DEFAULT_NUM_X * TOUCH_DEFAULT_NUM_Y ||
+	    !metadata[7] || !metadata[8] || !metadata[9] || !metadata[10] ||
+	    metadata[11] < 1 || metadata[11] > 4 ||
+	    get_unaligned_le16(metadata + 12) != nodes / 2)
+		return false;
+	trailer = 100 + 4 * pen_nodes;
+	required = trailer + 20 + nodes / 2;
+	outer_end = 20 + (size_t)get_unaligned_le32(payload + 8) * 4;
+	if (required > bytes || required > outer_end)
+		return false;
+	checksum = get_unaligned_le16(payload + trailer + 4);
+	count = get_unaligned_le32(payload + trailer + 8);
+	if (!count || count > (trailer + 4 - 20) / 4 ||
+	    get_unaligned_le16(payload + trailer + 12) != (u16)~checksum ||
+	    get_unaligned_le32(payload + trailer + 16) != ~count)
+		return false;
+	inner_end = 20 + (size_t)count * 4;
+	if (inner_end < trailer || inner_end > trailer + 4)
+		return false;
+	for (i = 20; i < inner_end; i += 2)
+		sum += get_unaligned_le16(payload + i);
+	return (u16)(0U - sum) == checksum;
+}
+
+static void nvt_input_frame(void)
+{
+	const u8 *payload = ts->thp_frame + NVT_THP_HEADER_LEN;
+	struct nvt_matrix_frame frame;
+	int ret;
+
+	ret = nvt_matrix_process(ts->matrix, payload, ts->thp_payload_len, &frame);
+	if (ret < 0)
+		return;
+	if (!ret && ts->thp_payload_len > 56 && payload[56] == 29) {
+		if (!nvt_input_pen_frame_valid(payload, ts->thp_payload_len))
+			return;
+		nvt_input_release(true);
+	}
+	if (ret > 0)
+		nvt_input_report(&frame);
+}
