+/* NT36532 host-computed finger contacts from mutual capacitance frames. */
+#include "nt36xxx-matrix.h"
+
+#include <linux/errno.h>
+#include <linux/math.h>
+#include <linux/math64.h>
+#include <linux/sort.h>
+#include <linux/string.h>
+#include <linux/unaligned.h>
+
+#define NVT_MATRIX_MAX_NODES 4096
+#define NVT_MATRIX_PROBE_FRAMES 16
+#define NVT_MATRIX_REF_FRAMES 32
+#define NVT_MATRIX_THRESHOLD 200
+#define NVT_MATRIX_PALM_CELLS 70
+#define NVT_MATRIX_PANEL_WIDTH 239
+#define NVT_MATRIX_PANEL_HEIGHT 163
+#define NVT_MATRIX_COORD_SCALE 16
+
+struct nvt_matrix_area {
+	struct nvt_matrix_point point;
+	bool reported;
+};
+
+struct nvt_matrix {
+	unsigned int capacity;
+	unsigned int rows, cols, nodes;
+	unsigned int probe_count, ref_count;
+	int type;
+	bool have_reference;
+	u8 probe_types[256];
+	s32 *delta;
+	s16 *reference, *samples;
+	u16 *queue;
+	u8 *labels;
+	s32 line[256];
+	s32 physical_x[256], physical_y[256];
+	u64 cell_variance_x, cell_variance_y;
+	struct nvt_matrix_area areas[NVT_MATRIX_MAX_POINTS];
+};
+
+size_t nvt_matrix_size(unsigned int capacity)
+{
+	if (!capacity || capacity > NVT_MATRIX_MAX_NODES)
+		return 0;
+
+	return sizeof(struct nvt_matrix) + capacity *
+		(sizeof(s32) + (NVT_MATRIX_REF_FRAMES + 1) * sizeof(s16) +
+		 sizeof(u16) + sizeof(u8));
+}
+
+void nvt_matrix_reset(struct nvt_matrix *matrix)
+{
+	if (!matrix)
+		return;
+
+	matrix->rows = 0;
+	matrix->cols = 0;
+	matrix->nodes = 0;
+	matrix->probe_count = 0;
+	matrix->ref_count = 0;
+	matrix->type = -1;
+	matrix->have_reference = false;
+	memset(matrix->probe_types, 0, sizeof(matrix->probe_types));
+}
+
+struct nvt_matrix *nvt_matrix_init(void *memory, unsigned int capacity)
+{
+	struct nvt_matrix *matrix = memory;
+
+	if (!memory || !nvt_matrix_size(capacity))
+		return NULL;
+
+	memset(matrix, 0, sizeof(*matrix));
+	matrix->capacity = capacity;
+	matrix->delta = (s32 *)(matrix + 1);
+	matrix->reference = (s16 *)(matrix->delta + capacity);
+	matrix->samples = matrix->reference + capacity;
+	matrix->queue = (u16 *)(matrix->samples +
+			       NVT_MATRIX_REF_FRAMES * capacity);
+	matrix->labels = (u8 *)(matrix->queue + capacity);
+	nvt_matrix_reset(matrix);
+	return matrix;
+}
+
+static int nvt_matrix_checksum(const u8 *payload, size_t bytes,
+			       size_t *covered)
+{
+	u16 checksum, inverse;
+	s32 dwords;
+	u32 sum = 0;
+	size_t i;
+
+	if (bytes < 64)
+		return -EMSGSIZE;
+
+	checksum = get_unaligned_le16(payload + 4);
+	inverse = get_unaligned_le16(payload + 12);
+	dwords = (s32)get_unaligned_le32(payload + 8);
+	if (inverse != (u16)~checksum ||
+	    get_unaligned_le32(payload + 16) != (u32)~dwords || dwords <= 0)
+		return -EBADMSG;
+	if ((size_t)dwords > (bytes - 20) / 4)
+		return -EMSGSIZE;
+
+	*covered = 20 + (size_t)dwords * 4;
+	if (*covered < 64)
+		return -EMSGSIZE;
+	for (i = 20; i < *covered; i += 2)
+		sum += get_unaligned_le16(payload + i);
+	return (u16)(0 - sum) == checksum ? 0 : -EBADMSG;
+}
+
+static int nvt_matrix_compare(const void *left, const void *right)
+{
+	s32 a = *(const s32 *)left, b = *(const s32 *)right;
+
+	return (a > b) - (a < b);
+}
+
+/* Equal values finish together. Limit partition work before using the
+ * kernel's bounded sort, so unusual sensor data cannot force quadratic work.
+ */
+static s32 nvt_matrix_median(s32 *line, unsigned int count)
+{
+	int first = 0, last = count - 1, middle = count / 2;
+	unsigned int budget = count * 3;
+
+	while (first < last) {
+		s32 a = line[first], b = line[first + (last - first) / 2];
+		s32 c = line[last], pivot;
+		int lower = first, upper = last, index = first;
+		unsigned int remaining = last - first + 1;
+
+		if (remaining > budget) {
+			sort(line + first, remaining, sizeof(*line),
+			     nvt_matrix_compare, NULL);
+			return line[middle];
+		}
+		budget -= remaining;
+		if (a > b) {
+			s32 value = a;
+
+			a = b;
+			b = value;
+		}
+		pivot = b < c ? b : (a > c ? a : c);
+		while (index <= upper) {
+			s32 value = line[index];
+
+			if (value < pivot) {
+				line[index++] = line[lower];
+				line[lower++] = value;
+			} else if (value > pivot) {
+				line[index] = line[upper];
+				line[upper--] = value;
+			} else {
+				index++;
+			}
+		}
+		if (middle < lower)
+			last = lower - 1;
+		else if (middle > upper)
+			first = upper + 1;
+		else
+			return pivot;
+	}
+	return line[middle];
+}
+
+static void nvt_matrix_geometry(struct nvt_matrix *matrix)
+{
+	unsigned int width = NVT_MATRIX_PANEL_WIDTH * NVT_MATRIX_RESOLUTION;
+	unsigned int height = NVT_MATRIX_PANEL_HEIGHT * NVT_MATRIX_RESOLUTION;
+	unsigned int i;
+
+	/* Physical centres use 1/16 input unit; their second moments use Q8.
+	 * Precomputing centres keeps division out of the flood-fill loop.
+	 */
+	for (i = 0; i < matrix->cols; i++)
+		matrix->physical_x[i] = ((2 * i + 1) * width *
+			NVT_MATRIX_COORD_SCALE + matrix->cols) / (2 * matrix->cols);
+	for (i = 0; i < matrix->rows; i++)
+		matrix->physical_y[i] = ((2 * i + 1) * height *
+			NVT_MATRIX_COORD_SCALE + matrix->rows) / (2 * matrix->rows);
+	matrix->cell_variance_x = div64_u64((u64)width * width *
+		NVT_MATRIX_COORD_SCALE * NVT_MATRIX_COORD_SCALE,
+		12 * matrix->cols * matrix->cols);
+	matrix->cell_variance_y = div64_u64((u64)height * height *
+		NVT_MATRIX_COORD_SCALE * NVT_MATRIX_COORD_SCALE,
+		12 * matrix->rows * matrix->rows);
+}
+
+static void nvt_matrix_build_reference(struct nvt_matrix *matrix)
+{
+	unsigned int node, frame;
+
+	for (node = 0; node < matrix->nodes; node++) {
+		for (frame = 0; frame < NVT_MATRIX_REF_FRAMES; frame++) {
+			unsigned int sample = frame * matrix->capacity + node;
+
+			matrix->line[frame] = matrix->samples[sample];
+		}
+		matrix->reference[node] =
+			nvt_matrix_median(matrix->line, NVT_MATRIX_REF_FRAMES);
+	}
+	matrix->have_reference = true;
+}
+
+static s32 nvt_matrix_filter(struct nvt_matrix *matrix)
+{
+	s32 common, maximum = 0;
+	unsigned int row, col, node;
+
+	for (col = 0; col < matrix->cols; col++) {
+		for (row = 0; row < matrix->rows; row++)
+			matrix->line[row] = matrix->delta[row * matrix->cols + col];
+		common = nvt_matrix_median(matrix->line, matrix->rows);
+		for (row = 0; row < matrix->rows; row++)
+			matrix->delta[row * matrix->cols + col] -= common;
+	}
+	for (row = 0; row < matrix->rows; row++) {
+		for (col = 0; col < matrix->cols; col++)
+			matrix->line[col] = matrix->delta[row * matrix->cols + col];
+		common = nvt_matrix_median(matrix->line, matrix->cols);
+		for (col = 0; col < matrix->cols; col++)
+			matrix->delta[row * matrix->cols + col] -= common;
+	}
+	for (node = 0; node < matrix->nodes; node++)
+		if (matrix->delta[node] > maximum)
+			maximum = matrix->delta[node];
+	return maximum;
+}
+
+static void nvt_matrix_position(const struct nvt_matrix *matrix,
+				u64 weight, u64 x2, u64 y2,
+				struct nvt_matrix_point *point)
+{
+	u64 width = 2 * matrix->cols * weight;
+	u64 height = 2 * matrix->rows * weight;
+
+	point->x = div64_u64(x2 * NVT_MATRIX_SCREEN_WIDTH, width);
+	point->y = div64_u64((height - y2) * NVT_MATRIX_SCREEN_HEIGHT, height);
+}
+
+static void nvt_matrix_queue(struct nvt_matrix *matrix, unsigned int node,
+			     u8 label, unsigned int *tail)
+{
+	if (matrix->labels[node] || matrix->delta[node] < NVT_MATRIX_THRESHOLD)
+		return;
+
+	matrix->labels[node] = label;
+	matrix->queue[(*tail)++] = node;
+}
+
+static u16 nvt_matrix_axis(u64 variance)
+{
+	/* sqrt(Q8) is Q4; four standard deviations rounded to input units. */
+	u32 axis = (int_sqrt64(variance) + 2) / 4;
+
+	if (axis > NVT_MATRIX_SHAPE_MAX)
+		axis = NVT_MATRIX_SHAPE_MAX;
+	return axis;
+}
+
+static void nvt_matrix_measure(struct nvt_matrix *matrix, unsigned int start,
+			       u8 label)
+{
+	struct nvt_matrix_area *area = &matrix->areas[label - 1];
+	s64 sx = 0, sy = 0, sxx = 0, syy = 0, sxy = 0;
+	s64 vx, vy, covariance, trace;
+	u64 weight = 0, x2 = 0, y2 = 0, count_squared, discriminant, root;
+	unsigned int head = 0, tail = 0;
+
+	memset(area, 0, sizeof(*area));
+	nvt_matrix_queue(matrix, start, label, &tail);
+	while (head < tail) {
+		unsigned int node = matrix->queue[head++];
+		unsigned int row = node / matrix->cols, col = node % matrix->cols;
+		s32 x = matrix->physical_x[col], y = matrix->physical_y[row];
+		u64 value = matrix->delta[node];
+
+		sx += x;
+		sy += y;
+		sxx += (s64)x * x;
+		syy += (s64)y * y;
+		sxy += (s64)x * y;
+		weight += value;
+		x2 += value * (2 * col + 1);
+		y2 += value * (2 * row + 1);
+		if (row)
+			nvt_matrix_queue(matrix, node - matrix->cols, label, &tail);
+		if (row + 1 < matrix->rows)
+			nvt_matrix_queue(matrix, node + matrix->cols, label, &tail);
+		if (col)
+			nvt_matrix_queue(matrix, node - 1, label, &tail);
+		if (col + 1 < matrix->cols)
+			nvt_matrix_queue(matrix, node + 1, label, &tail);
+	}
+
+	count_squared = (u64)tail * tail;
+	vx = div64_s64((s64)tail * sxx - sx * sx, count_squared) +
+		matrix->cell_variance_x;
+	vy = div64_s64((s64)tail * syy - sy * sy, count_squared) +
+		matrix->cell_variance_y;
+	covariance = div64_s64((s64)tail * sxy - sx * sy, count_squared);
+	trace = vx + vy;
+	discriminant = (vx - vy) * (vx - vy) + 4 * covariance * covariance;
+	root = int_sqrt64(discriminant);
+	area->point.major = nvt_matrix_axis((trace + root) / 2);
+	area->point.minor = root < (u64)trace ?
+		nvt_matrix_axis((trace - root) / 2) : 0;
+	area->point.palm = tail >= NVT_MATRIX_PALM_CELLS;
+	nvt_matrix_position(matrix, weight, x2, y2, &area->point);
+}
+
+static bool nvt_matrix_peak(const struct nvt_matrix *matrix, int row, int col)
+{
+	s32 value = matrix->delta[row * matrix->cols + col];
+	int dr, dc;
+
+	for (dr = -1; dr <= 1; dr++) {
+		for (dc = -1; dc <= 1; dc++) {
+			int rr = row + dr, cc = col + dc;
+			s32 neighbour;
+
+			if ((!dr && !dc) || rr < 0 || cc < 0 ||
+			    rr >= (int)matrix->rows || cc >= (int)matrix->cols)
+				continue;
+			neighbour = matrix->delta[rr * matrix->cols + cc];
+			if (neighbour > value ||
+			    (neighbour == value && (dr < 0 || (!dr && dc < 0))))
+				return false;
+		}
+	}
+	return true;
+}
+
+static void nvt_matrix_centroid(const struct nvt_matrix *matrix, int row,
+				int col, struct nvt_matrix_point *point)
+{
+	u64 weight = 0, x2 = 0, y2 = 0;
+	int dr, dc;
+
+	for (dr = -1; dr <= 1; dr++) {
+		for (dc = -1; dc <= 1; dc++) {
+			int rr = row + dr, cc = col + dc;
+			s32 value;
+
+			if (rr < 0 || cc < 0 || rr >= (int)matrix->rows ||
+			    cc >= (int)matrix->cols)
+				continue;
+			value = matrix->delta[rr * matrix->cols + cc];
+			if (value <= 0)
+				continue;
+			weight += value;
+			x2 += (u64)value * (2 * cc + 1);
+			y2 += (u64)value * (2 * rr + 1);
+		}
+	}
+	nvt_matrix_position(matrix, weight, x2, y2, point);
+}
+
+static void nvt_matrix_points(struct nvt_matrix *matrix,
+			      struct nvt_matrix_frame *out)
+{
+	unsigned int row, col, used = 0;
+
+	memset(matrix->labels, 0, matrix->nodes);
+	for (row = 0; row < matrix->rows; row++) {
+		for (col = 0; col < matrix->cols; col++) {
+			unsigned int node = row * matrix->cols + col;
+			struct nvt_matrix_area *area;
+			u8 label;
+
+			if (matrix->delta[node] < NVT_MATRIX_THRESHOLD ||
+			    !nvt_matrix_peak(matrix, row, col))
+				continue;
+			label = matrix->labels[node];
+			if (!label) {
+				if (used == NVT_MATRIX_MAX_POINTS)
+					continue;
+				label = ++used;
+				nvt_matrix_measure(matrix, node, label);
+			}
+			area = &matrix->areas[label - 1];
+			if (area->point.palm && area->reported)
+				continue;
+			out->points[out->count] = area->point;
+			if (area->point.palm)
+				area->reported = true;
+			else
+				nvt_matrix_centroid(matrix, row, col,
+						    &out->points[out->count]);
+			if (++out->count == NVT_MATRIX_MAX_POINTS)
+				return;
+		}
+	}
+}
+
+int nvt_matrix_process(struct nvt_matrix *matrix, const u8 *payload,
+		       size_t bytes, struct nvt_matrix_frame *out)
+{
+	unsigned int rows, cols, nodes, type, i;
+	size_t covered;
+	s32 minimum, maximum;
+	int ret;
+
+	if (!matrix || !payload || !out)
+		return -EINVAL;
+	out->count = 0;
+	ret = nvt_matrix_checksum(payload, bytes, &covered);
+	if (ret)
+		return ret;
+	type = payload[56];
+	if (type == 6 || type == 7 || type == 9 || type == 17 || type == 29)
+		return 0;
+
+	cols = payload[48];
+	rows = payload[49];
+	nodes = rows * cols;
+	if (!nodes || nodes > matrix->capacity)
+		return -EINVAL;
+	if (64 + nodes * sizeof(s16) > covered)
+		return -EMSGSIZE;
+
+	if (matrix->type < 0) {
+		matrix->probe_types[type]++;
+		if (++matrix->probe_count == NVT_MATRIX_PROBE_FRAMES) {
+			matrix->type = 0;
+			for (i = 1; i < 256; i++)
+				if (matrix->probe_types[i] >
+				    matrix->probe_types[matrix->type])
+					matrix->type = i;
+		}
+		return 0;
+	}
+	if (type != (unsigned int)matrix->type)
+		return 0;
+	if (!matrix->ref_count) {
+		matrix->rows = rows;
+		matrix->cols = cols;
+		matrix->nodes = nodes;
+		nvt_matrix_geometry(matrix);
+	}
+	if (rows != matrix->rows || cols != matrix->cols)
+		return -EPROTO;
+	if (!matrix->have_reference) {
+		for (i = 0; i < nodes; i++)
+			matrix->samples[matrix->ref_count * matrix->capacity + i] =
+				(s16)get_unaligned_le16(payload + 64 + i * 2);
+		if (++matrix->ref_count == NVT_MATRIX_REF_FRAMES)
+			nvt_matrix_build_reference(matrix);
+		return 0;
+	}
+
+	minimum = (s16)get_unaligned_le16(payload + 64) -
+		matrix->reference[0];
+	maximum = minimum;
+	for (i = 0; i < nodes; i++) {
+		matrix->delta[i] = (s16)get_unaligned_le16(payload + 64 + i * 2) -
+			matrix->reference[i];
+		if (matrix->delta[i] < minimum)
+			minimum = matrix->delta[i];
+		if (matrix->delta[i] > maximum)
+			maximum = matrix->delta[i];
+	}
+	/* Two median subtractions bound the maximum by twice the raw range.
+	 * Below threshold/4, baseline drift applies and no contact can exist.
+	 */
+	if (maximum - minimum < NVT_MATRIX_THRESHOLD / 4)
+		maximum = 0;
+	else
+		maximum = nvt_matrix_filter(matrix);
+	if (maximum < NVT_MATRIX_THRESHOLD / 2)
+		for (i = 0; i < nodes; i++)
+			matrix->reference[i] +=
+				((s16)get_unaligned_le16(payload + 64 + i * 2) -
+				 matrix->reference[i]) / 8;
+	if (maximum >= NVT_MATRIX_THRESHOLD)
+		nvt_matrix_points(matrix, out);
+	return 1;
+}
diff --git a/drivers/input/touchscreen/nt36532e/nt36xxx-matrix.h b/drivers/input/touchscreen/nt36532e/nt36xxx-matrix.h
new file mode 100644
index 0000000000..771c05b538
--- /dev/null
+++ b/drivers/input/touchscreen/nt36532e/nt36xxx-matrix.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _NT36XXX_MATRIX_H
+#define _NT36XXX_MATRIX_H
+
+#include <linux/types.h>
+
+#define NVT_MATRIX_MAX_POINTS 10
+#define NVT_MATRIX_SCREEN_WIDTH 3200
+#define NVT_MATRIX_SCREEN_HEIGHT 2136
+#define NVT_MATRIX_RESOLUTION 13
+#define NVT_MATRIX_SHAPE_MAX 3848
+
+struct nvt_matrix;
+
+struct nvt_matrix_point {
+	s32 x, y;
+	u16 major, minor;
+	bool palm;
+};
+
+struct nvt_matrix_frame {
+	unsigned int count;
+	struct nvt_matrix_point points[NVT_MATRIX_MAX_POINTS];
+};
+
+/* Capacity is the maximum node count, from 1 through 4096. The caller
+ * supplies aligned storage of nvt_matrix_size() bytes for the full lifetime.
+ */
+size_t nvt_matrix_size(unsigned int capacity);
+struct nvt_matrix *nvt_matrix_init(void *memory, unsigned int capacity);
+void nvt_matrix_reset(struct nvt_matrix *matrix);
+
+/* The payload begins after the SPI/event prefix. Return 1 for a decoded
+ * frame (including zero contacts), 0 while learning or for another type,
+ * and a negative errno for a malformed frame. No input state is retained.
+ */
+int nvt_matrix_process(struct nvt_matrix *matrix, const u8 *payload,
+		       size_t bytes, struct nvt_matrix_frame *out);
