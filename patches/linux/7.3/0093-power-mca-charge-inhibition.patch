+static void piano_mca_api_cp_stop_recovery_lifecycle_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	KUNIT_ASSERT_EQ(
+		test,
+		piano_mca_api_set(f,
+				  POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
+		0);
+	KUNIT_ASSERT_EQ(test, piano_mca_suspend(f->mca.dev), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_resume(f->mca.dev), 0);
+	flush_delayed_work(&f->mca.poll);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+	KUNIT_EXPECT_EQ(test, piano_mca_api_get(f),
+			POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
+	f->remote_generation += 2;
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_DOWN);
+	f->pmic_enabled = true;
+	f->fcc_ma = 500;
+	piano_mca_pdr_notify(&f->mca, SERVREG_SERVICE_STATE_UP);
+	f->only_5v = true;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_ASSERT_EQ(
+		test, piano_mca_api_set(f, POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO),
+		0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_OFF);
+}
