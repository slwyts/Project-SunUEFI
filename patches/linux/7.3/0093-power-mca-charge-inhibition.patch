+#define pmic_glink_send_generation piano_mca_test_send_generation
+#define pmic_glink_get_generation piano_mca_test_get_generation
+
+/* Include the actual implementation, not a second copy of its state machine. */
+#undef module_auxiliary_driver
+#define module_auxiliary_driver(...)
+#define pmic_glink_send piano_mca_test_send
+#define power_supply_changed piano_mca_test_psy_changed
+#include "piano_mca.c"
+#undef power_supply_changed
+#undef pmic_glink_send
+#undef pmic_glink_send_generation
+#undef pmic_glink_get_generation
+
+struct piano_mca_test_gauge {
+	int voltage_uv;
+	int current_ua;
+	int temp;
+	int error;
+};
+
+struct piano_mca_test {
+	struct piano_mca mca;
+	atomic_t work_runs;
+	struct completion blocker_started, blocker_release;
+	bool block_once;
+	u32 verify_process;
+	unsigned int start_writes;
+	unsigned int cleanup_writes;
+	unsigned int cleanup_failures;
+	unsigned int remote_generation;
+	unsigned int pd_clear_failures;
+	unsigned int pd_clears_after_final;
+	u32 pd_verified;
+	u32 last_vdm;
+	u8 seed[MCA_VDM_LEN];
+	u8 challenge[20];
+	bool complete_auth;
+	bool final_write_seen;
+	bool lose_final_ack;
+	bool lose_start_ack;
+	bool restart_on_pdos;
+	unsigned int pps_writes;
+	unsigned int icl_writes;
+	u32 icl_ma;
+	unsigned int fixed_voltage_writes;
+	unsigned int cp_stop_failures;
+	unsigned int cp_enable_writes;
+	bool cp_enabled;
+	struct piano_mca_test_gauge gauge[2];
+	u32 vbus_uv;
+	int pack_temp;
+	int pack_read_failures;
+	u32 fv_mv;
+	u32 fcc_ma;
+	u32 iterm_ma;
+	unsigned int iterm_writes;
+	unsigned int iterm_readbacks;
+	int iterm_write_failures;
+	int iterm_read_error;
+	bool lose_iterm_ack;
+	bool replug_on_iterm_write;
+	bool restart_on_iterm_write;
+	bool pmic_enabled;
+	unsigned int pmic_enable_writes;
+	unsigned int pmic_disable_writes;
+	unsigned int pmic_enable_readbacks;
+	int pmic_enable_write_failures;
+	int pmic_enable_read_error;
+	bool lose_pmic_enable_ack;
+	bool ignore_pmic_enable;
+	bool replug_on_enable_read;
+	bool restart_on_enable_read;
+	bool offer_cp_apdo;
+	bool only_5v;
+	unsigned int fv_writes;
+	unsigned int fcc_writes;
+	unsigned int fcc_positive_writes;
+	unsigned int fcc_500_writes;
+	unsigned int fcc_readbacks;
+	int fcc_write_failures;
+	int fv_write_failures;
+	bool lose_fv_ack;
+	bool ignore_fcc;
+	int fv_read_error;
+	unsigned int events;
+	unsigned int last_stop_event;
+	unsigned int last_fv_event;
+	unsigned int last_iterm_write_event;
+	unsigned int last_fcc_event;
+	unsigned int last_pmic_enable_event;
+	unsigned int last_pmic_disable_event;
+	unsigned int last_pps_event;
