+static int piano_mca_test_gauge_get(struct power_supply *psy,
+				    enum power_supply_property property,
+				    union power_supply_propval *value)
+{
+	struct piano_mca_test_gauge *gauge = power_supply_get_drvdata(psy);
+
+	if (gauge->error)
+		return gauge->error;
+
+	switch (property) {
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		value->intval = gauge->voltage_uv;
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		value->intval = gauge->current_ua;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		value->intval = gauge->temp;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int piano_mca_test_register_gauges(struct kunit *test)
+{
+	struct piano_mca_test *fixture = test->priv;
+	static const enum power_supply_property properties[] = {
+		POWER_SUPPLY_PROP_VOLTAGE_NOW,
+		POWER_SUPPLY_PROP_CURRENT_NOW,
+		POWER_SUPPLY_PROP_TEMP,
+	};
+	static const struct power_supply_desc descriptions[] = {
+		{
+			.name = "bq27z561-0",
+			.type = POWER_SUPPLY_TYPE_BATTERY,
+			.properties = properties,
+			.num_properties = ARRAY_SIZE(properties),
+			.get_property = piano_mca_test_gauge_get,
+		},
+		{
+			.name = "bq27z561-1",
+			.type = POWER_SUPPLY_TYPE_BATTERY,
+			.properties = properties,
+			.num_properties = ARRAY_SIZE(properties),
+			.get_property = piano_mca_test_gauge_get,
+		},
+	};
+	int index;
+
+	for (index = 0; index < ARRAY_SIZE(descriptions); index++) {
+		struct power_supply_config config = {
+			.drv_data = &fixture->gauge[index],
+		};
+		struct power_supply *supply;
+
+		supply = devm_power_supply_register(
+			fixture->mca.dev, &descriptions[index], &config);
+		if (IS_ERR(supply))
+			return PTR_ERR(supply);
+	}
+	return 0;
+}
+
+static int piano_mca_test_cp_get(struct power_supply *psy,
+				 enum power_supply_property property,
+				 union power_supply_propval *value)
+{
+	struct piano_mca_test *fixture = power_supply_get_drvdata(psy);
+
+	if ((int)property == fixture->cp_read_error_property)
+		return -EIO;
+	switch (property) {
+	case POWER_SUPPLY_PROP_ONLINE:
+		value->intval = fixture->cp_enabled;
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		value->intval = fixture->cp_voltage_uv;
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+		value->intval = fixture->cp_current_ua;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+		value->intval = fixture->cp_temp;
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int piano_mca_test_cp_set(struct power_supply *psy,
+				 enum power_supply_property property,
+				 const union power_supply_propval *value)
+{
+	struct piano_mca_test *fixture = power_supply_get_drvdata(psy);
+
+	if (property == POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT)
+		return 0;
+	if (property != POWER_SUPPLY_PROP_ONLINE)
+		return -EINVAL;
+	if (value->intval)
+		fixture->cp_enable_writes++;
+	if (!value->intval && fixture->cp_stop_failures) {
+		fixture->cp_stop_failures--;
+		return -EIO;
+	}
+	fixture->cp_enabled = value->intval;
+	if (!value->intval)
+		fixture->last_stop_event = ++fixture->events;
+	return 0;
+}
