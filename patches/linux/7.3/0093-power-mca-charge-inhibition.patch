+/* Called with the poll drained, or by the sole charging worker. */
+static int piano_mca_inhibit_charging(struct piano_mca *mca,
+				     unsigned int generation,
+				     unsigned int connection)
+{
+	int ret;
+
+	/* Remember the stop reason if confirmation must be retried. */
+	if (mca->cp == MCA_CP_OPENING || mca->cp == MCA_CP_ON)
+		mca->inhibit_stopped_cp = true;
+	ret = piano_mca_cp_stop(mca, "charging inhibited");
+	if (ret)
+		return ret;
+	if (!READ_ONCE(mca->service_up))
+		return -ENODEV;
+
+	return piano_mca_normal_pause(mca, generation, connection);
+}
