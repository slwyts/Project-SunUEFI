+static int piano_mca_usb_set_property(struct power_supply *psy,
+				      enum power_supply_property psp,
+				      const union power_supply_propval *val)
+{
+	struct piano_mca *mca = power_supply_get_drvdata(psy);
+	unsigned int generation, connection;
+	bool inhibit, changed = false;
+	u32 old_ma, ua = val->intval;
+	int ret = 0;
+
+	if (psp != POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR &&
+	    psp != POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT)
+		return -EINVAL;
+	if (!charge_policy || !cp_charge || !charge_current)
+		return -EOPNOTSUPP;
+	if (psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT) {
+		if (val->intval < 0 || ua > MCA_CP_IBAT_MAX_MA * 1000 || ua % 1000 ||
+		    (ua && ua < MCA_FCC_MIN_MA * 1000))
+			return -EINVAL;
+	} else if (val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO &&
+		   val->intval != POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE) {
+		return -EINVAL;
+	}
+
+	/* Wait for the complete poll decision; never drain work under its lock. */
+	mutex_lock(&mca->policy_lock);
+	if (mca->policy_stopped) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	if (psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT) {
+		old_ma = piano_mca_charge_limit(mca);
+		WRITE_ONCE(mca->charge_limit_ua, ua);
+		ret = piano_mca_update_charge_limit(mca, old_ma);
+		changed = true;
+		goto unlock;
+	}
+	if (mca->policy_suspended) {
+		ret = -EBUSY;
+		goto unlock;
+	}
+
+	inhibit = val->intval == POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+	changed = READ_ONCE(mca->inhibit_charge) != inhibit;
+	/* Retain inhibition after a lost ACK; the worker must retry stopping. */
+	WRITE_ONCE(mca->inhibit_charge, inhibit);
+	generation = pmic_glink_get_generation(mca->client);
+	connection = piano_mca_connection_generation(mca);
+	if (inhibit) {
+		if (READ_ONCE(mca->service_up) || piano_mca_cp_active(mca))
+			ret = piano_mca_inhibit_charging(mca, generation, connection);
+	} else {
+		/* Only undo a confirmed CP stop requested by this policy. */
+		if (mca->inhibit_stopped_cp && mca->cp == MCA_CP_DONE)
+			mca->cp = MCA_CP_OFF;
+		mca->inhibit_stopped_cp = false;
+	}
+	/* Auto re-enters the ordinary policy with fresh gauges and its hysteresis. */
+	mod_delayed_work(system_freezable_wq, &mca->poll, 0);
+unlock:
+	mutex_unlock(&mca->policy_lock);
+	if (changed)
+		power_supply_changed(psy);
+	return ret;
+}
+
+static int piano_mca_usb_property_is_writeable(struct power_supply *psy,
+					      enum power_supply_property psp)
+{
+	return (psp == POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR ||
+		psp == POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT) &&
+	       charge_policy && cp_charge && charge_current;
+}
