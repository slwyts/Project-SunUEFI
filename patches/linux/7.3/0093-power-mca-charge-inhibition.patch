+static void piano_mca_limit_preserves_inhibition_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval value = { .intval = 2000000 };
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE), 0);
+	KUNIT_ASSERT_EQ(test, power_supply_set_property(f->mca.usb,
+		POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT, &value), 0);
+	KUNIT_ASSERT_EQ(test, power_supply_get_property(f->mca.usb,
+		POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT, &value), 0);
+	KUNIT_EXPECT_EQ(test, value.intval, 2000000);
+	KUNIT_EXPECT_EQ(test, piano_mca_api_get(f),
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
+	KUNIT_EXPECT_FALSE(test, f->cp_enabled);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_stopped_cp);
+	KUNIT_ASSERT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_OFF);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 2000U);
+}
