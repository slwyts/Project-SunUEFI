+static void piano_mca_limit_during_suspend_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	union power_supply_propval value = { .intval = 1000000 };
+	unsigned int writes;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_suspend(f->mca.dev), 0);
+	writes = f->fcc_positive_writes;
+	KUNIT_ASSERT_EQ(test, power_supply_set_property(f->mca.usb,
+		POWER_SUPPLY_PROP_CHARGE_CONTROL_LIMIT, &value), 0);
+	KUNIT_EXPECT_EQ(test, f->fcc_positive_writes, writes);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 0U);
+	KUNIT_EXPECT_EQ(test, piano_mca_api_set(f,
+		POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO), -EBUSY);
+	KUNIT_ASSERT_EQ(test, piano_mca_resume(f->mca.dev), 0);
+	f->only_5v = true;
+	piano_mca_poll(&f->mca.poll.work);
+	KUNIT_EXPECT_TRUE(test, f->pmic_enabled);
+	KUNIT_EXPECT_EQ(test, f->fcc_ma, 1000U);
+	KUNIT_EXPECT_EQ(test, piano_mca_charge_limit(&f->mca), 1000U);
+}
