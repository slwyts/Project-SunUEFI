+static int piano_mca_test_start_cp(struct kunit *test)
+{
+	struct piano_mca_test *fixture = test->priv;
+	struct power_supply_config config = { .drv_data = fixture };
+	static const enum power_supply_property properties[] = {
+		POWER_SUPPLY_PROP_ONLINE,
+		POWER_SUPPLY_PROP_VOLTAGE_NOW,
+		POWER_SUPPLY_PROP_CURRENT_NOW,
+		POWER_SUPPLY_PROP_TEMP,
+		POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+	};
+	static const struct power_supply_desc description = {
+		.name = "sc8541",
+		.type = POWER_SUPPLY_TYPE_USB,
+		.properties = properties,
+		.num_properties = ARRAY_SIZE(properties),
+		.get_property = piano_mca_test_cp_get,
+		.set_property = piano_mca_test_cp_set,
+	};
+	struct power_supply *supply;
+	struct device *stage;
+
+	/* CP and MCA are different devices, as required by the real PM link. */
+	stage = kunit_device_register(test, "piano-sc8541");
+	if (IS_ERR(stage))
+		return PTR_ERR(stage);
+	supply = devm_power_supply_register(stage, &description, &config);
+	if (IS_ERR(supply))
+		return PTR_ERR(supply);
+	fixture->mca.cp_psy = power_supply_get_by_name("sc8541");
+	if (!fixture->mca.cp_psy)
+		return -ENODEV;
+	fixture->mca.cp = MCA_CP_ON;
+	fixture->mca.cp_generation = fixture->remote_generation;
+	fixture->mca.cp_connection_generation = 0;
+	fixture->mca.cp_mv = 8000;
+	fixture->mca.cp_ma = 3000;
+	fixture->mca.cp_max_mv = 10000;
+	fixture->mca.cp_ibus_ma = 4000;
+	fixture->mca.cp_ibus_hot = 4000;
+	fixture->cp_enabled = true;
+	return 0;
+}
