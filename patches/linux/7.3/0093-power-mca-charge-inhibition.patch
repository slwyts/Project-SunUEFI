+	/* Exercise actual length, sequence, reply copy and completion handling. */
+	piano_mca_callback(&response, sizeof(response), &fixture->mca);
+	return 0;
+}
+
+static unsigned int
+piano_mca_test_get_generation(struct pmic_glink_client *client)
+{
+	struct piano_mca_test *fixture = (void *)client;
+
+	return fixture->remote_generation;
+}
+
+static int piano_mca_test_send_generation(struct pmic_glink_client *client,
+					  void *data, size_t len,
+					  unsigned int generation)
+{
+	/* The separate actual-GLINK suite checks this transport API's contract. */
+	if (generation != piano_mca_test_get_generation(client))
+		return -ECONNRESET;
+	return piano_mca_test_send(client, data, len);
+}
+
+static int piano_mca_test_init(struct kunit *test)
+{
+	struct piano_mca_test *fixture =
+		kunit_kzalloc(test, sizeof(*fixture), GFP_KERNEL);
+	struct piano_mca *mca;
+
+	if (!fixture)
+		return -ENOMEM;
+	test->priv = fixture;
+	mca = &fixture->mca;
+	mca->dev = kunit_device_register(test, "piano-mca");
+	if (IS_ERR(mca->dev))
+		return PTR_ERR(mca->dev);
+	mca->client = (void *)fixture;
+	dev_set_drvdata(mca->dev, mca);
+	mca->service_up = true;
+	fixture->remote_generation = 1;
+	fixture->vbus_uv = 5000000;
+	fixture->pack_temp = 25;
+	fixture->fv_mv = 4480;
+	fixture->fcc_ma = 500;
+	fixture->pmic_enabled = true;
+	fixture->cp_voltage_uv = 8000000;
+	fixture->cp_current_ua = 1000000;
+	fixture->cp_temp = 350;
+	fixture->cp_read_error_property = -1;
+	fixture->gauge[0] =
+		(struct piano_mca_test_gauge){ 3800000, 1000000, 250, 0 };
+	fixture->gauge[1] = fixture->gauge[0];
+	mca->online = true;
+	mca->real_type = MCA_TYPE_PD;
+	mutex_init(&mca->lock);
+	mutex_init(&mca->policy_lock);
+	mca->charge_limit_ua = MCA_CP_IBAT_MAX_MA * 1000;
+	mca->policy_ready = true;
+	init_completion(&fixture->blocker_started);
+	init_completion(&fixture->blocker_release);
+	mutex_init(&mca->pen_boost_lock);
+	init_completion(&mca->ack);
+	INIT_DELAYED_WORK(&mca->poll, piano_mca_test_work);
+	mipps_auth = true;
+	charge_policy = true;
+	charge_current = false;
+	hv_charge = false;
+	cp_charge = false;
+	cp_ibat_max = MCA_CP_IBAT_MAX_MA;
+	return 0;
