 drivers/power/supply/Makefile         |    1 +
 drivers/power/supply/piano_mca.c      |  311 +++-
 drivers/power/supply/piano_mca_test.c | 2171 +++++++++++++++++++++++++
 4 files changed, 2420 insertions(+), 74 deletions(-)
