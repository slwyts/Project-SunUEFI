+static void piano_mca_api_blocking_work(struct work_struct *work)
+{
+	struct piano_mca *mca = container_of(work, struct piano_mca, poll.work);
+	struct piano_mca_test *f =
+		container_of(mca, struct piano_mca_test, mca);
+
+	guard(mutex)(&mca->policy_lock);
+	if (f->block_once) {
+		f->block_once = false;
+		complete(&f->blocker_started);
+		wait_for_completion(&f->blocker_release);
+	}
+	atomic_inc(&f->work_runs);
+}
+
+struct piano_mca_api_thread {
+	struct piano_mca_test *f;
+	struct completion started, done;
+	bool suspend;
+	int ret;
+};
+
+static int piano_mca_api_thread(void *data)
+{
+	struct piano_mca_api_thread *ctx = data;
+
+	complete(&ctx->started);
+	ctx->ret =
+		ctx->suspend ?
+			piano_mca_suspend(ctx->f->mca.dev) :
+			piano_mca_api_set(
+				ctx->f,
+				POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE);
+	complete(&ctx->done);
+	while (!kthread_should_stop())
+		schedule_timeout_interruptible(1);
+	return 0;
+}
+
+static struct task_struct *
+piano_mca_api_start_thread(struct piano_mca_api_thread *ctx,
+			   struct piano_mca_test *f, bool suspend)
+{
+	ctx->f = f;
+	ctx->suspend = suspend;
+	init_completion(&ctx->started);
+	init_completion(&ctx->done);
+	return kthread_run(piano_mca_api_thread, ctx, "piano-api-test");
+}
+
+static bool piano_mca_api_wait_control_locked(struct piano_mca *mca)
+{
+	int i;
+
+	for (i = 0; i < 1000; i++) {
+		if (!mutex_trylock(&mca->policy_lock))
+			return true;
+		mutex_unlock(&mca->policy_lock);
+		usleep_range(1000, 2000);
+	}
+	return false;
+}
+
+static void piano_mca_api_setter_serializes_work_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct piano_mca_api_thread setter;
+	struct task_struct *task;
+	bool started, locked, done_while_blocked, finished;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	INIT_DELAYED_WORK(&f->mca.poll, piano_mca_api_blocking_work);
+	f->block_once = true;
+	queue_delayed_work(system_freezable_wq, &f->mca.poll, 0);
+	started = wait_for_completion_timeout(&f->blocker_started, HZ);
+	task = piano_mca_api_start_thread(&setter, f, false);
+	if (IS_ERR(task)) {
+		complete(&f->blocker_release);
+		KUNIT_FAIL(test, "could not start setter thread");
+		return;
+	}
+	locked = piano_mca_api_wait_control_locked(&f->mca);
+	done_while_blocked = completion_done(&setter.done);
+	complete(&f->blocker_release);
+	finished = wait_for_completion_timeout(&setter.done, 3 * HZ);
+	kthread_stop(task);
+	KUNIT_EXPECT_TRUE(test, started);
+	KUNIT_EXPECT_TRUE(test, locked);
+	KUNIT_EXPECT_FALSE(test, done_while_blocked);
+	KUNIT_EXPECT_TRUE(test, finished);
+	KUNIT_EXPECT_EQ(test, setter.ret, 0);
+	KUNIT_EXPECT_FALSE(test, f->pmic_enabled);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_charge);
+}
+
+static void piano_mca_api_pm_serializes_setter_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct piano_mca_api_thread suspend, setter;
+	struct task_struct *pm_task, *set_task;
+	bool started, locked, early_pm, early_set, pm_done, set_done;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	INIT_DELAYED_WORK(&f->mca.poll, piano_mca_api_blocking_work);
+	f->block_once = true;
+	queue_delayed_work(system_freezable_wq, &f->mca.poll, 0);
+	started = wait_for_completion_timeout(&f->blocker_started, HZ);
+	pm_task = piano_mca_api_start_thread(&suspend, f, true);
+	if (IS_ERR(pm_task)) {
+		complete(&f->blocker_release);
+		KUNIT_FAIL(test, "could not start suspend thread");
+		return;
+	}
+	locked = piano_mca_api_wait_control_locked(&f->mca);
+	set_task = piano_mca_api_start_thread(&setter, f, false);
+	if (IS_ERR(set_task)) {
+		complete(&f->blocker_release);
+		wait_for_completion_timeout(&suspend.done, 3 * HZ);
+		kthread_stop(pm_task);
+		KUNIT_FAIL(test, "could not start setter thread");
+		return;
+	}
+	wait_for_completion_timeout(&setter.started, HZ);
+	early_pm = completion_done(&suspend.done);
+	early_set = completion_done(&setter.done);
+	complete(&f->blocker_release);
+	pm_done = wait_for_completion_timeout(&suspend.done, 3 * HZ);
+	set_done = wait_for_completion_timeout(&setter.done, 3 * HZ);
+	kthread_stop(pm_task);
+	kthread_stop(set_task);
+	KUNIT_EXPECT_TRUE(test, started);
+	KUNIT_EXPECT_TRUE(test, locked);
+	KUNIT_EXPECT_FALSE(test, early_pm);
+	KUNIT_EXPECT_FALSE(test, early_set);
+	KUNIT_EXPECT_TRUE(test, pm_done);
+	KUNIT_EXPECT_TRUE(test, set_done);
+	KUNIT_EXPECT_EQ(test, suspend.ret, 0);
+	/* Either caller may acquire the policy lock first. */
+	KUNIT_EXPECT_TRUE(test, setter.ret == 0 || setter.ret == -EBUSY);
+	KUNIT_EXPECT_TRUE(test, f->mca.policy_suspended);
+	KUNIT_EXPECT_EQ(test, f->mca.inhibit_charge, setter.ret == 0);
+	KUNIT_EXPECT_EQ(test, piano_mca_resume(f->mca.dev), 0);
+	flush_delayed_work(&f->mca.poll);
+	KUNIT_EXPECT_TRUE(test, queue_delayed_work(system_freezable_wq,
+						   &f->mca.poll, 0));
+	flush_delayed_work(&f->mca.poll);
+}
