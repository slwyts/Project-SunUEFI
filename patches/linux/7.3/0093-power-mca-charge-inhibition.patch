+static void
+piano_mca_api_cp_stop_replug_clears_recovery_test(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+
+	KUNIT_ASSERT_EQ(test, piano_mca_api_prepare(test), 0);
+	KUNIT_ASSERT_EQ(test, piano_mca_test_start_cp(test), 0);
+	f->cp_stop_failures = 1;
+	KUNIT_ASSERT_EQ(
+		test,
+		piano_mca_api_set(f,
+				  POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
+		-EIO);
+	atomic_inc(&f->mca.connection_generation);
+	KUNIT_ASSERT_EQ(test, piano_mca_sync_connection(&f->mca), 0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_OFF);
+	KUNIT_EXPECT_TRUE(test, f->mca.inhibit_charge);
+	/* A later fault in the new connection does not belong to the old stop. */
+	f->mca.cp = MCA_CP_DONE;
+	KUNIT_ASSERT_EQ(
+		test,
+		piano_mca_api_set(f,
+				  POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE),
+		0);
+	KUNIT_ASSERT_EQ(
+		test, piano_mca_api_set(f, POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO),
+		0);
+	KUNIT_EXPECT_EQ(test, f->mca.cp, MCA_CP_DONE);
+}
