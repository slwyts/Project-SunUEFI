+static int piano_mca_api_prepare(struct kunit *test)
+{
+	struct piano_mca_test *f = test->priv;
+	struct power_supply_config cfg = { .drv_data = &f->mca };
+	int ret;
+
+	cp_charge = charge_current = hv_charge = charge_policy = true;
+	mipps_auth = false;
+	ret = piano_mca_test_register_gauges(test);
+	if (ret)
+		return ret;
+	f->mca.usb = devm_power_supply_register(f->mca.dev, &piano_mca_usb_desc,
+						&cfg);
+	if (IS_ERR(f->mca.usb))
+		return PTR_ERR(f->mca.usb);
+	f->mca.fv_set_mv = f->fv_mv;
+	f->mca.fcc_set_ma = f->fcc_ma;
+	f->mca.icl_set_ma = f->icl_ma = 500;
+	f->mca.vbus_uv = f->vbus_uv;
+	return 0;
+}
+
+static int piano_mca_api_set(struct piano_mca_test *f, int mode)
+{
+	union power_supply_propval value = { .intval = mode };
+
+	return power_supply_set_property(
+		f->mca.usb, POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &value);
+}
+
+static int piano_mca_api_get(struct piano_mca_test *f)
+{
+	union power_supply_propval value;
+	int ret;
+
+	ret = power_supply_get_property(
+		f->mca.usb, POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR, &value);
+	return ret ? ret : value.intval;
+}
+
