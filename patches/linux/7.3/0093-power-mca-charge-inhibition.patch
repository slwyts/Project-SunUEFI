+
+static void piano_mca_test_work(struct work_struct *work)
+{
+	struct piano_mca *mca = container_of(work, struct piano_mca, poll.work);
+	struct piano_mca_test *fixture =
+		container_of(mca, struct piano_mca_test, mca);
+
+	atomic_inc(&fixture->work_runs);
+}
+
+static void piano_mca_test_psy_changed(struct power_supply *psy)
+{
+	/* No userspace listeners are required to exercise the charger policy. */
+}
+
+static int piano_mca_test_send(struct pmic_glink_client *client, void *data,
+			       size_t len)
+{
+	struct piano_mca_test *fixture = (void *)client;
+	const struct mca_req *request = data;
+	struct mca_resp response = {
+		.owner = request->owner,
+		.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.opcode = request->opcode,
+		.property = request->property,
+		.seq = request->seq,
+	};
+	u32 property = le32_to_cpu(request->property);
+	u32 value = get_unaligned_le32(request->data);
+	bool write = le32_to_cpu(request->opcode) == MCA_OP_WRITE;
+
+	if (len != sizeof(*request))
+		return -EINVAL;
+
+	if (!write && property == MCA_PROP_PACK_TBAT &&
+	    fixture->pack_read_failures) {
+		if (fixture->pack_read_failures > 0)
+			fixture->pack_read_failures--;
+		return -EIO;
+	}
+	if (!write && property == MCA_PROP_FV && fixture->fv_read_error)
+		return fixture->fv_read_error;
+	if (!write && property == MCA_PROP_ITERM && fixture->iterm_read_error)
+		return fixture->iterm_read_error;
+	if (!write && property == MCA_PROP_CHARGE_ENABLE &&
+	    fixture->pmic_enable_read_error)
+		return fixture->pmic_enable_read_error;
+	if (write && property == MCA_PROP_CHARGE_ENABLE) {
+		/* The original enable property is one byte, not a four-byte current. */
+		value = request->data[0];
+		if (value) {
+			fixture->pmic_enable_writes++;
+			fixture->last_pmic_enable_event = ++fixture->events;
+		} else {
+			fixture->pmic_disable_writes++;
+			fixture->last_pmic_disable_event = ++fixture->events;
+		}
+		if (fixture->pmic_enable_write_failures) {
+			if (fixture->pmic_enable_write_failures > 0)
+				fixture->pmic_enable_write_failures--;
+			return -EIO;
+		}
+		if (!fixture->ignore_pmic_enable)
+			fixture->pmic_enabled = value;
+		if (fixture->lose_pmic_enable_ack)
+			return 0;
+	} else if (write && property == MCA_PROP_FV) {
+		fixture->fv_writes++;
+		fixture->last_fv_event = ++fixture->events;
+		if (fixture->fv_write_failures) {
+			if (fixture->fv_write_failures > 0)
+				fixture->fv_write_failures--;
+			return -EIO;
+		}
+		if (fixture->cp_enabled && value < fixture->fv_mv)
+			fixture->lower_fv_while_cp_enabled++;
+		fixture->fv_mv = value;
+		if (fixture->lose_fv_ack)
+			return 0; /* The PMIC applied it, but its ACK was lost. */
+	} else if (write && property == MCA_PROP_ITERM) {
+		fixture->iterm_writes++;
+		fixture->last_iterm_write_event = ++fixture->events;
+		if (fixture->iterm_write_failures) {
+			if (fixture->iterm_write_failures > 0)
+				fixture->iterm_write_failures--;
+			return -EIO;
+		}
+		fixture->iterm_ma = value;
+		if (fixture->replug_on_iterm_write) {
+			fixture->replug_on_iterm_write = false;
+			atomic_inc(&fixture->mca.connection_generation);
+		}
+		if (fixture->restart_on_iterm_write) {
+			fixture->restart_on_iterm_write = false;
+			fixture->remote_generation += 2;
+			fixture->fv_mv = 4480;
+			fixture->fcc_ma = 500;
+			piano_mca_pdr_notify(&fixture->mca,
+					     SERVREG_SERVICE_STATE_DOWN);
+			piano_mca_pdr_notify(&fixture->mca,
+					     SERVREG_SERVICE_STATE_UP);
+		}
+		if (fixture->lose_iterm_ack)
+			return 0;
+	} else if (write && property == MCA_PROP_FCC) {
+		fixture->fcc_writes++;
+		fixture->last_fcc_event = ++fixture->events;
+		if (value)
+			fixture->fcc_positive_writes++;
+		if (value == 500)
+			fixture->fcc_500_writes++;
+		if (fixture->fcc_write_failures) {
+			if (fixture->fcc_write_failures > 0)
+				fixture->fcc_write_failures--;
+			return -EIO;
+		}
+		if (!fixture->ignore_fcc)
+			fixture->fcc_ma = value;
+	} else if (write && property == MCA_PROP_VERIFY_PROCESS) {
+		if (value) {
+			fixture->start_writes++;
+			fixture->verify_process = value;
+			if (fixture->lose_start_ack)
+				return 0; /* Applied on the ADSP, actual completion times out. */
+		} else {
+			fixture->cleanup_writes++;
+			if (fixture->cleanup_failures) {
+				fixture->cleanup_failures--;
+				return -EIO; /* Not applied: next poll must retry. */
+			}
+			fixture->verify_process = 0;
+		}
+	} else if (write && property == MCA_PROP_ICL) {
+		fixture->icl_writes++;
+		fixture->icl_ma = value;
+	} else if (write && property == MCA_PROP_PD_FIXED_VOLT) {
+		fixture->fixed_voltage_writes++;
+	} else if (write && property == MCA_PROP_PPS_SELECT) {
+		fixture->pps_writes++;
+		fixture->last_pps_event = ++fixture->events;
+	} else if (write && property >= MCA_PROP_VDM_BASE &&
+		   property < MCA_PROP_VDM_BASE + 8) {
+		unsigned int i;
+
+		if (!fixture->complete_auth)
+			return -EIO; /* Early failure tests need no challenge exchange. */
+		fixture->last_vdm = property - MCA_PROP_VDM_BASE + 1;
+		if (property == MCA_PROP_VDM_SEED ||
+		    property == MCA_PROP_VDM_AUTH) {
+			u8 *bytes = property == MCA_PROP_VDM_SEED ?
+					    fixture->seed :
+					    fixture->challenge;
+
+			for (i = 0; i < MCA_VDM_LEN / 4; i++)
+				put_unaligned_be32(
+					get_unaligned_le32(request->data +
+							   4 * i),
+					bytes + 4 * i);
+		}
+	} else if (write && property == MCA_PROP_PD_VERIFIED) {
+		if (value) {
+			fixture->pd_verified = 1;
+			fixture->final_write_seen = true;
+			if (fixture->lose_final_ack)
+				return 0;
+		} else {
+			if (fixture->final_write_seen) {
+				fixture->pd_clears_after_final++;
+				if (fixture->pd_clear_failures) {
+					fixture->pd_clear_failures--;
+					return -EIO;
+				}
+			}
+			fixture->pd_verified = 0;
+		}
+	} else if (!write) {
+		switch (property) {
+		case MCA_PROP_PDOS: {
+			struct piano_mca_pdo *pdo = (void *)response.data;
+
+			if (fixture->only_5v) {
+				pdo[0].min_mv = cpu_to_le32(5000);
+				pdo[0].max_mv = cpu_to_le32(5000);
+				pdo[0].max_ma = cpu_to_le32(3000);
+				break;
+			}
+
+			pdo[1].min_mv = cpu_to_le32(9000);
+			pdo[1].max_mv = cpu_to_le32(9000);
+			pdo[1].max_ma = cpu_to_le32(2000);
+			if (fixture->offer_cp_apdo) {
+				pdo[2].min_mv = cpu_to_le32(6000);
+				pdo[2].max_mv = cpu_to_le32(10000);
+				pdo[2].max_ma = cpu_to_le32(6000);
+			}
+			if (fixture->restart_on_pdos) {
+				fixture->restart_on_pdos = false;
+				fixture->remote_generation += 2;
+				piano_mca_pdr_notify(
+					&fixture->mca,
+					SERVREG_SERVICE_STATE_DOWN);
+				piano_mca_pdr_notify(&fixture->mca,
+						     SERVREG_SERVICE_STATE_UP);
+			}
+			break;
+		}
+		case MCA_PROP_ICL:
+			put_unaligned_le32(fixture->icl_ma, response.data);
+			break;
+		case MCA_PROP_BUS_VOLT:
+			put_unaligned_le32(fixture->vbus_uv, response.data);
+			break;
+		case MCA_PROP_REAL_TYPE:
+			put_unaligned_le32(MCA_TYPE_PD, response.data);
+			break;
+		case MCA_PROP_VERIFY_PROCESS:
+			put_unaligned_le32(fixture->verify_process,
+					   response.data);
+			break;
+		case MCA_PROP_PACK_TBAT:
+			put_unaligned_le32(fixture->pack_temp, response.data);
+			break;
+		case MCA_PROP_CHARGE_ENABLE:
+			/* This getter really reads PMIC CHGR_ENABLE (0x2646 bit 0). */
+			response.data[0] = fixture->pmic_enabled;
+			fixture->pmic_enable_readbacks++;
+			if (fixture->replug_on_enable_read) {
+				fixture->replug_on_enable_read = false;
+				atomic_inc(&fixture->mca.connection_generation);
+			}
+			if (fixture->restart_on_enable_read) {
+				fixture->restart_on_enable_read = false;
+				fixture->remote_generation += 2;
+				piano_mca_pdr_notify(
+					&fixture->mca,
+					SERVREG_SERVICE_STATE_DOWN);
+				piano_mca_pdr_notify(&fixture->mca,
+						     SERVREG_SERVICE_STATE_UP);
+			}
+			break;
+		case MCA_PROP_FV:
+			/* Model 0x56 setter uses 5 mV, while this getter uses 10 mV. */
+			put_unaligned_le32(3600 + 2 * (fixture->fv_mv - 3600),
+					   response.data);
+			break;
+		case MCA_PROP_FCC:
+			/* OS4 responds successfully without populating the zeroed reply. */
+			fixture->fcc_readbacks++;
+			break;
+		case MCA_PROP_ITERM:
+			/* Like FCC, this is a successful no-op, not hardware readback. */
+			fixture->iterm_readbacks++;
+			break;
+		case MCA_PROP_VDM_VERSION:
+			put_unaligned_le32(1, response.data);
+			break;
+		case MCA_PROP_UVDM_STATE:
+			put_unaligned_le32(fixture->last_vdm, response.data);
+			break;
+		case MCA_PROP_ADAPTER_ID:
+			put_unaligned_le32(1234, response.data);
+			break;
+		case MCA_PROP_VDM_AUTH: {
+			struct hmac_sha256_key prepared;
+			u8 digest[SHA256_DIGEST_SIZE];
+			unsigned int i, key;
+
+			for (key = 0; key < ARRAY_SIZE(piano_mipps_keys); key++)
+				if (!memcmp(fixture->seed,
+					    piano_mipps_keys[key].seed,
+					    MCA_VDM_LEN))
+					break;
+			if (key == ARRAY_SIZE(piano_mipps_keys))
+				return -EINVAL;
+			put_unaligned_be32(1234,
+					   fixture->challenge + MCA_VDM_LEN);
+			hmac_sha256_preparekey(&prepared,
+					       piano_mipps_keys[key].key, 32);
+			hmac_sha256(&prepared, fixture->challenge, 20, digest);
+			for (i = 0; i < MCA_VDM_LEN / 4; i++)
+				put_unaligned_le32(
+					get_unaligned_be32(digest + 4 * i),
+					response.data + 4 * i);
+			memzero_explicit(&prepared, sizeof(prepared));
+			memzero_explicit(digest, sizeof(digest));
+			break;
+		}
+		}
+	}
