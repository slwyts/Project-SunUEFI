From a9eead3c1303f32558c098050e9f5c6bd6169163 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Sun, 8 Nov 2026 22:28:29 +0800
Subject: [PATCH] power: supply: represent Piano parallel cells as one battery

Expose the physical parallel pack as one system power supply, summing
charge and current while keeping cell voltage and SOC estimates
distinct. Mark explicitly internal gauges as monitor components and
retain their measurements for charging and thermal consumers.

Signed-off-by: Cryolitia PukNgae <cryolitia@gmail.com>
---
 .../bindings/power/supply/bq27xxx.yaml        |   8 +
 .../power/supply/xiaomi,piano-battery.yaml    |  44 +++
 drivers/power/supply/Kconfig                  |   9 +
 drivers/power/supply/Makefile                 |   1 +
 drivers/power/supply/bq27xxx_battery.c        |   6 +-
 drivers/power/supply/piano_battery.c          | 254 ++++++++++++++++++
 6 files changed, 321 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/power/supply/xiaomi,piano-battery.yaml
 create mode 100644 drivers/power/supply/piano_battery.c

diff --git a/Documentation/devicetree/bindings/power/supply/bq27xxx.yaml b/Documentation/devicetree/bindings/power/supply/bq27xxx.yaml
index bc0540018..a8d5cbed0 100644
--- a/Documentation/devicetree/bindings/power/supply/bq27xxx.yaml
+++ b/Documentation/devicetree/bindings/power/supply/bq27xxx.yaml
@@ -69,6 +69,14 @@ properties:
 
   power-supplies: true
 
+  ti,cell-monitor:
+    type: boolean
+    description: |
+      The gauge monitors one cell bank inside a battery pack represented by
+      a separate power supply, rather than an independent system battery.
+      Retain its raw measurements as an internal monitor with unknown supply
+      type; the pack's power-supplies property references this gauge.
+
 allOf:
   - $ref: power-supply.yaml#
   - if:
diff --git a/Documentation/devicetree/bindings/power/supply/xiaomi,piano-battery.yaml b/Documentation/devicetree/bindings/power/supply/xiaomi,piano-battery.yaml
new file mode 100644
index 000000000..5362b5db1
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/xiaomi,piano-battery.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/xiaomi,piano-battery.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi Piano parallel battery pack
+
+maintainers:
+  - Cryolitia PukNgae <cryolitia@gmail.com>
+
+description: |
+  Xiaomi Piano contains two parallel cell banks, each monitored by a fuel
+  gauge. The gauges provide individual measurements for charge and thermal
+  control, while this node represents the complete system battery. Each
+  referenced BQ27xxx gauge must declare ti,cell-monitor so that it is not
+  presented as an additional system battery.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: xiaomi,piano-battery
+
+  power-supplies:
+    minItems: 2
+    maxItems: 2
+    description: Fuel gauges monitoring the two parallel cell banks.
+
+  monitored-battery: true
+
+required:
+  - compatible
+  - power-supplies
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    battery-pack {
+      compatible = "xiaomi,piano-battery";
+      power-supplies = <&fuel_gauge_master>, <&fuel_gauge_slave>;
+    };
