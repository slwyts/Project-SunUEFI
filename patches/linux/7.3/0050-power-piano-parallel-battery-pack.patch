index e9873e3b2..cccddfd9d 100644
--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -322,6 +322,15 @@ config MANAGER_SBS
 	  This driver can also be built as a module. If so, the module will be
 	  called sbs-manager.
 
+config BATTERY_PIANO
+	tristate "Xiaomi Piano parallel battery pack"
+	depends on OF
+	help
+	  Present the two parallel cell monitors in the Xiaomi Piano as one
+	  system battery, using their standard power supply measurements.
+
+	  The module is called piano_battery.
+
 config BATTERY_BQ27XXX
 	tristate "BQ27xxx battery driver"
 	help
