diff --git a/drivers/power/supply/bq27xxx_battery.c b/drivers/power/supply/bq27xxx_battery.c
index 01c9ec111..5c32de13c 100644
--- a/drivers/power/supply/bq27xxx_battery.c
+++ b/drivers/power/supply/bq27xxx_battery.c
@@ -2249,7 +2249,11 @@ int bq27xxx_battery_setup(struct bq27xxx_device_info *di)
 		return -ENOMEM;
 
 	psy_desc->name = di->name;
-	psy_desc->type = POWER_SUPPLY_TYPE_BATTERY;
+	/* A cell monitor remains readable by its pack driver, but is not an
+	 * independent system battery. The pack publishes the combined battery.
+	 */
+	psy_desc->type = device_property_read_bool(di->dev, "ti,cell-monitor") ?
+		POWER_SUPPLY_TYPE_UNKNOWN : POWER_SUPPLY_TYPE_BATTERY;
 	psy_desc->properties = bq27xxx_chip_data[di->chip].props;
 	psy_desc->num_properties = bq27xxx_chip_data[di->chip].props_size;
 	psy_desc->get_property = bq27xxx_battery_get_property;
diff --git a/drivers/power/supply/piano_battery.c b/drivers/power/supply/piano_battery.c
new file mode 100644
index 000000000..66ca32c52
--- /dev/null
+++ b/drivers/power/supply/piano_battery.c
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Xiaomi Piano's two parallel cell banks form one system battery. Keep the
+ * gauges' individual readings available to charging and thermal consumers,
+ * and expose the complete pack through the standard power supply interface.
+ */
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+
+#define PIANO_BATTERY_CELLS	2
+
+struct piano_battery {
+	struct power_supply *cells[PIANO_BATTERY_CELLS];
+};
+
+static int piano_battery_read_cells(struct power_supply *psy,
+				    enum power_supply_property prop,
+				    int values[PIANO_BATTERY_CELLS])
+{
+	struct piano_battery *battery = power_supply_get_drvdata(psy);
+	union power_supply_propval value;
+	int i, ret;
+
+	for (i = 0; i < PIANO_BATTERY_CELLS; i++) {
+		ret = power_supply_get_property(battery->cells[i], prop, &value);
+		if (ret)
+			return ret;
+		values[i] = value.intval;
+	}
+
+	return 0;
+}
+
+static int piano_battery_status(struct power_supply *psy,
+				union power_supply_propval *value)
+{
+	int currents[PIANO_BATTERY_CELLS], status[PIANO_BATTERY_CELLS];
+	int net_current, ret;
+
+	ret = piano_battery_read_cells(psy, POWER_SUPPLY_PROP_CURRENT_NOW, currents);
+	if (ret)
+		return ret;
+	net_current = currents[0] + currents[1];
+	ret = piano_battery_read_cells(psy, POWER_SUPPLY_PROP_STATUS, status);
+	if (ret)
+		return ret;
+
+	/* A connected charger need not cover the system load. Report net flow,
+	 * and do not let sticky full flags hide a pack that is discharging.
+	 */
+	if (net_current < 0)
+		value->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+	else if (status[0] == POWER_SUPPLY_STATUS_FULL &&
+		 status[1] == POWER_SUPPLY_STATUS_FULL)
+		value->intval = POWER_SUPPLY_STATUS_FULL;
+	else if (net_current > 0)
+		value->intval = POWER_SUPPLY_STATUS_CHARGING;
+	else
+		value->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+
+	return 0;
+}
+
+static int piano_battery_capacity(struct power_supply *psy,
+				  union power_supply_propval *value)
+{
+	int capacity[PIANO_BATTERY_CELLS], full[PIANO_BATTERY_CELLS];
+	u64 weighted, total;
+	int ret;
+
+	ret = piano_battery_read_cells(psy, POWER_SUPPLY_PROP_CAPACITY, capacity);
+	if (ret)
+		return ret;
+	ret = piano_battery_read_cells(psy, POWER_SUPPLY_PROP_CHARGE_FULL, full);
+	if (ret)
+		return ret;
+	if (full[0] <= 0 || full[1] <= 0)
+		return -ENODATA;
+
+	/* Preserve each gauge's SOC estimate while accounting for unequal aging.
+	 * Averaging percentages would give a smaller bank the same weight.
+	 */
+	total = (u64)full[0] + full[1];
+	weighted = (u64)clamp(capacity[0], 0, 100) * full[0] +
+		   (u64)clamp(capacity[1], 0, 100) * full[1];
+	value->intval = DIV_ROUND_CLOSEST_ULL(weighted, total);
+
+	return 0;
+}
+
+static int piano_battery_get_property(struct power_supply *psy,
+				      enum power_supply_property prop,
+				      union power_supply_propval *value)
+{
+	int cells[PIANO_BATTERY_CELLS], ret;
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_SCOPE:
+		value->intval = POWER_SUPPLY_SCOPE_SYSTEM;
+		return 0;
+	case POWER_SUPPLY_PROP_STATUS:
+		return piano_battery_status(psy, value);
+	case POWER_SUPPLY_PROP_CAPACITY:
+		return piano_battery_capacity(psy, value);
+	default:
+		break;
+	}
+
+	ret = piano_battery_read_cells(psy, prop, cells);
+	if (ret)
+		return ret;
+
+	switch (prop) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		value->intval = cells[0] && cells[1];
+		break;
+	case POWER_SUPPLY_PROP_CURRENT_NOW:
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
+		value->intval = cells[0] + cells[1];
+		break;
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		/* The banks are parallel: the pack voltage is not their sum. */
+		value->intval = (cells[0] + cells[1]) / PIANO_BATTERY_CELLS;
+		break;
+	case POWER_SUPPLY_PROP_TEMP:
+	case POWER_SUPPLY_PROP_CYCLE_COUNT:
+		value->intval = max(cells[0], cells[1]);
+		break;
+	case POWER_SUPPLY_PROP_HEALTH:
+		value->intval = cells[0] != POWER_SUPPLY_HEALTH_GOOD ?
+			cells[0] : cells[1];
+		break;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		value->intval = cells[0] == cells[1] ? cells[0] :
+			POWER_SUPPLY_TECHNOLOGY_UNKNOWN;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static void piano_battery_put_cell(void *data)
+{
+	power_supply_put(data);
+}
+
+static int piano_battery_init(struct power_supply *psy)
+{
+	struct piano_battery *battery = power_supply_get_drvdata(psy);
+	struct device *dev = psy->dev.parent;
+	int i, ret;
+
+	/* The core resolves power-supplies before this callback, including probe
+	 * deferral. Use those resolved providers instead of global gauge names.
+	 */
+	if (psy->num_supplies != PIANO_BATTERY_CELLS)
+		return dev_err_probe(dev, -EINVAL, "two cell monitors are required\n");
+
+	for (i = 0; i < PIANO_BATTERY_CELLS; i++) {
+		battery->cells[i] = power_supply_get_by_name(psy->supplied_from[i]);
+		if (!battery->cells[i])
+			return -EPROBE_DEFER;
+		ret = devm_add_action_or_reset(dev, piano_battery_put_cell,
+					       battery->cells[i]);
+		if (ret)
+			return ret;
+
+		/* Unbind the pack before either gauge can release its driver data. */
+		if (!device_link_add(dev, battery->cells[i]->dev.parent,
+				     DL_FLAG_AUTOREMOVE_CONSUMER))
+			return -ENOMEM;
+	}
+
+	return 0;
+}
+
+static void piano_battery_external_power_changed(struct power_supply *psy)
+{
+	/* Gauge updates arrive through the core's supplied_from relationship. */
+	power_supply_changed(psy);
+}
+
+static const enum power_supply_property piano_battery_properties[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_SCOPE,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_CURRENT_NOW,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_TEMP,
+	POWER_SUPPLY_PROP_TECHNOLOGY,
+	POWER_SUPPLY_PROP_HEALTH,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
+	POWER_SUPPLY_PROP_CHARGE_FULL,
+	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
+	POWER_SUPPLY_PROP_CYCLE_COUNT,
+};
+
+static const struct power_supply_desc piano_battery_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = piano_battery_properties,
+	.num_properties = ARRAY_SIZE(piano_battery_properties),
+	.get_property = piano_battery_get_property,
+	.external_power_changed = piano_battery_external_power_changed,
+	.init = piano_battery_init,
+	/* Temperatures are forwarded; retain the gauges' own thermal zones. */
+	.no_thermal = true,
+};
+
+static int piano_battery_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct power_supply_config config = {
+		.fwnode = dev_fwnode(dev),
+		.no_wakeup_source = true,
+	};
+	struct power_supply *psy;
+
+	config.drv_data = devm_kzalloc(dev, sizeof(struct piano_battery), GFP_KERNEL);
+	if (!config.drv_data)
+		return -ENOMEM;
+
+	psy = devm_power_supply_register(dev, &piano_battery_desc, &config);
+	return PTR_ERR_OR_ZERO(psy);
+}
+
+static const struct of_device_id piano_battery_of_match[] = {
+	{ .compatible = "xiaomi,piano-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, piano_battery_of_match);
+
+static struct platform_driver piano_battery_driver = {
+	.probe = piano_battery_probe,
+	.driver = {
+		.name = "piano-battery",
+		.of_match_table = piano_battery_of_match,
+	},
+};
+module_platform_driver(piano_battery_driver);
+
+MODULE_DESCRIPTION("Xiaomi Piano parallel battery pack");
+MODULE_LICENSE("GPL");
-- 
