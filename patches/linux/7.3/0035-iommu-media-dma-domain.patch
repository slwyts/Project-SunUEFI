From 351f397644914aacdb3bd4770458d604fa2bd5c0 Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia@gmail.com>
Date: Sun, 8 Nov 2026 01:57:31 +0800
Subject: [PATCH] iommu/arm-smmu-qcom: use DMA domains for SM8750 media clients

Source: Cryolitia/xiaomi-piano-nixos, packages/kernel/patches/iommu-media-default-domain.patch
---
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
index 76c68d95540..708934f0e23 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -665,6 +665,14 @@ static int qcom_smmu_def_domain_type(struct device *dev)
 	const struct of_device_id *match =
 		of_match_device(qcom_smmu_client_of_match, dev);
 
+	/* Camera scatter-gather buffers and VPU DMA masks need translation. */
+	if (fwspec &&
+	    of_device_is_compatible(to_of_node(fwspec->iommu_fwnode),
+				    "qcom,sm8750-smmu-500") &&
+	    (of_device_is_compatible(dev->of_node, "qcom,sm8750-camss") ||
+	     of_device_is_compatible(dev->of_node, "qcom,sm8750-iris")))
+		return IOMMU_DOMAIN_DMA;
+
 	/* FastRPC describes imported scatter-gather buffers as one DMA range. */
 	if (fwspec && of_device_is_compatible(dev->of_node, "qcom,fastrpc-compute-cb") &&
 	    of_device_is_compatible(to_of_node(fwspec->iommu_fwnode),
