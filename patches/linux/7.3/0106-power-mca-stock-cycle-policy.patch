按 4.0.6 运行时设备树和原厂 mca_strategy_quickchg 行为，补齐循环降流、CP 启动 SOC/电压余量、300 循环后的 20mV 额外余量，并把 CP 2:1 总线上限恢复到原厂 6A/7A OCP。驱动默认启用快充策略，避免依赖发行版 modprobe 配置。
---
 drivers/power/supply/piano_mca.c      | 104 +++++++++++++++++++++-----
 drivers/power/supply/piano_mca_test.c |  54 +++++++++++++
 2 files changed, 139 insertions(+), 19 deletions(-)

diff --git a/drivers/power/supply/piano_mca.c b/drivers/power/supply/piano_mca.c
index 901c477a2..e0b9da45b 100644
--- a/drivers/power/supply/piano_mca.c
+++ b/drivers/power/supply/piano_mca.c
@@ -171,10 +171,10 @@ static const char * const mca_real_type_names[MCA_TYPE_MAX] = {
 #define MCA_ICL_HV_MAX_MA	2500	/* at 9 V, see piano_mca_hv_icl() */
 #define MCA_ICL_DEFAULT_MA	500
 
-static bool charge_policy;
+static bool charge_policy = true;
 module_param(charge_policy, bool, 0444);
 MODULE_PARM_DESC(charge_policy,
-		 "Raise the USB input current limit by charger type (default: off, ADSP defaults)");
+		 "Raise the USB input current limit by charger type (default: on, may be disabled for debugging)");
 
 /*
  * charge_current: left alone, the ADSP charges the battery at about 500 mA
@@ -199,10 +199,10 @@ MODULE_PARM_DESC(charge_policy,
 #define MCA_FCC_DERATE_STEP_MA	300
 #define MCA_FCC_RAISE_MS	30000
 
-static bool charge_current;
+static bool charge_current = true;
 module_param(charge_current, bool, 0444);
 MODULE_PARM_DESC(charge_current,
-		 "Raise the battery charge current by charger type; needs charge_policy (default: off, about 500 mA)");
+		 "Raise the battery charge current by charger type; needs charge_policy (default: on, may be disabled for debugging)");
 
 /*
  * hv_charge: a PD source with a fixed 9 V PDO is asked for 9 V, as the
@@ -234,10 +234,10 @@ MODULE_PARM_DESC(charge_current,
 #define MCA_HV_PPS_MIN_MA	500
 #define MCA_HV_PPS_MAX_MA	3000
 
-static bool hv_charge;
+static bool hv_charge = true;
 module_param(hv_charge, bool, 0444);
 MODULE_PARM_DESC(hv_charge,
-		 "Ask PD sources with a fixed 9 V PDO for 9 V; needs charge_policy (default: off, 5 V)");
+		 "Ask PD sources with a fixed 9 V PDO for 9 V; needs charge_policy (default: on, may be disabled for debugging)");
 
 /*
  * pan_ack: the ADSP reports each USB-C port change (orientation, mux state)
@@ -257,10 +257,10 @@ MODULE_PARM_DESC(hv_charge,
 #define MCA_PAN_MAX_PORTS	3
 #define MCA_PAN_EN_PENDING	BIT(MCA_PAN_MAX_PORTS)
 
-static bool mipps_auth;
+static bool mipps_auth = true;
 module_param(mipps_auth, bool, 0444);
 MODULE_PARM_DESC(mipps_auth,
-		 "Authenticate Xiaomi MiPPS adapters before PPS negotiation (default: off)");
+		 "Authenticate Xiaomi MiPPS adapters before PPS negotiation (default: on, may be disabled for debugging)");
 
 /*
  * cp_charge: direct charging through the SC8541 2:1 switched-capacitor
@@ -293,6 +293,20 @@ MODULE_PARM_DESC(mipps_auth,
 #define MCA_FFC_IBAT_MAX_MA	12400
 #define MCA_FFC_FV_MV		4550
 #define MCA_FFC_SOC_MAX		95
+/*
+ * Stock 4.0.6 mca_strategy_quickchg cycle policy.  The vendor MCA source
+ * is not part of the public kernel tree; these values are the 4.0.6
+ * runtime FDT enable_cp_para, drop_fcc_para and drop_fv_* properties:
+ *
+ *   cycles       FCC drop   CP SOC max   CP headroom
+ *   < 300        0          90 %         70 mV
+ *   300..799     500 mA     85 %         90 mV
+ *   800..1199    1000 mA    80 %         200 mV
+ *   >= 1200      1000 mA    70 %         250 mV
+ *
+ * drop_fv_cycle 300 / drop_fv_value 20 adds 20 mV to the last stage
+ * voltage used by the CP entry check once the pack reaches 300 cycles.
+ */
 #define MCA_FFC_TEMP_MIN	18
 #define MCA_FFC_TEMP_MAX	48
 #define MCA_FFC_BUCK_STOP_MV	4480
@@ -345,7 +359,7 @@ static const struct piano_mca_cp_profile piano_mca_ffc_profiles[] = {
 };
 
 struct piano_mca_cp_limits {
-	u32 ma, cv_mv, fv_mv, iterm_ma;
+	u32 ma, cv_mv, fv_mv, last_mv, iterm_ma;
 	bool last;
 };
 
@@ -407,11 +421,13 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 #define MCA_CP_PAR_FCC_MA	2000
 #define MCA_CP_PAR_ICL_MA	1500
 #define MCA_CP_PPS_MAX_MA	6000	/* current limit asked of the source */
-#define MCA_CP_IBUS_MAX_MA	5000
+/* Stock div_max_curr for 2:1 is 12000 mA battery, i.e. 6000 mA bus. */
+#define MCA_CP_IBUS_MAX_MA	6000
 #define MCA_CP_THIRD_IBUS_MA	4100
 /* bus over-current protection of the stage, above the target */
 #define MCA_CP_BUSOCP_MARGIN_MA	1000
-#define MCA_CP_BUSOCP_MAX_MA	6000
+/* Stock SC8541 bus OCP is 7000 mA. */
+#define MCA_CP_BUSOCP_MAX_MA	7000
 #define MCA_CP_OPEN_IBUS_MA	500	/* the stage counts as running above */
 #define MCA_CP_OPEN_TRIES	10
 #define MCA_CP_LOW_IBUS_MA	300	/* leaves when below for MCA_CP_LOW_POLLS */
@@ -433,15 +449,15 @@ static const struct piano_mca_jeita piano_mca_jeita[] = {
 /* an authenticated adapter resets itself within this, see piano_mca_auth_pending() */
 #define MCA_AUTH_RESET_WAIT_MS	30000
 
-static bool cp_charge;
+static bool cp_charge = true;
 module_param(cp_charge, bool, 0444);
 MODULE_PARM_DESC(cp_charge,
-		 "Charge through the SC8541 switched-capacitor stage from PPS sources; needs hv_charge and charge_current (default: off)");
+		 "Charge through the SC8541 switched-capacitor stage from PPS sources; needs hv_charge and charge_current (default: on, may be disabled for debugging)");
 
-static unsigned int cp_ibus_max = 5000;
+static unsigned int cp_ibus_max = 6000;
 module_param(cp_ibus_max, uint, 0444);
 MODULE_PARM_DESC(cp_ibus_max,
-		 "Bus current of the switched-capacitor stage, mA (500-5000, default 5000; constrained by the combined pump/PMIC source budget)");
+		 "Bus current of the switched-capacitor stage, mA (500-6000, default 6000; stock 2:1 is 6000 mA for a 12000 mA battery budget)");
 
 static unsigned int cp_ibat_max = MCA_FFC_IBAT_MAX_MA;
 module_param(cp_ibat_max, uint, 0444);
@@ -593,6 +609,9 @@ struct piano_mca {
 	u32 battery_fv_derate_mv;
 	u32 battery_normal_fv_derate_mv;
 	u32 battery_health_fv_derate_mv;
+	u32 cp_soc_max;		/* stock enable_cp_para SOC gate */
+	u32 cp_headroom_mv;	/* stock enable_cp_para voltage headroom */
+	u32 cp_fv_extra_mv;	/* stock drop_fv_value after drop_fv_cycle */
 	u32 iterm_set_ma;
 	u32 buck_cv_steps;
 	unsigned long buck_cv_at;
@@ -2088,6 +2107,30 @@ static int piano_mca_normal_pause(struct piano_mca *mca,
 				  unsigned int generation,
 				  unsigned int connection);
 
+static void piano_mca_cycle_policy(struct piano_mca *mca)
+{
+	u32 cycles = mca->battery_cycles > 0 ? mca->battery_cycles : 0;
+
+	if (cycles < 300) {
+		mca->battery_fcc_derate_ma = 0;
+		mca->cp_soc_max = 90;
+		mca->cp_headroom_mv = 70;
+	} else if (cycles < 800) {
+		mca->battery_fcc_derate_ma = 500;
+		mca->cp_soc_max = 85;
+		mca->cp_headroom_mv = 90;
+	} else if (cycles < 1200) {
+		mca->battery_fcc_derate_ma = 1000;
+		mca->cp_soc_max = 80;
+		mca->cp_headroom_mv = 200;
+	} else {
+		mca->battery_fcc_derate_ma = 1000;
+		mca->cp_soc_max = 70;
+		mca->cp_headroom_mv = 250;
+	}
+	mca->cp_fv_extra_mv = cycles >= 300 ? 20 : 0;
+}
+
 static int piano_mca_battery_state(struct piano_mca *mca)
 {
 	union power_supply_propval value;
@@ -2096,6 +2139,11 @@ static int piano_mca_battery_state(struct piano_mca *mca)
 
 	mca->battery_authentic = false;
 	mca->battery_cycles = 0;
+	mca->battery_soc = 0;
+	mca->battery_fcc_derate_ma = 0;
+	mca->cp_soc_max = 90;
+	mca->cp_headroom_mv = 70;
+	mca->cp_fv_extra_mv = 0;
 	for (i = 0; i < ARRAY_SIZE(piano_mca_supplied_to); i++) {
 		psy = power_supply_get_by_name(piano_mca_supplied_to[i]);
 		if (!psy)
@@ -2146,8 +2194,7 @@ static int piano_mca_battery_state(struct piano_mca *mca)
 	if (soc < 0 || soc > 10000)
 		return -ENODATA;
 	mca->battery_soc = soc / 100;
-	/* The final same-device smart_charge cc_ichg_cfg, not ut_test. */
-	mca->battery_fcc_derate_ma = mca->battery_cycles <= 800 ? 100 : 200;
+	piano_mca_cycle_policy(mca);
 	/* Active Piano BAA_config_final CN-battery, not the DT's ut_test table. */
 	mca->battery_fv_derate_mv = mca->battery_cycles <= 100 ? 0 :
 		mca->battery_cycles <= 300 ? 20 : mca->battery_cycles < 1000 ? 40 : 50;
@@ -2362,14 +2409,15 @@ static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
 		}
 	}
 	ma = min(ma, (u32)voltage->max_ma);
-	if (mca->ffc)
+	if (mca->battery_authentic)
 		ma -= min(ma, mca->battery_fcc_derate_ma);
-	else if (!mca->battery_authentic)
+	else
 		ma = min(ma, 2000U);
 	limits->ma = min(ma, piano_mca_charge_limit(mca));
 	limits->last = stage + 1 == profile->count;
 	limits->cv_mv = voltage->mv - (limits->last ? MCA_CP_TAPER_DELTA_MV : 0);
 	limits->fv_mv = profile->fv_mv;
+	limits->last_mv = profile->voltage[profile->count - 1].mv;
 	limits->iterm_ma = mca->ffc ? profile->voltage[profile->count - 1].min_ma +
 					     (twarm >= 35 ? 68 : 75) : MCA_NORMAL_ITERM_MA;
 	if (vbat >= limits->cv_mv)
@@ -2377,6 +2425,23 @@ static int piano_mca_cp_normal_limits(struct piano_mca *mca, int vbat, int ibat,
 	return 0;
 }
 
+/*
+ * Stock enable_cp_para: do not open the pump unless the pack is below the
+ * cycle-dependent SOC limit and the last stage still has enough voltage
+ * headroom.  drop_fv_value adds 20 mV after drop_fv_cycle (300 cycles).
+ */
+static bool piano_mca_cp_entry_allowed(struct piano_mca *mca, int vbat,
+				       const struct piano_mca_cp_limits *limits)
+{
+	int target = limits->last_mv + mca->cp_fv_extra_mv;
+
+	if (mca->battery_soc < 0 || mca->battery_soc >= mca->cp_soc_max)
+		return false;
+	if (target - vbat <= mca->cp_headroom_mv)
+		return false;
+	return true;
+}
+
 /* Factory low-FV JEITA vote, independent of the temperature-stop vote. */
 static bool piano_mca_normal_voltage_stop(struct piano_mca *mca, int vbat, int fv)
 {
@@ -2978,6 +3043,7 @@ static void piano_mca_cp_try_start(struct piano_mca *mca, unsigned int generatio
 	    limits.ma < MCA_CP_BUCK_MA + 4 * MCA_CP_OPEN_IBUS_MA ||
 	    piano_mca_normal_voltage_stop(mca, vbat, limits.fv_mv) ||
 	    vbat < MCA_CP_VBAT_MIN_MV || vbat >= limits.cv_mv ||
+	    !piano_mca_cp_entry_allowed(mca, vbat, &limits) ||
 	    piano_mca_verifying(mca, generation, mca->cp_connection_generation))
 		return;
 	/* Keep the PMIC stopped until all gauge and charger limits are set. */
diff --git a/drivers/power/supply/piano_mca_test.c b/drivers/power/supply/piano_mca_test.c
index d91e80cda..9039eb3ec 100644
--- a/drivers/power/supply/piano_mca_test.c
+++ b/drivers/power/supply/piano_mca_test.c
@@ -3638,7 +3638,61 @@ static void piano_mca_ffc_tail_does_not_reenter_test(struct kunit *test)
 	KUNIT_EXPECT_TRUE(test, f->mca.normal_full);
 }
 
+static void piano_mca_cycle_policy_test(struct kunit *test)
+{
+	static const struct {
+		int cycles;
+		u32 drop, soc, headroom, extra;
+	} cases[] = {
+		{ 0, 0, 90, 70, 0 },
+		{ 299, 0, 90, 70, 0 },
+		{ 300, 500, 85, 90, 20 },
+		{ 799, 500, 85, 90, 20 },
+		{ 800, 1000, 80, 200, 20 },
+		{ 1199, 1000, 80, 200, 20 },
+		{ 1200, 1000, 70, 250, 20 },
+		{ 2000, 1000, 70, 250, 20 },
+	};
+	struct piano_mca mca = { 0 };
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		mca.battery_cycles = cases[i].cycles;
+		piano_mca_cycle_policy(&mca);
+		KUNIT_EXPECT_EQ(test, mca.battery_fcc_derate_ma, cases[i].drop);
+		KUNIT_EXPECT_EQ(test, mca.cp_soc_max, cases[i].soc);
+		KUNIT_EXPECT_EQ(test, mca.cp_headroom_mv, cases[i].headroom);
+		KUNIT_EXPECT_EQ(test, mca.cp_fv_extra_mv, cases[i].extra);
+	}
+}
+
+static void piano_mca_cp_entry_gate_test(struct kunit *test)
+{
+	struct piano_mca mca = {
+		.battery_soc = 89,
+		.cp_soc_max = 90,
+		.cp_headroom_mv = 70,
+	};
+	struct piano_mca_cp_limits limits = { .last_mv = 4540 };
+
+	KUNIT_EXPECT_TRUE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+	mca.battery_soc = 90;
+	KUNIT_EXPECT_FALSE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+	mca.battery_soc = 89;
+	mca.cp_headroom_mv = 141;
+	KUNIT_EXPECT_FALSE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+	mca.cp_headroom_mv = 139;
+	KUNIT_EXPECT_TRUE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+	mca.cp_fv_extra_mv = 20;
+	mca.cp_headroom_mv = 160;
+	KUNIT_EXPECT_FALSE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+	mca.cp_headroom_mv = 159;
+	KUNIT_EXPECT_TRUE(test, piano_mca_cp_entry_allowed(&mca, 4400, &limits));
+}
+
 static struct kunit_case piano_mca_test_cases[] = {
+	KUNIT_CASE(piano_mca_cycle_policy_test),
+	KUNIT_CASE(piano_mca_cp_entry_gate_test),
 	KUNIT_CASE(piano_mca_ffc_requires_both_gauges_test),
 	KUNIT_CASE(piano_mca_ffc_temperature_and_thermal_budget_test),
 	KUNIT_CASE(piano_mca_ffc_partial_mode_write_rolls_back_test),
-- 
