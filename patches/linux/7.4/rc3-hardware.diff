+
+static int ktz8866_read_brightness(struct regmap *regmap)
+{
+	unsigned int enable;
+	u8 values[2];
+	int ret;
+
+	ret = regmap_read(regmap, BL_EN, &enable);
+	if (ret)
+		return ret;
+	if (!(enable & BL_EN_BIT) || !(enable & BL_SINK_MASK))
+		return 0;
+
+	ret = regmap_bulk_read(regmap, BL_BRT_LSB, values, ARRAY_SIZE(values));
+	if (ret)
+		return ret;
+
+	return (values[1] << 3) | (values[0] & 0x7);
+}
+
+static int ktz8866_backlight_get_brightness(struct backlight_device *backlight_dev)
+{
+	struct ktz8866 *ktz = bl_get_data(backlight_dev);
+	int primary, secondary;
+
+	guard(mutex)(&ktz->lock);
+
+	/* Failed MSB writes can leave the LSB register updated but not latched. */
+	if (ktz->update_error)
+		return ktz->update_error;
+
+	primary = ktz8866_read_brightness(ktz->regmap);
+	if (primary < 0 || !ktz->secondary)
+		return primary;
+
+	secondary = ktz8866_read_brightness(ktz->secondary);
+	if (secondary < 0)
+		return secondary;
+	if (secondary != primary)
+		return -EIO;
+
+	return primary;
+}
