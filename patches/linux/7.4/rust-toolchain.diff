+class BinderToolchainTests(unittest.TestCase):
+    def test_only_rust_binder_needs_rust_and_keeps_the_same_devices(self):
+        with tempfile.TemporaryDirectory(prefix='binder-kconfig-') as directory:
+            source = Path(directory)
+            kconfig = source / 'drivers/android/Kconfig'
+            kconfig.parent.mkdir(parents=True)
+            expected = dict(full.PLATFORM_OVERRIDES)
+            rust = 'config ANDROID_BINDER_IPC_RUST\n\tbool "Rust Binder"\n'
+            kconfig.write_text('config ANDROID_BINDER_IPC\n\tbool "C Binder"\n' + rust)
+            self.assertEqual(full.binder_overrides(source, expected), expected)
+            c_config = full.config_values(full.effective_config(full.binder_overrides(source, expected)))
+            self.assertNotIn('CONFIG_RUST', c_config)
+            kconfig.write_text(rust)
+            config = full.config_values(full.effective_config(full.binder_overrides(source, expected)))
+            for name in ('CONFIG_ANDROID_BINDER_IPC', 'CONFIG_ANDROID_BINDERFS'):
+                self.assertNotIn(name, config)
+            self.assertEqual(config['CONFIG_RUST'], 'y')
+            self.assertEqual(config['CONFIG_ANDROID_BINDER_IPC_RUST'], 'y')
+            self.assertEqual(config['CONFIG_ANDROID_BINDER_DEVICES'], expected['CONFIG_ANDROID_BINDER_DEVICES'])
+            self.assertEqual(config['CONFIG_LTO_CLANG_THIN'], 'y')
+
+    def test_sealed_toolchain_tracks_libclang_and_each_rust_library_file(self):
+        with tempfile.TemporaryDirectory(prefix='rust-toolchain-') as directory:
+            root = Path(directory)
+            rust_src, rust_std, clang = (root / name for name in ('src', 'std', 'libclang.so'))
+            files = (rust_src / 'core/src/lib.rs', rust_std / 'libcore.rlib', clang)
+            for file in files:
+                file.parent.mkdir(parents=True, exist_ok=True)
+                file.write_bytes(b'original')
+            paths = {'rust_src': rust_src, 'rust_std': rust_std, 'libclang': clang}
+            sealed = full.toolchain_digests(paths)
+            for file in files:
+                with self.subTest(file=file.name):
+                    file.write_bytes(b'modified')
+                    self.assertNotEqual(full.toolchain_digests(paths), sealed)
+                    file.write_bytes(b'original')
+            self.assertEqual(full.toolchain_digests(paths), sealed)
+
+    @unittest.skipUnless(shutil.which('cc') and shutil.which('ldd'),
+                         'native compiler and dynamic loader required')
+    def test_runtime_library_fingerprint_follows_loader_not_binary_path(self):
+        with tempfile.TemporaryDirectory(prefix='kernel-tool-runtime-') as directory:
+            root = Path(directory)
+            library = 'libkernel-tool-test.so'
+            environment = dict(os.environ)
+            original, replaced = root / 'original', root / 'replaced'
+            for path, status in ((original, 17), (replaced, 19)):
+                path.mkdir()
+                subprocess.run(['cc', '-shared', '-fPIC', '-Wl,-soname,' + library,
+                                '-x', 'c', '-', '-o', path / library],
+                               input=f'int tool_status(void) {{ return {status}; }}',
+                               text=True, check=True)
+            binary = root / 'tool'
+            subprocess.run(['cc', '-x', 'c', '-', '-L' + str(original),
+                            '-lkernel-tool-test', '-o', binary],
+                           input='int tool_status(void); int main(void) { return tool_status(); }',
+                           text=True, check=True)
+            records = []
+            for path, status in ((original, 17), (replaced, 19)):
+                environment['LD_LIBRARY_PATH'] = str(path)
+                self.assertEqual(subprocess.run([binary], env=environment).returncode, status)
+                paths = {'tool': binary, **full.tool_runtime_libraries('tool', binary, environment)}
+                self.assertEqual(paths['tool:' + library], str(path / library))
+                records.append(full.toolchain_digests(paths))
+            self.assertEqual(records[0]['tool'], records[1]['tool'])
+            self.assertNotEqual(records[0]['tool:' + library], records[1]['tool:' + library])
