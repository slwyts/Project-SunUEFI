+    nvt_thp_restore_game(); assert(!ts->thp_game_valid);
+    reset(); confirmed_request(1); ts->thp_game_prior_valid=true; ts->thp_game_prior=0;
+    plan_game(true, 0); plan_game(false, 1); plan_game(true, 1);
