+bool canTryV4L2H264(const QMediaEncoderSettings &settings, AVPixelFormat sourceFormat)
+{
+    // These muxers can obtain H.264 sequence headers from the first packet.
+    const auto container = settings.fileFormat();
+    if (container != QMediaFormat::MPEG4 && container != QMediaFormat::QuickTime)
+        return false;
+
+    const auto mode = settings.encodingMode();
+    if (mode != QMediaRecorder::ConstantQualityEncoding && mode != QMediaRecorder::AverageBitRateEncoding)
+        return false;
+
+    // The layouts tried below are eight-bit. Leave higher depths to other encoders.
+    const auto *desc = av_pix_fmt_desc_get(sourceFormat);
+    return avCodecID(settings) == AV_CODEC_ID_H264 && desc && desc->comp[0].depth == 8;
+}
