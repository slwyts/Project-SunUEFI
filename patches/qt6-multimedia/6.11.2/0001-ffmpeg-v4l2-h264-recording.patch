     return findAVCodec(Encoders, codecId, format);
 }
 
+std::optional<Codec> findV4L2H264Encoder()
+{
+#if defined(Q_OS_LINUX) && !defined(Q_OS_ANDROID)
+    // An explicitly selected hardware backend list takes precedence over
+    // V4L2, which FFmpeg does not expose as an AVHWDeviceType.
+    if (qEnvironmentVariableIsSet("QT_FFMPEG_ENCODING_HW_DEVICE_TYPES"))
+        return std::nullopt;
+
+    // Try V4L2 only while setting up a recorder. Its registered wrappers do
+    // not imply an available device or a supported input format.
+    for (const Codec codec : CodecEnumerator()) {
+        if (codec.id() == AV_CODEC_ID_H264 && codec.isEncoder() && !codec.isExperimental()
+            && QLatin1StringView{ codec.get()->wrapper_name } == QLatin1StringView{ "v4l2m2m" }
+            && !CodecStoreSingleton::isExcludedEncoder(codec.name())) {
+            return codec;
+        }
+    }
+#endif
+    return std::nullopt;
+}
