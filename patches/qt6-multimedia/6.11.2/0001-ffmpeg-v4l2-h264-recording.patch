+bool configureV4L2H264Encoder(const QMediaEncoderSettings &settings, AVCodecContext *codec)
+{
+    // ITU-T H.264 Annex A, table A-1. Use the bitrate limit without the
+    // high-profile multiplier: the driver selects the actual profile.
+    static constexpr struct Level {
+        int idc;
+        int macroblocksPerSecond;
+        int macroblocksPerFrame;
+        int kilobitsPerSecond;
+    } levels[] = {
+        { 10,     1485,     99,     64 },
+        {  9,     1485,     99,    128 }, // Level 1b
+        { 11,     3000,    396,    192 },
+        { 12,     6000,    396,    384 },
+        { 13,    11880,    396,    768 },
+        { 20,    11880,    396,   2000 },
+        { 21,    19800,    792,   4000 },
+        { 22,    20250,   1620,   4000 },
+        { 30,    40500,   1620,  10000 },
+        { 31,   108000,   3600,  14000 },
+        { 32,   216000,   5120,  20000 },
+        { 40,   245760,   8192,  20000 },
+        { 41,   245760,   8192,  50000 },
+        { 42,   522240,   8704,  50000 },
+        { 50,   589824,  22080, 135000 },
+        { 51,   983040,  36864, 240000 },
+        { 52,  2073600,  36864, 240000 },
+        { 60,  4177920, 139264, 240000 },
+        { 61,  8355840, 139264, 480000 },
+        { 62, 16711680, 139264, 800000 },
+    };
+    if (codec->width < 1 || codec->height < 1 || codec->framerate.num < 1
+        || codec->framerate.den < 1) {
+        return false;
+    }
+
+    const qint64 width = (qint64(codec->width) + 15) / 16;
+    const qint64 height = (qint64(codec->height) + 15) / 16;
+    const qint64 frameSize = width * height;
+    if (frameSize > levels[std::size(levels) - 1].macroblocksPerFrame)
+        return false;
+
+    const auto rate = codec->framerate;
+    const auto bitrate = settings.videoBitRate() > 0 ? settings.videoBitRate()
+                                                    : bitrateForSettings(settings);
+    if (bitrate <= 0)
+        return false;
+
+    for (const auto &level : levels) {
+        const qint64 maxFrameSize = level.macroblocksPerFrame;
+        if (frameSize <= maxFrameSize && width * width <= 8 * maxFrameSize
+            && height * height <= 8 * maxFrameSize
+            && frameSize * rate.num <= qint64(level.macroblocksPerSecond) * rate.den
+            && bitrate <= level.kilobitsPerSecond * 1000) {
+            codec->bit_rate = bitrate;
+            codec->level = level.idc;
+            return true;
+        }
+    }
+    return false;
+}
