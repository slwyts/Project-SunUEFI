 		break;
@@ -1768,6 +1776,7 @@ libwacom_stylus_get_for_id(const WacomDeviceDatabase *db,
 	case GENERIC_PEN_NO_ERASER:
 	case GENERIC_PEN_3BTN_WITH_ERASER:
 	case GENERIC_ERASER_3BTN:
+	case GENERIC_PEN_NO_ERASER_TILT:
