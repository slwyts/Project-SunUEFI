         assert device.bustype == WacomBustype.BLUETOOTH
 
 
+def test_new_from_spi_builder(db):
+    builder = WacomBuilder.create(
+        bus=WacomBustype.SPI, usbid=(0x0603, 0x6532), match_name="Novatek Focus Pen Pro"
+    )
+    device = db.new_from_builder(builder)
+    assert device is not None
+    assert device.bustype == WacomBustype.SPI
+    assert device.name == "Xiaomi Pad 8 Pro"
+
+
 def test_new_from_builder_empty(db):
     builder = WacomBuilder.create()
     device = db.new_from_builder(builder)
@@ -608,6 +618,7 @@ def test_new_from_path_unknown_device(db, fallback, bustype):
         WacomBustype.USB: 0x3,
