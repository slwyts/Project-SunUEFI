From: Project SunUEFI <sunuefi@users.noreply.github.com>
Subject: [PATCH] Support SPI digitizers and describe Xiaomi Pad 8 Pro pens

Keep SPI input identity intact, describe pressure and tilt without an
inverted eraser, and let standard desktop tablet settings find the device.

diff --git a/data/wacom.example b/data/wacom.example
index d2287c9..e4f090f 100644
--- a/data/wacom.example
+++ b/data/wacom.example
@@ -59,7 +59,7 @@ Name=Wacom Intuos4 6x9
 # Leave blank where the device name is sufficient to identify.
 ModelName=
 
-# DeviceMatch includes the bus (usb, bluetooth, serial), the vendor ID and
+# DeviceMatch includes the bus (usb, bluetooth, serial, i2c, spi), the vendor ID and
 # product ID and optionally the device name. This is the connector used,
 # not whatever name the kernel might give it, so some "Wacom Serial" builtin
 # devices will be USB as that's how they're connected.
@@ -127,6 +127,8 @@ Layout=wacom-bamboo-16fg-m-pt.svg
 # Styli=@generic-with-eraser
 # If the stylus does not have an eraser:
 # Styli=@generic-no-eraser
+# With tilt and no eraser:
+# Styli=@generic-no-eraser-tilt
 # If the stylus has 3 buttons and an eraser (e.g. Huion PW600):
 # Styli=@generic-3btn-with-eraser
 #
diff --git a/data/wacom.stylus b/data/wacom.stylus
index 56725d8..93d1a7f 100644
--- a/data/wacom.stylus
+++ b/data/wacom.stylus
@@ -26,6 +26,14 @@ Axes=Pressure;
 Type=General
 IsGenericStylus=true
 
+[0x0:0xffffa]
+Name=General Pen with Tilt and no Eraser
+Group=generic-no-eraser-tilt
+Buttons=2
+Axes=Tilt;Pressure;
+Type=General
+IsGenericStylus=true
+
 # Used by e.g. Huion devices
 [0x0:0xffffb]
 Name=General 3 Button Pen
diff --git a/data/xiaomi-pad-8-pro.tablet b/data/xiaomi-pad-8-pro.tablet
new file mode 100644
index 0000000..4f0898b
--- /dev/null
+++ b/data/xiaomi-pad-8-pro.tablet
@@ -0,0 +1,16 @@
+# Novatek NT36532E SPI digitizer, as reported by the Linux input driver.
+# Both pens share the digitizer's IDs; the driver reports the connected model.
+
+[Device]
+Name=Xiaomi Pad 8 Pro
+ModelName=piano
+DeviceMatch=spi|0603|6532|Novatek Focus Pen;spi|0603|6532|Novatek Focus Pen Pro;
+Class=ISDV4
+Width=239
+Height=163
+IntegratedIn=Display;System
+Styli=@generic-no-eraser-tilt;
+
+[Features]
+Stylus=true
+Touch=false
