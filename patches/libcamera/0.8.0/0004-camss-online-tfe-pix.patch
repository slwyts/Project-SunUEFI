+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Qualcomm TFE online PIX capture
+ */
+
+#include "camss_csi.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+#include <cstdlib>
+#include <map>
+
+#include <linux/media-bus-format.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/formats.h>
+#include <libcamera/property_ids.h>
+
+#include "libcamera/internal/media_device.h"
+#include "libcamera/internal/sysfs.h"
+
+namespace libcamera {
+
+LOG_DECLARE_CATEGORY(Camss)
+
+namespace {
+
+bool isBayer10(unsigned int code)
+{
+	switch (code) {
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+		return true;
+	default:
+		return false;
+	}
+}
+
+bool isPixFormat(const V4L2DeviceFormat &format, const Size &size)
+{
+	uint64_t stride = format.planes[0].bpl;
+
+	return format.fourcc == V4L2PixelFormat(V4L2_PIX_FMT_NV12) &&
+	       format.size == size && format.planesCount == 1 &&
+	       stride >= size.width && format.planes[0].size >= stride * size.height * 3 / 2;
+}
+
+int setFormat(V4L2Subdevice *dev, unsigned int pad, V4L2SubdeviceFormat format)
+{
+	/* Each sink must preserve the sensor's code and geometry. */
+	V4L2SubdeviceFormat requested = format;
+	int ret = dev->setFormat(pad, &format);
+	if (ret)
+		return ret;
+
+	return format.size == requested.size && format.code == requested.code ? 0 : -EINVAL;
+}
+
+/* Configure only links incident to the selected route. Other cameras use
+ * different PHY, CSID and VFE entities. Restore the old link state on failure.
+ */
+class PixLinks
+{
+public:
+	~PixLinks()
+	{
+		for (auto it = changes_.rbegin(); it != changes_.rend(); ++it) {
+			if (it->first->setEnabled(!it->second))
+				LOG(Camss, Error) << "Failed to restore " << *it->first;
+		}
+	}
+
+	int select(MediaLink *link)
+	{
+		for (const MediaPad *pad : link->source()->entity()->pads()) {
+			if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+				continue;
+
+			for (MediaLink *other : pad->links()) {
+				if (other != link && !(other->flags() & MEDIA_LNK_FL_IMMUTABLE)) {
+					int ret = change(other, false);
+					if (ret)
+						return ret;
+				}
+			}
+		}
+
+		for (MediaLink *other : link->sink()->links()) {
+			if (other != link) {
+				int ret = change(other, false);
+				if (ret)
+					return ret;
+			}
+		}
+
+		return change(link, true);
+	}
+
+	void commit() { changes_.clear(); }
+
+private:
+	int change(MediaLink *link, bool enabled)
+	{
+		if (!!(link->flags() & MEDIA_LNK_FL_ENABLED) == enabled)
+			return 0;
+
+		int ret = link->setEnabled(enabled);
+		if (ret)
+			return ret;
+
+		changes_.emplace_back(link, enabled);
+		return 0;
+	}
+
+	std::vector<std::pair<MediaLink *, bool>> changes_;
+};
+
+} /* namespace */
+
+int CamssCsiCamera::initPix()
+{
+	const MediaPad *source = links_[SensorPhyLink].link->source();
+	const MediaEntity *entity = source->entity();
+	const std::string model = entity->name().substr(0, entity->name().find(' '));
+
+	/*
+	 * Restrict the initial implementation to the known binned modes.
+	 * The full-size modes have a Quad CFA that the PIX path cannot remosaic.
+	 */
+	if (model != "s5kjn1" && model != "ov32d40")
+		return -ENODEV;
+	if (!output_->formats().contains(V4L2PixelFormat(V4L2_PIX_FMT_NV12)))
+		return -ENODEV;
+
+	pixSensor_ = std::make_unique<V4L2Subdevice>(entity);
+	int ret = pixSensor_->open();
+	if (ret)
+		return ret;
+
+	pixId_ = sysfs::firmwareNodePath(pixSensor_->devicePath());
+	if (pixId_.empty())
+		return -ENODEV;
+
+	for (const auto &[code, ranges] : pixSensor_->formats(source->index())) {
+		if (!isBayer10(code))
+			continue;
+		for (const SizeRange &range : ranges) {
+			const Size &size = range.min;
+
+			if (size == range.max && !size.isNull() && size.width <= 4096 &&
+			    !(size.width % 16) && !(size.height % 2))
+				pixSizes_.push_back(size);
+		}
+	}
+	std::sort(pixSizes_.begin(), pixSizes_.end());
+	pixSizes_.erase(std::unique(pixSizes_.begin(), pixSizes_.end()), pixSizes_.end());
+	if (pixSizes_.empty())
+		return -ENODEV;
+
+	pixProperties_ = ControlList(properties::properties);
+	pixProperties_.set(properties::Model, model);
+	const auto &controls = pixSensor_->controls();
+	auto location = controls.find(V4L2_CID_CAMERA_ORIENTATION);
+	if (location != controls.end()) {
+		switch (location->second.def().get<int32_t>()) {
+		case V4L2_CAMERA_ORIENTATION_FRONT:
+			pixProperties_.set(properties::Location, properties::LocationFront);
+			break;
+		case V4L2_CAMERA_ORIENTATION_BACK:
+			pixProperties_.set(properties::Location, properties::LocationBack);
+			break;
+		case V4L2_CAMERA_ORIENTATION_EXTERNAL:
+			pixProperties_.set(properties::Location, properties::LocationExternal);
+			break;
+		}
+	}
+	auto rotation = controls.find(V4L2_CID_CAMERA_SENSOR_ROTATION);
+	if (rotation != controls.end()) {
+		int32_t angle = rotation->second.def().get<int32_t>();
+		auto orientation = orientationFromRotation(angle);
+		if (orientation) {
+			pixOrientation_ = *orientation;
+			pixProperties_.set(properties::Rotation, angle);
+		}
+	}
+
+	return 0;
+}
