+StreamConfiguration CamssCsiCamera::generatePixConfiguration() const
+{
+	std::vector<SizeRange> sizes(pixSizes_.begin(), pixSizes_.end());
+	StreamConfiguration cfg(StreamFormats({ { formats::NV12, sizes } }));
+
+	cfg.size = pixSizes_.back();
+	cfg.pixelFormat = formats::NV12;
+
+	return cfg;
+}
+
+int CamssCsiCamera::validatePix(StreamConfiguration *cfg) const
+{
+	if (!output_->isOpen())
+		return -EPIPE;
+
+	auto error = [cfg](const Size &size) {
+		return std::abs(static_cast<int64_t>(size.width) - cfg->size.width) +
+		       std::abs(static_cast<int64_t>(size.height) - cfg->size.height);
+	};
+	const Size &size = *std::min_element(pixSizes_.begin(), pixSizes_.end(),
+					    [&error](const Size &a, const Size &b) {
+		return error(a) < error(b);
+	});
+	V4L2DeviceFormat fmt = {};
+	fmt.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+	fmt.planesCount = 1;
+	fmt.size = size;
+
+	int ret = output_->tryFormat(&fmt);
+	if (ret)
+		return ret;
+	if (!isPixFormat(fmt, size))
+		return -EINVAL;
+
+	cfg->size = size;
+	cfg->pixelFormat = formats::NV12;
+	cfg->stride = fmt.planes[0].bpl;
+	cfg->frameSize = fmt.planes[0].size;
+	cfg->colorSpace = fmt.colorSpace;
+	/* Applications can choose enough real buffers to cover scheduling delays. */
+	cfg->bufferCount = std::clamp(cfg->bufferCount, kBufferCount,
+				      static_cast<unsigned int>(VIDEO_MAX_FRAME));
+
+	return 0;
+}
+
+int CamssCsiCamera::configurePix(const StreamConfiguration &cfg)
+{
+	auto &phy = links_[SensorPhyLink];
+	auto &csid = links_[PhyCsidLink];
+	auto &vfe = links_[CsidVfeLink];
+	unsigned int sensorPad = phy.link->source()->index();
+	unsigned int pixPad = vfe.link->source()->index();
+	PixLinks changes;
+	int ret;
+
+	/*
+	 * Do not modify formats before the selected links have been accepted
+	 * by the media controller. Link changes to a streaming entity fail.
+	 */
+	for (const auto &link : links_) {
+		ret = changes.select(link.link);
+		if (ret)
+			return ret;
+	}
+
+	ControlList flips(pixSensor_->controls());
+	for (unsigned int id : { V4L2_CID_HFLIP, V4L2_CID_VFLIP }) {
+		const auto *info = pixSensor_->controlInfo(id);
+		if (info && !(info->flags & V4L2_CTRL_FLAG_READ_ONLY))
+			flips.set(id, 0);
+	}
+	if (!flips.empty() && pixSensor_->setControls(&flips))
+		return -EINVAL;
+
+	V4L2SubdeviceFormat raw;
+	ret = pixSensor_->getFormat(sensorPad, &raw);
+	if (ret)
+		return ret;
+	raw.size = cfg.size;
+	ret = pixSensor_->setFormat(sensorPad, &raw);
+	if (ret)
+		return ret;
+	if (!isBayer10(raw.code) || raw.size != cfg.size)
+		return -EINVAL;
+
+	ret = setFormat(phy.sinkSubdev.get(), phy.link->sink()->index(), raw);
+	if (ret)
+		return ret;
+	ret = setFormat(csid.sinkSubdev.get(), csid.link->sink()->index(), raw);
+	if (ret)
+		return ret;
+	ret = setFormat(csid.sinkSubdev.get(), pixPad, raw);
+	if (ret)
+		return ret;
+	ret = setFormat(vfe.sinkSubdev.get(), vfe.link->sink()->index(), raw);
+	if (ret)
+		return ret;
+
+	/* The first online path exposes 1:1 binned modes only. */
+	Rectangle full(cfg.size), compose(full), crop(full);
+	ret = vfe.sinkSubdev->setSelection(0, V4L2_SEL_TGT_COMPOSE, &compose);
+	if (ret)
+		return ret;
+	ret = vfe.sinkSubdev->setSelection(1, V4L2_SEL_TGT_CROP, &crop);
+	if (ret)
+		return ret;
+	if (compose != full || crop != full)
+		return -EINVAL;
+
+	V4L2SubdeviceFormat yuv = raw;
+	yuv.code = MEDIA_BUS_FMT_YUYV8_1_5X8;
+	ret = setFormat(vfe.sinkSubdev.get(), 1, yuv);
+	if (ret)
+		return ret;
+
+	V4L2DeviceFormat fmt = {};
+	fmt.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_NV12);
+	fmt.planesCount = 1;
+	fmt.size = cfg.size;
+	fmt.colorSpace = cfg.colorSpace;
+	ret = output_->setFormat(&fmt);
+	if (ret)
+		return ret;
+	if (!isPixFormat(fmt, cfg.size) || fmt.planes[0].bpl != cfg.stride ||
+	    fmt.planes[0].size != cfg.frameSize || fmt.colorSpace != cfg.colorSpace)
+		return -EIO;
+
+	bufferCount_ = cfg.bufferCount;
+	changes.commit();
+	return 0;
+}
+
+int CamssCsiCamera::startPix()
+{
+	if (!output_->isOpen())
+		return -EPIPE;
+
+	int ret = output_->importBuffers(bufferCount_);
+	if (ret)
+		return ret;
+
+	auto before = std::chrono::steady_clock::now();
+	LOG(Camss, Debug) << "Starting PIX STREAMON on " << output_->deviceNode()
+			  << " with " << bufferCount_ << " request buffers";
+	ret = output_->streamOn();
+	auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+		std::chrono::steady_clock::now() - before);
+	LOG(Camss, Debug) << "PIX STREAMON on " << output_->deviceNode() << ": "
+			  << elapsed.count() << " us, status " << ret;
+	if (ret && output_->releaseBuffers())
+		closePix();
+
+	return ret;
+}
+
+void CamssCsiCamera::stopPix()
+{
+	/* On failure close the device before returning outstanding buffers. */
+	if (output_->streamOff() || output_->releaseBuffers())
+		closePix();
+}
+
+void CamssCsiCamera::closePix()
+{
+	std::string node = output_->deviceNode();
+	output_.reset();
+	output_ = std::make_unique<V4L2VideoDevice>(node);
+	int ret = output_->open();
+	if (ret) {
+		output_->close();
+		LOG(Camss, Error) << "Failed to re-open " << node;
+	}
+}
+
+int CamssCsiCamera::queuePixBuffer(FrameBuffer *buffer)
+{
+	return output_->queueBuffer(buffer);
+}
+
+} /* namespace libcamera */
