+/**
+ * \brief Begin a camera start on the CameraManager thread
+ *
+ * A pipeline may finish synchronously or supply a blocking operation to run
+ * in the thread calling Camera::start().
+ */
+int PipelineHandler::startCamera(Camera *camera, const ControlList *controls,
+				 StartOperation *operation)
+{
+	Camera::Private *data = camera->_d();
+	int ret = data->isAccessAllowed(Camera::Private::CameraConfigured);
+	if (ret)
+		return ret;
+
+	data->setState(Camera::Private::CameraStarting);
+	ret = prepareStart(camera, controls, operation);
+	if (ret || !operation->run)
+		data->setState(ret ? Camera::Private::CameraConfigured : Camera::Private::CameraRunning);
+
+	return ret;
+}
+
+/**
+ * \brief Finish a deferred camera start on the CameraManager thread
+ */
+int PipelineHandler::completeCameraStart(Camera *camera, StartOperation *operation, int result)
+{
+	Camera::Private *data = camera->_d();
+	const bool disconnected = data->disconnected_;
+	int ret = operation->complete(result, disconnected);
+	if (disconnected)
+		ret = -ENODEV;
+
+	data->setState(ret ? Camera::Private::CameraConfigured : Camera::Private::CameraRunning);
+	return ret;
+}
+
+/**
+ * \brief Prepare a camera start or start it synchronously
+ *
+ * The camera is kept alive until the operation completes. Deferred operations
+ * must not access pipeline objects from the caller's thread. Their completion
+ * runs back on the CameraManager thread and must unwind resources on failure
+ * or disconnection before a new camera operation can start.
+ */
+int PipelineHandler::prepareStart(Camera *camera, const ControlList *controls,
+				  [[maybe_unused]] StartOperation *operation)
+{
+	return start(camera, controls);
+}
