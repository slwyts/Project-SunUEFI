Subject: [PATCH] gstreamer: fall back to the completed buffer timestamp

SensorTimestamp is optional. Treating an absent value as zero underflows
running time and gives encoders unusable PTS. Use the timestamp of a
completed capture buffer when the request provides no sensor timestamp.
Do not substitute a capture-completion timestamp for SensorTimestamp:
the latter describes the start of exposure.

--- a/src/gstreamer/gstlibcamerasrc.cpp
+++ b/src/gstreamer/gstlibcamerasrc.cpp
@@ -21,6 +21,7 @@
 
 #include "gstlibcamerasrc.h"
 
+#include <algorithm>
 #include <atomic>
 #include <queue>
 #include <tuple>
@@ -58,7 +59,8 @@
 };
 
 RequestWrap::RequestWrap(std::unique_ptr<Request> request)
-	: request_(std::move(request)), latency_(0), pts_(GST_CLOCK_TIME_NONE)
+	: request_(std::move(request)), latency_(GST_CLOCK_TIME_NONE),
+	  pts_(GST_CLOCK_TIME_NONE)
 {
 }
 
@@ -222,6 +224,36 @@
 	return 0;
 }
 
+static GstClockTime
+gst_libcamera_capture_latency(const Request &request)
+{
+	const GstClockTime now = g_get_monotonic_time() * GST_USECOND;
+	const auto sensorTimestamp = request.metadata().get(controls::SensorTimestamp);
+
+	/*
+	 * Existing pipeline handlers often copy a V4L2 monotonic timestamp
+	 * into SensorTimestamp. Keep its current interpretation until the
+	 * producers are consistent about the clock domain.
+	 */
+	if (sensorTimestamp && *sensorTimestamp > 0 &&
+	    static_cast<GstClockTime>(*sensorTimestamp) <= now)
+		return now - *sensorTimestamp;
+
+	/* V4L2 buffer timestamps are monotonic; keep one time for this request. */
+	GstClockTime timestamp = GST_CLOCK_TIME_NONE;
+	for (const auto &[stream, buffer] : request.buffers()) {
+		const FrameMetadata &metadata = buffer->metadata();
+		if (metadata.status == FrameMetadata::FrameCancelled ||
+		    metadata.timestamp == 0 || metadata.timestamp > now)
+			continue;
+
+		timestamp = std::min<GstClockTime>(timestamp, metadata.timestamp);
+	}
+
+	return GST_CLOCK_TIME_IS_VALID(timestamp) ? now - timestamp
+						  : GST_CLOCK_TIME_NONE;
+}
+
