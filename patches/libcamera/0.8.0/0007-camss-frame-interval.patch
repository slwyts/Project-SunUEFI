+int64_t CamssCsiCamera::PixFrameTiming::duration(int32_t blanking) const
+{
+	return std::llround((static_cast<double>(height) + blanking) *
+			    lineMicroseconds);
+}
+
+std::optional<int32_t> CamssCsiCamera::PixFrameTiming::blanking(int64_t minimum,
+							     int64_t maximum) const
+{
+	const int64_t maxSteps = (maxBlanking - minBlanking) / step;
+	const double steps = std::clamp((minimum / lineMicroseconds - height -
+					 minBlanking) / step, 0.0,
+					static_cast<double>(maxSteps));
+	const auto fromSteps = [this](int64_t count) {
+		return static_cast<int32_t>(minBlanking + count * step);
+	};
+
+	if (minimum == maximum)
+		return fromSteps(std::llround(steps));
+
+	/* With no AE controlling the period, use the shortest legal duration. */
+	int64_t count = std::ceil(steps);
+	if (count > 0 && duration(fromSteps(count - 1)) >= minimum)
+		count--;
+	int32_t value = fromSteps(count);
+	if (duration(value) < minimum || duration(value) > maximum)
+		return std::nullopt;
+
+	return value;
+}
+
+void CamssCsiCamera::readPixFrameTiming(unsigned int pad, const Size &sensorSize)
+{
+	pixFrameTiming_.reset();
+	pixDefaultFrameDuration_ = 0;
+	pixFrameDuration_ = 0;
+	pixFrameTimingChanged_ = false;
+
+	/*
+	 * A sensor without programmable blanking may report a fixed interval.
+	 * Its link pixel rate does not describe the pixel array's timing.
+	 */
+	const auto *hblank = pixSensor_->controlInfo(V4L2_CID_HBLANK);
+	const auto *vblank = pixSensor_->controlInfo(V4L2_CID_VBLANK);
+	if (!hblank || !vblank || !pixSensor_->controlInfo(V4L2_CID_PIXEL_RATE)) {
+		struct v4l2_fract interval;
+		if (!pixSensor_->getFrameInterval({ pad, 0 }, &interval))
+			pixDefaultFrameDuration_ =
+				(1'000'000LL * interval.numerator + interval.denominator / 2) /
+				interval.denominator;
+		return;
+	}
+
+	pixSensor_->updateControlInfo();
+	if (hblank->minimum != hblank->maximum || hblank->minimum < 0 ||
+	    (vblank->flags & (V4L2_CTRL_FLAG_DISABLED | V4L2_CTRL_FLAG_READ_ONLY |
+			      V4L2_CTRL_FLAG_INACTIVE)) ||
+	    vblank->minimum < 0 || vblank->minimum > vblank->default_value ||
+	    vblank->default_value > vblank->maximum ||
+	    vblank->maximum > std::numeric_limits<int32_t>::max() ||
+	    !vblank->step || vblank->step > std::numeric_limits<int32_t>::max() ||
+	    (vblank->default_value - vblank->minimum) % vblank->step)
+		return;
+
+	constexpr std::array<uint32_t, 2> ids{ V4L2_CID_PIXEL_RATE, V4L2_CID_HBLANK };
+	const ControlList timing = pixSensor_->getControls(ids);
+	const ControlValue &rate = timing.get(V4L2_CID_PIXEL_RATE);
+	const ControlValue &horizontalBlanking = timing.get(V4L2_CID_HBLANK);
+	if (rate.type() != ControlTypeInteger64 ||
+	    horizontalBlanking.type() != ControlTypeInteger32 ||
+	    rate.get<int64_t>() <= 0 || horizontalBlanking.get<int32_t>() != hblank->minimum)
+		return;
+
+	const double lineMicroseconds = 1'000'000.0 *
+		(static_cast<double>(sensorSize.width) + horizontalBlanking.get<int32_t>()) /
+		rate.get<int64_t>();
+	const int64_t maxBlanking = vblank->minimum +
+		(vblank->maximum - vblank->minimum) / vblank->step * vblank->step;
+	if ((sensorSize.height + static_cast<double>(vblank->minimum)) *
+		    lineMicroseconds < 0.5 ||
+	    (sensorSize.height + static_cast<double>(maxBlanking)) *
+		    lineMicroseconds >= std::numeric_limits<int64_t>::max())
+		return;
+
+	pixFrameTiming_ = PixFrameTiming{
+		lineMicroseconds, sensorSize.height,
+		static_cast<int32_t>(vblank->minimum), static_cast<int32_t>(maxBlanking),
+		static_cast<int32_t>(vblank->default_value), static_cast<int32_t>(vblank->step),
+	};
+	pixDefaultFrameDuration_ = pixFrameTiming_->duration(pixFrameTiming_->defaultBlanking);
+}
+
+ControlInfoMap CamssCsiCamera::pixControls() const
+{
+	ControlInfoMap::Map info;
+	if (pixDefaultFrameDuration_) {
+		int64_t minimum = pixDefaultFrameDuration_;
+		int64_t maximum = pixDefaultFrameDuration_;
+		if (const auto &timing = pixFrameTiming_) {
+			minimum = timing->duration(timing->minBlanking);
+			maximum = timing->duration(timing->maxBlanking);
+		}
+		std::array<int64_t, 2> defaults{ pixDefaultFrameDuration_, pixDefaultFrameDuration_ };
+		info.emplace(&controls::FrameDurationLimits,
+			     ControlInfo(minimum, maximum, std::span<const int64_t, 2>(defaults)));
+	}
+
+	return ControlInfoMap(std::move(info), controls::controls);
+}
+
+int CamssCsiCamera::selectPixFrameTiming(const ControlList *controls, int64_t *duration,
+					int32_t *blanking) const
+{
+	const auto limits = controls ? controls->get(controls::FrameDurationLimits)
+				     : std::nullopt;
+	*duration = pixDefaultFrameDuration_;
+	if (pixFrameTiming_)
+		*blanking = pixFrameTiming_->defaultBlanking;
+	if (!limits || (!(*limits)[0] && !(*limits)[1]))
+		return 0;
+	if (!pixDefaultFrameDuration_)
+		return -EOPNOTSUPP;
+
+	int64_t minimum = (*limits)[0];
+	int64_t maximum = (*limits)[1];
+	if (minimum <= 0 || maximum < minimum)
+		return -EINVAL;
+	if (!pixFrameTiming_)
+		return minimum <= *duration && *duration <= maximum ? 0 : -ERANGE;
+
+	const PixFrameTiming &timing = *pixFrameTiming_;
+	int64_t fastest = timing.duration(timing.minBlanking);
+	int64_t slowest = timing.duration(timing.maxBlanking);
+	auto value = timing.blanking(std::clamp(minimum, fastest, slowest),
+				     std::clamp(maximum, fastest, slowest));
+	if (!value)
+		return -ERANGE;
+
+	*blanking = *value;
+	*duration = timing.duration(*blanking);
+	return 0;
+}
+
+int CamssCsiCamera::validatePixFrameDuration(const ControlList &controls) const
+{
+	const auto limits = controls.get(controls::FrameDurationLimits);
+	if (!limits)
+		return 0;
+
+	const int64_t minimum = (*limits)[0], maximum = (*limits)[1];
+	if (minimum > 0 && minimum < maximum &&
+	    minimum <= pixFrameDuration_ && pixFrameDuration_ <= maximum)
+		return 0;
+
+	int64_t duration;
+	int32_t blanking;
+	int ret = selectPixFrameTiming(&controls, &duration, &blanking);
+	if (ret)
+		return ret;
+
+	/* Programming a different duration needs per-frame sensor scheduling. */
+	return duration == pixFrameDuration_ ? 0 : -EOPNOTSUPP;
+}
+
+int CamssCsiCamera::setPixFrameBlanking(int32_t blanking)
+{
+	ControlList values(pixSensor_->controls());
+	values.set(V4L2_CID_VBLANK, blanking);
+	int ret = pixSensor_->setControls(&values);
+	if (ret)
+		return ret;
+
+	constexpr std::array<uint32_t, 1> ids{ V4L2_CID_VBLANK };
+	const ControlList applied = pixSensor_->getControls(ids);
+	const ControlValue &value = applied.get(V4L2_CID_VBLANK);
+	return value.type() == ControlTypeInteger32 && value.get<int32_t>() == blanking ? 0 : -EIO;
+}
+
+int CamssCsiCamera::applyPixFrameTiming(const ControlList *controls)
+{
+	int64_t duration;
+	int32_t blanking;
+	int ret = selectPixFrameTiming(controls, &duration, &blanking);
+	if (ret)
+		return ret;
+
+	if (pixFrameTiming_) {
+		pixFrameTimingChanged_ = blanking != pixFrameTiming_->defaultBlanking;
+		ret = setPixFrameBlanking(blanking);
+		if (ret)
+			return ret;
+	}
+
+	pixFrameDuration_ = duration;
+	if (duration)
+		LOG(Camss, Debug) << "PIX configured frame duration " << duration << " us";
+	return 0;
+}
+
+void CamssCsiCamera::restorePixFrameTiming()
+{
+	if (pixFrameTimingChanged_) {
+		if (setPixFrameBlanking(pixFrameTiming_->defaultBlanking))
+			LOG(Camss, Warning) << "Failed to restore default PIX frame duration";
+		pixFrameTimingChanged_ = false;
+	}
+	pixFrameDuration_ = 0;
+}
