+/**
+ * \brief Get the active frame interval of a subdevice stream
+ * \param[in] stream The pad and stream
+ * \param[out] interval The frame interval in seconds
+ *
+ * \return 0 on success or a negative error code otherwise
+ */
+int V4L2Subdevice::getFrameInterval(const Stream &stream, v4l2_fract *interval)
+{
+	struct v4l2_subdev_frame_interval fi = {};
+	fi.pad = stream.pad;
+	fi.stream = stream.stream;
+	fi.which = ActiveFormat;
+
+	int ret = ioctl(VIDIOC_SUBDEV_G_FRAME_INTERVAL, &fi);
+	if (ret)
+		return ret;
+	if (!fi.interval.numerator || !fi.interval.denominator)
+		return -EINVAL;
+
+	*interval = fi.interval;
+	return 0;
+}
