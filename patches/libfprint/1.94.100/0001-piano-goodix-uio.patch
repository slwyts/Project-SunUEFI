diff --git a/libfprint/drivers/piano-goodix.c b/libfprint/drivers/piano-goodix.c
new file mode 100644
--- /dev/null
+++ b/libfprint/drivers/piano-goodix.c
@@ -0,0 +1,627 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Piano's Goodix reader is controlled by a named UIO device and the signed
+ * QTEE application. The native library owns its real hardware transactions;
+ * this driver adapts those operations to libfprint without an Android HAL.
+ */
+#define FP_COMPONENT "piano_goodix"
+
+#include "drivers_api.h"
+#include <errno.h>
+#include <pwd.h>
+#include <sys/stat.h>
+#include <piano-goodix.h>
+
+typedef struct
+{
+  FpDevice parent;
+  GTask *task;
+} FpDevicePianoGoodix;
+
+typedef FpDeviceClass FpDevicePianoGoodixClass;
+
+GType fpi_device_piano_goodix_get_type (void);
+G_DEFINE_TYPE (FpDevicePianoGoodix, fpi_device_piano_goodix, FP_TYPE_DEVICE)
+
+typedef struct
+{
+  guint32 uid;
+  guint finger;
+  gchar *username;
+} StoredFinger;
+
+typedef struct
+{
+  FpiDeviceAction action;
+  GMainContext *context;
+  GCancellable *parent_cancel;
+  GCancellable *stop;
+  FpPrint *print;
+  GPtrArray *gallery;
+  GArray *identify_uids;
+  GPtrArray *stored;
+  guint32 uid;
+  guint finger;
+  guint matched_finger;
+  guint total_stages;
+  guint completed_stages;
+  gint result;
+  gint user_cancel;
+  gboolean not_matched;
+  gboolean finished;
+} Work;
+
+typedef struct
+{
+  GTask *task;
+  enum piano_goodix_progress event;
+  guint remaining;
+} Progress;
+
+static void
+stored_finger_free (gpointer pointer)
+{
+  StoredFinger *finger = pointer;
+
+  g_free (finger->username);
+  g_free (finger);
+}
+
+static void
+work_free (gpointer pointer)
+{
+  Work *work = pointer;
+
+  g_main_context_unref (work->context);
+  g_clear_object (&work->parent_cancel);
+  g_clear_object (&work->stop);
+  g_clear_object (&work->print);
+  g_clear_pointer (&work->gallery, g_ptr_array_unref);
+  g_clear_pointer (&work->identify_uids, g_array_unref);
+  g_clear_pointer (&work->stored, g_ptr_array_unref);
+  g_free (work);
+}
+
+static gboolean
+user_uid (const gchar *username, guint32 *uid)
+{
+  struct passwd entry, *found = NULL;
+  gchar buffer[16384];
+
+  if (!username || !*username ||
+      getpwnam_r (username, &entry, buffer, sizeof buffer, &found) || !found ||
+      entry.pw_uid > 0x0fffffffU)
+    return FALSE;
+
+  *uid = entry.pw_uid;
+  return TRUE;
+}
+
+static gboolean
+print_coordinates (FpPrint *print, guint32 *uid, guint *finger)
+{
+  g_autoptr(GVariant) data = NULL;
+  guint32 named_uid, saved_finger;
+
+  g_object_get (print, "fpi-data", &data, NULL);
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uu)")) ||
+      !user_uid (fp_print_get_username (print), &named_uid))
+    return FALSE;
+
+  g_variant_get (data, "(uu)", uid, &saved_finger);
+  *finger = saved_finger;
+  return *uid == named_uid && *finger >= 1 && *finger <= 10 &&
+         *finger == fp_print_get_finger (print);
+}
+
+static FpPrint *
+stored_print (FpDevice *device, guint32 uid, guint finger, const gchar *username)
+{
+  FpPrint *print = fp_print_new (device);
+
+  fpi_print_set_type (print, FPI_PRINT_RAW);
+  fpi_print_set_device_stored (print, TRUE);
+  fp_print_set_username (print, username);
+  fp_print_set_finger (print, finger);
+  g_object_set (print, "fpi-data", g_variant_new ("(uu)", uid, finger), NULL);
+  return print;
+}
+
+static gboolean
+parent_cancelled (Work *work)
+{
+  return g_atomic_int_get (&work->user_cancel) ||
+         (work->parent_cancel && g_cancellable_is_cancelled (work->parent_cancel));
+}
+
+static int
+should_cancel (void *context)
+{
+  GTask *task = context;
+  Work *work = g_task_get_task_data (task);
+
+  return parent_cancelled (work) || g_cancellable_is_cancelled (work->stop);
+}
+
+static gboolean
+progress_on_context (gpointer pointer)
+{
+  Progress *progress = pointer;
+  Work *work = g_task_get_task_data (progress->task);
+  FpDevice *device = g_task_get_source_object (progress->task);
+
+  /* Queued progress may follow completion. Its task reference keeps the data
+   * alive, but it must never address a subsequent libfprint operation.
+   */
+  if (work->finished || parent_cancelled (work))
+    return G_SOURCE_REMOVE;
+
+  switch (progress->event)
+    {
+    case PIANO_GOODIX_FINGER_DOWN:
+      fpi_device_report_finger_status (device, FP_FINGER_STATUS_NEEDED | FP_FINGER_STATUS_PRESENT);
+      break;
+    case PIANO_GOODIX_FINGER_UP:
+      fpi_device_report_finger_status (device, FP_FINGER_STATUS_NEEDED);
+      break;
+    case PIANO_GOODIX_ENROLL_PROGRESS:
+      if (work->action != FPI_DEVICE_ACTION_ENROLL)
+        break;
+      if (!work->total_stages || progress->remaining > work->total_stages)
+        {
+          work->total_stages = progress->remaining + 1;
+          fpi_device_set_nr_enroll_stages (device, work->total_stages);
+        }
+      /* Zero remaining is not durable enrollment: native code still has to
+       * save the template, post-enroll, and commit its Linux metadata.
+       */
+      if (progress->remaining)
+        {
+          work->completed_stages = work->total_stages - progress->remaining;
+          fpi_device_enroll_progress (device, work->completed_stages, NULL, NULL);
+        }
+      break;
+    case PIANO_GOODIX_NOT_MATCH:
+      /* Native code finishes the negative attempt and cancels safely. */
+      break;
+    case PIANO_GOODIX_RETRY:
+      if (work->action == FPI_DEVICE_ACTION_ENROLL)
+        fpi_device_enroll_progress (device, work->completed_stages, NULL,
+                                   fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      /* Verification quality notifications are not completed attempts. Keep
+       * the native operation running, as its CLI does. libfprint permits one
+       * verify report per operation, including a retry report, so reporting
+       * here would prevent the eventual match from being delivered.
+       */
+      break;
+    }
+  return G_SOURCE_REMOVE;
+}
+
+static void
+progress_free (gpointer pointer)
+{
+  Progress *progress = pointer;
+
+  g_object_unref (progress->task);
+  g_free (progress);
+}
+
+static void
+native_progress (enum piano_goodix_progress event, unsigned int remaining, void *context)
+{
+  GTask *task = context;
+  Work *work = g_task_get_task_data (task);
+  Progress *progress = g_new0 (Progress, 1);
+
+  if (event == PIANO_GOODIX_NOT_MATCH)
+    work->not_matched = TRUE;
+  progress->task = g_object_ref (task);
+  progress->event = event;
+  progress->remaining = remaining;
+  GSource *source = g_idle_source_new ();
+
+  g_source_set_priority (source, G_PRIORITY_DEFAULT);
+  g_source_set_callback (source, progress_on_context, progress, progress_free);
+  g_source_attach (source, work->context);
+  g_source_unref (source);
+}
+
+static gint
+list_linux_fingers (Work *work)
+{
+  const gchar *root = "/var/lib/piano-goodix";
+  struct stat info;
+  g_autoptr(GDir) directory = NULL;
+  const gchar *name;
+
+  work->stored = g_ptr_array_new_with_free_func (stored_finger_free);
+  if (lstat (root, &info))
+    return errno == ENOENT ? 0 : -errno;
+  if (!S_ISDIR (info.st_mode) || info.st_uid != 0 || (info.st_mode & 0777) != 0700)
+    return -EACCES;
+  directory = g_dir_open (root, 0, NULL);
+  if (!directory)
+    return -EIO;
+
+  while ((name = g_dir_read_name (directory)))
+    {
+      gchar *end;
+      gchar canonical[16], lookup[16384];
+      struct passwd entry, *found = NULL;
+      guint64 uid;
+      unsigned int fingers[10];
+      size_t count = 0;
+      gint result;
+
+      if (parent_cancelled (work))
+        return -ECANCELED;
+      errno = 0;
+      uid = g_ascii_strtoull (name, &end, 10);
+      if (errno || !*name || *end || uid > 0x0fffffffU)
+        continue;
+      g_snprintf (canonical, sizeof canonical, "%u", (guint32) uid);
+      if (!g_str_equal (canonical, name))
+        continue;
+      if (getpwuid_r (uid, &entry, lookup, sizeof lookup, &found) || !found)
+        continue;
+
+      result = piano_goodix_list (uid, fingers, &count);
+      if (result == -ENOENT || result == -ENODATA)
+        continue;
+      if (result)
+        return result;
+      for (size_t i = 0; i < count; i++)
+        {
+          StoredFinger *finger = g_new0 (StoredFinger, 1);
+
+          finger->uid = uid;
+          finger->finger = fingers[i];
+          finger->username = g_strdup (entry.pw_name);
+          g_ptr_array_add (work->stored, finger);
+        }
+    }
+  return 0;
+}
+
+static void
+add_identify_uid (Work *work, guint32 uid)
+{
+  for (guint i = 0; i < work->identify_uids->len; i++)
+    if (g_array_index (work->identify_uids, guint32, i) == uid)
+      return;
+  g_array_append_val (work->identify_uids, uid);
+}
+
+static gint
+identify_linux_fingers (Work *work, const struct piano_goodix_options *options)
+{
+  if (!work->gallery->len)
+    {
+      /* An empty gallery still needs to recognize Linux-owned prints that
+       * fprintd has lost, for its normal duplicate-enrollment cleanup.
+       */
+      gint result = list_linux_fingers (work);
+
+      if (result)
+        return result;
+      for (guint i = 0; i < work->stored->len; i++)
+        add_identify_uid (work, ((StoredFinger *) g_ptr_array_index (work->stored, i))->uid);
+    }
+
+  /* The TA selects one user's group per transaction. Only a completed
+   * negative attempt permits trying another group; authentication, storage
+   * and cancellation errors must retain their original meaning.
+   */
+  for (guint i = 0; i < work->identify_uids->len; i++)
+    {
+      gint result;
+
+      if (options->should_cancel (options->context))
+        return -ECANCELED;
+      work->uid = g_array_index (work->identify_uids, guint32, i);
+      work->not_matched = FALSE;
+      work->matched_finger = 0;
+      result = piano_goodix_verify (work->uid, 0, &work->matched_finger, options);
+      if (result == -EACCES && work->not_matched)
+        continue;
+      return result;
+    }
+
+  work->matched_finger = 0;
+  return 0;
+}
+
+static void
+worker (GTask *task, gpointer source, gpointer pointer, GCancellable *cancellable)
+{
+  Work *work = pointer;
+  struct piano_goodix_options options = {
+    .should_cancel = should_cancel,
+    .progress = native_progress,
+    .context = task,
+  };
+
+  (void) source;
+  (void) cancellable;
+
+  if (should_cancel (task))
+    work->result = -ECANCELED;
+  else if (work->action == FPI_DEVICE_ACTION_ENROLL)
+    work->result = piano_goodix_enroll (work->uid, work->finger, &options);
+  else if (work->action == FPI_DEVICE_ACTION_VERIFY)
+    work->result = piano_goodix_verify (work->uid, work->finger, &work->matched_finger, &options);
+  else if (work->action == FPI_DEVICE_ACTION_IDENTIFY)
+    work->result = identify_linux_fingers (work, &options);
+  else if (work->action == FPI_DEVICE_ACTION_DELETE)
+    work->result = piano_goodix_delete (work->uid, work->finger);
+  else
+    work->result = list_linux_fingers (work);
+
+  g_task_return_boolean (task, TRUE);
+}
+
+static GError *
+operation_error (gint result)
+{
+  if (result == -ECANCELED)
+    return g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED, "Fingerprint operation cancelled");
+  if (result == -ETIMEDOUT)
+    return fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL);
+  if (result == -ENOENT || result == -ENODATA)
+    return fpi_device_error_new (FP_DEVICE_ERROR_DATA_NOT_FOUND);
+  if (result == -EEXIST)
+    return fpi_device_error_new (FP_DEVICE_ERROR_DATA_DUPLICATE);
+  if (result == -ENOSPC)
+    return fpi_device_error_new (FP_DEVICE_ERROR_DATA_FULL);
+  /* EAGAIN is temporary storage or Gatekeeper unavailability, not a bad
+   * acquisition. Reporting a scan retry would make fprintd loop immediately.
+   */
+  if (result == -EBUSY || result == -EAGAIN)
+    return fpi_device_error_new (FP_DEVICE_ERROR_BUSY);
+  if (result == -ENODEV)
+    return fpi_device_error_new (FP_DEVICE_ERROR_REMOVED);
+  return fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                   "Fingerprint operation failed: %s", g_strerror (-result));
+}
+
+static void
+worker_done (GObject *source, GAsyncResult *result, gpointer unused)
+{
+  FpDevice *device = FP_DEVICE (source);
+  FpDevicePianoGoodix *self = (FpDevicePianoGoodix *) device;
+  GTask *task = G_TASK (result);
+  Work *work = g_task_get_task_data (task);
+  GError *error = NULL;
+
+  (void) unused;
+  g_task_propagate_boolean (task, NULL);
+  work->finished = TRUE;
+  self->task = NULL;
+  if (parent_cancelled (work) && (work->result == -ECANCELED || work->result == 0))
+    error = operation_error (-ECANCELED);
+  else if (work->not_matched && work->result == -EACCES)
+    work->matched_finger = 0;
+  else if (work->result)
+    error = operation_error (work->result);
+
+  fpi_device_report_finger_status (device, FP_FINGER_STATUS_NONE);
+  if (work->action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      if (error)
+        fpi_device_enroll_complete (device, NULL, error);
+      else
+        {
+          fpi_print_set_type (work->print, FPI_PRINT_RAW);
+          fpi_print_set_device_stored (work->print, TRUE);
+          g_object_set (work->print, "fpi-data",
+                         g_variant_new ("(uu)", work->uid, work->finger), NULL);
+          fpi_device_enroll_progress (device, MAX (work->total_stages, 1), NULL, NULL);
+          fpi_device_enroll_complete (device, g_object_ref (work->print), NULL);
+        }
+    }
+  else if (work->action == FPI_DEVICE_ACTION_VERIFY)
+    {
+      if (error && error->domain == FP_DEVICE_RETRY)
+        {
+          fpi_device_verify_report (device, FPI_MATCH_ERROR, NULL, error);
+          error = NULL;
+        }
+      else if (!error)
+        {
+          fpi_device_verify_report (device, work->matched_finger == work->finger ?
+                                     FPI_MATCH_SUCCESS : FPI_MATCH_FAIL, NULL, NULL);
+        }
+      fpi_device_verify_complete (device, error);
+    }
+  else if (work->action == FPI_DEVICE_ACTION_IDENTIFY)
+    {
+      FpPrint *match = NULL;
+      g_autoptr(FpPrint) found = NULL;
+
+      if (!error && work->matched_finger)
+        {
+          struct passwd entry, *user = NULL;
+          gchar buffer[16384];
+
+          if (getpwuid_r (work->uid, &entry, buffer, sizeof buffer, &user) || !user)
+            error = fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID);
+          else
+            {
+              found = g_object_ref_sink (stored_print (device, work->uid,
+                                                       work->matched_finger, user->pw_name));
+              for (guint i = 0; i < work->gallery->len; i++)
+                {
+                  FpPrint *print = g_ptr_array_index (work->gallery, i);
+                  guint32 uid;
+                  guint finger;
+
+                  if (print_coordinates (print, &uid, &finger) &&
+                      uid == work->uid && finger == work->matched_finger)
+                    {
+                      match = print;
+                      break;
+                    }
+                }
+            }
+        }
+      if (error && error->domain == FP_DEVICE_RETRY)
+        {
+          fpi_device_identify_report (device, NULL, NULL, error);
+          error = NULL;
+        }
+      else if (!error)
+        fpi_device_identify_report (device, match, found, NULL);
+      fpi_device_identify_complete (device, error);
+    }
+  else if (work->action == FPI_DEVICE_ACTION_DELETE)
+    fpi_device_delete_complete (device, error);
+  else
+    {
+      GPtrArray *prints = NULL;
+
+      if (!error)
+        {
+          prints = g_ptr_array_new_with_free_func (g_object_unref);
+          for (guint i = 0; i < work->stored->len; i++)
+            {
+              StoredFinger *finger = g_ptr_array_index (work->stored, i);
+              FpPrint *print = stored_print (device, finger->uid, finger->finger, finger->username);
+
+              g_ptr_array_add (prints, g_object_ref_sink (print));
+            }
+        }
+      fpi_device_list_complete (device, prints, error);
+    }
+
+  g_object_unref (task);
+}
+
+static void
+start (FpDevice *device)
+{
+  FpDevicePianoGoodix *self = (FpDevicePianoGoodix *) device;
+  Work *work = g_new0 (Work, 1);
+  FpiDeviceAction action = fpi_device_get_current_action (device);
+  gboolean valid = TRUE;
+
+  work->action = action;
+  work->context = g_main_context_ref_thread_default ();
+  work->parent_cancel = fpi_device_get_cancellable (device);
+  if (work->parent_cancel)
+    g_object_ref (work->parent_cancel);
+  work->stop = g_cancellable_new ();
+
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      fpi_device_get_enroll_data (device, &work->print);
+      g_object_ref (work->print);
+      work->finger = fp_print_get_finger (work->print);
+      valid = user_uid (fp_print_get_username (work->print), &work->uid) &&
+              work->finger >= 1 && work->finger <= 10;
+    }
+  else if (action == FPI_DEVICE_ACTION_VERIFY || action == FPI_DEVICE_ACTION_DELETE)
+    {
+      if (action == FPI_DEVICE_ACTION_VERIFY)
+        fpi_device_get_verify_data (device, &work->print);
+      else
+        fpi_device_get_delete_data (device, &work->print);
+      g_object_ref (work->print);
+      valid = print_coordinates (work->print, &work->uid, &work->finger);
+    }
+  else if (action == FPI_DEVICE_ACTION_IDENTIFY)
+    {
+      GPtrArray *gallery;
+
+      fpi_device_get_identify_data (device, &gallery);
+      work->gallery = g_ptr_array_ref (gallery);
+      work->identify_uids = g_array_new (FALSE, FALSE, sizeof (guint32));
+      for (guint i = 0; valid && i < gallery->len; i++)
+        {
+          guint32 uid;
+          guint finger;
+
+          valid = print_coordinates (g_ptr_array_index (gallery, i), &uid, &finger);
+          if (valid)
+            add_identify_uid (work, uid);
+        }
+    }
+
+  if (!valid)
+    {
+      work_free (work);
+      fpi_device_action_error (device, fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+      return;
+    }
+
+  self->task = g_task_new (device, work->parent_cancel, worker_done, NULL);
+  g_task_set_check_cancellable (self->task, FALSE);
+  g_task_set_return_on_cancel (self->task, FALSE);
+  g_task_set_task_data (self->task, work, work_free);
+  g_task_run_in_thread (self->task, worker);
+}
+
+static void
+cancel (FpDevice *device)
+{
+  FpDevicePianoGoodix *self = (FpDevicePianoGoodix *) device;
+
+  if (self->task)
+    {
+      Work *work = g_task_get_task_data (self->task);
+
+      g_atomic_int_set (&work->user_cancel, TRUE);
+      g_cancellable_cancel (work->stop);
+    }
+}
+
+static void
+probe (FpDevice *device)
+{
+  fpi_device_probe_complete (device, "piano-goodix", NULL, NULL);
+}
+
+static void
+open_device (FpDevice *device)
+{
+  /* Native operations open and close UIO/QTEE as a single transaction. */
+  fpi_device_open_complete (device, NULL);
+}
+
+static void
+close_device (FpDevice *device)
+{
+  fpi_device_close_complete (device, NULL);
+}
+
+static const FpIdEntry driver_ids[] = {
+  { .udev_types = FPI_DEVICE_UDEV_SUBTYPE_UIO, .uio_name = "piano-goodix" },
+  { .udev_types = 0 },
+};
+
+static void
+fpi_device_piano_goodix_init (FpDevicePianoGoodix *self)
+{
+  (void) self;
+}
+
+static void
+fpi_device_piano_goodix_class_init (FpDevicePianoGoodixClass *klass)
+{
+  klass->id = FP_COMPONENT;
+  klass->full_name = "Goodix fingerprint sensor";
+  klass->type = FP_DEVICE_TYPE_UDEV;
+  klass->id_table = driver_ids;
+  klass->nr_enroll_stages = 1; /* Replaced by actual TA remaining counts. */
+  klass->scan_type = FP_SCAN_TYPE_PRESS;
+  klass->temp_hot_seconds = -1;
+  klass->probe = probe;
+  klass->open = open_device;
+  klass->close = close_device;
+  klass->enroll = start;
+  klass->verify = start;
+  klass->identify = start;
+  klass->list = start;
+  klass->delete = start;
+  klass->cancel = cancel;
+  fpi_device_class_auto_initialize_features (klass);
+}
