diff --git a/tests/test-piano-goodix.c b/tests/test-piano-goodix.c
new file mode 100644
--- /dev/null
+++ b/tests/test-piano-goodix.c
@@ -0,0 +1,585 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Exercise the actual FpDevice bridge and GLib dispatch. Native transaction
+ * boundaries are replaced here; no test opens a UIO device or QTEE session.
+ */
+#include "drivers_api.h"
+#include <piano-goodix.h>
+#include <errno.h>
+#include <pwd.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+GType fpi_device_piano_goodix_get_type (void);
+
+typedef enum {
+  MATCH, NO_MATCH, RETRY_MATCH, RETRY_NO_MATCH, RETRY_FAILURE, RETRY_CANCEL,
+  TIMEOUT, BUSY, CANCEL_SCAN, ENROLL, ENROLL_FAILURE, ENROLL_BUSY,
+  IDENTIFY_SECOND, IDENTIFY_NO_MATCH, IDENTIFY_MIXED, IDENTIFY_MIXED_ERROR,
+  IDENTIFY_OUTSIDE, IDENTIFY_EMPTY, IDENTIFY_EMPTY_STORED
+} Scenario;
+static Scenario scenario;
+static GThread *main_thread;
+static gboolean cleaned;
+static guint calls, retries, last_stage, progress_count, verify_reports;
+static guint identify_calls, directory_index;
+static guint32 other_uid;
+static char directory_marker;
+static GCancellable *cancel_scan;
+
+int __wrap_lstat (const char *path, struct stat *info);
+int __wrap_lstat64 (const char *path, struct stat *info);
+GDir *__wrap_g_dir_open (const gchar *path, guint flags, GError **error);
+const gchar *__wrap_g_dir_read_name (GDir *directory);
+void __wrap_g_dir_close (GDir *directory);
+
+int __real_lstat (const char *path, struct stat *info);
+int __real_lstat64 (const char *path, struct stat *info);
+GDir *__real_g_dir_open (const gchar *path, guint flags, GError **error);
+const gchar *__real_g_dir_read_name (GDir *directory);
+void __real_g_dir_close (GDir *directory);
+
+/* Exercise the real metadata enumeration without using the host's profiles. */
+int
+__wrap_lstat (const char *path, struct stat *info)
+{
+  if (!g_str_equal (path, "/var/lib/piano-goodix"))
+    return __real_lstat (path, info);
+  if (scenario != IDENTIFY_EMPTY_STORED)
+    {
+      errno = ENOENT;
+      return -1;
+    }
+  memset (info, 0, sizeof *info);
+  info->st_mode = S_IFDIR | 0700;
+  return 0;
+}
+
+int
+__wrap_lstat64 (const char *path, struct stat *info)
+{
+  /* _FILE_OFFSET_BITS=64 may redirect the driver's lstat to this symbol. */
+  if (g_str_equal (path, "/var/lib/piano-goodix"))
+    return __wrap_lstat (path, info);
+  return __real_lstat64 (path, info);
+}
+
+GDir *
+__wrap_g_dir_open (const gchar *path, guint flags, GError **error)
+{
+  if (g_str_equal (path, "/var/lib/piano-goodix"))
+    return (GDir *) &directory_marker;
+  return __real_g_dir_open (path, flags, error);
+}
+
+const gchar *
+__wrap_g_dir_read_name (GDir *directory)
+{
+  static gchar uid[16];
+
+  if (directory != (GDir *) &directory_marker)
+    return __real_g_dir_read_name (directory);
+  if (directory_index++)
+    return NULL;
+  g_snprintf (uid, sizeof uid, "%u", (guint32) getuid ());
+  return uid;
+}
+
+void
+__wrap_g_dir_close (GDir *directory)
+{
+  if (directory != (GDir *) &directory_marker)
+    __real_g_dir_close (directory);
+}
+
+static void
+assert_worker (void)
+{
+  g_assert_true (g_thread_self () != main_thread);
+  calls++;
+}
+
+int
+piano_goodix_enroll (uint32_t uid, unsigned int finger, const struct piano_goodix_options *options)
+{
+  assert_worker ();
+  g_assert_cmpuint (uid, ==, getuid ());
+  g_assert_cmpuint (finger, ==, FP_FINGER_LEFT_THUMB);
+  if (scenario == ENROLL_BUSY)
+    {
+      cleaned = TRUE;
+      return -EAGAIN;
+    }
+  options->progress (PIANO_GOODIX_ENROLL_PROGRESS, 3, options->context);
+  options->progress (PIANO_GOODIX_RETRY, 0, options->context);
+  g_assert_false (options->should_cancel (options->context));
+  options->progress (PIANO_GOODIX_ENROLL_PROGRESS, 2, options->context);
+  options->progress (PIANO_GOODIX_ENROLL_PROGRESS, 1, options->context);
+  options->progress (PIANO_GOODIX_ENROLL_PROGRESS, 0, options->context);
+  cleaned = TRUE;
+  return scenario == ENROLL_FAILURE ? -EIO : 0;
+}
+
+static gboolean
+cancel_on_main (gpointer unused)
+{
+  (void) unused;
+  g_cancellable_cancel (cancel_scan);
+  return G_SOURCE_REMOVE;
+}
+
+int
+piano_goodix_verify (uint32_t uid, unsigned int finger, unsigned int *matched,
+                     const struct piano_goodix_options *options)
+{
+  assert_worker ();
+  if (!finger)
+    {
+      identify_calls++;
+      g_assert_cmpuint (uid, ==, identify_calls == 2 ? other_uid : getuid ());
+      if (scenario == IDENTIFY_NO_MATCH ||
+          ((scenario == IDENTIFY_MIXED || scenario == IDENTIFY_MIXED_ERROR) && identify_calls == 1))
+        {
+          options->progress (PIANO_GOODIX_NOT_MATCH, 0, options->context);
+          cleaned = TRUE;
+          return -EACCES;
+        }
+      if (scenario == IDENTIFY_MIXED_ERROR)
+        {
+          cleaned = TRUE;
+          return -EACCES; /* An invalid HAT is not a negative match. */
+        }
+      if (scenario != CANCEL_SCAN && scenario != TIMEOUT)
+        {
+          *matched = scenario == IDENTIFY_SECOND || scenario == IDENTIFY_OUTSIDE ?
+                     FP_FINGER_RIGHT_THUMB : FP_FINGER_LEFT_THUMB;
+          cleaned = TRUE;
+          return 0;
+        }
+    }
+  g_assert_cmpuint (uid, ==, getuid ());
+  g_assert_true (!finger || finger == FP_FINGER_LEFT_THUMB);
+  if (scenario == BUSY)
+    {
+      cleaned = TRUE;
+      return -EAGAIN;
+    }
+  options->progress (PIANO_GOODIX_FINGER_DOWN, 0, options->context);
+  if (scenario == RETRY_MATCH || scenario == RETRY_NO_MATCH ||
+      scenario == RETRY_FAILURE || scenario == RETRY_CANCEL)
+    {
+      for (guint i = 0; i < 3; i++)
+        {
+          options->progress (PIANO_GOODIX_RETRY, 0, options->context);
+          g_assert_false (options->should_cancel (options->context));
+        }
+      if (scenario == RETRY_FAILURE)
+        {
+          cleaned = TRUE;
+          return -EIO;
+        }
+    }
+  if (scenario == NO_MATCH || scenario == RETRY_NO_MATCH)
+    {
+      options->progress (PIANO_GOODIX_NOT_MATCH, 0, options->context);
+      cleaned = TRUE;
+      return -EACCES;
+    }
+  if (scenario == TIMEOUT)
+    {
+      cleaned = TRUE;
+      return -ETIMEDOUT;
+    }
+  if (scenario == CANCEL_SCAN || scenario == RETRY_CANCEL)
+    {
+      g_idle_add (cancel_on_main, NULL);
+      while (!options->should_cancel (options->context))
+        g_usleep (1000);
+      cleaned = TRUE;
+      return -ECANCELED;
+    }
+  options->progress (PIANO_GOODIX_FINGER_UP, 0, options->context);
+  *matched = FP_FINGER_LEFT_THUMB;
+  cleaned = TRUE;
+  return 0;
+}
+
+int
+piano_goodix_list (uint32_t uid, unsigned int fingers[10], size_t *count)
+{
+  (void) uid;
+  assert_worker ();
+  if (scenario == IDENTIFY_EMPTY_STORED)
+    {
+      fingers[0] = FP_FINGER_LEFT_THUMB;
+      *count = 1;
+      return 0;
+    }
+  return -EIO;
+}
+
+int
+piano_goodix_delete (uint32_t uid, unsigned int finger)
+{
+  assert_worker ();
+  g_assert_cmpuint (uid, ==, getuid ());
+  g_assert_cmpuint (finger, ==, FP_FINGER_LEFT_THUMB);
+  cleaned = TRUE;
+  return 0;
+}
+
+static void
+initialized (GObject *source, GAsyncResult *result, gpointer pointer)
+{
+  GError *error = NULL;
+  FpDevice **device = pointer;
+
+  *device = FP_DEVICE (g_async_initable_new_finish (G_ASYNC_INITABLE (source), result, &error));
+  g_assert_no_error (error);
+}
+
+static FpDevice *
+new_device (void)
+{
+  FpDevice *device = NULL;
+  GError *error = NULL;
+
+  g_async_initable_new_async (fpi_device_piano_goodix_get_type (), G_PRIORITY_DEFAULT,
+                              NULL, initialized, &device, NULL);
+  while (!device)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (fp_device_open_sync (device, NULL, &error));
+  g_assert_no_error (error);
+  return device;
+}
+
+static FpPrint *
+print_for_user (FpDevice *device, guint32 uid, guint finger, gboolean enrolled)
+{
+  struct passwd *entry = getpwuid (uid);
+  FpPrint *print = fp_print_new (device);
+
+  g_assert_nonnull (entry);
+  fp_print_set_username (print, entry->pw_name);
+  fp_print_set_finger (print, finger);
+  if (enrolled)
+    {
+      fpi_print_set_type (print, FPI_PRINT_RAW);
+      fpi_print_set_device_stored (print, TRUE);
+      g_object_set (print, "fpi-data", g_variant_new ("(uu)", uid, finger), NULL);
+    }
+  return g_object_ref_sink (print);
+}
+
+static FpPrint *
+new_print (FpDevice *device, gboolean enrolled)
+{
+  return print_for_user (device, getuid (), FP_FINGER_LEFT_THUMB, enrolled);
+}
+
+static void
+close_device (FpDevice *device)
+{
+  GError *error = NULL;
+
+  g_assert_true (fp_device_close_sync (device, NULL, &error));
+  g_assert_no_error (error);
+  g_object_unref (device);
+  while (g_main_context_pending (NULL))
+    g_main_context_iteration (NULL, FALSE);
+}
+
+static void
+progress (FpDevice *device, gint completed, FpPrint *print, gpointer unused, GError *error)
+{
+  (void) print;
+  (void) unused;
+  g_assert_true (g_thread_self () == main_thread);
+  if (error)
+    {
+      g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+      retries++;
+    }
+  last_stage = completed;
+  progress_count++;
+  g_assert_cmpint (completed, <=, fp_device_get_nr_enroll_stages (device));
+}
+
+static void
+reset (Scenario value)
+{
+  scenario = value;
+  cleaned = FALSE;
+  calls = retries = last_stage = progress_count = verify_reports = 0;
+  identify_calls = directory_index = 0;
+}
+
+static void
+test_enroll (gconstpointer pointer)
+{
+  reset (GPOINTER_TO_INT (pointer));
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, FALSE);
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) result = fp_device_enroll_sync (device, print, NULL, progress, NULL, &error);
+
+  g_assert_true (cleaned);
+  g_assert_cmpuint (calls, ==, 1);
+  if (scenario == ENROLL_BUSY)
+    {
+      g_assert_null (result);
+      g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_BUSY);
+      g_assert_cmpuint (progress_count, ==, 0);
+    }
+  else if (scenario == ENROLL_FAILURE)
+    {
+      g_assert_cmpuint (retries, ==, 1);
+      g_assert_null (result);
+      g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+      g_assert_cmpuint (last_stage, <, 4);
+    }
+  else
+    {
+      g_assert_cmpuint (retries, ==, 1);
+      g_assert_no_error (error);
+      g_assert_nonnull (result);
+      g_assert_true (fp_print_get_device_stored (result));
+      g_assert_cmpuint (last_stage, ==, 4);
+      g_assert_cmpuint (fp_device_get_nr_enroll_stages (device), ==, 4);
+    }
+  close_device (device);
+}
+
+static void
+verify_report (FpDevice *device, FpPrint *match, FpPrint *print, gpointer unused, GError *error)
+{
+  (void) device;
+  (void) match;
+  (void) print;
+  (void) unused;
+  g_assert_true (g_thread_self () == main_thread);
+  /* Nonterminal acquisition retries must not finish or report the attempt.
+   * Deliver its single result only after the native transaction has closed.
+   */
+  g_assert_true (cleaned);
+  if (error)
+    g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  verify_reports++;
+}
+
+static void
+test_verify (gconstpointer pointer)
+{
+  reset (GPOINTER_TO_INT (pointer));
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, TRUE);
+  g_autoptr(GError) error = NULL;
+  gboolean match = FALSE;
+
+  cancel_scan = g_cancellable_new ();
+  gboolean result = fp_device_verify_sync (device, print, cancel_scan, verify_report, NULL,
+                                           &match, NULL, &error);
+  g_assert_true (cleaned);
+  g_assert_cmpuint (calls, ==, 1);
+  if (scenario == MATCH || scenario == NO_MATCH ||
+      scenario == RETRY_MATCH || scenario == RETRY_NO_MATCH)
+    {
+      g_assert_true (result);
+      g_assert_no_error (error);
+      g_assert_cmpint (match, ==, scenario == MATCH || scenario == RETRY_MATCH);
+      g_assert_cmpuint (verify_reports, ==, 1);
+    }
+  else
+    {
+      g_assert_false (result);
+      g_assert_false (match);
+      if (scenario == TIMEOUT)
+        {
+          g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+          g_assert_cmpuint (verify_reports, ==, 1);
+        }
+      else if (scenario == RETRY_FAILURE)
+        {
+          g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+          g_assert_cmpuint (verify_reports, ==, 0);
+        }
+      else if (scenario == BUSY)
+        {
+          g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_BUSY);
+          g_assert_cmpuint (verify_reports, ==, 0);
+        }
+      else
+        {
+          g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+          g_assert_cmpuint (verify_reports, ==, 0);
+        }
+    }
+  g_clear_object (&cancel_scan);
+  close_device (device);
+}
+
+static void
+test_invalid_coordinates (void)
+{
+  reset (MATCH);
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, TRUE);
+  g_autoptr(GError) error = NULL;
+  gboolean match;
+
+  g_object_set (print, "fpi-data", g_variant_new ("(uu)", (guint32) getuid () + 1, 1U), NULL);
+  g_assert_false (fp_device_verify_sync (device, print, NULL, NULL, NULL, &match, NULL, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID);
+  g_assert_cmpuint (calls, ==, 0);
+  close_device (device);
+}
+
+static void
+test_capabilities (void)
+{
+  reset (MATCH);
+  FpDevice *device = new_device ();
+  FpDeviceFeature features = FP_DEVICE_FEATURE_VERIFY | FP_DEVICE_FEATURE_IDENTIFY | FP_DEVICE_FEATURE_STORAGE |
+                             FP_DEVICE_FEATURE_STORAGE_LIST | FP_DEVICE_FEATURE_STORAGE_DELETE |
+                             FP_DEVICE_FEATURE_ALWAYS_ON;
+
+  g_assert_cmpuint (fp_device_get_features (device), ==, features);
+  g_assert_cmpstr (fp_device_get_driver (device), ==, "piano_goodix");
+  g_assert_cmpint (fp_device_get_scan_type (device), ==, FP_SCAN_TYPE_PRESS);
+  g_assert_cmpuint (calls, ==, 0);
+  close_device (device);
+}
+
+static void
+test_identify (gconstpointer pointer)
+{
+  reset (GPOINTER_TO_INT (pointer));
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, TRUE);
+  g_autoptr(FpPrint) second = NULL;
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new ();
+  g_autoptr(GError) error = NULL;
+  g_autoptr(FpPrint) match = NULL;
+  g_autoptr(FpPrint) found = NULL;
+
+  if (scenario != IDENTIFY_EMPTY && scenario != IDENTIFY_EMPTY_STORED)
+    {
+      g_ptr_array_add (gallery, print);
+      if (scenario == IDENTIFY_SECOND || scenario == IDENTIFY_MIXED || scenario == IDENTIFY_MIXED_ERROR)
+        {
+          guint32 uid = scenario == IDENTIFY_SECOND ? getuid () : other_uid;
+          guint finger = scenario == IDENTIFY_SECOND ? FP_FINGER_RIGHT_THUMB : FP_FINGER_LEFT_THUMB;
+
+          second = print_for_user (device, uid, finger, TRUE);
+          g_ptr_array_add (gallery, second);
+        }
+    }
+
+  cancel_scan = g_cancellable_new ();
+  gboolean result = fp_device_identify_sync (device, gallery, cancel_scan, NULL, NULL,
+                                             &match, &found, &error);
+  if (scenario == IDENTIFY_MIXED_ERROR || scenario == CANCEL_SCAN || scenario == TIMEOUT)
+    {
+      g_assert_false (result);
+      if (scenario == CANCEL_SCAN)
+        g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+      else if (scenario == TIMEOUT)
+        g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+      else
+        g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_GENERAL);
+      g_assert_null (match);
+      g_assert_null (found);
+      g_assert_true (cleaned);
+    }
+  else
+    {
+      g_assert_true (result);
+      g_assert_no_error (error);
+      if (scenario == IDENTIFY_SECOND || scenario == IDENTIFY_MIXED)
+        g_assert_true (match == second);
+      else
+        g_assert_null (match);
+      if (scenario == IDENTIFY_NO_MATCH || scenario == IDENTIFY_EMPTY)
+        g_assert_null (found);
+      else
+        {
+          g_assert_nonnull (found);
+          g_assert_true (fp_print_get_device_stored (found));
+          g_assert_cmpint (fp_print_get_finger (found), ==,
+                           scenario == IDENTIFY_OUTSIDE || scenario == IDENTIFY_SECOND ?
+                           FP_FINGER_RIGHT_THUMB : FP_FINGER_LEFT_THUMB);
+        }
+    }
+  g_assert_cmpuint (identify_calls, ==, scenario == IDENTIFY_EMPTY ? 0 :
+                    scenario == IDENTIFY_MIXED || scenario == IDENTIFY_MIXED_ERROR ? 2 : 1);
+  g_clear_object (&cancel_scan);
+  close_device (device);
+}
+
+static void
+test_identify_invalid_coordinates (void)
+{
+  reset (IDENTIFY_SECOND);
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, TRUE);
+  g_autoptr(GPtrArray) gallery = g_ptr_array_new ();
+  g_autoptr(GError) error = NULL;
+
+  g_object_set (print, "fpi-data", g_variant_new ("(uu)", (guint32) getuid () + 1, 1U), NULL);
+  g_ptr_array_add (gallery, print);
+  g_assert_false (fp_device_identify_sync (device, gallery, NULL, NULL, NULL, NULL, NULL, &error));
+  g_assert_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_DATA_INVALID);
+  g_assert_cmpuint (calls, ==, 0);
+  close_device (device);
+}
+
+static void
+test_delete (void)
+{
+  reset (MATCH);
+  FpDevice *device = new_device ();
+  g_autoptr(FpPrint) print = new_print (device, TRUE);
+  g_autoptr(GError) error = NULL;
+
+  g_assert_true (fp_device_has_feature (device, FP_DEVICE_FEATURE_STORAGE_LIST));
+  g_assert_false (fp_device_has_feature (device, FP_DEVICE_FEATURE_STORAGE_CLEAR));
+  g_assert_true (fp_device_delete_print_sync (device, print, NULL, &error));
+  g_assert_no_error (error);
+  g_assert_true (cleaned);
+  g_assert_cmpuint (calls, ==, 1);
+  close_device (device);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  main_thread = g_thread_self ();
+  other_uid = getuid () ? 0 : 65534;
+  g_assert_nonnull (getpwuid (other_uid));
+  g_test_add_data_func ("/piano-goodix/enroll/progress", GINT_TO_POINTER (ENROLL), test_enroll);
+  g_test_add_data_func ("/piano-goodix/enroll/save-failure", GINT_TO_POINTER (ENROLL_FAILURE), test_enroll);
+  g_test_add_data_func ("/piano-goodix/enroll/busy", GINT_TO_POINTER (ENROLL_BUSY), test_enroll);
+  g_test_add_data_func ("/piano-goodix/verify/match", GINT_TO_POINTER (MATCH), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/not-match", GINT_TO_POINTER (NO_MATCH), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/retry-then-match", GINT_TO_POINTER (RETRY_MATCH), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/retry-then-not-match", GINT_TO_POINTER (RETRY_NO_MATCH), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/retry-then-failure", GINT_TO_POINTER (RETRY_FAILURE), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/retry-then-cancel", GINT_TO_POINTER (RETRY_CANCEL), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/timeout", GINT_TO_POINTER (TIMEOUT), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/busy", GINT_TO_POINTER (BUSY), test_verify);
+  g_test_add_data_func ("/piano-goodix/verify/cancel-cleanup", GINT_TO_POINTER (CANCEL_SCAN), test_verify);
+  g_test_add_func ("/piano-goodix/verify/foreign-uid", test_invalid_coordinates);
+  g_test_add_func ("/piano-goodix/capabilities", test_capabilities);
+  g_test_add_data_func ("/piano-goodix/identify/second-finger", GINT_TO_POINTER (IDENTIFY_SECOND), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/not-match", GINT_TO_POINTER (IDENTIFY_NO_MATCH), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/mixed-users", GINT_TO_POINTER (IDENTIFY_MIXED), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/mixed-users-auth-error", GINT_TO_POINTER (IDENTIFY_MIXED_ERROR), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/outside-gallery", GINT_TO_POINTER (IDENTIFY_OUTSIDE), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/empty-gallery", GINT_TO_POINTER (IDENTIFY_EMPTY), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/empty-gallery-stored", GINT_TO_POINTER (IDENTIFY_EMPTY_STORED), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/cancel-cleanup", GINT_TO_POINTER (CANCEL_SCAN), test_identify);
+  g_test_add_data_func ("/piano-goodix/identify/timeout", GINT_TO_POINTER (TIMEOUT), test_identify);
+  g_test_add_func ("/piano-goodix/identify/foreign-uid", test_identify_invalid_coordinates);
+  g_test_add_func ("/piano-goodix/storage/scoped-delete", test_delete);
+  return g_test_run ();
+}
