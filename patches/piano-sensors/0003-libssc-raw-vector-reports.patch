From: Project SunUEFI
Subject: [PATCH] sensors: package libssc raw-vector APIs and client

Apply after the property-type wrapper. Use the frozen upstream libssc
source and normal Debian quilt/Meson/debhelper path for the new API and
public client. Give the added symbol a Debian minimum-version entry so
libssc-bin cannot silently resolve against the older library.
Only raw payload/vector/accuracy values are exposed; no units or sensor
calibration are invented and no daemon/subscription starts by default.

--- /dev/null
+++ b/patches/libssc/0002-raw-vector-reports.patch
@@ -0,0 +1,259 @@
+From: Project SunUEFI
+Subject: [PATCH] libssc: expose immutable raw reports and uninterpreted vectors
+
+Apply after the sensor property type correction to libssc 0.4.4.
+Keep the existing SUID discovery, QMI subscription and typed measurements.
+Forward original event bytes only for the sensor UID and only if used;
+provide a public proto-c vector decoder without guessed component units.
+Unknown event IDs and malformed payloads return normal GIO errors.
+
+Package as a new +sunuefi2 build, not a replacement of +sunuefi1.
+Live delivery and ARM64/GIR packaging still require normal validation.
+
+--- a/src/libssc-sensor.c
++++ b/src/libssc-sensor.c
+@@ -40,6 +40,12 @@
+ };
+ static GParamSpec *properties[N_PROPERTIES];
+ 
++enum {
++	SIGNAL_RAW_REPORT,
++	N_SIGNALS
++};
++static guint signals[N_SIGNALS];
++
+ typedef struct {
+ 	GTask *task;
+ 	SSCSensor *sensor;
+@@ -80,6 +86,28 @@
+ 
+ static void
+ report_received (SSCClient *self, guint32 msg_id, guint64 uid_high, guint64 uid_low, GArray *buf, gpointer user_data);
++
++static void
++raw_report_received (SSCClient *client, guint32 msg_id, guint64 uid_high,
++		     guint64 uid_low, GArray *buf, gpointer user_data)
++{
++	SSCSensor *self = SSC_SENSOR (user_data);
++	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (self);
++	g_autoptr (GBytes) payload = NULL;
++
++	if (uid_high != priv->uid_high || uid_low != priv->uid_low ||
++	    !g_signal_has_handler_pending (self, signals[SIGNAL_RAW_REPORT], 0, FALSE))
++		return;
++	if (buf == NULL || g_array_get_element_size (buf) != 1 || buf->len > 65536) {
++		g_warning ("Invalid raw SSC report buffer");
++		return;
++	}
++	/* The client frees its GArray after report emission. Copy only when used. */
++	payload = g_bytes_new (buf->data, buf->len);
++	g_object_ref (self);
++	g_signal_emit (self, signals[SIGNAL_RAW_REPORT], 0, msg_id, payload);
++	g_object_unref (self);
++}
+ 
+ GQuark ssc_sensor_error_quark (void)
+ {
+@@ -670,6 +698,11 @@
+ 		return;
+ 	}
+ 
++	/* Separate from the temporary discovery/open report handler. The closure
++	 * disconnects when the sensor is destroyed; no new QMI subscription. */
++	g_signal_connect_object (priv->client, "report",
++		G_CALLBACK (raw_report_received), self, 0);
++
+ 	ctx = g_slice_new (ReportReceivedContext);
+ 	ctx->task = task;
+ 	ctx->sensor = self;
+@@ -812,6 +845,21 @@
+ 	ssc_sensor_class->open_finish = sensor_open_finish;
+ 	ssc_sensor_class->close = sensor_close;
+ 	ssc_sensor_class->close_finish = sensor_close_finish;
++
++	/**
++	 * SSCSensor::raw-report:
++	 * @self: the sensor matching the report's original SUID
++	 * @message_id: original SSC message ID
++	 * @payload: (transfer none): immutable original event protobuf bytes
++	 *
++	 * Emitted synchronously in the SSC client's report dispatch context.
++	 * Retain @payload with g_bytes_ref() to keep it after the callback.
++	 * No physical units, firmware timestamp or successful hardware calibration
++	 * are implied. Discovery/open/close and sampling remain the existing APIs.
++	 */
++	signals[SIGNAL_RAW_REPORT] = g_signal_new ("raw-report",
++		G_TYPE_FROM_CLASS (klass), G_SIGNAL_RUN_LAST,
++		0, NULL, NULL, NULL, G_TYPE_NONE, 2, G_TYPE_UINT, G_TYPE_BYTES);
+ 
+ 	properties[PROP_UID_LOW] =
+ 		g_param_spec_uint64 (SSC_SENSOR_UID_LOW,
