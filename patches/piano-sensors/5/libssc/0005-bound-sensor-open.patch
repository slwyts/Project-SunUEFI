@@ -55,3 +55,3 @@ ssc_common_wait_sync_context (SyncContext *ctx) {
 		g_mutex_unlock (&ctx->mutex);
-		g_main_context_iteration (g_main_context_default (), FALSE);
+		g_main_context_iteration (ctx->context, TRUE);
 		g_mutex_lock (&ctx->mutex);
@@ -69,3 +69,3 @@ ssc_common_callback_sync_context (GObject *source, GAsyncResult *result, gpointe
 	ctx->finished = TRUE;
-	g_cond_signal (&ctx->condition);
+	g_main_context_wakeup (ctx->context);
