+++ b/src/libssc-common-private.h
@@ -76,6 +76,5 @@ typedef struct {
 	GMutex mutex;
-	GCond condition;
+	GMainContext *context;
 	GAsyncResult *result;
 	gboolean finished;
-	GObject *object;
 } SyncContext;
