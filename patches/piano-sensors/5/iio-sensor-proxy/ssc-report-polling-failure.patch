Description: Complete waiting D-Bus claims when an SSC sensor cannot start
 Use the existing asynchronous SSC stream operations so D-Bus and device
 changes remain responsive. On failure remove the measurement listener,
 return the error to pending claims, and let clients claim the sensor
 again. A release cancels an unfinished start before destroying the device.
Forwarded: no
---
diff --git a/src/drivers.c b/src/drivers.c
index 1afb7f0..f43f044 100644
--- a/src/drivers.c
+++ b/src/drivers.c
@@ -9,6 +9,142 @@
 #include "drivers.h"
 #include <gudev/gudev.h>
 
+#define FIRST_READING_TIMEOUT_S 10
+
+struct SensorPollingStart {
+	grefcount refs;
+	SensorDevice *device;
+	GCancellable *cancellable;
+	GBytes *first_reading;
+	guint timeout_id;
+	gboolean opened;
+};
+
+void
+sensor_polling_start_unref (SensorPollingStart *start)
+{
+	if (!g_ref_count_dec (&start->refs))
+		return;
+	g_clear_pointer (&start->first_reading, g_bytes_unref);
+	g_object_unref (start->cancellable);
+	g_free (start);
+}
+
+static void
+sensor_polling_detach (SensorPollingStart *start)
+{
+	g_clear_handle_id (&start->timeout_id, g_source_remove);
+	start->device->polling_start = NULL;
+	start->device = NULL;
+	sensor_polling_start_unref (start);
+}
+
+static gboolean
+sensor_polling_timed_out (gpointer user_data)
+{
+	SensorPollingStart *start = user_data;
+	SensorDevice *device = start->device;
+	g_autoptr (GError) error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_TIMED_OUT,
+						     "Sensor did not send a measurement");
+
+	start->timeout_id = 0;
+	sensor_polling_detach (start);
+	device->polling_start_failed = TRUE;
+	driver_set_polling (device, FALSE);
+	device->polling_failed (device, error, device->user_data);
+	return G_SOURCE_REMOVE;
+}
+
+static void
+sensor_polling_publish_first_reading (SensorPollingStart *start)
+{
+	SensorDevice *device = start->device;
+	g_autoptr (GBytes) reading = g_steal_pointer (&start->first_reading);
+
+	sensor_polling_detach (start);
+	device->callback_func (device, (gpointer) g_bytes_get_data (reading, NULL),
+			       device->user_data);
+}
+
+SensorPollingStart *
+sensor_polling_start (SensorDevice *device)
+{
+	SensorPollingStart *start = g_new0 (SensorPollingStart, 1);
+
+	g_ref_count_init (&start->refs);
+	start->device = device;
+	start->cancellable = g_cancellable_new ();
+	device->polling_start = start;
+	device->polling_start_failed = FALSE;
+
+	/* The device and the caller's open callback each hold one reference. */
+	g_ref_count_inc (&start->refs);
+	return start;
+}
+
+GCancellable *
+sensor_polling_cancellable (SensorPollingStart *start)
+{
+	return start->cancellable;
+}
+
+SensorDevice *
+sensor_polling_device (SensorPollingStart *start)
+{
+	return start->device;
+}
+
+void
+sensor_polling_opened (SensorPollingStart *start, const GError *error)
+{
+	SensorDevice *device = start->device;
+
+	if (!device)
+		return;
+	if (error) {
+		sensor_polling_detach (start);
+		device->polling_start_failed = TRUE;
+		device->polling_failed (device, error, device->user_data);
+		return;
+	}
+
+	start->opened = TRUE;
+	if (start->first_reading)
+		sensor_polling_publish_first_reading (start);
+	else
+		start->timeout_id = g_timeout_add_seconds (FIRST_READING_TIMEOUT_S,
+							  sensor_polling_timed_out, start);
+}
+
+void
+sensor_polling_cancel (SensorDevice *device)
+{
+	SensorPollingStart *start = device->polling_start;
+	g_autoptr (GCancellable) cancellable = NULL;
+
+	if (!start)
+		return;
+	cancellable = g_object_ref (start->cancellable);
+	sensor_polling_detach (start);
+	g_cancellable_cancel (cancellable);
+}
+
+void
+sensor_polling_report (SensorDevice *device, gpointer readings, gsize size)
+{
+	SensorPollingStart *start = device->polling_start;
+
+	if (!start) {
+		device->callback_func (device, readings, device->user_data);
+		return;
+	}
+
+	if (!start->first_reading)
+		start->first_reading = g_bytes_new (readings, size);
+	if (start->opened)
+		sensor_polling_publish_first_reading (start);
+}
+
 gboolean drv_check_udev_sensor_type (GUdevDevice *device,
 				     const gchar *match,
 				     const gchar *name)
