@@ -116,6 +136,7 @@ driver_open (SensorDriver       *driver,
 		return NULL;
 	sensor_device->drv = driver;
 	sensor_device->callback_func = callback_func;
+	sensor_device->polling_failed = polling_failed;
 	sensor_device->user_data = user_data;
 	return sensor_device;
 }
@@ -142,6 +163,7 @@ driver_close (SensorDevice *sensor_device)
 	SensorDriver *driver;
 
 	g_return_if_fail (sensor_device);
