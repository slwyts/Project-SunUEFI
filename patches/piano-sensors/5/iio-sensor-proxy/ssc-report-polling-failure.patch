+static void
+ssc_accelerometer_open_ready (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	g_autoptr (SensorPollingStart) start = user_data;
+	g_autoptr (GError) error = NULL;
+	SensorDevice *device = sensor_polling_device (start);
+
+	if (!device)
+		return;
+	if (!ssc_sensor_accelerometer_open_finish (SSC_SENSOR_ACCELEROMETER (source), result, &error)) {
+		DrvData *drv_data = device->priv;
+
+		if (!error)
+			error = g_error_new_literal (G_IO_ERROR, G_IO_ERROR_FAILED, "Sensor did not start");
+		g_clear_signal_handler (&drv_data->measurement_id, drv_data->sensor);
+		g_warning ("Opening SSC accelerometer sensor failed: %s", error->message);
+	}
+	sensor_polling_opened (start, error);
+}
+
+static void
+ssc_accelerometer_close_ready (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+	g_autoptr (GError) error = NULL;
+
+	if (!ssc_sensor_accelerometer_close_finish (SSC_SENSOR_ACCELEROMETER (source), result, &error))
+		g_warning ("Closing SSC accelerometer sensor failed: %s", error ? error->message : "Unknown error");
+}
