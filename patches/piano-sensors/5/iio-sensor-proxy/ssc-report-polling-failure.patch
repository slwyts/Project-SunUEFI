diff --git a/src/iio-sensor-proxy.c b/src/iio-sensor-proxy.c
index b635f29..91134e5 100644
--- a/src/iio-sensor-proxy.c
+++ b/src/iio-sensor-proxy.c
@@ -389,6 +389,31 @@ send_driver_changed_dbus_event (SensorData   *data,
 		g_assert_not_reached ();
 }
 
+static void
+sensor_polling_failed (SensorDevice *device, const GError *error, gpointer user_data)
+{
+	SensorData *data = user_data;
+	DriverType type = device->drv->type;
+	g_autofree GDBusMethodInvocation **invocations = NULL;
+	gsize count, i;
+
+	invocations = (GDBusMethodInvocation **) g_ptr_array_steal (
+		data->sensor_startup_dbus_invocations_delayed[type], &count);
+	for (i = 0; i < count; i++) {
+		const char *sender = g_dbus_method_invocation_get_sender (invocations[i]);
+
