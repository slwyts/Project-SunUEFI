From 4142f9b4ea12236a3d65cb40fdf70e3165b9c92b Mon Sep 17 00:00:00 2001
From: slwyts <slwyts@foxmail.com>
Date: Tue, 10 Nov 2026 00:11:15 +0800
Subject: [PATCH] resize.f2fs: grow in an existing metadata layout

Add an explicit keep-layout growth mode for volumes previously shrunk online. Verify existing SIT and SSA capacity before writing, retain NAT/SIT version maps and checkpoint payloads, initialize only new segment entries, and never migrate file data. Preserve the original main-area start independently of the block-device partition offset.

Reject backward main-area migration before journal writes in normal growth. Add a no-write layout check for offline preflight.
---
 fsck/main.c       |  12 ++++--
 fsck/resize.c     | 128 ++++++++++++++++++++++++++++++++++++++++++----
 include/f2fs_fs.h |   2 +
 3 files changed, 130 insertions(+), 12 deletions(-)

diff --git a/fsck/main.c b/fsck/main.c
index 08d38d8..e56c686 100644
--- a/fsck/main.c
+++ b/fsck/main.c
@@ -150,6 +150,8 @@ void resize_usage()
 	MSG(0, "  -g add default options\n");
 	MSG(0, "  -o overprovision percentage [default:auto]\n");
 	MSG(0, "  -s safe resize (Does not resize metadata)\n");
+	MSG(0, "  -k grow within the existing metadata layout without moving file blocks\n");
+	MSG(0, "  -P check the -k target without writing\n");
 	MSG(0, "  -t target sectors [default: device size]\n");
 	MSG(0, "  -V print the version number and exit\n");
 	exit(1);
@@ -643,7 +645,7 @@ void f2fs_parse_options(int argc, char *argv[])
 #endif
 	} else if (!strcmp("resize.f2fs", prog)) {
 #ifdef WITH_RESIZE
-		const char *option_string = "d:fFg:Hst:o:V";
+		const char *option_string = "d:fFg:HkPst:o:V";
 
 		c.func = RESIZE;
 		while ((option = getopt(argc, argv, option_string)) != EOF) {
@@ -680,6 +682,14 @@ void f2fs_parse_options(int argc, char *argv[])
 			case 's':
 				c.safe_resize = 1;
 				break;
+			case 'k':
+				c.keep_layout = 1;
+				break;
+			case 'P':
+				c.keep_layout = 1;
+				c.check_layout = 1;
+				c.dry_run = 1;
+				break;
 			case 't':
 				if (strncmp(optarg, "0x", 2))
 					ret = sscanf(optarg, "%"PRIu64"",
diff --git a/fsck/resize.c b/fsck/resize.c
index beb7ce0..f6229eb 100644
--- a/fsck/resize.c
+++ b/fsck/resize.c
@@ -9,7 +9,7 @@
  */
 #include "fsck.h"
 
-static int get_new_sb(struct f2fs_super_block *sb)
+static int get_new_sb(struct f2fs_super_block *sb, bool keep_meta)
 {
 	uint32_t zone_size_bytes;
 	uint64_t zone_align_start_offset;
@@ -25,6 +25,16 @@ static int get_new_sb(struct f2fs_super_block *sb)
 
 	set_sb(block_count, c.target_sectors >>
 				get_sb(log_sectors_per_block));
+	if (keep_meta) {
+		u64 blocks = get_sb(block_count);
+		u32 section = get_sb(segs_per_sec);
+
+		if (blocks <= get_sb(segment0_blkaddr) || !section)
+			return -1;
+		set_sb(segment_count, (blocks - get_sb(segment0_blkaddr)) /
+				blks_per_seg / section * section);
+		goto safe_resize;
+	}
 
 	zone_size_bytes = segment_size_bytes * segs_per_zone;
 	zone_align_start_offset =
@@ -37,7 +47,7 @@ static int get_new_sb(struct f2fs_super_block *sb)
 				zone_align_start_offset) / segment_size_bytes /
 				c.segs_per_sec * c.segs_per_sec);
 
-	if (c.safe_resize)
+	if (c.safe_resize || keep_meta)
 		goto safe_resize;
 
 	blocks_for_sit = SIZE_ALIGN(get_sb(segment_count), SIT_ENTRY_PER_BLOCK);
@@ -542,9 +552,9 @@ static void rebuild_checkpoint(struct f2fs_sb_info *sbi,
 			get_cp(overprov_segment_count)) * c.blks_per_seg));
 
 	if (is_set_ckpt_flags(cp, CP_ORPHAN_PRESENT_FLAG))
-		orphan_blks = __start_sum_addr(sbi) - 1;
+		orphan_blks = __start_sum_addr(sbi) - 1 - get_sb(cp_payload);
 
-	set_cp(cp_pack_start_sum, 1 + get_newsb(cp_payload));
+	set_cp(cp_pack_start_sum, 1 + orphan_blks + get_newsb(cp_payload));
 	set_cp(cp_pack_total_block_count, 8 + orphan_blks + get_newsb(cp_payload));
 
 	/* cur->segno - offset */
@@ -581,7 +591,7 @@ static void rebuild_checkpoint(struct f2fs_sb_info *sbi,
 
 	memcpy(new_cp, cp, (unsigned char *)cp->sit_nat_version_bitmap -
 						(unsigned char *)cp);
-	if (c.safe_resize)
+	if (c.safe_resize || c.keep_layout)
 		memcpy((void *)new_cp + CP_BITMAP_OFFSET,
 			(void *)cp + CP_BITMAP_OFFSET,
 			F2FS_BLKSIZE - CP_BITMAP_OFFSET);
@@ -605,12 +615,16 @@ static void rebuild_checkpoint(struct f2fs_sb_info *sbi,
 
 	memset(buf, 0, F2FS_BLKSIZE);
 	for (i = 0; i < get_newsb(cp_payload); i++) {
+		if (c.keep_layout)
+			memcpy(buf, (char *)cp + (i + 1) * F2FS_BLKSIZE,
+					F2FS_BLKSIZE);
 		ret = dev_write_block(buf, new_cp_blk_no++, WRITE_LIFE_NONE);
 		ASSERT(ret >= 0);
 	}
 
 	for (i = 0; i < orphan_blks; i++) {
-		block_t orphan_blk_no = old_cp_blk_no + 1 + get_sb(cp_payload);
+		block_t orphan_blk_no = old_cp_blk_no + 1 +
+					get_sb(cp_payload) + i;
 
 		ret = dev_read_block(buf, orphan_blk_no++);
 		ASSERT(ret >= 0);
@@ -628,6 +642,8 @@ static void rebuild_checkpoint(struct f2fs_sb_info *sbi,
 		ASSERT(ret >= 0);
 	}
 
+	ret = f2fs_fsync_device();
+	ASSERT(ret >= 0);
 	/* write the last cp */
 	ret = dev_write_block(new_cp, new_cp_blk_no++, WRITE_LIFE_NONE);
 	ASSERT(ret >= 0);
@@ -635,6 +651,8 @@ static void rebuild_checkpoint(struct f2fs_sb_info *sbi,
 	/* Write nat bits */
 	if (flags & CP_NAT_BITS_FLAG)
 		write_nat_bits(sbi, new_sb, new_cp, sbi->cur_cp == 1 ? 2 : 1);
+	ret = f2fs_fsync_device();
+	ASSERT(ret >= 0);
 
 	/* disable old checkpoint */
 	memset(buf, 0, F2FS_BLKSIZE);
@@ -667,6 +685,78 @@ static int f2fs_resize_check(struct f2fs_sb_info *sbi, struct f2fs_super_block *
 	return 0;
 }
 
+static int check_layout_capacity(struct f2fs_sb_info *sbi,
+				struct f2fs_super_block *new_sb)
+{
+	struct f2fs_super_block *sb = F2FS_RAW_SUPER(sbi);
+	u64 sit_entries = (u64)(get_sb(segment_count_sit) / 2) *
+			c.blks_per_seg * SIT_ENTRY_PER_BLOCK;
+	u64 summary_blocks = get_newsb(segment_count_main);
+	unsigned int i;
+
+	if (c.feature & F2FS_FEATURE_PACKED_SSA)
+		summary_blocks = (summary_blocks + SUMS_PER_BLOCK - 1) /
+					SUMS_PER_BLOCK;
+	if (c.ndevs != 1 || get_newsb(segment_count_main) > sit_entries ||
+	    summary_blocks > (u64)get_sb(segment_count_ssa) * c.blks_per_seg ||
+	    get_newsb(main_blkaddr) != get_sb(main_blkaddr) ||
+	    get_newsb(cp_payload) != get_sb(cp_payload) ||
+	    get_newsb(segment_count_main) < get_sb(segment_count_main) ||
+	    (is_set_ckpt_flags(F2FS_CKPT(sbi), CP_ORPHAN_PRESENT_FLAG) &&
+	     __start_sum_addr(sbi) < 1 + get_sb(cp_payload))) {
+		MSG(0, "Error: Existing metadata cannot cover the target size\n");
+		return -1;
+	}
+	for (i = 0; i < NO_CHECK_TYPE; i++) {
+		if (CURSEG_I(sbi, i)->segno >= get_sb(segment_count_main))
+			return -1;
+	}
+	return 0;
+}
+
+static int grow_keep_layout(struct f2fs_sb_info *sbi,
+				struct f2fs_super_block *new_sb)
+{
+	struct f2fs_super_block *sb = F2FS_RAW_SUPER(sbi);
+	u32 old_main = get_sb(segment_count_main);
+	u32 new_main = get_newsb(segment_count_main);
+	u32 first = old_main / SIT_ENTRY_PER_BLOCK;
+	u32 last = (new_main + SIT_ENTRY_PER_BLOCK - 1) / SIT_ENTRY_PER_BLOCK;
+	struct f2fs_sit_block *block = calloc(F2FS_BLKSIZE, 1);
+	u32 page, set;
+	int ret;
+
+	ASSERT(block);
+	/* Leave every existing entry and every file block at its current address. */
+	flush_journal_entries(sbi);
+	for (set = 0; set < 2; set++) {
+		block_t start = get_sb(sit_blkaddr) +
+				set * (get_sb(segment_count_sit) / 2) * c.blks_per_seg;
+
+		for (page = first; page < last; page++) {
+			u32 base = page * SIT_ENTRY_PER_BLOCK;
+			u32 begin = old_main > base ? old_main - base : 0;
+			u32 end = min(new_main - base, (u32)SIT_ENTRY_PER_BLOCK);
+
+			ret = dev_read_block(block, start + page);
+			ASSERT(ret >= 0);
+			memset(&block->entries[begin], 0,
+					(end - begin) * sizeof(struct f2fs_sit_entry));
+			ret = dev_write_block(block, start + page, WRITE_LIFE_NONE);
+			ASSERT(ret >= 0);
+		}
+	}
+	free(block);
+	ret = f2fs_fsync_device();
+	ASSERT(ret >= 0);
+	rebuild_checkpoint(sbi, new_sb, 0);
+	ret = f2fs_fsync_device();
+	ASSERT(ret >= 0);
+	update_superblock(new_sb, SB_MASK_ALL);
+	MSG(0, "Info: Expanded in the existing layout; no file blocks moved\n");
+	return 0;
+}
+
 static int f2fs_resize_grow(struct f2fs_sb_info *sbi)
 {
 	struct f2fs_super_block *sb = F2FS_RAW_SUPER(sbi);
@@ -677,15 +767,27 @@ static int f2fs_resize_grow(struct f2fs_sb_info *sbi)
 	unsigned int offset_seg = 0;
 	int err = -1;
 
-	/* flush NAT/SIT journal entries */
-	flush_journal_entries(sbi);
-
 	memcpy(new_sb, F2FS_RAW_SUPER(sbi), sizeof(*new_sb));
-	if (get_new_sb(new_sb))
+	if (get_new_sb(new_sb, c.keep_layout))
 		return -1;
 
+	if (c.keep_layout && check_layout_capacity(sbi, new_sb))
+		return -1;
+	if (!c.keep_layout && get_newsb(main_blkaddr) < get_sb(main_blkaddr)) {
+		MSG(0, "Error: Cannot move the main area backward; use -k\n");
+		return -1;
+	}
 	if (f2fs_resize_check(sbi, new_sb) < 0)
 		return -1;
+	if (c.check_layout) {
+		MSG(0, "Info: Existing metadata covers the target; no writes\n");
+		return 0;
+	}
+	if (c.keep_layout)
+		return grow_keep_layout(sbi, new_sb);
+
+	/* Layout validation must complete before the first on-disk write. */
+	flush_journal_entries(sbi);
 
 	/* check nat availability */
 	if (get_sb(segment_count_nat) > get_newsb(segment_count_nat)) {
@@ -739,7 +841,7 @@ static int f2fs_resize_shrink(struct f2fs_sb_info *sbi)
 	flush_journal_entries(sbi);
 
 	memcpy(new_sb, F2FS_RAW_SUPER(sbi), sizeof(*new_sb));
-	if (get_new_sb(new_sb))
+	if (get_new_sb(new_sb, false))
 		return -1;
 
 	if (f2fs_resize_check(sbi, new_sb) < 0)
@@ -800,6 +902,10 @@ int f2fs_resize(struct f2fs_sb_info *sbi)
 
 	/* may different sector size */
 	if (target_blocks < get_sb(block_count)) {
+		if (c.keep_layout) {
+			MSG(0, "Error: -k supports expansion only\n");
+			return -1;
+		}
 		if (!c.safe_resize) {
 			ASSERT_MSG("Nothing to resize, now only supports resizing with safe resize flag\n");
 			return -1;
