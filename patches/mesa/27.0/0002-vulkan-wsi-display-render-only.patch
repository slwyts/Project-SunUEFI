From 0f2de12c43a90939423bd3c3e719ad82c9b14b1e Mon Sep 17 00:00:00 2001
From: Cryolitia PukNgae <cryolitia.pukngae@linux.dev>
Date: Mon, 23 Nov 2026 16:11:07 +0800
Subject: [PATCH] wsi/display: Handle DRM resource query errors during
 enumeration

drmModeGetResources() fails with EOPNOTSUPP on a render-only DRM primary
node because the device lacks modesetting support. The ioctl can also
fail with ENODEV after device removal. Reporting every failure as host
memory exhaustion hides these distinctions from the application.

Treat EOPNOTSUPP like the case where there is no display fd, so
enumeration can succeed on render-only devices. Return
VK_ERROR_OUT_OF_HOST_MEMORY for ENOMEM and VK_ERROR_UNKNOWN for other
query failures.

Generated-by: LLM
---
 src/vulkan/wsi/wsi_common_display.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/vulkan/wsi/wsi_common_display.c b/src/vulkan/wsi/wsi_common_display.c
index ea546b584390..a0e9321d1834 100644
--- a/src/vulkan/wsi/wsi_common_display.c
+++ b/src/vulkan/wsi/wsi_common_display.c
@@ -902,8 +902,15 @@ wsi_get_connectors(VkPhysicalDevice physicalDevice)
    drmModeResPtr mode_res = drmModeGetResources(wsi->fd);
 
    if (!mode_res) {
+      const int err = errno;
       mtx_unlock(&wsi->connectors_mutex);
-      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+      /* A render-only device has no modeset resources. */
+      if (err == EOPNOTSUPP)
+         return VK_SUCCESS;
+      if (err == ENOMEM)
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      return VK_ERROR_UNKNOWN;
    }
 
    /* Get current information */
