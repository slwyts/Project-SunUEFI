+typedef struct {
+        gint maximum;
+        gchar *source;
+} KbdBacklightRefresh;
+
+static void
+kbd_backlight_refresh_free (gpointer data)
+{
+        KbdBacklightRefresh *refresh = data;
+
+        g_free (refresh->source);
+        g_free (refresh);
+}
+
+static void
+kbd_backlight_update (GsdPowerManager *manager,
+                      gint maximum,
+                      gint brightness,
+                      const gchar *source)
+{
+        if (maximum <= 0 || brightness < 0 || brightness > maximum) {
+                maximum = 0;
+                brightness = -1;
+                manager->kbd_brightness_old = -1;
+                manager->kbd_brightness_pre_dim = -1;
+        }
+
+        if (maximum != manager->kbd_brightness_max || maximum <= 0)
+                source = NULL;
+
+        if (source == NULL && manager->kbd_brightness_max == maximum &&
+            manager->kbd_brightness_now == brightness)
+                return;
+
+        manager->kbd_brightness_max = maximum;
+        manager->kbd_brightness_now = brightness;
+        backlight_iface_emit_changed (manager, GSD_POWER_DBUS_INTERFACE_KEYBOARD,
+                                      kbd_backlight_get_percentage (manager), source);
+}
+
+static void
+kbd_backlight_brightness_ready_cb (GObject *source,
+                                   GAsyncResult *res,
+                                   gpointer user_data)
+{
+        g_autoptr(GTask) task = user_data;
+        GsdPowerManager *manager = g_task_get_source_object (task);
+        KbdBacklightRefresh *refresh = g_task_get_task_data (task);
+        g_autoptr(GVariant) reply = NULL;
+        gint brightness;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, NULL);
+        if (g_task_return_error_if_cancelled (task))
+                return;
+
+        if (reply != NULL) {
+                g_variant_get (reply, "(i)", &brightness);
+                kbd_backlight_update (manager, refresh->maximum, brightness, refresh->source);
+        } else {
+                kbd_backlight_update (manager, 0, -1, refresh->source);
+        }
+        g_task_return_boolean (task, reply != NULL);
+}
+
+static void
+kbd_backlight_maximum_ready_cb (GObject *source,
+                                GAsyncResult *res,
+                                gpointer user_data)
+{
+        g_autoptr(GTask) task = user_data;
+        GsdPowerManager *manager = g_task_get_source_object (task);
+        KbdBacklightRefresh *refresh = g_task_get_task_data (task);
+        g_autoptr(GVariant) reply = NULL;
+        GCancellable *cancellable;
+        gint maximum = 0;
+
+        reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, NULL);
+        if (g_task_return_error_if_cancelled (task))
+                return;
+
+        if (reply != NULL)
+                g_variant_get (reply, "(i)", &maximum);
+        if (maximum <= 0) {
+                kbd_backlight_update (manager, 0, -1, refresh->source);
+                g_task_return_boolean (task, reply != NULL);
+                return;
+        }
+
+        refresh->maximum = maximum;
+        cancellable = g_task_get_cancellable (task);
+        g_dbus_proxy_call (G_DBUS_PROXY (source), "GetBrightness", NULL,
+                           G_DBUS_CALL_FLAGS_NONE, -1,
+                           cancellable,
+                           kbd_backlight_brightness_ready_cb, g_steal_pointer (&task));
+}
+
+static void
+kbd_backlight_refresh (GsdPowerManager *manager, const gchar *source)
+{
+        g_autoptr(GTask) task = NULL;
+        g_autofree gchar *owner = NULL;
+        KbdBacklightRefresh *refresh;
+
+        if (manager->upower_kbd_proxy == NULL)
+                return;
+
+        if (manager->kbd_refresh_cancellable != NULL)
+                g_cancellable_cancel (manager->kbd_refresh_cancellable);
+        g_clear_object (&manager->kbd_refresh_cancellable);
+
+        owner = g_dbus_proxy_get_name_owner (manager->upower_kbd_proxy);
+        if (owner == NULL) {
+                kbd_backlight_update (manager, 0, -1, NULL);
+                return;
+        }
+
+        /* A new event supersedes both replies from the previous refresh. */
+        manager->kbd_refresh_cancellable = g_cancellable_new ();
+        task = g_task_new (manager, manager->kbd_refresh_cancellable, NULL, NULL);
+        refresh = g_new0 (KbdBacklightRefresh, 1);
+        refresh->source = g_strdup (source);
+        g_task_set_task_data (task, refresh, kbd_backlight_refresh_free);
+        g_dbus_proxy_call (manager->upower_kbd_proxy, "GetMaxBrightness", NULL,
+                           G_DBUS_CALL_FLAGS_NONE, -1,
+                           manager->kbd_refresh_cancellable,
+                           kbd_backlight_maximum_ready_cb, g_steal_pointer (&task));
+}
+
+static void
+upower_kbd_name_owner_changed_cb (GDBusProxy *proxy,
+                                  GParamSpec *pspec,
+                                  GsdPowerManager *manager)
+{
+        kbd_backlight_refresh (manager, NULL);
+}
