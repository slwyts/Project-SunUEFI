+static gint
+kbd_backlight_get_percentage (GsdPowerManager *manager)
+{
+        if (manager->kbd_brightness_max <= 0 || manager->kbd_brightness_now < 0)
+                return -1;
+
+        return ABS_TO_PERCENTAGE (0,
+                                  manager->kbd_brightness_max,
+                                  manager->kbd_brightness_now);
+}
+
+static gint
+backlight_get_n_steps (GsdPowerManager *manager)
+{
+        gint step;
+
+        if (manager->kbd_brightness_max <= 0)
+                return 0;
+
+        step = BRIGHTNESS_STEP_AMOUNT (manager->kbd_brightness_max);
+        return (manager->kbd_brightness_max / step) + 1;
+}
