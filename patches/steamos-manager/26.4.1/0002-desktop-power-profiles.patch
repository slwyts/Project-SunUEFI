+pub(crate) trait DesktopPowerProfiles {
+    #[zbus(property)]
+    fn profiles(&self) -> zbus::Result<Vec<HashMap<String, OwnedValue>>>;
+
+    #[zbus(property)]
+    fn active_profile(&self) -> zbus::Result<String>;
+
+    #[zbus(property)]
+    fn set_active_profile(&self, profile: &str) -> zbus::Result<()>;
+}
+
+fn steam_profile_name(profile: &str) -> String {
+    match profile {
+        "power-saver" => "low-power".into(),
+        other => other.into(),
+    }
+}
+
+impl PerformanceProfileConfig {
+    pub(crate) async fn available_profiles(&self, system: &Connection) -> Result<Vec<String>> {
+        if let Some(name) = &self.platform_profile_name {
+            return get_available_platform_profiles(name).await;
+        }
+        let proxy = DesktopPowerProfilesProxy::builder(system)
+            .cache_properties(CacheProperties::No)
+            .build()
+            .await?;
+        let profiles = match proxy.profiles().await {
+            Ok(profiles) => profiles,
+            Err(zbus::Error::FDO(error))
+                if matches!(
+                    error.as_ref(),
+                    fdo::Error::ServiceUnknown(_) | fdo::Error::NameHasNoOwner(_)
+                ) =>
+            {
+                return Ok(Vec::new());
+            }
+            Err(zbus::Error::MethodError(name, _, _))
+                if matches!(
+                    name.as_str(),
+                    "org.freedesktop.DBus.Error.ServiceUnknown"
+                        | "org.freedesktop.DBus.Error.NameHasNoOwner"
+                ) =>
+            {
+                return Ok(Vec::new());
+            }
+            Err(error) => return Err(error.into()),
+        };
+        profiles
+            .iter()
+            .map(|profile| {
+                let name = profile
+                    .get("Profile")
+                    .ok_or_else(|| anyhow!("Missing profile name"))?;
+                Ok(steam_profile_name(<&str>::try_from(name)?))
+            })
+            .collect()
+    }
+
+    pub(crate) async fn active_profile(&self, system: &Connection) -> Result<String> {
+        if let Some(name) = &self.platform_profile_name {
+            return get_platform_profile(name).await;
+        }
+        let profile = DesktopPowerProfilesProxy::new(system)
+            .await?
+            .active_profile()
+            .await?;
+        Ok(steam_profile_name(&profile))
+    }
+}
