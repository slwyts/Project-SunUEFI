+async fn watch_desktop_power_profiles(
+    system: &Connection,
+    object_server: &ObjectServer,
+) -> Result<()> {
+    let interface = object_server
+        .interface::<_, PerformanceProfile1>(MANAGER_PATH)
+        .await?;
+    let proxy = DesktopPowerProfilesProxy::builder(system)
+        .cache_properties(CacheProperties::No)
+        .build()
+        .await?;
+    let properties = fdo::PropertiesProxy::builder(system)
+        .destination(proxy.inner().destination().clone())?
+        .path(proxy.inner().path().clone())?
+        .build()
+        .await?;
+    let mut owners = proxy.inner().receive_owner_changed().await?;
+    let mut profiles = properties
+        .receive_properties_changed_with_args(&[(0, proxy.inner().interface().as_str())])
+        .await?;
+    spawn(async move {
+        loop {
+            let refresh_available = select! {
+                Some(owner) = owners.next() => {
+                    if owner.is_none() {
+                        let values = HashMap::from([(
+                            "AvailablePerformanceProfiles",
+                            zvariant::Value::from(Vec::<String>::new()),
+                        )]);
+                        let invalidated = ["PerformanceProfile"].as_slice().into();
+                        if let Err(error) = fdo::Properties::properties_changed(
+                            interface.signal_emitter(), PerformanceProfile1::name(), values, invalidated,
+                        ).await {
+                            debug!("Could not report the PowerProfiles service stopping: {error}");
+                        }
+                        continue;
+                    }
+                    true
+                },
+                Some(signal) = profiles.next() => {
+                    let Ok(data) = signal.args() else { continue; };
+                    let changed = |name: &str| data.changed_properties().contains_key(name)
+                        || data.invalidated_properties().contains(&name);
+                    if !changed("Profiles") && !changed("ActiveProfile") {
+                        continue;
+                    }
+                    changed("Profiles")
+                },
+                else => break,
+            };
+            let profile = interface.get().await;
+            let emitter = interface.signal_emitter();
+            if refresh_available
+                && let Err(error) = profile
+                    .available_performance_profiles_changed(emitter)
+                    .await
+            {
+                debug!("Could not update the available power profiles: {error}");
+            }
+            if let Err(error) = profile.performance_profile_changed(emitter).await {
+                debug!("Could not update the active power profile: {error}");
+            }
+        }
+    });
+    Ok(())
+}
