+int choose_frame_duration(const ControlInfoMap &controls, spa_fraction fps,
+		std::optional<int64_t> &duration, spa_fraction &period)
+{
+	const auto it = controls.find(&libcamera::controls::FrameDurationLimits);
+	duration.reset();
+	period = {};
+
+	/* An unconstrained or unknown interval is not a fixed capture rate. */
+	if (it == controls.end())
+		return 0;
+
+	const auto &info = it->second;
+	const int64_t minimum = info.min().get<int64_t>();
+	const int64_t maximum = info.max().get<int64_t>();
+	if (minimum <= 0 || maximum < minimum)
+		return 0;
+
+	if (!fps.num) {
+		if (minimum == maximum && maximum <= UINT32_MAX) {
+			period = SPA_FRACTION(uint32_t(maximum), 1'000'000u);
+			/* Retain a whole fps when it produced the same rounded period. */
+			const uint32_t whole_fps = (1'000'000ull + maximum / 2) / maximum;
+			if (whole_fps &&
+			    int64_t((1'000'000ull + whole_fps / 2) / whole_fps) == maximum)
+				period = SPA_FRACTION(1u, whole_fps);
+		}
+	} else {
+		if (!fps.denom)
+			return -EINVAL;
+		/* FrameDurationLimits uses integer microseconds. */
+		const int64_t requested = (1'000'000ull * fps.denom + fps.num / 2) / fps.num;
+		if (!requested || requested < minimum || requested > maximum)
+			return -ERANGE;
+		duration = requested;
+		period = SPA_FRACTION(fps.denom, fps.num);
+	}
+
+	if (period.num) {
+		const uint32_t divisor = std::gcd(period.num, period.denom);
+		period.num /= divisor;
+		period.denom /= divisor;
 	}
+	return 0;
+}
 
