+bool same_video_mode(const spa_video_info &a, const spa_video_info &b)
+{
+	const video_mode lhs = get_video_mode(a), rhs = get_video_mode(b);
+	return a.media_subtype == b.media_subtype &&
+		lhs.format == rhs.format &&
+		lhs.size.width == rhs.size.width && lhs.size.height == rhs.size.height;
+}
+
+bool same_framerate(spa_fraction a, spa_fraction b)
+{
+	if (!a.num || !b.num)
+		return !a.num && !b.num;
+	return uint64_t(a.num) * b.denom == uint64_t(b.num) * a.denom;
+}
