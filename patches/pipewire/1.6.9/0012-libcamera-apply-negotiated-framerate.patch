+void update_capture_clock(spa_io_clock &clock, spa_dll &dll, spa_fraction period,
+			  std::optional<uint64_t> &origin, uint64_t &last_timestamp,
+			  const FrameMetadata &frame)
+{
+	if (!frame.timestamp)
+		return;
+
+	clock.nsec = frame.timestamp;
+	clock.delay = 0;
+	if (period.num && period.denom) {
+		double seconds = double(period.num) / period.denom;
+		double corr = 1.0;
+
+		if (dll.bw == 0.0) {
+			spa_dll_set_bw(&dll, SPA_DLL_BW_MAX, period.num, period.denom);
+			clock.next_nsec = frame.timestamp;
+		} else {
+			double diff = (double(clock.next_nsec) - double(frame.timestamp))
+					/ SPA_NSEC_PER_SEC;
+			double error = period.denom * (diff - seconds);
+			corr = spa_dll_update(&dll, SPA_CLAMPD(error, -128., 128.));
+		}
+
+		/* The graph counts samples at the denominator's frequency. */
+		clock.target_rate = clock.rate = SPA_FRACTION(1u, period.denom);
+		clock.target_duration = clock.duration = period.num;
+		clock.position = uint64_t(frame.sequence) * period.num;
+		clock.rate_diff = corr;
+		clock.next_nsec += uint64_t(seconds * SPA_NSEC_PER_SEC * corr);
+	} else {
+		/* An unknown frame rate still has a monotonic timestamp clock. */
+		const uint64_t nsec = frame.timestamp;
+		uint64_t elapsed = 0;
+		if (!origin || nsec < last_timestamp)
+			origin = nsec;
+		else
+			elapsed = nsec - last_timestamp;
+		last_timestamp = nsec;
+
+		clock.target_rate = clock.rate = SPA_FRACTION(1u, SPA_NSEC_PER_SEC);
+		clock.target_duration = clock.duration = std::max<uint64_t>(elapsed, 1);
+		clock.position = nsec - *origin;
+		clock.rate_diff = 1.0;
+		clock.next_nsec = nsec + elapsed;
+	}
+}
