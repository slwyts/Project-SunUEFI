+void update_video_modifier(spa_video_info_raw &format, const PixelFormat &pixel)
+{
+	format.modifier = pixel.modifier();
+	format.flags |= SPA_VIDEO_FLAG_MODIFIER;
+	format.flags &= ~SPA_VIDEO_FLAG_MODIFIER_FIXATION_REQUIRED;
+}
+
+bool update_video_mode(spa_video_info &format, const StreamConfiguration &config)
+{
+	const auto *info = video_format_to_info(config.pixelFormat);
+	if (!info || info->media_type != format.media_type ||
+	    info->media_subtype != format.media_subtype)
+		return false;
+
+	const auto size = SPA_RECTANGLE(config.size.width, config.size.height);
+	switch (format.media_subtype) {
+	case SPA_MEDIA_SUBTYPE_raw:
+		format.info.raw.format = info->format;
+		format.info.raw.size = size;
+		break;
+	case SPA_MEDIA_SUBTYPE_mjpg:
+		format.info.mjpg.size = size;
+		break;
+	case SPA_MEDIA_SUBTYPE_h264:
+		format.info.h264.size = size;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
