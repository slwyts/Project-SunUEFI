Subject: [PATCH] spa: libcamera: Honour the negotiated capture format

CameraConfiguration::validate() may adjust the pixel format or size.
Reporting the requested fields after that adjustment gives the client a
format different from the buffers returned by the camera.

Reject changes to an exact request. When NEAREST permits an adjustment
within the same media subtype, signal the change and return the accepted
format so the video adapter can negotiate with the actual buffer layout.

diff --git a/spa/plugins/libcamera/libcamera-source.cpp b/spa/plugins/libcamera/libcamera-source.cpp
--- a/spa/plugins/libcamera/libcamera-source.cpp
+++ b/spa/plugins/libcamera/libcamera-source.cpp
@@ -718,6 +718,31 @@
 		lhs.size.width == rhs.size.width && lhs.size.height == rhs.size.height;
 }
 
+bool update_video_mode(spa_video_info &format, const StreamConfiguration &config)
+{
+	const auto *info = video_format_to_info(config.pixelFormat);
+	if (!info || info->media_type != format.media_type ||
+	    info->media_subtype != format.media_subtype)
+		return false;
+
+	const auto size = SPA_RECTANGLE(config.size.width, config.size.height);
+	switch (format.media_subtype) {
+	case SPA_MEDIA_SUBTYPE_raw:
+		format.info.raw.format = info->format;
+		format.info.raw.size = size;
+		break;
+	case SPA_MEDIA_SUBTYPE_mjpg:
+		format.info.mjpg.size = size;
+		break;
+	case SPA_MEDIA_SUBTYPE_h264:
+		format.info.h264.size = size;
+		break;
+	default:
+		return false;
+	}
+	return true;
+}
+
 bool same_framerate(spa_fraction a, spa_fraction b)
 {
 	if (!a.num || !b.num)
@@ -771,7 +796,7 @@
 }
 
 int spa_libcamera_set_format(struct impl *impl, struct port *port,
-		const spa_video_info &format, bool try_only)
+		spa_video_info &format, uint32_t flags)
 {
 	const video_mode mode = get_video_mode(format);
 	const auto *info = find_format_info_by_media_type(format.media_type,
@@ -787,25 +812,36 @@
 	auto config = impl->camera->generateConfiguration({ StreamRole::VideoRecording });
 	if (!config)
 		return -EINVAL;
+	const Size requestedSize(mode.size.width, mode.size.height);
 	auto &streamConfig = config->at(0);
 
 	streamConfig.pixelFormat = info->pix;
-	streamConfig.size.width = mode.size.width;
-	streamConfig.size.height = mode.size.height;
+	streamConfig.size = requestedSize;
 	streamConfig.bufferCount = 8;
 
 	const auto validation = config->validate();
 	if (validation == CameraConfiguration::Invalid)
 		return -EINVAL;
 
+	const auto &validated = config->at(0);
+	spa_video_info accepted = format;
+	const bool adjusted = validated.pixelFormat != info->pix || validated.size != requestedSize;
+	/* Changes to stride, color space or buffer count do not change the mode. */
+	if (adjusted && (!SPA_FLAG_IS_SET(flags, SPA_NODE_PARAM_FLAG_NEAREST) ||
+			 !update_video_mode(accepted, validated)))
+		return -EINVAL;
+
 	std::optional<int64_t> duration;
 	spa_fraction period;
-	if (try_only) {
-		if (port->current_format && same_video_mode(*port->current_format, format))
-			return choose_frame_duration(impl->camera->controls(), mode.framerate,
-						     duration, period);
+	if (SPA_FLAG_IS_SET(flags, SPA_NODE_PARAM_FLAG_TEST_ONLY)) {
+		if (port->current_format && same_video_mode(*port->current_format, accepted)) {
+			int res = choose_frame_duration(impl->camera->controls(), mode.framerate,
+							duration, period);
+			if (res < 0)
+				return res;
+		}
 		/* Mode-specific controls may not be known until configure(). */
-		return 0;
+		return adjusted;
 	}
 
 	int res;
@@ -839,7 +875,8 @@
 		SPA_PORT_FLAG_TERMINAL;
 	port->info.rate = period;
 
-	return 0;
+	format = accepted;
+	return adjusted;
 error:
 	spa_libcamera_close(impl);
 	return res;
@@ -1987,7 +2024,7 @@
 {
 	const bool try_only = SPA_FLAG_IS_SET(flags, SPA_NODE_PARAM_FLAG_TEST_ONLY);
 	spa_video_info info;
-	int res;
+	int res = 0;
 
 	if (format != nullptr) {
 		spa_zero(info);
@@ -2034,13 +2071,13 @@
 			return !requested.num || same_framerate(requested, current) ? 0 : -EBUSY;
 		}
 
-		res = spa_libcamera_set_format(impl, port, info, true);
+		res = spa_libcamera_set_format(impl, port, info, flags | SPA_NODE_PARAM_FLAG_TEST_ONLY);
 		if (res < 0)
 			return res;
 	}
 
 	if (try_only)
-		return 0;
+		return res;
 
 	spa_libcamera_stream_off(impl);
 	spa_libcamera_clear_buffers(port);
@@ -2054,7 +2091,7 @@
 	if (format == nullptr) {
 		spa_libcamera_close(impl);
 	} else {
-		res = spa_libcamera_set_format(impl, port, info, false);
+		res = spa_libcamera_set_format(impl, port, info, flags);
 		if (res >= 0)
 			port->current_format = info;
 	}
