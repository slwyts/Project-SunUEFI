 }
 
+/* Return 1 when the node needs to fixate the modifier in its reply. */
+int match_video_modifier(const spa_pod_prop *prop, const PixelFormat &pixel)
+{
+	if (!prop)
+		return 0;
+
+	uint32_t count, choice;
+	const auto *values = spa_pod_get_values(&prop->value, &count, &choice);
+	const int64_t modifier = pixel.modifier();
+	if (values->type != SPA_TYPE_Long || values->size != sizeof(modifier) || !count ||
+	    (choice != SPA_CHOICE_None && choice != SPA_CHOICE_Enum) ||
+	    !spa_pod_compare_is_valid_choice(values->type, values->size, &modifier,
+					     SPA_POD_BODY_CONST(values), count, choice))
+		return -EINVAL;
+
+	return choice == SPA_CHOICE_Enum ||
+		SPA_FLAG_IS_SET(prop->flags, SPA_POD_PROP_FLAG_DONT_FIXATE);
+}
