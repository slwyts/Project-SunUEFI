+fn expect_call(calls: &mpsc::Receiver<Call>, name: &'static str, claim: bool) -> String {
+    let (provider, requested, client) = calls.recv_timeout(TIMEOUT).unwrap();
+    assert_eq!((provider, requested), (name, claim));
+    client
+}
+
+fn expect_orientation(source: &Channel<Orientation>, expected: Orientation) {
+    let deadline = Instant::now() + TIMEOUT;
+    while Instant::now() < deadline {
+        if let Ok(value) = source.try_recv() {
+            if value != Orientation::Undefined || expected == Orientation::Undefined {
+                assert_eq!(value, expected);
+                return;
+            }
+        }
+        thread::sleep(Duration::from_millis(5));
+    }
+    panic!("expected the provider to report {expected:?}");
+}
+
+struct Monitor {
+    client: Connection,
+    source: Channel<Orientation>,
+    demand: Arc<Demand>,
+    worker: JoinHandle<()>,
+    done: mpsc::Receiver<zbus::Result<MonitorResult>>,
+}
+
+impl Monitor {
+    fn start(bus: &TestBus) -> Self {
+        Self::with_claim_timeout(bus, TIMEOUT)
+    }
+
+    fn with_claim_timeout(bus: &TestBus, timeout: Duration) -> Self {
+        let client = bus.connection().build().unwrap();
+        let (events, source) = channel();
+        let demand = Arc::new(Demand::new(true).unwrap());
+        let (finished, done) = mpsc::channel();
+        let worker_demand = Arc::clone(&demand);
+        let worker_client = client.clone();
+        let address = bus.address.clone();
+        let worker = thread::spawn(move || {
+            let connect = || {
+                Builder::address(address.trim())?
+                    .method_timeout(timeout)
+                    .build()
+            };
+            let result =
+                monitor_connection(&worker_client, &events, &mut None, &worker_demand, connect);
+            let _ = finished.send(result);
+        });
+        Self {
+            client,
+            source,
+            demand,
+            worker,
+            done,
+        }
+    }
+
+    fn set_wanted(&self, wanted: bool) {
+        self.demand.set_wanted(wanted);
+    }
+
+    fn stop(self) {
+        self.demand.stop();
+        assert!(matches!(
+            self.done.recv_timeout(TIMEOUT),
+            Ok(Ok(MonitorResult::Closed))
+        ));
+        assert!(!self.client.inner().is_closed());
+        self.worker.join().unwrap();
+    }
+}
