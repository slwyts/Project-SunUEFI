+    fn expect_disconnected(&self, owner: &str, deadline: Duration) {
+        let connection = self.connection().build().unwrap();
+        let dbus = DBusProxy::new(&connection).unwrap();
+        let start = Instant::now();
+        while start.elapsed() < deadline {
+            if !dbus
+                .name_has_owner(BusName::try_from(owner).unwrap())
+                .unwrap()
