+struct Fixture {
+    name: &'static str,
+    present: bool,
+    reading: &'static str,
+    claims: Claims,
+    calls: mpsc::Sender<Call>,
+    claim_reply_delay: Duration,
+    deny_release: bool,
+}
+
+impl Fixture {
+    fn new(
+        name: &'static str,
+        present: bool,
+        reading: &'static str,
+        calls: &mpsc::Sender<Call>,
+        bus: &TestBus,
+    ) -> Self {
+        Self {
+            name,
+            present,
+            reading,
+            claims: Arc::clone(&bus.claims),
+            calls: calls.clone(),
+            claim_reply_delay: Duration::ZERO,
+            deny_release: false,
+        }
+    }
+
+    async fn claim(&self, claim: bool, header: Header<'_>) -> fdo::Result<()> {
+        let client = header.sender().unwrap().as_str().to_owned();
+        let key = (self.name, client.clone());
+        let valid = if claim {
+            self.present && self.claims.lock().unwrap().insert(key)
+        } else if self.deny_release {
+            self.calls.send((self.name, false, client)).unwrap();
+            return Err(fdo::Error::AccessDenied("session is inactive".to_owned()));
+        } else {
+            self.claims.lock().unwrap().remove(&key)
+        };
+        self.calls.send((self.name, claim, client)).unwrap();
+        if !valid {
+            return Err(fdo::Error::Failed("invalid claim transition".to_owned()));
+        }
+        if claim && self.claim_reply_delay != Duration::ZERO {
+            async_io::Timer::after(self.claim_reply_delay).await;
+        }
+        Ok(())
+    }
+}
