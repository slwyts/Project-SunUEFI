+        BufReader::new(bus.process.stdout.take().unwrap())
+            .read_line(&mut bus.address)
+            .unwrap();
+        assert!(!bus.address.is_empty(), "D-Bus did not report an address");
+        let connection = bus.connection().build().unwrap();
+        let claims = Arc::clone(&bus.claims);
+        let (ready, waiting) = mpsc::channel();
+        bus.watcher = Some(thread::spawn(move || {
+            let dbus = DBusProxy::new(&connection).unwrap();
+            let owners = dbus.receive_name_owner_changed().unwrap();
+            ready.send(()).unwrap();
+            for change in owners {
+                let Ok(args) = change.args() else { continue };
+                if args.name().as_str().starts_with(':') && args.new_owner().is_none() {
+                    claims
+                        .lock()
+                        .unwrap()
+                        .retain(|(_, client)| client != args.name().as_str());
+                }
+            }
+        }));
+        waiting.recv_timeout(TIMEOUT).unwrap();
+        bus
