+#[test]
+fn follows_the_standard_sensor_and_releases_the_correct_provider() {
+    let bus = TestBus::start();
+    let (calls, observed_calls) = mpsc::channel();
+    let (standard_name, standard_path, _) = Backend::SensorProxy.endpoint();
+    let (steinerd_name, steinerd_path, _) = Backend::Steinerd.endpoint();
+    let original = bus
+        .connection()
+        .name(standard_name)
+        .unwrap()
+        .serve_at(
+            standard_path,
+            SensorProxyFixture(Fixture::new("standard", false, "left-up", &calls, &bus)),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    let _steinerd = bus
+        .connection()
+        .name(steinerd_name)
+        .unwrap()
+        .serve_at(
+            steinerd_path,
+            SteinerdFixture(Fixture::new("steinerd", true, "bottom-up", &calls, &bus)),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    let monitor = Monitor::start(&bus);
+
+    let fallback = expect_call(&observed_calls, "steinerd", true);
+    expect_orientation(&monitor.source, Orientation::BottomUp);
+    let old_sensor = original
+        .object_server()
+        .interface::<_, SensorProxyFixture>(standard_path)
+        .unwrap();
+    {
+        let mut sensor = old_sensor.get_mut();
+        sensor.0.present = true;
+        async_io::block_on(sensor.has_accelerometer_changed(old_sensor.signal_emitter())).unwrap();
+    }
+    assert_eq!(expect_call(&observed_calls, "steinerd", false), fallback);
+    bus.expect_disconnected(&fallback, TIMEOUT);
+    let first = expect_call(&observed_calls, "standard", true);
+    expect_orientation(&monitor.source, Orientation::LeftUp);
+
+    {
+        let mut sensor = old_sensor.get_mut();
+        sensor.0.reading = "right-up";
+        async_io::block_on(sensor.accelerometer_orientation_changed(old_sensor.signal_emitter()))
+            .unwrap();
+    }
+    expect_orientation(&monitor.source, Orientation::RightUp);
+
+    monitor.set_wanted(false);
+    assert_eq!(expect_call(&observed_calls, "standard", false), first);
+    bus.expect_disconnected(&first, TIMEOUT);
+    assert_eq!(
+        observed_calls.recv_timeout(Duration::from_millis(100)),
+        Err(mpsc::RecvTimeoutError::Timeout)
+    );
+    monitor.set_wanted(true);
+    let restored = expect_call(&observed_calls, "standard", true);
+    assert_ne!(restored, first);
+
+    // Keep the old unique owner alive after it gives up its well-known name.
+    // Only that connection can release its original claim.
+    assert!(original.release_name(standard_name).unwrap());
+    assert_eq!(expect_call(&observed_calls, "standard", false), restored);
+    bus.expect_disconnected(&restored, TIMEOUT);
+    let fallback = expect_call(&observed_calls, "steinerd", true);
+    expect_orientation(&monitor.source, Orientation::BottomUp);
+    let replacement = bus
+        .connection()
+        .name(standard_name)
+        .unwrap()
+        .serve_at(
+            standard_path,
+            SensorProxyFixture(Fixture::new("replacement", true, "normal", &calls, &bus)),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    assert_eq!(expect_call(&observed_calls, "steinerd", false), fallback);
+    let last = expect_call(&observed_calls, "replacement", true);
+    expect_orientation(&monitor.source, Orientation::Normal);
+
+    monitor.stop();
+    assert_eq!(expect_call(&observed_calls, "replacement", false), last);
+    bus.expect_disconnected(&last, TIMEOUT);
+    drop(replacement);
+}
