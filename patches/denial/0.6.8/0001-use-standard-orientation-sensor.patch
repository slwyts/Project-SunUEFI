+                "/net/hadess/SensorProxy",
+                "net.hadess.SensorProxy",
+            ),
+            Self::Steinerd => ("org.steinerd", "/org/steinerd", "org.steinerd.Sensors1"),
+        }
+    }
+
+    const fn capability(self) -> &'static str {
+        match self {
+            Self::SensorProxy => "HasAccelerometer",
+            Self::Steinerd => "HasOrientation",
+        }
+    }
+
+    const fn reading(self) -> &'static str {
+        match self {
+            Self::SensorProxy => "AccelerometerOrientation",
+            Self::Steinerd => "Orientation",
+        }
+    }
+
+    fn properties(self, connection: &Connection) -> zbus::Result<PropertiesProxy<'static>> {
+        let (service, path, _) = self.endpoint();
+        future::block_on(
+            PropertiesProxy::builder(connection.inner())
+                .destination(service)?
+                .path(path)?
+                .build(),
+        )
+    }
+
+    fn available(self, properties: &PropertiesProxy<'_>) -> bool {
+        let (_, _, interface) = self.endpoint();
+        let interface = InterfaceName::from_static_str_unchecked(interface);
+        // A provider may be absent on first use. Don't retain the result of
+        // zbus's one-time GetAll cache initialization across owner changes.
+        future::block_on(properties.get(interface, self.capability()))
+            .ok()
+            .and_then(|value| bool::try_from(value).ok())
+            .unwrap_or(false)
+    }
+
+    fn set_claimed(self, proxy: &Proxy<'_>, claim: bool) -> zbus::Result<()> {
+        match (self, claim) {
+            (Self::SensorProxy, true) => proxy.call("ClaimAccelerometer", &()),
+            (Self::SensorProxy, false) => proxy.call("ReleaseAccelerometer", &()),
+            (Self::Steinerd, true) => proxy.call("Claim", &("orientation",)),
+            (Self::Steinerd, false) => proxy.call("Release", &("orientation",)),
+        }
+    }
+}
