+impl TestBus {
+    fn start() -> Self {
+        let process = Command::new("dbus-daemon")
+            .args(["--session", "--nofork", "--nopidfile", "--print-address=1"])
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("start an isolated D-Bus");
+        let mut bus = Self {
+            process,
+            address: String::new(),
+            claims: Claims::default(),
+            watcher: None,
