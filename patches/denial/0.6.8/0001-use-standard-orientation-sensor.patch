+#[test]
+fn cleans_up_a_claim_when_the_service_denies_release() {
+    let bus = TestBus::start();
+    let (calls, observed_calls) = mpsc::channel();
+    let mut fixture = Fixture::new("standard", true, "normal", &calls, &bus);
+    fixture.deny_release = true;
+    let _service = start_sensor_proxy(&bus, fixture);
+    let monitor = Monitor::start(&bus);
+
+    let client = expect_call(&observed_calls, "standard", true);
+    expect_orientation(&monitor.source, Orientation::Normal);
+    monitor.set_wanted(false);
+    assert_eq!(expect_call(&observed_calls, "standard", false), client);
+    bus.expect_disconnected(&client, TIMEOUT);
+
+    monitor.set_wanted(true);
+    let next = expect_call(&observed_calls, "standard", true);
+    assert_ne!(next, client);
+    monitor.stop();
+    bus.expect_disconnected(&next, TIMEOUT);
+}
