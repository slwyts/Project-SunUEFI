+        }
+        panic!("orientation claim from {owner} was not cleaned up");
+    }
+}
+
+impl Drop for TestBus {
+    fn drop(&mut self) {
+        let _ = self.process.kill();
+        let _ = self.process.wait();
+        if let Some(watcher) = self.watcher.take() {
+            watcher.join().unwrap();
+        }
+    }
+}
