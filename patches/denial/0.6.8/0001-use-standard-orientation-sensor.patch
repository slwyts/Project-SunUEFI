+use super::*;
+use std::io::{BufRead, BufReader};
+use std::process::{Child, Command, Stdio};
+use std::sync::mpsc;
+use std::time::Instant;
+use zbus::blocking::connection::Builder;
+use zbus::fdo;
+
+const TIMEOUT: Duration = Duration::from_secs(4);
+type Call = (&'static str, bool);
+
+struct TestBus {
+    process: Child,
+    address: String,
+}
+
+impl TestBus {
+    fn start() -> Self {
+        let process = Command::new("dbus-daemon")
+            .args(["--session", "--nofork", "--nopidfile", "--print-address=1"])
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("start an isolated D-Bus");
+        let mut bus = Self {
+            process,
+            address: String::new(),
+        };
+        BufReader::new(bus.process.stdout.take().unwrap())
+            .read_line(&mut bus.address)
+            .unwrap();
+        assert!(!bus.address.is_empty(), "D-Bus did not report an address");
+        bus
+    }
+
+    fn connection(&self) -> Builder<'_> {
+        Builder::address(self.address.trim())
+            .unwrap()
+            .method_timeout(TIMEOUT)
+    }
+}
+
+impl Drop for TestBus {
+    fn drop(&mut self) {
+        let _ = self.process.kill();
+        let _ = self.process.wait();
+    }
+}
+
+struct Fixture {
+    name: &'static str,
+    present: bool,
+    reading: &'static str,
+    claimed: bool,
+    calls: mpsc::Sender<Call>,
+}
+
+impl Fixture {
+    fn new(
+        name: &'static str,
+        present: bool,
+        reading: &'static str,
+        calls: &mpsc::Sender<Call>,
+    ) -> Self {
+        Self {
+            name,
+            present,
+            reading,
+            claimed: false,
+            calls: calls.clone(),
+        }
+    }
+
+    fn claim(&mut self, claim: bool) -> fdo::Result<()> {
+        self.calls.send((self.name, claim)).unwrap();
+        if self.claimed == claim || (claim && !self.present) {
+            return Err(fdo::Error::Failed("invalid claim transition".to_owned()));
+        }
+        self.claimed = claim;
+        Ok(())
+    }
+}
