+        Err(mpsc::RecvTimeoutError::Timeout)
+    );
+    monitor.set_wanted(true);
+    expect_call(&observed_calls, "standard", true);
+
+    // Keep the old unique owner alive after it gives up its well-known name.
+    // Only that connection can release its original claim.
+    assert!(original.release_name(standard_name).unwrap());
+    expect_call(&observed_calls, "standard", false);
+    expect_call(&observed_calls, "steinerd", true);
+    expect_orientation(&monitor.source, Orientation::BottomUp);
+    let replacement = bus
+        .connection()
+        .name(standard_name)
+        .unwrap()
+        .serve_at(
+            standard_path,
+            SensorProxyFixture(Fixture::new("replacement", true, "normal", &calls)),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    expect_call(&observed_calls, "steinerd", false);
+    expect_call(&observed_calls, "replacement", true);
+    expect_orientation(&monitor.source, Orientation::Normal);
+
+    monitor.stop();
+    drop(replacement);
+}
+
+#[test]
+fn claims_sensorproxy_when_service_starts_after_the_desktop() {
+    let bus = TestBus::start();
+    let monitor = Monitor::start(&bus);
+    expect_orientation(&monitor.source, Orientation::Undefined);
+
+    let (calls, observed_calls) = mpsc::channel();
+    let (name, path, _) = Backend::SensorProxy.endpoint();
+    let _service = bus
+        .connection()
+        .name(name)
+        .unwrap()
+        .serve_at(
+            path,
+            SensorProxyFixture(Fixture::new("standard", true, "normal", &calls)),
+        )
+        .unwrap()
+        .build()
+        .unwrap();
+    expect_call(&observed_calls, "standard", true);
+    expect_orientation(&monitor.source, Orientation::Normal);
+    monitor.stop();
+}
