 struct bt_hog {
 	int			ref_count;
@@ -1336,6 +1337,55 @@ static void discovery_idle(void *user_data)
 	create_uhid(hog);
 }
 
+static void find_pnp_id(struct gatt_db_attribute *attr, void *user_data)
+{
+	uint16_t *handle = user_data;
+	bt_uuid_t uuid, device_info;
+
+	if (*handle || !gatt_db_attribute_get_service_data(attr, NULL, NULL,
+								NULL, &uuid))
+		return;
+
+	bt_string_to_uuid(&device_info, DEVICE_INFORMATION_UUID);
+
+	if (!bt_uuid_cmp(&uuid, &device_info))
+		*handle = gatt_db_attribute_get_handle(attr);
+}
+
+static void pnp_id_read_cb(bool success, uint8_t att_ecode,
+					const uint8_t *value, uint16_t length,
+					void *user_data)
+{
+	struct bt_hog *hog = user_data;
+
+	if (!success) {
+		DBG(hog, "PnP ID read failed: 0x%02x", att_ecode);
+		return;
+	}
+
+	if (length != PNP_ID_SIZE) {
+		DBG(hog, "Malformed PnP ID: length %u", length);
+		return;
+	}
+
+	hog->vendor = get_le16(&value[1]);
+	hog->product = get_le16(&value[3]);
+	hog->version = get_le16(&value[5]);
+}
+
+static void read_pnp_id(struct bt_hog *hog)
+{
+	uint16_t handle = 0;
+	bt_uuid_t uuid;
+
+	bt_string_to_uuid(&uuid, PNPID_UUID);
+	gatt_db_find_by_type(hog->db, 0x0001, 0xffff, &uuid, find_pnp_id,
+								&handle);
+
+	if (handle)
+		read_char(hog, handle, false, pnp_id_read_cb, hog);
+}
+
 bool bt_hog_attach(struct bt_hog *hog, struct bt_gatt_client *client)
 {
 	const struct queue_entry *entry;
@@ -1365,6 +1415,13 @@ bool bt_hog_attach(struct bt_hog *hog, struct bt_gatt_client *client)
 	if (created)
 		uhid_register(hog);
 
+	/*
+	 * DeviceInfo may not have read the peer's identity yet. Read it on
+	 * this client so UHID creation waits for the result.
+	 */
+	if (!created && !hog->vendor && !hog->product)
+		read_pnp_id(hog);
+
 	DBG(hog, "HoG discovering characteristics");
 	gatt_db_service_foreach_char(hog->attr, foreach_hog_chrc, hog);
 
