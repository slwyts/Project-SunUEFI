+static void add_pnp_id(struct bt_gatt_client *client)
+{
+	struct gatt_db *db = bt_gatt_client_get_db(client);
+	struct gatt_db_attribute *service, *attr;
+	bt_uuid_t uuid;
+
+	bt_string_to_uuid(&uuid, DEVICE_INFORMATION_UUID);
+	service = gatt_db_add_service(db, &uuid, true, 3);
+	g_assert(service);
+
+	bt_string_to_uuid(&uuid, PNPID_UUID);
+	attr = gatt_db_service_add_characteristic(service, &uuid,
+						BT_ATT_PERM_READ,
+						BT_GATT_CHRC_PROP_READ,
+						NULL, NULL, NULL);
+	g_assert(attr);
+	g_assert_cmpuint(gatt_db_attribute_get_handle(attr), ==, PNP_ID_HANDLE);
+	g_assert(gatt_db_service_set_active(service, true));
+}
