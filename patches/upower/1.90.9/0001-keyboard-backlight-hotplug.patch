Subject: [PATCH] keyboard: rescan LED backlights after hotplug

Keep the legacy keyboard D-Bus object exported while no keyboard is present.
Monitor standard LED add/remove events, close obsolete descriptors and publish
the new range and brightness through the existing UPower signals. This lets
GNOME refresh detachable keyboards without restarting either daemon.

---
--- a/src/up-kbd-backlight.c
+++ b/src/up-kbd-backlight.c
@@ -32,6 +32,9 @@
 #include <string.h>
 #include <dirent.h>
 #include <errno.h>
+#ifdef __linux__
+#include <gudev/gudev.h>
+#endif
 
 #include "up-kbd-backlight.h"
 #include "up-daemon.h"
@@ -45,6 +48,10 @@
 	gint			 fd_hw_changed;
 	GIOChannel		*channel_hw_changed;
 	gint			 max_brightness;
+	guint			 hw_changed_source;
+#ifdef __linux__
+	GUdevClient		*udev_client;
+#endif
 };
 
 G_DEFINE_TYPE_WITH_PRIVATE (UpKbdBacklight, up_kbd_backlight, UP_TYPE_EXPORTED_KBD_BACKLIGHT_SKELETON)
@@ -70,7 +77,8 @@
 	ssize_t len;
 	gint64 brightness = -1;
 
-	g_return_val_if_fail (fd >= 0, brightness);
+	if (fd < 0)
+		return -1;
 
 	lseek (fd, 0, SEEK_SET);
 	len = read (fd, buf, G_N_ELEMENTS (buf) - 1);
@@ -217,12 +225,16 @@
 	UpKbdBacklight *kbd_backlight = (UpKbdBacklight*) data;
 	gint brightness;
 
-	if (!(condition & G_IO_PRI))
+	if (!(condition & G_IO_PRI)) {
+		kbd_backlight->priv->hw_changed_source = 0;
 		return FALSE;
+	}
 
 	brightness = up_kbd_backlight_brightness_read (kbd_backlight, kbd_backlight->priv->fd_hw_changed);
-	if (brightness < 0 && errno == ENODEV)
+	if (brightness < 0 && errno == ENODEV) {
+		kbd_backlight->priv->hw_changed_source = 0;
 		return FALSE;
+	}
 
 	if (brightness >= 0)
 		up_kbd_backlight_emit_change (kbd_backlight, brightness, "internal");
@@ -230,6 +242,24 @@
 	return TRUE;
 }
 
+static void
+up_kbd_backlight_close (UpKbdBacklight *kbd_backlight)
+{
+	if (kbd_backlight->priv->hw_changed_source)
+		g_clear_handle_id (&kbd_backlight->priv->hw_changed_source, g_source_remove);
+	if (kbd_backlight->priv->channel_hw_changed) {
+		g_io_channel_shutdown (kbd_backlight->priv->channel_hw_changed, FALSE, NULL);
+		g_clear_pointer (&kbd_backlight->priv->channel_hw_changed, g_io_channel_unref);
+	}
+	if (kbd_backlight->priv->fd_hw_changed >= 0)
+		close (kbd_backlight->priv->fd_hw_changed);
+	if (kbd_backlight->priv->fd >= 0)
+		close (kbd_backlight->priv->fd);
+	kbd_backlight->priv->fd = -1;
+	kbd_backlight->priv->fd_hw_changed = -1;
+	kbd_backlight->priv->max_brightness = 0;
+}
+
 /**
  * up_kbd_backlight_find:
  **/
@@ -238,7 +268,7 @@
 {
 	gboolean ret;
 	gboolean found = FALSE;
-	GDir *dir;
+	GDir *dir = NULL;
 	const gchar *filename;
 	gchar *end = NULL;
 	gchar *dir_path = NULL;
