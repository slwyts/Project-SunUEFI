@@ -299,7 +329,7 @@
 	kbd_backlight->priv->fd_hw_changed = open (path_hw_changed, O_RDONLY);
 	if (kbd_backlight->priv->fd_hw_changed >= 0) {
 		kbd_backlight->priv->channel_hw_changed = g_io_channel_unix_new (kbd_backlight->priv->fd_hw_changed);
-		g_io_add_watch (kbd_backlight->priv->channel_hw_changed,
+		kbd_backlight->priv->hw_changed_source = g_io_add_watch (kbd_backlight->priv->channel_hw_changed,
 				G_IO_PRI, up_kbd_backlight_event_io, kbd_backlight);
 	}
 
@@ -314,9 +344,28 @@
 	g_free (path_hw_changed);
 	g_free (buf_max);
 	g_free (buf_now);
+	if (!found)
+		up_kbd_backlight_close (kbd_backlight);
 	return found;
 }
 
+#ifdef __linux__
+static void
+up_kbd_backlight_uevent (GUdevClient *client, const gchar *action,
+			 GUdevDevice *device, UpKbdBacklight *kbd_backlight)
+{
+	const gchar *name = g_udev_device_get_name (device);
+	int brightness;
+
+	if (!name || !strstr (name, "kbd_backlight") ||
+	    (g_strcmp0 (action, "add") != 0 && g_strcmp0 (action, "remove") != 0))
+		return;
+	up_kbd_backlight_find (kbd_backlight);
+	brightness = up_kbd_backlight_brightness_read (kbd_backlight, kbd_backlight->priv->fd);
+	up_kbd_backlight_emit_change (kbd_backlight, brightness, "hotplug");
+}
+#endif
+
 /**
  * up_kbd_backlight_init:
  **/
@@ -324,6 +373,13 @@
 up_kbd_backlight_init (UpKbdBacklight *kbd_backlight)
 {
 	kbd_backlight->priv = up_kbd_backlight_get_instance_private (kbd_backlight);
+	kbd_backlight->priv->fd = -1;
+	kbd_backlight->priv->fd_hw_changed = -1;
+#ifdef __linux__
+	kbd_backlight->priv->udev_client = g_udev_client_new ((const gchar *[]) { "leds", NULL });
+	g_signal_connect (kbd_backlight->priv->udev_client, "uevent",
+			  G_CALLBACK (up_kbd_backlight_uevent), kbd_backlight);
+#endif
 
 	g_signal_connect (kbd_backlight, "handle-get-brightness",
 			  G_CALLBACK (up_kbd_backlight_get_brightness), kbd_backlight);
@@ -347,17 +403,10 @@
 	kbd_backlight = UP_KBD_BACKLIGHT (object);
 	kbd_backlight->priv = up_kbd_backlight_get_instance_private (kbd_backlight);
 
-	if (kbd_backlight->priv->channel_hw_changed) {
