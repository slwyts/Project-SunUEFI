From: slwyts <slwyts@foxmail.com>
Subject: [PATCH] backends/drm: reapply hardware brightness when leaving HDR

Internal displays use maximum hardware brightness in HDR while the output
tracks the user's brightness in software. After disabling HDR, that cached
value can still match the next frame's brightness, so updateBrightness()
returns without restoring the backlight.

Invalidate the cached value on the transition to SDR. The next presented
frame then applies the requested brightness through the existing device.

---
 src/backends/drm/drm_output.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/backends/drm/drm_output.cpp b/src/backends/drm/drm_output.cpp
--- a/src/backends/drm/drm_output.cpp
+++ b/src/backends/drm/drm_output.cpp
@@ -523,7 +523,13 @@ bool DrmOutput::queueChanges(const std::shared_ptr<OutputChangeSet> &props)
     m_nextState->dimming = props->dimming.value_or(m_state.dimming);
     m_nextState->brightnessDevice = props->brightnessDevice.value_or(m_state.brightnessDevice);
     if (!m_nextState->highDynamicRange && m_nextState->brightnessDevice) {
-        m_nextState->currentBrightness = props->currentHardwareBrightness.has_value() ? props->currentHardwareBrightness : m_state.currentBrightness;
+        if (m_state.highDynamicRange) {
+            // HDR brightness is applied in software; the hardware must be
+            // updated even when the requested brightness has not changed.
+            m_nextState->currentBrightness.reset();
+        } else {
+            m_nextState->currentBrightness = props->currentHardwareBrightness.has_value() ? props->currentHardwareBrightness : m_state.currentBrightness;
+        }
     }
     m_nextState->uuid = props->uuid.value_or(m_state.uuid);
     m_nextState->replicationSource = props->replicationSource.value_or(m_state.replicationSource);
