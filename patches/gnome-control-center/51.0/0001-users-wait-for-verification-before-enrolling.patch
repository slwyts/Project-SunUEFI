     }
+
+    remove_dialog_state (self, DIALOG_STATE_DEVICE_VERIFY_STARTING);
+    start_pending_enrollment (self);
 }
 
 static void
@@ -523,6 +525,18 @@ identification_stop_cb (GObject *object, GAsyncResult *res, gpointer user_data)
 
     remove_dialog_state (self, DIALOG_STATE_DEVICE_VERIFYING | DIALOG_STATE_DEVICE_VERIFY_STOPPING);
 
+    if (self->pending_enroll_finger) {
+        g_autofree char *name = error ? g_dbus_error_get_remote_error (error) : NULL;
+
+        if (error && g_strcmp0 (name, CC_FPRINTD_NAME ".Error.NoActionInProgress") != 0) {
+            g_clear_pointer (&self->pending_enroll_finger, g_free);
+            report_enroll_start_error (self, fprintd_device, error);
+        } else {
+            start_pending_enrollment (self);
+        }
+        return;
+    }
+
     /* Resume identification if it is still appropriate (e.g. after a match). */
     maybe_start_identification (self);
 }
@@ -858,11 +872,27 @@ handle_enroll_signal (CcFingerprintDialog *self, const char *result, gboolean do
     handle_enroll_retry (self, result);
 }
 
+static void
+report_enroll_start_error (CcFingerprintDialog *self, CcFprintdDevice *device, GError *error)
+{
+    g_autofree char *error_message = NULL;
+
+    remove_dialog_state (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STARTING);
+
+    error_message = g_strdup_printf (_("Failed to start enrollment: %s"), dbus_error_to_human (self, error));
+    g_warning ("Enrollment on device %s failed: %s", cc_fprintd_device_get_name (device), error->message);
+    notify_error (self, error_message);
+
+    set_enroll_result_message (self, ENROLL_STATE_ERROR,
+                               C_("Fingerprint enroll state",
+                                "Failed to enroll new fingerprint"));
+    gtk_widget_set_sensitive (self->enrollment_view, FALSE);
+}
+
 static void
 enroll_start_cb (GObject *object, GAsyncResult *res, gpointer user_data)
 {
     g_autoptr(GError) error = NULL;
-    g_autoptr(DialogStateRemover) state_remover = NULL;
