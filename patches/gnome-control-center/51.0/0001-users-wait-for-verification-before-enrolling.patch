-        remove_dialog_state (self, DIALOG_STATE_DEVICE_ENROLLING);
-
-        error_message = g_strdup_printf (_("Failed to start enrollment: %s"), dbus_error_to_human (self, error));
-        g_warning ("Enrollment on device %s failed: %s", cc_fprintd_device_get_name (self->device), error->message);
-        notify_error (self, error_message);
-
-        set_enroll_result_message (self, ENROLL_STATE_ERROR,
-                                   C_("Fingerprint enroll state",
-                                    "Failed to enroll new fingerprint"));
-        gtk_widget_set_sensitive (self->enrollment_view, FALSE);
-
-        return;
-    }
+    if (error)
+        report_enroll_start_error (self, fprintd_device, error);
+    else
+        remove_dialog_state (self, DIALOG_STATE_DEVICE_ENROLL_STARTING);
 }
 
 static void
@@ -904,7 +920,8 @@ enroll_stop_cb (GObject *object, GAsyncResult *res, gpointer user_data)
     if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
         return;
 
-    state_remover = auto_state_remover (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STOPPING);
+    state_remover = auto_state_remover (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STOPPING
+                                             | DIALOG_STATE_DEVICE_ENROLL_STARTING);
     gtk_widget_set_sensitive (self->enrollment_view, TRUE);
     gtk_stack_set_visible_child (self->stack, self->prints_manager);
 
@@ -958,6 +975,26 @@ get_enrollment_string (CcFingerprintDialog *self, const char *finger_id)
     return g_strdup (_("Repeatedly lift and place your finger on the reader to enroll your fingerprint"));
 }
 
+static void
+start_pending_enrollment (CcFingerprintDialog *self)
+{
+    g_autofree char *finger_id = NULL;
+
+    if (!self->pending_enroll_finger || !(self->dialog_state & DIALOG_STATE_DEVICE_CLAIMED) ||
+        (self->dialog_state & (DIALOG_STATE_DEVICE_VERIFY_STARTING | DIALOG_STATE_DEVICE_VERIFY_STOPPING)))
+        return;
+
+    /* fprintd keeps the verification action until VerifyStop completes. */
+    if (self->dialog_state & DIALOG_STATE_DEVICE_VERIFYING) {
+        stop_identification (self);
+        return;
+    }
+
+    finger_id = g_steal_pointer (&self->pending_enroll_finger);
+    cc_fprintd_device_call_enroll_start (self->device, finger_id, G_DBUS_CALL_FLAGS_NONE, -1, self->cancellable,
+                                        enroll_start_cb, self);
+}
+
 static void
 enroll_finger (CcFingerprintDialog *self, const char *finger_id)
 {
@@ -968,6 +1005,7 @@ enroll_finger (CcFingerprintDialog *self, const char *finger_id)
     if (!add_dialog_state (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STARTING))
         return;
 
+    self->pending_enroll_finger = g_strdup (finger_id);
     self->enroll_progress = 0;
     self->enroll_stages_passed = 0;
 
@@ -980,10 +1018,7 @@ enroll_finger (CcFingerprintDialog *self, const char *finger_id)
     gtk_progress_bar_set_fraction (self->progress_bar, 0);
     adw_status_page_set_title (ADW_STATUS_PAGE (self->enrollment_view), enroll_message);
 
-    stop_identification (self);
-
-    cc_fprintd_device_call_enroll_start (self->device, finger_id, G_DBUS_CALL_FLAGS_NONE, -1, self->cancellable,
-                                         enroll_start_cb, self);
+    start_pending_enrollment (self);
 }
 
 static void
@@ -1098,8 +1133,12 @@ static void
 abort_operations_and_close (CcFingerprintDialog *self)
 {
     if (self->dialog_state & DIALOG_STATE_DEVICE_ENROLLING) {
-        g_debug ("Stopping enrollment due to screen lock");
-        cc_fprintd_device_call_enroll_stop_sync (self->device, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL);
+        if (self->pending_enroll_finger) {
+            g_clear_pointer (&self->pending_enroll_finger, g_free);
+        } else {
+            g_debug ("Stopping enrollment due to screen lock");
+            cc_fprintd_device_call_enroll_stop_sync (self->device, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL);
+        }
         remove_dialog_state (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STOPPING
                                        | DIALOG_STATE_DEVICE_ENROLL_STARTING);
     }
@@ -1167,6 +1206,10 @@ on_device_owner_changed (CcFprintdDevice *device, GParamSpec *spec, CcFingerprin
                                             "Problem Reading Device"));
             }
 
+            if (self->pending_enroll_finger) {
+                g_clear_pointer (&self->pending_enroll_finger, g_free);
+                remove_dialog_state (self, DIALOG_STATE_DEVICE_ENROLLING | DIALOG_STATE_DEVICE_ENROLL_STARTING);
+            }
             remove_dialog_state (self, DIALOG_STATE_DEVICE_CLAIMED);
             claim_device (self);
         }
@@ -1383,7 +1426,11 @@ back_button_clicked_cb (CcFingerprintDialog *self)
 static void
 cancel_button_clicked_cb (CcFingerprintDialog *self)
 {
-    if (self->dialog_state & DIALOG_STATE_DEVICE_ENROLLING) {
+    if (self->pending_enroll_finger) {
